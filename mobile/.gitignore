# Generated per-machine platform glue. `flutter create` rewrites these.
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Pods/
ios/.symlinks/

# The base URL a developer points the app at is theirs, not the repository's.
lib/core/app_config.local.dart

# IntelliJ / Android Studio module files, regenerated by the IDE per machine.
*.iml
