<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <RootNamespace>Sms.Erp.Bridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ERP reads the signed-in principal off HttpContext, exactly as its own host does, so the
         adapter that supplies its ICurrentUser needs IHttpContextAccessor. Keeping that adapter here
         with the others is worth the framework reference: the seam is easier to reason about — and to
         delete — when it is one project rather than one project plus pieces in the host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The only two sides this project is allowed to see.

      ERP2028.Modules.Accounting.Contracts — contracts ONLY. Not .Application,
      not .Infrastructure, not .Domain. That is the same rule the ERP imposes on
      its own modules (docs/Architecture/05-Dependency-Rules.md §3), and it is
      what keeps this bridge from becoming a second, private coupling to
      Accounting's internals. Its transitive closure is Application.Abstractions
      + Common + SharedKernel and nothing else.

      Sms.Application — where the ports live. The school defines the interface;
      this project supplies the ERP-backed implementation. Sms.Application,
      Sms.Domain and Sms.Infrastructure never reference anything ERP: delete this
      project and the school is standalone again, unchanged.

      The composition root (Sms.Web) is the one place allowed to reference
      Accounting's .Application/.Infrastructure/.Web, because registering a
      module and migrating its DbContext cannot be done through a contract.
    -->
    <ProjectReference Include="..\..\external\erp\src\Modules\Accounting\ERP2028.Modules.Accounting.Contracts\ERP2028.Modules.Accounting.Contracts.csproj" />
    <!-- Contracts only, for the permission names Organization declares. Accounting already pulls this
         in transitively; naming it is honest about the fact that this project reads from it. -->
    <ProjectReference Include="..\..\external\erp\src\Modules\Organization\ERP2028.Modules.Organization.Contracts\ERP2028.Modules.Organization.Contracts.csproj" />
    <!-- Contracts only, again, and for one reason only: ErpPermissionCatalog declares these modules'
         permissions to this system's role screen. A module hosted here whose permissions are not in
         that list is a set of screens nobody but SYSADMIN can ever be given. -->
    <ProjectReference Include="..\..\external\erp\src\Modules\Inventory\ERP2028.Modules.Inventory.Contracts\ERP2028.Modules.Inventory.Contracts.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Purchasing\ERP2028.Modules.Purchasing.Contracts\ERP2028.Modules.Purchasing.Contracts.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Sales\ERP2028.Modules.Sales.Contracts\ERP2028.Modules.Sales.Contracts.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Cash\ERP2028.Modules.Cash.Contracts\ERP2028.Modules.Cash.Contracts.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Partners\ERP2028.Modules.Partners.Contracts\ERP2028.Modules.Partners.Contracts.csproj" />
    <ProjectReference Include="..\Sms.Application\Sms.Application.csproj" />
  </ItemGroup>

</Project>
