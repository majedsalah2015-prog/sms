<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Sms.Application\Sms.Application.csproj" />
    <ProjectReference Include="..\Sms.Infrastructure\Sms.Infrastructure.csproj" />
    <ProjectReference Include="..\Sms.Erp.Bridge\Sms.Erp.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The composition root is the one place allowed to see an ERP module's
      .Application / .Infrastructure / .Web, because registering a module and
      migrating its DbContext cannot be expressed through a contract. Every
      other project of this system reaches the ERP through Sms.Erp.Bridge, and
      only through Accounting.Contracts — enforced by ErpBoundaryTests.

      Organization is not optional: Accounting.Application injects
      IBranchDirectory to validate the BranchCode on a posting line.
      See docs/Integration/01-Embedded-Accounting-Plan.md §4.2.
    -->
    <ProjectReference Include="..\..\external\erp\src\Modules\Organization\ERP2028.Modules.Organization.Application\ERP2028.Modules.Organization.Application.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Organization\ERP2028.Modules.Organization.Infrastructure\ERP2028.Modules.Organization.Infrastructure.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Accounting\ERP2028.Modules.Accounting.Application\ERP2028.Modules.Accounting.Application.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Accounting\ERP2028.Modules.Accounting.Infrastructure\ERP2028.Modules.Accounting.Infrastructure.csproj" />
    <!-- Razor class libraries: their Area controllers and compiled views are discovered through
         AddApplicationPart in Startup, and their _ViewStart asks for a layout by name, so the
         layout they render inside is this application's own. -->
    <ProjectReference Include="..\..\external\erp\src\Modules\Organization\ERP2028.Modules.Organization.Web\ERP2028.Modules.Organization.Web.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Accounting\ERP2028.Modules.Accounting.Web\ERP2028.Modules.Accounting.Web.csproj" />

    <!--
      The operational modules: stores, buying, selling, the till, and the money that
      moves against them. Same three layers each, for the same reason as above.

      Partners is here because Cash needs it, not because a school does: Cash's
      voucher drafts resolve Partners' directory to name the counterparty on an
      owner's-account voucher, so registering Cash without Partners produces a
      container that resolves until the first voucher is drafted. Its own screens
      come along with it — a module that is running and reachable but hidden from the
      menu is a worse lie than one entry a school will not use.

      Inventory, Purchasing, Sales and Cash reference each other's .Contracts only,
      so this list is five modules, not a graph: adding one changes nothing here
      except its own three lines.
    -->
    <ProjectReference Include="..\..\external\erp\src\Modules\Inventory\ERP2028.Modules.Inventory.Application\ERP2028.Modules.Inventory.Application.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Inventory\ERP2028.Modules.Inventory.Infrastructure\ERP2028.Modules.Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Inventory\ERP2028.Modules.Inventory.Web\ERP2028.Modules.Inventory.Web.csproj" />

    <ProjectReference Include="..\..\external\erp\src\Modules\Purchasing\ERP2028.Modules.Purchasing.Application\ERP2028.Modules.Purchasing.Application.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Purchasing\ERP2028.Modules.Purchasing.Infrastructure\ERP2028.Modules.Purchasing.Infrastructure.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Purchasing\ERP2028.Modules.Purchasing.Web\ERP2028.Modules.Purchasing.Web.csproj" />

    <ProjectReference Include="..\..\external\erp\src\Modules\Sales\ERP2028.Modules.Sales.Application\ERP2028.Modules.Sales.Application.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Sales\ERP2028.Modules.Sales.Infrastructure\ERP2028.Modules.Sales.Infrastructure.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Sales\ERP2028.Modules.Sales.Web\ERP2028.Modules.Sales.Web.csproj" />

    <ProjectReference Include="..\..\external\erp\src\Modules\Cash\ERP2028.Modules.Cash.Application\ERP2028.Modules.Cash.Application.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Cash\ERP2028.Modules.Cash.Infrastructure\ERP2028.Modules.Cash.Infrastructure.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Cash\ERP2028.Modules.Cash.Web\ERP2028.Modules.Cash.Web.csproj" />

    <ProjectReference Include="..\..\external\erp\src\Modules\Partners\ERP2028.Modules.Partners.Application\ERP2028.Modules.Partners.Application.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Partners\ERP2028.Modules.Partners.Infrastructure\ERP2028.Modules.Partners.Infrastructure.csproj" />
    <ProjectReference Include="..\..\external\erp\src\Modules\Partners\ERP2028.Modules.Partners.Web\ERP2028.Modules.Partners.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- E-011 background jobs (doc 02 T-6, IP-02 §2 toolchain decision). -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.7.34" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.7.34" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="5.0.17">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Reading a school's old Access register on the way in (StudentImport). ODBC rather than OLEDB
      deliberately: the machine this runs on has the ACE ODBC driver registered and no ACE OLEDB
      provider at all, and ODBC is the one of the two that Linux could also serve one day.
    -->
    <PackageReference Include="System.Data.Odbc" Version="5.0.0" />
    <!--
      The mobile API's OpenAPI document (docs/Integration/03-Mobile-API.md). 6.4.0 is the
      last line that still ships a net5.0 target — 7.x is net6.0 and up, so this pin is the
      framework's, not a preference. Served in Development only; see Startup.Configure.
    -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
  </PropertyGroup>

  <!--
    The ERP's design system, which its Tag Helpers emit class names against, so its screens are
    styled when rendered here. Copied on every build rather than committed: a committed copy is a
    stale copy the moment the submodule pointer moves, which is the exact failure P0 spent its time
    undoing. The destination is git-ignored.

    The file is plain, self-contained CSS — no @import, no url() — so it needs none of the ERP's
    Vite pipeline. If that ever stops being true, this target is where it will break, loudly.
  -->
  <Target Name="CopyErpTheme" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="..\..\external\erp\src\Bootstrap\ERP2028.Web\Assets\css\erp-theme.css"
          DestinationFiles="wwwroot\css\erp-theme.css"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    The five scripts the embedded modules' views ask for by absolute path. They live in the ERP
    host's wwwroot rather than in the module that uses them, so hosting the module here without
    them gives a screen that renders and does nothing — the till takes no payment, the label
    designer has no canvas.

    Copied, git-ignored and enumerated for the same reasons as the theme above: an itemised list
    breaks loudly when a script is renamed upstream, where a wildcard would quietly start shipping
    whatever else the ERP host happens to keep in that folder (its chat and notification scripts,
    which belong to a module this system does not host).
  -->
  <ItemGroup>
    <ErpScript Include="..\..\external\erp\src\Bootstrap\ERP2028.Web\wwwroot\js\erp-calculator.js" />
    <ErpScript Include="..\..\external\erp\src\Bootstrap\ERP2028.Web\wwwroot\js\erp-label-designer.js" />
    <ErpScript Include="..\..\external\erp\src\Bootstrap\ERP2028.Web\wwwroot\js\erp-label-print.js" />
    <ErpScript Include="..\..\external\erp\src\Bootstrap\ERP2028.Web\wwwroot\js\erp-scale-scan.js" />
    <ErpScript Include="..\..\external\erp\src\Bootstrap\ERP2028.Web\wwwroot\js\pos-till.js" />
  </ItemGroup>

  <Target Name="CopyErpScripts" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="@(ErpScript)" DestinationFolder="wwwroot\js" SkipUnchangedFiles="true" />
  </Target>

</Project>
