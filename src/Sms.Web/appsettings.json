{
  "ConnectionStrings": {
    "Sms": "Server=.;Database=Sms;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "ExternalApps": {
    "ErpUrl": "http://localhost:5080"
  },
  "Tenant": {
    "SchoolId": 1,
    "WorkingAcademicYearId": 1
  },
  "Organization": {
    "CompanyCode": "SCHOOL",
    "CompanyNameAr": "المدرسة",
    "CompanyNameEn": "The School",
    "AssignExistingUsersToHeadOffice": true
  },
  "AccountingSeed": {
    "SeedDefaultChartOfAccounts": true,
    "SeedCurrentFiscalYear": true,
    "BaseCurrencyCode": "SAR",
    "BaseCurrencyNameAr": "ريال سعودي",
    "BaseCurrencyNameEn": "Saudi Riyal",
    "BaseCurrencyDecimalPlaces": 2
  },
  "FileStore": {
    "RootPath": "App_Data/ErpFiles",
    "MaxSizeBytes": 10485760,
    "AllowedExtensions": [ "pdf", "jpg", "jpeg", "png", "tif", "tiff", "xlsx", "docx" ]
  },
  "Attachments": {
    "RootPath": "App_Data/Attachments"
  },
  "MobileApp": {
    "PackagePath": "App_Data/MobileApp",
    "MinimumSupportedVersion": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
