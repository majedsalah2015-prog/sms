@using System.Globalization
@model DepartmentEditViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Edit department", "تعديل القسم") + " — " + (isRtl ? Model.NameAr : Model.NameEn);
    ViewData["Breadcrumb"] = T("Subjects / Departments / Edit", "المواد الدراسية / الأقسام / تعديل");
    ViewData["SubjectsTab"] = "departments";
    var help = new HelpPanelViewModel
    {
        Id = "department-edit-help",
        Title = T("Edit department — help", "تعديل القسم — مساعدة"),
        Intro = T("A department groups subjects and gives them a head (doc/Modules/13 §8). It is an organisational unit, not a teaching one — nothing is timetabled against a department.", "القسم يجمع المواد ويمنحها رئيساً (الوثيقة 13 §8). وهو وحدة تنظيمية لا تدريسية — فلا شيء يُجدوَل على قسم."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("The head must be a teacher with an account", "رئيس القسم معلم له حساب"), T("The picker only offers teachers who have a linked user account (BR-SUB-007), because the role carries screens they have to be able to open. A teacher missing from the list needs an account first, not a different department.", "لا يعرض المنتقي إلا المعلمين ذوي الحسابات المرتبطة (BR-SUB-007)، لأن الدور يحمل شاشات يجب أن يستطيعوا فتحها. فالمعلم الغائب من القائمة يحتاج حساباً أولاً لا قسماً آخر.")),
            new HelpPanelViewModel.Item(T("Renaming is safe", "إعادة التسمية آمنة"), T("Subjects reference the department by identity, not by name, so a correction here follows through everywhere at once. Both languages are required (BR-GLB-001).", "المواد تشير إلى القسم بهويته لا باسمه، فالتصحيح هنا يسري في كل مكان دفعةً واحدة. واللغتان مطلوبتان (BR-GLB-001).")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Names and head of department (a teacher with a linked user account, BR-SUB-007).", "الأسماء ورئيس القسم (معلم له حساب مستخدم مرتبط، BR-SUB-007).")</p></div>
    <partial name="_HelpModal" model="help" /></div>
<partial name="_SubjectsNav" />

<div class="sms-card p-4" style="max-width:640px">
    <form method="post" asp-action="EditDepartment" asp-route-id="@Model.Id" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6"><label class="form-label">@T("Name (Arabic)", "الاسم (عربي)")</label><input asp-for="NameAr" class="form-control" dir="rtl" /></div>
            <div class="col-md-6"><label class="form-label">@T("Name (English)", "الاسم (إنجليزي)")</label><input asp-for="NameEn" class="form-control" dir="ltr" /></div>
        </div>
        <div class="mb-3"><label class="form-label">@T("Head of department", "رئيس القسم")</label><select asp-for="HeadTeacherUserId" class="form-select"><option value="">—</option>@foreach (var t in Model.Teachers) { <option value="@t.UserAccountId" disabled="@(t.UserAccountId == null)">@(isRtl ? t.NameAr : t.NameEn)@(t.UserAccountId == null ? " (" + T("no user account", "بلا حساب") + ")" : "")</option> }</select></div>
        <div class="small text-muted mb-3"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@Model.SubjectCount @T("subject(s) in this department.", "مادة/مواد في هذا القسم.")</div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>@T("Save changes", "حفظ التعديلات")</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-tab="departments">@T("Cancel", "إلغاء")</a>
    </form>
</div>
