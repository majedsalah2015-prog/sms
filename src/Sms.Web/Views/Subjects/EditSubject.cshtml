@using System.Globalization
@model SubjectEditViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Edit subject", "تعديل المادة") + " — " + Model.Code;
    ViewData["Breadcrumb"] = T("Subjects / Edit", "المواد الدراسية / تعديل");
    ViewData["SubjectsTab"] = "catalog";
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Code is unique per school (BR-SUB-001). Changing the code/name updates every plan and matrix entry that references the subject.", "الرمز فريد على مستوى المدرسة (BR-SUB-001). تغيير الرمز/الاسم ينعكس على كل خطة ومصفوفة تشير إلى المادة.")</p></div></div>
<partial name="_SubjectsNav" />

<div class="sms-card p-4" style="max-width:640px">
    <form method="post" asp-action="EditSubject" asp-route-id="@Model.Id" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-4"><label class="form-label">@T("Code", "الرمز")</label><input asp-for="Code" class="form-control" dir="ltr" /></div>
            <div class="col-md-8"><label class="form-label">@T("Name (English)", "الاسم (إنجليزي)")</label><input asp-for="NameEn" class="form-control" dir="ltr" /></div>
        </div>
        <div class="mb-3"><label class="form-label">@T("Name (Arabic)", "الاسم (عربي)")</label><input asp-for="NameAr" class="form-control" dir="rtl" /></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6"><label class="form-label">@T("Category", "الفئة")</label><select asp-for="Category" class="form-select">@foreach (var c in SubjectCatalogViewModel.Categories) { <option value="@c">@SubjectCatalogViewModel.CategoryLabel(c, isRtl)</option> }</select></div>
            <div class="col-md-6"><label class="form-label">@T("Department", "القسم")</label><select asp-for="DepartmentId" class="form-select"><option value="">—</option>@foreach (var d in Model.Departments) { <option value="@d.Id">@(isRtl ? d.Name.NameAr : d.Name.NameEn)</option> }</select></div>
        </div>
        <div class="small text-muted mb-3"><i class="bi bi-info-circle me-1"></i>@Model.CurrentOfferings @T("current curriculum plan(s) include this subject.", "خطة/خطط دراسية حالية تتضمن هذه المادة.")</div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>@T("Save changes", "حفظ التعديلات")</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-tab="catalog">@T("Cancel", "إلغاء")</a>
    </form>
</div>
