@using System.Globalization
@using Sms.Domain.Subjects
@model SubjectCatalogViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Subjects", "المواد الدراسية");
    ViewData["Breadcrumb"] = T("Subjects", "المواد الدراسية");
    ViewData["SubjectsTab"] = Model.ActiveTab;
    string TeacherName(int userId) => Model.Teachers.FirstOrDefault(t => t.UserAccountId == userId) is { } t ? (isRtl ? t.NameAr : t.NameEn) : $"#{userId}";
    var subjectsAll = Model.Subjects.Select(r => r.Subject).ToList();
    var help = new HelpPanelViewModel
    {
        Id = "subjects-help",
        Title = T("Subjects — help", "المواد الدراسية — مساعدة"),
        Intro = T("The subject catalog is the school-wide list of subjects; departments group them for the head-of-department chain; the qualification matrix says which teacher may teach which subject (and in which stages). The per-grade weekly plan is on the Curriculum plan tab.", "دليل المواد هو قائمة المواد على مستوى المدرسة؛ والأقسام تجمعها لسلسلة رئيس القسم؛ ومصفوفة التأهيل تحدد أي معلم يجوز له تدريس أي مادة (وفي أي مراحل). الخطة الأسبوعية لكل صف في تبويب الخطة الدراسية."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Catalog", "الدليل"), T("Code (unique per school, BR-SUB-001), Arabic/English names, category and department. Filter by department from the dropdown. 'Offerings' = how many current grade plans include the subject; 'Qualified teachers' = matrix coverage — 0 is a gap.", "الرمز (فريد على مستوى المدرسة، BR-SUB-001) والاسمان والفئة والقسم. صفِّ حسب القسم من القائمة. «في الخطط» = عدد خطط الصفوف الحالية التي تتضمن المادة؛ «المعلمون المؤهلون» = تغطية المصفوفة — الصفر فجوة.")),
            new HelpPanelViewModel.Item(T("Edit ✎ / Delete 🗑", "تعديل ✎ / حذف 🗑"), T("Edit changes code/names/category/department. Delete deactivates the subject (never a hard delete) and is refused while a current curriculum plan still offers it — end-date the offering in the plan first (BR-SUB-004). Past offerings and qualifications stay as history.", "التعديل يغيّر الرمز/الأسماء/الفئة/القسم. الحذف يلغي تفعيل المادة (لا حذف فعلي) ويُرفض ما دامت خطة دراسية حالية تتضمنها — أنهِ المادة في الخطة أولاً (BR-SUB-004). تبقى العروض السابقة والتأهيلات كسجل.")),
            new HelpPanelViewModel.Item(T("Departments", "الأقسام"), T("Group subjects and name a head of department (must be a teacher with a user account, BR-SUB-007). A department can be removed only after its subjects are moved elsewhere.", "تجمع المواد وتحدد رئيس القسم (يجب أن يكون معلماً له حساب مستخدم، BR-SUB-007). لا يُحذف القسم إلا بعد نقل مواده.")),
            new HelpPanelViewModel.Item(T("Qualification matrix", "مصفوفة التأهيل"), T("Record teacher × subject (optionally limited to a stage). Assigning a teacher outside the matrix is blocked unless an approval-sourced entry exists (BR-SUB-006).", "سجّل معلم × مادة (مع تقييد اختياري بمرحلة). إسناد معلم خارج المصفوفة محجوب ما لم يوجد تأهيل باعتماد (BR-SUB-006).")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Catalog, departments and teacher qualifications (BR-SUB-001/002/006); the per-grade plan lives under Curriculum plan.", "الدليل والأقسام وتأهيل المعلمين (BR-SUB-001/002/006)؛ الخطة لكل صف تحت الخطة الدراسية.")</p></div>
    <partial name="_HelpModal" model="help" /></div>
<partial name="_SubjectsNav" />

@if (Model.ActiveTab == "catalog")
{
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="sms-card">
                <div class="p-2 border-bottom d-flex gap-2 align-items-center">
                    <form method="get" class="d-flex gap-2 align-items-center"><input type="hidden" name="tab" value="catalog" /><select name="department" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="@T("Filter by department", "تصفية حسب القسم")"><option value="">@T("All departments", "كل الأقسام")</option>@foreach (var d in Model.Departments) { <option value="@d.Id" selected="@(d.Id == Model.DepartmentFilter)">@(isRtl ? d.Name.NameAr : d.Name.NameEn)</option> }</select></form>
                    <span class="small text-muted ms-auto">@Model.Subjects.Count @T("subjects", "مادة")</span>
                </div>
                <div class="table-responsive"><table class="table sms-table mb-0">
                    <caption class="visually-hidden">@T("Subject catalog", "دليل المواد")</caption>
                    <thead><tr><th scope="col">@T("Code", "الرمز")</th><th scope="col">@T("Subject", "المادة")</th><th scope="col">@T("Category", "الفئة")</th><th scope="col">@T("Department", "القسم")</th><th scope="col">@T("Offerings", "في الخطط")</th><th scope="col">@T("Qualified teachers", "المعلمون المؤهلون")</th><th scope="col"><span class="visually-hidden">@T("Actions", "إجراءات")</span></th></tr></thead>
                    <tbody>@foreach (var r in Model.Subjects) { <tr><td><code>@r.Subject.Code</code></td><td class="fw-semibold">@(isRtl ? r.Subject.Name.NameAr : r.Subject.Name.NameEn)</td><td>@SubjectCatalogViewModel.CategoryLabel(r.Subject.Category, isRtl)</td><td>@(r.Department == null ? "—" : (isRtl ? r.Department.Name.NameAr : r.Department.Name.NameEn))</td><td><span class="badge text-bg-light border">@r.Offerings</span></td><td>@if (r.QualifiedTeachers == 0) { <span class="badge text-bg-warning">0 · @T("gap", "فجوة")</span> } else { <span class="badge text-bg-light border">@r.QualifiedTeachers</span> }</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="EditSubject" asp-route-id="@r.Subject.Id" title="@T("Edit subject", "تعديل المادة")" aria-label="@T("Edit subject", "تعديل المادة")"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            <form method="post" asp-action="DeleteSubject" asp-route-id="@r.Subject.Id" class="d-inline" onsubmit="return confirm('@T("Remove this subject from the catalog?", "حذف هذه المادة من الدليل؟")');">
                                <button class="btn btn-sm btn-outline-danger" type="submit" title="@(r.Offerings > 0 ? T("In current plans — end-date the offerings first", "في خطط حالية — أنهِ العروض أولاً") : T("Remove subject", "حذف المادة"))" aria-label="@(r.Offerings > 0 ? T("In current plans — end-date the offerings first", "في خطط حالية — أنهِ العروض أولاً") : T("Remove subject", "حذف المادة"))" disabled="@(r.Offerings > 0)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </form>
                        </td></tr> }
                    @if (Model.Subjects.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">@T("No subjects yet.", "لا مواد بعد.")</td></tr> }</tbody>
                </table></div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="sms-card p-3 mb-3">
                <h2 class="h6">@T("Load a stage's subjects", "إدخال مواد مرحلة")</h2>
                <p class="small text-muted mb-2">
                    @T("The list a school of that stage starts from. Codes that already exist are left untouched, so pressing a button twice changes nothing and a school teaching two stages can load both.",
                       "القائمة التي تبدأ منها مدرسة تلك المرحلة. والرموز الموجودة تُترك كما هي، فالضغط مرتين لا يغيّر شيئاً، ومدرسة تدرّس مرحلتين تستطيع تحميل الحزمتين.")
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var stage in SubjectStagePacks.All)
                    {
                        var pack = SubjectStagePacks.For(stage);
                        <form method="post" asp-action="AddStagePack" class="d-inline">
                            <input type="hidden" name="stage" value="@stage" />
                            <button class="btn btn-sm btn-outline-primary" type="submit"
                                    title="@string.Join(" · ", pack.Select(r => isRtl ? r.NameAr : r.NameEn))">
                                <i class="bi bi-collection me-1" aria-hidden="true"></i>@SubjectStagePacks.Label(stage, isRtl)
                                <span class="badge text-bg-light border ms-1">@pack.Count</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
            <div class="sms-card p-3">
                <h2 class="h6">@T("New subject", "مادة جديدة")</h2>
                <form method="post" asp-action="DefineSubject">
                    <div class="row g-2 mb-2"><div class="col-4"><label asp-for="Code" class="form-label small mb-1">@T("Code", "الرمز") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Code" class="form-control form-control-sm" dir="ltr" placeholder="MATH" required aria-required="true" /></div><div class="col-8"><label asp-for="NameEn" class="form-label small mb-1">@T("Name (English)", "الاسم (إنجليزي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="NameEn" class="form-control form-control-sm" dir="ltr" placeholder="Mathematics" required aria-required="true" /></div></div>
                    <div class="mb-2"><label asp-for="NameAr" class="form-label small mb-1">@T("Name (Arabic)", "الاسم (عربي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="NameAr" class="form-control form-control-sm" dir="rtl" placeholder="رياضيات" required aria-required="true" /></div>
                    <div class="row g-2 mb-2"><div class="col-6"><label asp-for="Category" class="form-label small mb-1">@T("Category", "الفئة")</label><select asp-for="Category" class="form-select form-select-sm">@foreach (var c in SubjectCatalogViewModel.Categories) { <option value="@c">@SubjectCatalogViewModel.CategoryLabel(c, isRtl)</option> }</select></div><div class="col-6"><label asp-for="DepartmentId" class="form-label small mb-1">@T("Department", "القسم")</label><select asp-for="DepartmentId" class="form-select form-select-sm"><option value="">@T("— department —", "— القسم —")</option>@foreach (var d in Model.Departments) { <option value="@d.Id">@(isRtl ? d.Name.NameAr : d.Name.NameEn)</option> }</select></div></div>
                    <button class="btn btn-sm btn-primary w-100" type="submit">@T("Create subject", "إنشاء مادة")</button>
                </form>
            </div>
        </div>
    </div>
}
else if (Model.ActiveTab == "departments")
{
    <div class="row g-3">
        <div class="col-xl-8">
            @foreach (var d in Model.Departments)
            {
                var deptSubjects = subjectsAll.Count(s => s.DepartmentId == d.Id);
                <div class="sms-card mb-3"><div class="p-3 border-bottom d-flex gap-2 align-items-center"><h2 class="h6 mb-0">@(isRtl ? d.Name.NameAr : d.Name.NameEn)</h2><span class="small text-muted">@T("Head:", "الرئيس:") @(d.HeadTeacherUserId == null ? "—" : TeacherName(d.HeadTeacherUserId.Value))</span>
                    <span class="ms-auto d-flex gap-1">
                        <a class="btn btn-sm btn-outline-primary" asp-action="EditDepartment" asp-route-id="@d.Id" title="@T("Edit department", "تعديل القسم")"><i class="bi bi-pencil" aria-hidden="true"></i> @T("Edit", "تعديل")</a>
                        <form method="post" asp-action="DeleteDepartment" asp-route-id="@d.Id" class="d-inline" onsubmit="return confirm('@T("Remove this department?", "حذف هذا القسم؟")');">
                            <button class="btn btn-sm btn-outline-danger" type="submit" title="@(deptSubjects > 0 ? T("Move its subjects first", "انقل مواده أولاً") : T("Remove department", "حذف القسم"))" disabled="@(deptSubjects > 0)"><i class="bi bi-trash" aria-hidden="true"></i> @T("Delete", "حذف")</button>
                        </form>
                    </span></div>
                    <div class="p-3 d-flex flex-wrap gap-2">@foreach (var s in subjectsAll.Where(s => s.DepartmentId == d.Id)) { <span class="badge text-bg-light border">@s.Code · @(isRtl ? s.Name.NameAr : s.Name.NameEn)</span> }@if (!subjectsAll.Any(s => s.DepartmentId == d.Id)) { <span class="small text-muted">@T("No subjects assigned.", "لا مواد مسندة.")</span> }</div></div>
            }
            @if (Model.Departments.Count == 0) { <div class="sms-card p-4 text-center text-muted">@T("No departments yet.", "لا أقسام بعد.")</div> }
        </div>
        <div class="col-xl-4">
            <div class="sms-card p-3"><h2 class="h6">@T("New department", "قسم جديد")</h2>
                <form method="post" asp-action="DefineDepartment">
                    <div class="mb-2"><label asp-for="DeptNameAr" class="form-label small mb-1">@T("Name (Arabic)", "الاسم (عربي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="DeptNameAr" class="form-control form-control-sm" dir="rtl" placeholder="قسم العلوم" required aria-required="true" /></div>
                    <div class="mb-2"><label asp-for="DeptNameEn" class="form-label small mb-1">@T("Name (English)", "الاسم (إنجليزي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="DeptNameEn" class="form-control form-control-sm" dir="ltr" placeholder="Science" required aria-required="true" /></div>
                    <div class="mb-2"><label asp-for="HeadTeacherUserId" class="form-label small mb-1">@T("Head of department", "رئيس القسم")</label><select asp-for="HeadTeacherUserId" class="form-select form-select-sm"><option value="">@T("— head of department —", "— رئيس القسم —")</option>@foreach (var t in Model.Teachers) { <option value="@t.UserAccountId" disabled="@(t.UserAccountId == null)">@(isRtl ? t.NameAr : t.NameEn)@(t.UserAccountId == null ? " (" + T("no user account", "بلا حساب") + ")" : "")</option> }</select></div>
                    <button class="btn btn-sm btn-primary w-100" type="submit">@T("Create department", "إنشاء قسم")</button>
                </form></div>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="sms-card">
                <div class="p-3 border-bottom"><h2 class="h6 mb-0">@T("Teacher × subject", "معلم × مادة")</h2><div class="small text-muted">@T("Cells list stage restrictions; empty = not qualified. Columns with no qualified teacher are gaps.", "الخلايا تعرض قيود المرحلة؛ الفارغة = غير مؤهل. الأعمدة بلا معلم مؤهل فجوات.")</div></div>
                <div class="table-responsive"><table class="table table-sm sms-table mb-0">
                    <caption class="visually-hidden">@T("Qualification matrix", "مصفوفة التأهيل")</caption>
                    <thead><tr><th scope="col">@T("Teacher", "المعلم")</th>@foreach (var s in subjectsAll) { var gap = !Model.Matrix.Values.Any(m => m.ContainsKey(s.Id)); <th scope="col" class="@(gap ? "text-warning-emphasis" : "")" title="@(isRtl ? s.Name.NameAr : s.Name.NameEn)"><abbr title="@(isRtl ? s.Name.NameAr : s.Name.NameEn)">@s.Code</abbr>@if (gap) { <i class="bi bi-exclamation-triangle ms-1" aria-hidden="true"></i> }</th> }</tr></thead>
                    <tbody>@foreach (var t in Model.Teachers.Where(t => t.UserAccountId != null))
                    {
                        Model.Matrix.TryGetValue(t.UserAccountId!.Value, out var row);
                        <tr><th scope="row" class="fw-semibold">@(isRtl ? t.NameAr : t.NameEn)</th>@foreach (var s in subjectsAll) { <td>@if (row != null && row.TryGetValue(s.Id, out var stages)) { <span class="badge text-bg-success" title="@string.Join(", ", stages)">✓ <span class="fw-normal">@string.Join(", ", stages)</span></span> } else { <span class="visually-hidden">@T("not qualified", "غير مؤهل")</span> }</td> }</tr>
                    }
                    @if (!Model.Teachers.Any(t => t.UserAccountId != null)) { <tr><td colspan="@(subjectsAll.Count + 1)" class="text-center text-muted py-3">@T("No teachers with user accounts yet.", "لا معلمون بحسابات مستخدم بعد.")</td></tr> }</tbody>
                </table></div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="sms-card p-3"><h2 class="h6">@T("Record qualification", "تسجيل تأهيل")</h2>
                <form method="post" asp-action="DefineQualification">
                    <div class="mb-2"><select asp-for="QTeacherUserId" class="form-select form-select-sm" required aria-required="true" aria-label="@T("Teacher", "المعلم")"><option value="">@T("— teacher —", "— المعلم —")</option>@foreach (var t in Model.Teachers) { <option value="@t.UserAccountId" disabled="@(t.UserAccountId == null)">@(isRtl ? t.NameAr : t.NameEn)@(t.UserAccountId == null ? " (" + T("no user account", "بلا حساب") + ")" : "")</option> }</select></div>
                    <div class="mb-2"><select asp-for="QSubjectId" class="form-select form-select-sm" required aria-required="true" aria-label="@T("Subject", "المادة")"><option value="">@T("— subject —", "— المادة —")</option>@foreach (var s in subjectsAll) { <option value="@s.Id">@s.Code · @(isRtl ? s.Name.NameAr : s.Name.NameEn)</option> }</select></div>
                    <div class="row g-2 mb-2"><div class="col-7"><select asp-for="QStageId" class="form-select form-select-sm" aria-label="@T("Stage restriction", "قيد المرحلة")"><option value="">@T("all stages", "كل المراحل")</option>@foreach (var s in Model.Stages) { <option value="@s.Id">@(isRtl ? s.Name.NameAr : s.Name.NameEn)</option> }</select></div><div class="col-5"><select asp-for="QSource" class="form-select form-select-sm" aria-label="@T("Source", "المصدر")"><option value="Qualification">@T("Qualification", "مؤهل")</option><option value="Approval">@T("Approval", "اعتماد")</option></select></div></div>
                    <button class="btn btn-sm btn-primary w-100" type="submit">@T("Record", "تسجيل")</button>
                    <div class="form-text">@T("BR-SUB-006: assignments outside the matrix are blocked (or need an approval-sourced entry).", "BR-SUB-006: الإسناد خارج المصفوفة محجوب (أو يحتاج تأهيلاً باعتماد).")</div>
                </form></div>
        </div>
    </div>
}
