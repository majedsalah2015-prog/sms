@using System.Globalization
@model CurriculumPlanViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Curriculum plan", "الخطة الدراسية");
    ViewData["Breadcrumb"] = T("Subjects / Curriculum plan", "المواد الدراسية / الخطة الدراسية");
    var yid = Model.Year?.Id; var pid = Model.Profile?.ProfileId;
    var over = Model.TotalPeriods > Model.AvailableSlots;
    var pct = Model.AvailableSlots == 0 ? 0 : Math.Min(100, (int)Math.Round(100.0 * Model.TotalPeriods / Model.AvailableSlots));
    var help = new HelpPanelViewModel
    {
        Id = "sub-plan-help", Title = T("Curriculum plan — help", "الخطة الدراسية — مساعدة"),
        Intro = T("What one grade teaches in one year: each subject with its periods a week. The three pickers at the top choose the year, the grade, and how many slots the timetable actually has to give — change any of them and the page follows.", "ما يدرسه صف واحد في عام واحد: كل مادة وحصصها في الأسبوع. والقوائم الثلاث في الأعلى تختار العام والصف وعدد الحصص التي يملكها الجدول فعلاً — غيّر أياً منها تتبعك الصفحة."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("The period total is a real limit", "مجموع الحصص حدّ حقيقي"), T("The bar compares what the plan asks for against the slots a week holds. Going over is refused, not warned about (BR-SUB-005) — a plan that does not fit is a timetable that cannot be built, and it is cheaper to discover here.", "يقارن الشريط ما تطلبه الخطة بالحصص التي يتّسع لها الأسبوع. والتجاوز يُرفَض ولا يُحذَّر منه فقط (BR-SUB-005) — فالخطة التي لا تتّسع جدولٌ لا يمكن بناؤه، واكتشاف ذلك هنا أرخص.")),
            new HelpPanelViewModel.Item(T("Removing is for mistakes; ending is for changes", "الحذف للأخطاء والإنهاء للتغييرات"), T("The moment a mark, a timetable session, an assignment, an exam or a lesson points at a line, removing it is refused and end-dating is what applies (BR-SUB-004) — those records have to keep pointing somewhere. A line nothing has touched yet can be taken off outright, and the trash button appears only on those.", "ما إن تشير درجة أو حصة جدول أو إسناد أو اختبار أو درس إلى سطر، حتى يُرفض حذفه ويكون الإنهاء بتاريخ هو ما ينطبق (BR-SUB-004) — فتلك السجلات لا بد أن تظل تشير إلى شيء. أما السطر الذي لم يمسّه شيء بعد فيمكن رفعه تماماً، وزر السلة لا يظهر إلا عليه.")),
            new HelpPanelViewModel.Item(T("Assessable and GPA weight", "قابلة للتقييم ووزن المعدل"), T("An assessable subject appears in the gradebook and on the report card; the weight is what it counts for in the average. An activity subject is usually carried at weight zero rather than left out, so it still shows on the card.", "المادة القابلة للتقييم تظهر في سجل العلامات وكشف الدرجات؛ والوزن هو ما تُحسب به في المعدل. ومادة النشاط تُحمَل عادة بوزن صفر بدل استبعادها، فتظل ظاهرة في الكشف.")),
            new HelpPanelViewModel.Item(T("Elective groups", "المجموعات الاختيارية"), T("Subjects sharing an elective group tag are the alternatives a student picks one of. Tag them identically or the group is not a group — the tag is the only thing that ties them together.", "المواد التي تشترك في وسم مجموعة اختيارية هي البدائل التي يختار الطالب واحدة منها. فوسِمها بالنص ذاته وإلا لم تكن المجموعة مجموعة — فالوسم هو ما يربطها وحده.")),
            new HelpPanelViewModel.Item(T("Copying last year's plan", "نسخ خطة العام الماضي"), T("Copying brings the offerings of another grade-year across as new ones effective from today; it never touches what is already here. Start from the closest plan you have and edit the differences.", "النسخ يجلب مواد صف سنوي آخر كمواد جديدة تسري من اليوم؛ ولا يمسّ ما هو قائم هنا. ابدأ من أقرب خطة لديك ثم عدّل الفروق.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Per grade-year: subject, periods/week, assessable, GPA weight, elective group; the period total must fit the timetable's available slots (BR-SUB-005). A line anything already points at is end-dated, never removed (BR-SUB-004).", "لكل صف سنوي: المادة، الحصص أسبوعياً، قابلة للتقييم، وزن المعدل، مجموعة اختيارية؛ يجب أن يتسع مجموع الحصص في الجدول (BR-SUB-005). والسطر الذي يشير إليه شيء بالفعل يُنهى بتاريخ ولا يُحذف (BR-SUB-004).")</p></div>
    @* Each picker carries its own visible label. Two bare dropdowns side by side did not say which
       one was the year and which the grade, and the one label on the row ("slots/wk") sat between
       the grade dropdown and the number box, so it read as the grade's. Labels above fields is the
       house rule anyway (docs/UI/02-Screen-Patterns.md §2). *@
    <div class="d-flex gap-2 align-items-end flex-wrap">
    <form method="get" class="d-flex gap-2 align-items-end flex-wrap">
        <div>
            <label for="plan-year" class="form-label small text-muted mb-1">@T("Academic year", "العام الدراسي")</label>
            <select id="plan-year" name="year" class="form-select form-select-sm" onchange="this.form.submit()">
                @if (Model.Years.Count == 0) { <option value="">@T("— no years defined —", "— لا أعوام معرَّفة —")</option> }
                @foreach (var y in Model.Years) { <option value="@y.Id" selected="@(y.Id == yid)">@(isRtl ? y.LabelAr : y.LabelEn)</option> }
            </select>
        </div>
        <div>
            <label for="plan-grade" class="form-label small text-muted mb-1">@T("Grade", "الصف")</label>
            <select id="plan-grade" name="profile" class="form-select form-select-sm" onchange="this.form.submit()">
                @if (Model.Profiles.Count == 0) { <option value="">@T("— no grades this year —", "— لا صفوف هذا العام —")</option> }
                @foreach (var p in Model.Profiles) { <option value="@p.ProfileId" selected="@(p.ProfileId == pid)">@p.Grade.Code · @(isRtl ? p.Grade.Name.NameAr : p.Grade.Name.NameEn)@(p.Stage == null ? "" : " · " + (isRtl ? p.Stage.Name.NameAr : p.Stage.Name.NameEn))</option> }
            </select>
        </div>
        <div>
            <label for="plan-slots" class="form-label small text-muted mb-1">@T("Slots/week", "حصص الأسبوع")</label>
            <input id="plan-slots" name="slots" type="number" min="1" class="form-control form-control-sm" style="width:6rem" value="@Model.AvailableSlots" onchange="this.form.submit()" />
        </div>
    </form>
    <partial name="_HelpModal" model="help" />
    </div></div>
<partial name="_SubjectsNav" />

@if (Model.YearFellBack || Model.ProfileFellBack)
{
    <div class="alert alert-warning d-flex align-items-start gap-2">
        <i class="bi bi-exclamation-triangle mt-1 flex-shrink-0" aria-hidden="true"></i>
        <div>
            @if (Model.YearFellBack) { <div>@T("The address named an academic year this school does not have; the plan below is for the year selected above.", "طلب العنوان عاماً دراسياً لا تملكه المدرسة؛ والخطة أدناه للعام المحدد أعلاه.")</div> }
            @if (Model.ProfileFellBack) { <div>@T("The address named a grade with no profile in this year; the plan below is for the grade selected above.", "طلب العنوان صفاً لا ملف له في هذا العام؛ والخطة أدناه للصف المحدد أعلاه.")</div> }
        </div>
    </div>
}

@if (Model.Year == null)
{
    @* Split from the message below: with no year at all, "define a grade-year profile for this year"
       named a year that does not exist and sent the reader to the wrong screen. *@
    <div class="alert alert-info">@T("Define an academic year first (Academic years → Define).", "عرّف عاماً دراسياً أولاً (الأعوام الدراسية → تعريف).")</div>
}
else if (Model.Profile == null)
{
    <div class="alert alert-info">@T("Define a grade-year profile for this year first (Grades → Profile).", "عرّف ملف الصف السنوي لهذا العام أولاً (الصفوف → الملف).")</div>
}
else
{
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="sms-card">
                <div class="p-3 border-bottom d-flex align-items-center gap-3 flex-wrap">
                    @* Which grade, which year — said once, plainly, above the plan itself. It was an h6
                       reading "G3 Grade 3 · 2027-2028", smaller than the table it heads and with the
                       code welded to the name. *@
                    <div>
                        <h2 class="h5 mb-0">@(isRtl ? Model.Profile.Grade.Name.NameAr : Model.Profile.Grade.Name.NameEn) <span class="text-muted fw-normal">· @(isRtl ? Model.Year!.LabelAr : Model.Year!.LabelEn)</span></h2>
                        <div class="small text-muted"><code>@Model.Profile.Grade.Code</code>@if (Model.Profile.Stage != null) { <text> · @(isRtl ? Model.Profile.Stage.Name.NameAr : Model.Profile.Stage.Name.NameEn)</text> }</div>
                    </div>
                    <div class="ms-auto d-flex align-items-center gap-2 small"><span class="@(over ? "text-danger fw-semibold" : "")">@Model.TotalPeriods / @Model.AvailableSlots @T("periods/week", "حصة/أسبوع")</span><div class="sms-progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="@T("Capacity", "السعة")" style="width:8rem"><span style="width:@(pct)%;@(over ? "background:#dc2626" : "")"></span></div>@if (over) { <span class="badge text-bg-danger">@T("over capacity (BR-SUB-005)", "يتجاوز السعة (BR-SUB-005)")</span> }</div>
                </div>
                <div class="table-responsive"><table class="table sms-table mb-0">
                    <caption class="visually-hidden">@T("Curriculum plan", "الخطة الدراسية")</caption>
                    <thead><tr><th scope="col">@T("Subject", "المادة")</th><th scope="col">@T("Periods/wk", "حصص/أسبوع")</th><th scope="col">@T("Assessable", "تقييم")</th><th scope="col">@T("GPA weight", "وزن المعدل")</th><th scope="col">@T("Elective", "اختيارية")</th><th scope="col">@T("Effective", "السريان")</th><th scope="col"><span class="visually-hidden">@T("Actions", "إجراءات")</span></th></tr></thead>
                    <tbody>@foreach (var r in Model.Offerings)
                    {
                        var ended = r.Offering.EffectiveToUtc != null;
                        <tr class="@(ended ? "text-muted" : "")"><td><code>@r.Subject.Code</code> @(isRtl ? r.Subject.Name.NameAr : r.Subject.Name.NameEn)@if (r.SubjectIsRetired) { <span class="badge text-bg-secondary ms-1" title="@T("The subject was deactivated; this offering still stands.", "أُلغيت المادة، وهذه الحصص قائمة.")">@T("retired subject", "مادة ملغاة")</span> }</td><td>@r.Offering.WeeklyPeriods</td><td>@(r.Offering.IsAssessable ? "✓" : "—")</td><td>@r.Offering.GpaWeight</td><td>@(r.Offering.IsElective ? (r.Offering.ElectiveGroupTag ?? "✓") : "—")</td><td class="small">@r.Offering.EffectiveFromUtc.ToString("yyyy-MM-dd")@(ended ? " → " + r.Offering.EffectiveToUtc!.Value.ToString("yyyy-MM-dd") : "")</td>
                            @* Three answers to "this line is wrong", in the order they cost. Edit
                               corrects it. End-dating closes it and keeps every mark ever recorded
                               against it (BR-SUB-004). Removing is only offered when the inspector
                               finds nothing pointing at the line at all — a mistake caught before it
                               was used — and is absent rather than disabled otherwise, with the
                               reason on the lock. *@
                            <td class="text-end"><div class="d-inline-flex gap-1 align-items-center justify-content-end flex-wrap">
                                @if (!ended)
                                {
                                    <form method="post" asp-action="EndOffering" asp-route-id="@r.Offering.Id" asp-route-year="@yid" asp-route-profile="@pid" asp-route-slots="@Model.AvailableSlots" class="d-inline-flex gap-1"><input name="effectiveTo" type="date" class="form-control form-control-sm" style="width:9.5rem" aria-label="@T("End date", "تاريخ الإنهاء")" /><button class="btn btn-sm btn-outline-secondary" type="submit" title="@T("End-date", "إنهاء بتاريخ")" aria-label="@T("End-date", "إنهاء بتاريخ")"><i class="bi bi-calendar-x" aria-hidden="true"></i></button></form>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="EditOffering" asp-route-id="@r.Offering.Id" asp-route-year="@yid" asp-route-profile="@pid" asp-route-slots="@Model.AvailableSlots" title="@T("Edit", "تعديل")" aria-label="@T("Edit", "تعديل")"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                }
                                @if (r.CanRemove)
                                {
                                    <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#rm-@(r.Offering.Id)" title="@T("Remove", "حذف")" aria-label="@T("Remove", "حذف")"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                }
                                else if (r.Usage != null)
                                {
                                    <span class="text-muted small" title="@T($"Cannot be removed — {r.Usage.Describe(false)} reference it. End-date it instead.", $"لا يمكن حذفه — يشير إليه {r.Usage.Describe(true)}. أنهِه بتاريخ بدلاً من ذلك.")"><i class="bi bi-lock" aria-hidden="true"></i><span class="visually-hidden">@T("Cannot be removed", "لا يمكن حذفه")</span></span>
                                }
                            </div></td></tr>
                    }
                    @if (Model.Offerings.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">@T("No offerings yet.", "لا مواد في الخطة بعد.")</td></tr> }</tbody>
                </table></div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="sms-card p-3 mb-3"><h2 class="h6">@T("Add offering", "إضافة مادة")</h2>
                <form method="post" asp-action="AddOffering" asp-route-year="@yid" asp-route-profile="@pid" asp-route-slots="@Model.AvailableSlots">
                    <div class="mb-2"><select asp-for="SubjectId" class="form-select form-select-sm"><option value="">@T("— subject —", "— المادة —")</option>@foreach (var s in Model.Subjects) { <option value="@s.Id">@s.Code · @(isRtl ? s.Name.NameAr : s.Name.NameEn)</option> }</select></div>
                    <div class="row g-2 mb-2"><div class="col-6"><label class="form-label small">@T("Periods/wk", "حصص/أسبوع")</label><input asp-for="WeeklyPeriods" class="form-control form-control-sm" type="number" min="1" /></div><div class="col-6"><label class="form-label small">@T("GPA weight", "وزن المعدل")</label><input asp-for="GpaWeight" class="form-control form-control-sm" type="number" step="0.5" min="0" /></div></div>
                    <div class="form-check"><input asp-for="IsAssessable" class="form-check-input" /><label asp-for="IsAssessable" class="form-check-label small">@T("Assessable (weight must be > 0)", "قابلة للتقييم (الوزن > 0)")</label></div>
                    <div class="form-check mb-2"><input asp-for="IsElective" class="form-check-input" /><label asp-for="IsElective" class="form-check-label small">@T("Elective", "اختيارية")</label></div>
                    <div class="mb-2"><input asp-for="ElectiveGroupTag" class="form-control form-control-sm" placeholder="@T("elective group tag (optional)", "وسم المجموعة الاختيارية (اختياري)")" /></div>
                    <button class="btn btn-sm btn-primary w-100" type="submit">@T("Add", "إضافة")</button>
                </form></div>
            @if (Model.PreviousYearProfileId != null)
            {
                <div class="sms-card p-3"><h2 class="h6">@T("Copy from previous year", "نسخ من العام السابق")</h2>
                    <form method="post" asp-action="CopyPlan" asp-route-year="@yid" asp-route-profile="@pid" asp-route-slots="@Model.AvailableSlots"><input type="hidden" name="sourceProfile" value="@Model.PreviousYearProfileId" />
                        <button class="btn btn-sm btn-outline-primary w-100" type="submit"><i class="bi bi-files me-1" aria-hidden="true"></i>@T("Copy", "نسخ") @Model.PreviousYearLabel → @(isRtl ? Model.Year!.LabelAr : Model.Year!.LabelEn)</button>
                        <div class="form-text">@T("Copies active offerings of the same grade; subjects already in this plan are skipped.", "ينسخ مواد الصف نفسه النشطة؛ ويتخطى الموجود.")</div></form></div>
            }
        </div>
    </div>

    @* Confirmations sit outside the table on purpose: a modal inside <tbody> is invalid markup and
       Bootstrap reparents it to the body anyway, which detaches it from the antiforgery form it was
       meant to carry. Only drawn for rows the inspector cleared, so a dialog that could only ever
       refuse is never opened. *@
    @foreach (var r in Model.Offerings)
    {
        if (!r.CanRemove) { continue; }
        <div class="modal fade" id="rm-@(r.Offering.Id)" tabindex="-1" aria-labelledby="rml-@(r.Offering.Id)" aria-hidden="true">
            <div class="modal-dialog"><div class="modal-content">
                <form method="post" asp-action="RemoveOffering" asp-route-id="@r.Offering.Id" asp-route-year="@yid" asp-route-profile="@pid" asp-route-slots="@Model.AvailableSlots">
                    <div class="modal-header"><h3 class="modal-title h6" id="rml-@(r.Offering.Id)">@T("Remove from the plan", "حذف من الخطة")</h3><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T("Close", "إغلاق")"></button></div>
                    <div class="modal-body">
                        <p class="mb-1"><code>@r.Subject.Code</code> @(isRtl ? r.Subject.Name.NameAr : r.Subject.Name.NameEn)</p>
                        <p class="small text-muted mb-0">@T("Nothing has been recorded against this line — no marks, timetable sessions, teacher assignments, exams or lessons — so removing it takes nothing else with it. It cannot be undone. To close a subject that has actually been taught, end-date it instead (BR-SUB-004).", "لم يُسجَّل شيء على هذا السطر — لا درجات ولا حصص جدول ولا إسنادات معلمين ولا اختبارات ولا دروس — فحذفه لا يأخذ معه شيئاً. ولا يمكن التراجع عنه. أما إغلاق مادة دُرِّست فعلاً فيكون بإنهائها بتاريخ (BR-SUB-004).")</p>
                    </div>
                    <div class="modal-footer"><button class="btn btn-sm btn-danger" type="submit"><i class="bi bi-trash me-1" aria-hidden="true"></i>@T("Remove", "حذف")</button></div>
                </form>
            </div></div>
        </div>
    }
}
