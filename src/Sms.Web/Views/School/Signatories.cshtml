@using System.Globalization
@model SignatoriesViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Signatories", "الموقّعون");
    ViewData["Breadcrumb"] = T("Schools / Signatories", "المدارس / الموقّعون");
    var help = new HelpPanelViewModel
    {
        Id = "school-signatories-help",
        Title = T("Signatories — help", "الموقّعون — مساعدة"),
        Intro = T("Who signs each class of official document, and from when (doc/Modules/02 §8, BR-SCH-004). This is a history, not a setting: the table keeps every signatory the school has ever had, because a document reissued in 2030 must carry the name that was in force on its original issue date.", "من يوقّع كل فئة من المستندات الرسمية، ومنذ متى (الوثيقة 02 §8، BR-SCH-004). وهذا سجل تاريخي لا إعداد: يحتفظ الجدول بكل موقّع مرّ على المدرسة، لأن مستنداً يُعاد إصداره عام 2030 يجب أن يحمل الاسم الساري في تاريخ إصداره الأصلي."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Effective dating does the closing for you", "تاريخ السريان يُغلق نيابةً عنك"), T("Saving a new signatory for a document class ends the current one automatically, dated the day the new one begins. There is no \"end this signatory\" button and there should not be — a gap with nobody in force is what would leave a certificate unsigned.", "حفظ موقّع جديد لفئة مستند يُنهي الحالي تلقائياً بتاريخ بدء الجديد. ولا يوجد زر «إنهاء هذا الموقّع» ولا ينبغي — فالفجوة التي لا يسري فيها أحد هي ما يترك شهادة بلا توقيع.")),
            new HelpPanelViewModel.Item(T("Reading the table", "قراءة الجدول"), T("The bold row with no \"effective to\" date is the one signing today; greyed rows are closed history. A class showing \"None defined\" will print its documents without a signatory block — define one before the first certificate run, not after.", "الصف الغامق الذي لا تاريخ انتهاء له هو الموقّع اليوم؛ والصفوف الباهتة تاريخ مغلق. والفئة التي تُظهر «غير معرَّف» ستطبع مستنداتها بلا كتلة توقيع — عرِّف واحداً قبل أول دفعة شهادات لا بعدها.")),
            new HelpPanelViewModel.Item(T("Name and title, in both languages", "الاسم والمسمى بكلتا اللغتين"), T("Both are required (BR-GLB-001), and both are printed — an Arabic certificate carries the Arabic name and title, an English transcript the English pair. The title is the office (\"Principal\", \"مدير المدرسة\"), not the person's academic rank; it is what appears under the signature line.", "كلاهما مطلوب (BR-GLB-001)، وكلاهما يُطبع — فالشهادة العربية تحمل الاسم والمسمى بالعربية، وكشف الدرجات الإنجليزي يحمل النظير الإنجليزي. والمسمى هو المنصب («مدير المدرسة»، \"Principal\") لا الرتبة العلمية للشخص؛ وهو ما يظهر تحت سطر التوقيع.")),
            new HelpPanelViewModel.Item(T("Effective from is a real date", "«ساري من» تاريخ حقيقي"), T("Backdate it to when the person actually took office rather than to today, and documents issued in between will reissue correctly. Dates are Gregorian in both languages — the Arabic interface does not switch the calendar.", "أرجِعه إلى اليوم الذي تولّى فيه الشخص المنصب فعلاً لا إلى اليوم، فتُعاد المستندات الصادرة بينهما إصداراً صحيحاً. والتواريخ ميلادية في اللغتين — فالواجهة العربية لا تبدّل التقويم.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Per document class, effective-dated: defining a new signatory closes out the current one; reissued documents show the signatory in force at issue (BR-SCH-004).", "لكل فئة مستند بتاريخ سريان: تعريف موقّع جديد يغلق الحالي؛ المستندات المعاد إصدارها تعرض الموقّع الساري وقت الإصدار (BR-SCH-004).")</p></div>
    <partial name="_HelpModal" model="help" /></div>
<partial name="_SchoolNav" />

<div class="row g-3">
    <div class="col-lg-8">
        @foreach (var cls in SignatoriesViewModel.DocumentClasses)
        {
            var rows = Model.Signatories.Where(s => s.DocumentClassCode == cls.Code).ToList();
            <div class="sms-card mb-3">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center"><h2 class="h6 mb-0">@(isRtl ? cls.Ar : cls.En) <code class="small text-muted">@cls.Code</code></h2>
                    @if (rows.FirstOrDefault(r => r.EffectiveToUtc == null) is { } cur) { <span class="badge text-bg-success">@T("Current", "الحالي"): @(isRtl ? cur.NameAr : cur.NameEn)</span> } else { <span class="badge text-bg-warning">@T("None defined", "غير معرَّف")</span> }</div>
                @if (rows.Count > 0)
                {
                    <div class="table-responsive"><table class="table table-sm sms-table mb-0">
                        <caption class="visually-hidden">@T("Signatories", "الموقّعون") — @(isRtl ? cls.Ar : cls.En)</caption>
                        <thead><tr><th scope="col">@T("Name", "الاسم")</th><th scope="col">@T("Title", "المسمى")</th><th scope="col">@T("Effective from", "ساري من")</th><th scope="col">@T("Effective to", "ساري إلى")</th></tr></thead>
                        <tbody>@foreach (var s in rows) { <tr class="@(s.EffectiveToUtc == null ? "fw-semibold" : "text-muted")"><td>@(isRtl ? s.NameAr : s.NameEn)</td><td>@(isRtl ? s.TitleAr : s.TitleEn)</td><td>@s.EffectiveFromUtc.ToString("yyyy-MM-dd")</td><td>@(s.EffectiveToUtc?.ToString("yyyy-MM-dd") ?? "—")</td></tr> }</tbody>
                    </table></div>
                }
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="sms-card p-4">
            <h2 class="h6">@T("Define signatory", "تعريف موقّع")</h2>
            <form method="post" asp-action="Signatories" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
                <div class="mb-2"><label class="form-label" asp-for="DocumentClassCode">@T("Document class", "فئة المستند")</label><select asp-for="DocumentClassCode" class="form-select">@foreach (var c in SignatoriesViewModel.DocumentClasses) { <option value="@c.Code">@(isRtl ? c.Ar : c.En)</option> }</select></div>
                <div class="mb-2"><label class="form-label" asp-for="NameAr">@T("Name (Arabic)", "الاسم (عربي)")</label><input asp-for="NameAr" class="form-control" dir="rtl" /></div>
                <div class="mb-2"><label class="form-label" asp-for="NameEn">@T("Name (English)", "الاسم (إنجليزي)")</label><input asp-for="NameEn" class="form-control" dir="ltr" /></div>
                <div class="mb-2"><label class="form-label" asp-for="TitleAr">@T("Title (Arabic)", "المسمى (عربي)")</label><input asp-for="TitleAr" class="form-control" dir="rtl" placeholder="مدير المدرسة" /></div>
                <div class="mb-2"><label class="form-label" asp-for="TitleEn">@T("Title (English)", "المسمى (إنجليزي)")</label><input asp-for="TitleEn" class="form-control" dir="ltr" placeholder="Principal" /></div>
                <div class="mb-3"><label class="form-label" asp-for="EffectiveFrom">@T("Effective from", "ساري من")</label><input asp-for="EffectiveFrom" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" /></div>
                <button class="btn btn-primary w-100" type="submit"><i class="bi bi-pen me-1" aria-hidden="true"></i>@T("Save", "حفظ")</button>
            </form>
        </div>
    </div>
</div>
