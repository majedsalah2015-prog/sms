@using System.Globalization
@model SchoolProfileViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("School profile", "ملف المدرسة");
    ViewData["Breadcrumb"] = T("Schools / School profile", "المدارس / ملف المدرسة");
    var tabs = new (string Key, string En, string Ar)[] { ("identity", "Identity", "الهوية"), ("license", "License & Ministry", "الترخيص والوزارة"), ("contacts", "Contacts & Location", "التواصل والموقع"), ("branding", "Branding", "الهوية البصرية"), ("stages", "Stages offered", "المراحل المقدَّمة") };
    string Show(string k) => Model.ActiveTab == k ? "show active" : "";
    var help = new HelpPanelViewModel
    {
        Id = "school-profile-help",
        Title = T("School profile — help", "ملف المدرسة — مساعدة"),
        Intro = T("The school's own record (doc/Modules/02 §8). One school per deployment, so this screen is filled once and corrected rarely — but everything it holds is printed on official documents, which is why identity edits are audited and demand a reason.", "سجل المدرسة نفسها (الوثيقة 02 §8). مدرسة واحدة لكل تركيب، فتُملأ هذه الشاشة مرة وتُصحَّح نادراً — لكن ما تحمله يُطبع على المستندات الرسمية، ولذلك تُدقَّق تعديلات الهوية وتتطلب سبباً."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Identity", "الهوية"), T("The Arabic and English official names are both required and are reproduced on certificates and letters exactly as typed (BR-SCH-001) — a trailing space or a spelling variant is what the ministry will read. Time zone and currency are shown disabled here because the Setup wizard owns them: currency in particular is what every stored amount means, so it is not a field to revise from a profile screen.", "الاسمان الرسميان بالعربية والإنجليزية كلاهما مطلوب، ويُنقلان إلى الشهادات والخطابات كما كُتبا تماماً (BR-SCH-001) — فمسافة زائدة أو اختلاف إملائي هو ما ستقرأه الوزارة. المنطقة الزمنية والعملة معطَّلتان هنا لأن معالج الإعداد يملكهما: والعملة تحديداً هي معنى كل مبلغ مخزَّن، فليست حقلاً يُراجَع من شاشة ملف.")),
            new HelpPanelViewModel.Item(T("The reason field is not optional", "حقل السبب ليس اختيارياً"), T("Changing an identity field without a reason is refused (BR-SCH-002). The school is T1-audited: the old value, the new value and the reason are written in the same transaction as the change, and that record is what answers \"who renamed the school before the certificates were printed\" a year later.", "تغيير حقل هوية بلا سبب مرفوض (BR-SCH-002). والمدرسة مدقَّقة بمستوى T1: تُكتب القيمة القديمة والجديدة والسبب في المعاملة نفسها مع التغيير، وهذا السجل هو ما يجيب لاحقاً عن «من غيّر اسم المدرسة قبل طباعة الشهادات».")),
            new HelpPanelViewModel.Item(T("License & Ministry", "الترخيص والوزارة"), T("License number, ministry code and expiry date. Nothing here blocks the system when it lapses — the product does not stop a school from teaching because a date passed — but these are the fields official documents and ministry exports quote, so an out-of-date expiry is a real reporting error.", "رقم الترخيص والرمز الوزاري وتاريخ الانتهاء. ولا شيء هنا يوقف النظام عند انتهائه — فالمنتج لا يمنع مدرسة من التدريس لأن تاريخاً مضى — لكن هذه هي الحقول التي تقتبسها المستندات الرسمية والتصدير الوزاري، فالتاريخ المنتهي خطأ تقريري حقيقي.")),
            new HelpPanelViewModel.Item(T("Stages offered", "المراحل المقدَّمة"), T("A grade cannot be created outside a stage the school offers (BR-SCH-003). Today the list is read-only and every stage defined in Module 05 counts as offered; declaring a subset explicitly is a follow-up. Empty means the stage structure has not been entered yet — the Setup wizard's stage step is where it starts.", "لا يمكن إنشاء صف خارج مرحلة تقدّمها المدرسة (BR-SCH-003). واليوم القائمة للقراءة فقط وكل مرحلة معرَّفة في الوحدة 05 تُعدّ مقدَّمة؛ وتحديد مجموعة جزئية صراحةً عمل لاحق. والقائمة الفارغة تعني أن الهيكل الدراسي لم يُدخل بعد — وخطوة المراحل في معالج الإعداد هي البداية.")),
            new HelpPanelViewModel.Item(T("What is not here yet", "ما لم يصل بعد"), T("Logo and seal upload (PNG/SVG ≤ 2 MB, BR-SCH-006) arrives with the attachment store screens in doc 10; templates render whatever branding is current at the moment a document is issued. The map pin picker behind latitude/longitude (BR-SCH-008) is also pending, which is why those two boxes are disabled rather than hidden.", "رفع الشعار والختم (PNG/SVG ≤ 2 م.ب، BR-SCH-006) يأتي مع شاشات مخزن المرفقات في الوثيقة 10؛ والقوالب تعرض الهوية البصرية السارية لحظة إصدار المستند. ومنتقي الخريطة خلف خطي العرض والطول (BR-SCH-008) لم يصل بعد، ولذلك الحقلان معطَّلان لا مخفيان.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@(Model.SchoolId == null ? T("New school", "مدرسة جديدة") : (isRtl ? Model.NameAr : Model.NameEn))</h1>
    <p class="text-muted mb-0">@T("Module 02 — identity fields appear on official documents exactly as entered (BR-SCH-001) and later edits require a reason (BR-SCH-002).", "الوحدة 02 — حقول الهوية تظهر في المستندات الرسمية كما أُدخلت (BR-SCH-001) والتعديلات اللاحقة تتطلب سبباً (BR-SCH-002).")</p></div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.Status != null) { <span class="badge @(Model.Status == Sms.Domain.Schools.SchoolStatus.Active ? "text-bg-success" : "text-bg-secondary")">@Model.Status</span> }
        <partial name="_HelpModal" model="help" />
    </div>
</div>
<partial name="_SchoolNav" />

<form method="post" asp-action="Profile" novalidate>
    <input type="hidden" asp-for="SchoolId" /><input type="hidden" asp-for="TimeZoneId" /><input type="hidden" asp-for="CurrencyCode" /><input type="hidden" asp-for="ActiveTab" id="ActiveTab" />
    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
    <div class="sms-card">
        <ul class="nav nav-tabs px-3 pt-2" role="tablist">
            @foreach (var t in tabs) { <li class="nav-item"><button class="nav-link @(Model.ActiveTab == t.Key ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-@t.Key" type="button" onclick="document.getElementById('ActiveTab').value='@t.Key'">@(isRtl ? t.Ar : t.En)</button></li> }
        </ul>
        <div class="tab-content p-4">
            <div class="tab-pane fade @Show("identity")" id="tab-identity">
                <div class="sms-bilingual mb-3">
                    <div><label class="form-label" asp-for="NameAr">@T("Official name (Arabic)", "الاسم الرسمي (عربي)")</label><input asp-for="NameAr" class="form-control" dir="rtl" /></div>
                    <div><label class="form-label" asp-for="NameEn">@T("Official name (English)", "الاسم الرسمي (إنجليزي)")</label><input asp-for="NameEn" class="form-control" dir="ltr" /></div>
                </div>
                <div class="row g-3"><div class="col-md-4"><label class="form-label" for="tz-display">@T("Time zone", "المنطقة الزمنية")</label><input id="tz-display" class="form-control" value="@Model.TimeZoneId" disabled /><div class="form-text">@T("Set in the Setup wizard.", "يُحدَّد في معالج الإعداد.")</div></div>
                    <div class="col-md-4"><label class="form-label" for="currency-display">@T("Currency", "العملة")</label><input id="currency-display" class="form-control" value="@Model.CurrencyCode" disabled /></div></div>
            </div>
            <div class="tab-pane fade @Show("license")" id="tab-license">
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label" asp-for="LicenseNumber">@T("License number", "رقم الترخيص")</label><input asp-for="LicenseNumber" class="form-control" dir="ltr" /></div>
                    <div class="col-md-4"><label class="form-label" asp-for="MinistryCode">@T("Ministry code", "الرمز الوزاري")</label><input asp-for="MinistryCode" class="form-control" dir="ltr" /></div>
                    <div class="col-md-4"><label class="form-label" asp-for="LicenseExpiryDate">@T("License expiry", "انتهاء الترخيص")</label><input asp-for="LicenseExpiryDate" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" /></div>
                </div>
            </div>
            <div class="tab-pane fade @Show("contacts")" id="tab-contacts">
                <div class="row g-3 mb-3">
                    <div class="col-md-4"><label class="form-label" asp-for="City">@T("City", "المدينة")</label><input asp-for="City" class="form-control" /></div>
                    <div class="col-md-8"><label class="form-label" asp-for="AddressLine">@T("Address", "العنوان")</label><input asp-for="AddressLine" class="form-control" /></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4"><label class="form-label" asp-for="ContactEmail">@T("Official email", "البريد الرسمي")</label><input asp-for="ContactEmail" class="form-control" type="email" dir="ltr" /></div>
                    <div class="col-md-4"><label class="form-label" asp-for="ContactPhone">@T("Phone", "الهاتف")</label><input asp-for="ContactPhone" class="form-control" dir="ltr" /></div>
                    <div class="col-md-4"><label class="form-label" asp-for="Website">@T("Website", "الموقع الإلكتروني")</label><input asp-for="Website" class="form-control" dir="ltr" /></div>
                </div>
                <div class="row g-3">
                    <div class="col-md-3"><label class="form-label" asp-for="Latitude">@T("Latitude", "خط العرض")</label><input asp-for="Latitude" class="form-control" dir="ltr" disabled /></div>
                    <div class="col-md-3"><label class="form-label" asp-for="Longitude">@T("Longitude", "خط الطول")</label><input asp-for="Longitude" class="form-control" dir="ltr" disabled /></div>
                    <div class="col-md-6"><div class="form-text mt-4">@T("Map pin picker pending (BR-SCH-008 geo validation).", "منتقي الخريطة لاحقاً (BR-SCH-008).")</div></div>
                </div>
            </div>
            <div class="tab-pane fade @Show("branding")" id="tab-branding">
                <div class="alert alert-info small mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@T("Logo/seal upload (PNG/SVG ≤ 2 MB, BR-SCH-006) lands with the attachment store screens (doc 10). Templates render current branding at issue time.", "رفع الشعار/الختم (PNG/SVG ≤ 2 م.ب، BR-SCH-006) يأتي مع شاشات المرفقات (الوثيقة 10).")</div>
            </div>
            <div class="tab-pane fade @Show("stages")" id="tab-stages">
                @if (Model.StagesOffered.Count == 0) { <div class="alert alert-warning small">@T("No stages defined yet — see the Setup wizard's Stage structure step or Module 05.", "لا مراحل بعد — انظر خطوة الهيكل الدراسي في المعالج أو الوحدة 05.")</div> }
                else { <ul class="list-group">@foreach (var s in Model.StagesOffered) { <li class="list-group-item d-flex justify-content-between"><span>@(isRtl ? s.Ar : s.En)</span><span class="badge text-bg-light border">@s.Grades @T("grades", "صفوف")</span></li> }</ul> }
                <div class="form-text mt-2">@T("BR-SCH-003: grades outside offered stages cannot be created (the explicit declaration UI is a follow-up; today every defined stage counts as offered).", "BR-SCH-003: لا يمكن إنشاء صفوف خارج المراحل المقدَّمة.")</div>
            </div>
        </div>
        <div class="p-3 border-top d-flex gap-2 align-items-end">
            <div style="max-width:420px" class="flex-grow-1"><label class="form-label small" asp-for="Reason">@T("Reason (required when changing identity fields)", "السبب (مطلوب عند تعديل حقول الهوية)")</label><input asp-for="Reason" class="form-control" /></div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1" aria-hidden="true"></i>@T("Save", "حفظ")</button>
        </div>
    </div>
</form>
