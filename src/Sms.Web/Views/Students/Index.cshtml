@using System.Globalization
@using Sms.Domain.Common
@using Sms.Domain.Students
@model StudentListViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Students", "الطلاب");
    ViewData["Breadcrumb"] = T("Students / List", "الطلاب / القائمة");
    string Badge(StudentStatus s) => s switch { StudentStatus.Enrolled => "text-bg-success", StudentStatus.Suspended => "text-bg-warning", StudentStatus.Graduated or StudentStatus.Alumni => "text-bg-primary", _ => "text-bg-secondary" };
    var help = new HelpPanelViewModel { Id = "stu-help", Title = T("Students — help", "الطلاب — مساعدة"), Intro = T("The student list searches by number, names, ID or mobile. Every student has a Student File with tabs; most tabs read through other modules and light up as those screens land.", "قائمة الطلاب تبحث بالرقم أو الأسماء أو الهوية أو الجوال. لكل طالب ملف بتبويبات؛ معظمها يقرأ من وحدات أخرى وتُفعَّل مع شاشاتها."), Items = new[] { new HelpPanelViewModel.Item(T("Register", "تسجيل"), T("Direct registration is for transfers-in and opening data; the normal path is Admissions → registration wizard (BR-ADM-007). Names in both languages are mandatory (BR-GLB-001); a student number is issued from the STU series.", "التسجيل المباشر للمنقولين وبيانات الافتتاح؛ المسار الطبيعي هو القبول → معالج التسجيل (BR-ADM-007). الاسمان بلغتين إلزاميان (BR-GLB-001)؛ يصدر رقم الطالب من سلسلة STU.")), new HelpPanelViewModel.Item(T("Student file", "ملف الطالب"), T("Personal (✎ identity edits need a reason, T1), Parents & guardians (the last financially-responsible link cannot be removed), Emergency contacts, Academic history, Status (transitions per BR-WF-001), Audit.", "الشخصية (✎ تعديل الهوية يتطلب سبباً)، أولياء الأمور (لا يُزال آخر مسؤول مالي)، جهات الطوارئ، السجل الأكاديمي، الحالة (BR-WF-001)، التدقيق.")), new HelpPanelViewModel.Item(T("Grade & section", "الصف والشعبة"), T("The ⛶ button on a row opens that one child's placement: which grade-year they are enrolled in, and which section they sit in. A first seat is recorded plainly; moving a child who already has a section is a transfer and carries a reason (BR-SCN-005/006). Nationality is not a directory column — it stays on the student's file.", "زر ⛶ في السطر يفتح إسناد ذلك الطفل وحده: الصف السنوي المقيَّد فيه، والشعبة التي يجلس فيها. الإسناد الأول يُسجَّل مباشرة؛ أما نقل من له شعبة فنقلٌ يحمل سبباً (BR-SCN-005/006). والجنسية ليست عموداً في الدليل — تبقى في ملف الطالب.")), new HelpPanelViewModel.Item(T("Filters, print and export", "الفلاتر والطباعة والتصدير"), T("Status, grade, section and gender narrow the list together, and the count above the table is what they matched in the whole school — not what fits on the page, which stops at 200 rows. Print and Export carry the same filter: the sheet and the CSV hold every matching student, and the sheet prints the filter under the school's name. Both are separate rights, so the buttons are simply absent where they are not granted (BR-SEC-010, doc/Modules/10 §6).", "الحالة والصف والشعبة والجنس تُضيّق القائمة معاً، والعدد فوق الجدول هو ما طابقها في المدرسة كلها لا ما يسعه العرض المتوقف عند 200 سطر. وزرّا الطباعة والتصدير يحملان الفلتر نفسه: الورقة وملف CSV يضمّان كل طالب مطابق، وتُطبع الورقة والفلتر مذكور أسفل اسم المدرسة. وكلاهما صلاحية مستقلة، فيغيب الزر أصلاً عمّن لا يملكها (BR-SEC-010، وثيقة الوحدة 10 §6).")) } };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@Model.Total @T("students", "طالب")</p></div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.CanPrint) { <a class="btn btn-outline-secondary" asp-action="Print" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-grade="@Model.GradeId" asp-route-section="@Model.SectionId" asp-route-gender="@Model.Gender"><i class="bi bi-printer me-1" aria-hidden="true"></i>@T("Print", "طباعة")</a> }
        @if (Model.CanExport) { <a class="btn btn-outline-secondary" asp-action="ExportCsv" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-grade="@Model.GradeId" asp-route-section="@Model.SectionId" asp-route-gender="@Model.Gender"><i class="bi bi-filetype-csv me-1" aria-hidden="true"></i>@T("Export", "تصدير")</a> }
        <a class="btn btn-primary" asp-action="Register"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>@T("Register student", "تسجيل طالب")</a><a class="btn btn-outline-primary" asp-action="Import"><i class="bi bi-database-down me-1" aria-hidden="true"></i>@T("Import from Access", "استيراد من أكسس")</a><partial name="_HelpModal" model="help" />
    </div></div>

<div class="sms-card">
    <form method="get" class="p-2 border-bottom d-flex flex-wrap gap-2 align-items-center">
        <input name="q" class="form-control form-control-sm" style="max-width:20rem" value="@Model.Query" placeholder="@T("number, name, ID, mobile…", "الرقم، الاسم، الهوية، الجوال…")" />
        <select name="status" class="form-select form-select-sm" style="max-width:11rem" onchange="this.form.submit()"><option value="">@T("Any status", "كل الحالات")</option>@foreach (StudentStatus s in Enum.GetValues(typeof(StudentStatus))) { <option value="@s" selected="@(s == Model.Status)">@Labels.StudentStatus(s, isRtl)</option> }</select>
        <select name="grade" class="form-select form-select-sm" style="max-width:12rem" onchange="this.form.submit()" aria-label="@T("Grade", "الصف")"><option value="">@T("Any grade", "كل الصفوف")</option>@foreach (var g in Model.Grades) { <option value="@g.Id" selected="@(g.Id == Model.GradeId)">@g.Code @(isRtl ? g.Name.NameAr : g.Name.NameEn)</option> }</select>
        @* The working year's sections, grouped by their grade — "A" names nothing on its own. *@
        <select name="section" class="form-select form-select-sm" style="max-width:12rem" onchange="this.form.submit()" aria-label="@T("Section", "الشعبة")"><option value="">@T("Any section", "كل الشعب")</option>@foreach (var group in Model.Sections.GroupBy(s => s.GradeName)) { <optgroup label="@group.Key">@foreach (var sec in group) { <option value="@sec.Id" selected="@(sec.Id == Model.SectionId)">@sec.Name</option> }</optgroup> }</select>
        <select name="gender" class="form-select form-select-sm" style="max-width:9rem" onchange="this.form.submit()" aria-label="@T("Gender", "الجنس")"><option value="">@T("Any gender", "الجنسان")</option>@foreach (Gender g in Enum.GetValues(typeof(Gender))) { <option value="@g" selected="@(g == Model.Gender)">@Labels.Gender(g, isRtl)</option> }</select>
        <button class="btn btn-sm btn-outline-secondary" type="submit" aria-label="@T("Search", "بحث")"><i class="bi bi-search" aria-hidden="true"></i></button>
    </form>
    <div class="table-responsive"><table class="table sms-table mb-0">
        <caption class="visually-hidden">@T("Student list", "قائمة الطلاب")</caption>
        <thead><tr><th scope="col">@T("Student no.", "رقم الطالب")</th><th scope="col">@T("Name", "الاسم")</th><th scope="col">@T("Gender", "الجنس")</th><th scope="col">@T("DOB", "الميلاد")</th><th scope="col">@T("Grade / section", "الصف / الشعبة")</th><th scope="col">@T("Primary parent", "ولي الأمر")</th><th scope="col">@T("Mobile", "الجوال")</th><th scope="col">@T("Status", "الحالة")</th><th scope="col" class="text-end"></th></tr></thead>
        <tbody>@foreach (var r in Model.Rows) { var s = r.Student; <tr><td><a asp-action="File" asp-route-id="@s.Id"><code>@s.StudentNo</code></a></td><td class="fw-semibold"><a asp-action="File" asp-route-id="@s.Id">@(isRtl ? $"{s.FirstNameAr} {s.FatherNameAr} {s.FamilyNameAr}" : $"{s.FirstNameEn} {s.FatherNameEn} {s.FamilyNameEn}")</a></td><td>@(s.Gender == Sms.Domain.Common.Gender.Male ? T("M", "ذ") : T("F", "أ"))</td><td>@s.DateOfBirth.ToString("yyyy-MM-dd")</td><td>@(r.GradeName ?? "—")@(r.SectionName == null ? "" : " / " + r.SectionName)</td><td>@(r.PrimaryParent ?? "—")</td><td dir="ltr" class="text-nowrap">@(string.IsNullOrWhiteSpace(s.Mobile) ? "—" : s.Mobile)</td><td><span class="badge @Badge(s.Status)">@Labels.StudentStatus(s.Status, isRtl)</span></td><td class="text-end text-nowrap">@if (Model.CanPlace) { <a class="btn btn-sm btn-outline-primary me-1" asp-action="Placement" asp-route-id="@s.Id" title="@T("Grade & section", "الصف والشعبة")" aria-label="@T($"Grade and section for {s.StudentNo}", $"الصف والشعبة للطالب {s.StudentNo}")"><i class="bi bi-diagram-3" aria-hidden="true"></i></a> }<form method="post" asp-action="Delete" asp-route-id="@s.Id" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-grade="@Model.GradeId" asp-route-section="@Model.SectionId" asp-route-gender="@Model.Gender" class="d-inline" onsubmit="return confirm('@T($"Delete student {s.StudentNo}? This cannot be undone.", $"حذف الطالب {s.StudentNo}؟ لا يمكن التراجع عن هذا الإجراء.")');"><button class="btn btn-sm btn-outline-danger" type="submit" title="@T("Delete student", "حذف الطالب")" aria-label="@T("Delete student", "حذف الطالب")"><i class="bi bi-trash" aria-hidden="true"></i></button></form></td></tr> }
        @if (Model.Rows.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">@T("No students match.", "لا طلاب مطابقون.")</td></tr> }</tbody>
    </table></div>
</div>
