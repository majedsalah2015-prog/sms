@using System.Globalization
@model StudentFormViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Register student", "تسجيل طالب");
    ViewData["Breadcrumb"] = T("Students / Register", "الطلاب / تسجيل");
    var help = new HelpPanelViewModel
    {
        Id = "student-register-help",
        Title = T("Register student — help", "تسجيل طالب — مساعدة"),
        Intro = T("The direct route into the student register (doc/Modules/08 §8) — for a transfer-in, or for loading the school's existing students when the system goes live. An applicant who came through admissions should not be registered here; the admissions pipeline creates the student itself on acceptance, and doing both makes two records for one child.", "الطريق المباشر إلى سجل الطلاب (الوثيقة 08 §8) — للطالب المنقول، أو لتحميل طلاب المدرسة الحاليين عند بدء التشغيل. أما المتقدم عبر القبول فلا يُسجَّل هنا؛ فمسار القبول ينشئ الطالب نفسه عند الموافقة، وفعل الاثنين يصنع سجلين لطفل واحد."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Four name parts, in both languages", "أربعة أجزاء للاسم بكلتا اللغتين"), T("First, father, grandfather and family, Arabic and English, all required. They are printed on certificates and matched against ministry records, so this is the one place where entering the name casually costs the most later — a missing grandfather name is a re-issued certificate.", "الأول والأب والجد والعائلة، بالعربية والإنجليزية، وكلها مطلوبة. وتُطبع على الشهادات وتُطابق بسجلات الوزارة، فهذا هو الموضع الذي يكلّف فيه إدخال الاسم باستعجال أكثر ما يكلّف لاحقاً — فاسم جدٍّ ناقص يعني شهادة معادة الإصدار.")),
            new HelpPanelViewModel.Item(T("The student number is issued, not typed", "رقم الطالب يُصدَر لا يُكتب"), T("It comes from the numbering series configured for students and materialises with the record it belongs to. You do not choose it, and it does not change afterwards.", "يأتي من سلسلة الترقيم المضبوطة للطلاب ويتجسّد مع السجل الذي يخصّه. فأنت لا تختاره، ولا يتغيّر بعد ذلك.")),
            new HelpPanelViewModel.Item(T("Registering is not enrolling", "التسجيل ليس إلحاقاً"), T("This creates the student and their file. Placing them in a grade and a section for a given academic year is a separate step — a student can exist without a current enrolment, which is exactly what a transfer-out or a gap year looks like.", "هذا ينشئ الطالب وملفه. أما وضعه في صف وشعبة لعام دراسي محدد فخطوة منفصلة — فقد يوجد طالب بلا التحاق حالي، وهذا بالضبط ما يبدو عليه المنقول أو المنقطع لعام.")),
            new HelpPanelViewModel.Item(T("Dates of birth are Gregorian", "تواريخ الميلاد ميلادية"), T("Entered and stored Gregorian in both interface languages. If the family gives a Hijri date, convert it before entering rather than typing the Hijri numbers into a Gregorian field — age-based rules read this value directly.", "تُدخل وتُخزَّن ميلادية في لغتي الواجهة. فإن أعطت الأسرة تاريخاً هجرياً فحوّله قبل الإدخال بدل كتابة أرقام هجرية في حقل ميلادي — فالقواعد المبنية على العمر تقرأ هذه القيمة مباشرة.")),
        },
    };
}
<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Direct registration (transfer-in / opening data). Admissions applicants register through the pipeline instead.", "تسجيل مباشر (منقول / بيانات افتتاح). متقدمو القبول يُسجَّلون عبر المسار.")</p></div>
    <partial name="_HelpModal" model="help" /></div>
<form method="post" asp-action="Register" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
    <p class="form-text">@T("Fields marked * are required.", "الحقول المعلّمة بـ * إلزامية.")</p>
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="sms-card p-4 mb-3">
                <h2 class="h6 mb-3">@T("Identity", "الهوية")</h2>
                <div class="sms-bilingual mb-3">
                    <div><label class="form-label small" asp-for="FirstNameAr">@T("Name (Arabic): first / father / grandfather / family", "الاسم بالعربية: الأول / الأب / الجد / العائلة") <span class="text-danger" aria-hidden="true">*</span></label><div class="row g-1"><div class="col-3"><input asp-for="FirstNameAr" class="form-control form-control-sm" dir="rtl" required aria-required="true" aria-label="@T("First name (Arabic)", "الاسم الأول (عربي)")" /><span asp-validation-for="FirstNameAr" class="text-danger small"></span></div><div class="col-3"><input asp-for="FatherNameAr" class="form-control form-control-sm" dir="rtl" required aria-required="true" aria-label="@T("Father name (Arabic)", "اسم الأب (عربي)")" /><span asp-validation-for="FatherNameAr" class="text-danger small"></span></div><div class="col-3"><input asp-for="GrandfatherNameAr" class="form-control form-control-sm" dir="rtl" required aria-required="true" aria-label="@T("Grandfather name (Arabic)", "اسم الجد (عربي)")" /><span asp-validation-for="GrandfatherNameAr" class="text-danger small"></span></div><div class="col-3"><input asp-for="FamilyNameAr" class="form-control form-control-sm" dir="rtl" required aria-required="true" aria-label="@T("Family name (Arabic)", "اسم العائلة (عربي)")" /><span asp-validation-for="FamilyNameAr" class="text-danger small"></span></div></div></div>
                    <div><label class="form-label small" asp-for="FirstNameEn">@T("Name (English)", "الاسم بالإنجليزية") <span class="text-danger" aria-hidden="true">*</span></label><div class="row g-1"><div class="col-3"><input asp-for="FirstNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#FirstNameAr" required aria-required="true" aria-label="@T("First name (English)", "الاسم الأول (إنجليزي)")" /><span asp-validation-for="FirstNameEn" class="text-danger small"></span></div><div class="col-3"><input asp-for="FatherNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#FatherNameAr" required aria-required="true" aria-label="@T("Father name (English)", "اسم الأب (إنجليزي)")" /><span asp-validation-for="FatherNameEn" class="text-danger small"></span></div><div class="col-3"><input asp-for="GrandfatherNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#GrandfatherNameAr" required aria-required="true" aria-label="@T("Grandfather name (English)", "اسم الجد (إنجليزي)")" /><span asp-validation-for="GrandfatherNameEn" class="text-danger small"></span></div><div class="col-3"><input asp-for="FamilyNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#FamilyNameAr" required aria-required="true" aria-label="@T("Family name (English)", "اسم العائلة (إنجليزي)")" /><span asp-validation-for="FamilyNameEn" class="text-danger small"></span></div></div></div>
                </div>
                <div class="row g-3">
                    <div class="col-md-2"><label class="form-label small" asp-for="Gender">@T("Gender", "الجنس")</label><select asp-for="Gender" class="form-select form-select-sm"><option value="Male">@T("Male", "ذكر")</option><option value="Female">@T("Female", "أنثى")</option></select></div>
                    <div class="col-md-3"><label class="form-label small" asp-for="DateOfBirth">@T("Date of birth", "تاريخ الميلاد") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="DateOfBirth" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control form-control-sm" required aria-required="true" /><span asp-validation-for="DateOfBirth" class="text-danger small"></span></div>
                    <div class="col-md-3"><label class="form-label small" asp-for="NationalityLookupId">@T("Nationality", "الجنسية") <span class="text-danger" aria-hidden="true">*</span></label><select asp-for="NationalityLookupId" class="form-select form-select-sm" required aria-required="true"><option value="">—</option>@foreach (var n in Model.Nationalities) { <option value="@n.Id">@(isRtl ? n.Ar : n.En)</option> }</select><span asp-validation-for="NationalityLookupId" class="text-danger small"></span></div>
                    <div class="col-md-2"><label class="form-label small" asp-for="PrimaryIdTypeLookupId">@T("ID type", "نوع الهوية")</label><select asp-for="PrimaryIdTypeLookupId" class="form-select form-select-sm"><option value="">—</option>@foreach (var t in Model.IdTypes) { <option value="@t.Id">@(isRtl ? t.Ar : t.En)</option> }</select></div>
                    <div class="col-md-2"><label class="form-label small" asp-for="PrimaryIdNo">@T("ID number", "رقم الهوية")</label><input asp-for="PrimaryIdNo" class="form-control form-control-sm" dir="ltr" /></div>
                </div>
            </div>
            <div class="sms-card p-4">
                <h2 class="h6 mb-3">@T("Enrollment & guardian (optional now)", "القيد وولي الأمر (اختياري الآن)")</h2>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label small" asp-for="GradeYearProfileId">@T("Grade-year", "الصف السنوي")</label><select asp-for="GradeYearProfileId" class="form-select form-select-sm"><option value="">—</option>@foreach (var p in Model.Profiles) { <option value="@p.ProfileId">@(isRtl ? p.GradeAr : p.GradeEn) · @(isRtl ? p.YearAr : p.YearEn)</option> }</select></div>
                    <div class="col-md-5"><partial name="_ParentPicker" model="@(new ParentPickerViewModel { Id = "register-parent", Name = "ParentId", Label = T("Parent", "ولي الأمر"), SelectedId = Model.ParentId, Parents = Model.Parents })" /></div>
                    <div class="col-md-3"><label class="form-label small" asp-for="RelationshipLookupId">@T("Relationship", "صلة القرابة")</label><select asp-for="RelationshipLookupId" class="form-select form-select-sm"><option value="">—</option>@foreach (var r in Model.Relationships) { <option value="@r.Id">@(isRtl ? r.Ar : r.En)</option> }</select></div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            @* The photograph is taken while the family is at the counter, so it belongs on this form
               rather than only on the file screen afterwards — a registrar who has to come back for
               it usually does not. It posts with the rest of the form and is attached to the student
               the moment the record exists (BR-STU-008). *@
            <div class="sms-card p-4 mb-3">
                <h2 class="h6 mb-3">@T("Photograph", "الصورة الشخصية")</h2>
                @* Not _PhotoPanel: that partial posts an upload form of its own, and the student it
                   would post about does not exist until this form is submitted. Here the file rides
                   the registration itself, so one submission makes the record and its photograph. *@
                <div class="sms-photo-panel text-center" id="student-register-photo">
                    <div class="sms-photo-frame mx-auto mb-2">
                        <img data-photo-preview class="d-none" alt="@T("Chosen photo", "الصورة المختارة")" />
                        <span class="sms-photo-empty" data-photo-placeholder aria-hidden="true"><i class="bi bi-person"></i></span>
                    </div>
                    <label class="form-label small" for="student-register-photo-file">@T("Photo file", "ملف الصورة")</label>
                    <input id="student-register-photo-file" name="photo" type="file" accept="image/jpeg,image/png" class="form-control form-control-sm" />
                    <button type="button" class="btn btn-sm btn-link text-danger p-0 mt-1 d-none" data-photo-clear>@T("Remove", "إزالة")</button>
                    <div class="form-text">@T("JPEG or PNG, up to 2 MB. Optional — it can also be added from the student's file later.", "JPEG أو PNG، حتى 2 ميغابايت. اختيارية — ويمكن إضافتها لاحقاً من ملف الطالب.")</div>
                    @* A browser never re-sends a file after a failed post, so the box comes back
                       empty even though the registrar chose something. Saying so beats letting them
                       submit twice and wonder why the file is still missing. *@
                    @if (!ViewData.ModelState.IsValid) { <div class="form-text fw-semibold">@T("Choose the photo again — a browser does not resend it after an error.", "اختر الصورة مرة أخرى — فالمتصفح لا يعيد إرسالها بعد الخطأ.")</div> }
                </div>
            </div>
            <div class="sms-card p-4"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-person-check me-1" aria-hidden="true"></i>@T("Register", "تسجيل")</button><a class="btn btn-outline-secondary w-100 mt-2" asp-action="Index">@T("Cancel", "إلغاء")</a></div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    // Local preview only: the registrar sees the chosen file back before it is posted, so nobody
    // registers a child with somebody else's photograph attached. Nothing leaves the page here —
    // the file is uploaded by this form's own submission, and the server checks it there.
    (function () {
        var panel = document.getElementById('student-register-photo');
        if (!panel) { return; }
        var input = panel.querySelector('input[type=file]');
        var image = panel.querySelector('[data-photo-preview]');
        var empty = panel.querySelector('[data-photo-placeholder]');
        var clear = panel.querySelector('[data-photo-clear]');

        function show(file) {
            if (image.src) { URL.revokeObjectURL(image.src); }
            image.src = URL.createObjectURL(file);
            image.classList.remove('d-none');
            empty.classList.add('d-none');
            clear.classList.remove('d-none');
        }

        function reset() {
            input.value = '';
            if (image.src) { URL.revokeObjectURL(image.src); }
            image.removeAttribute('src');
            image.classList.add('d-none');
            empty.classList.remove('d-none');
            clear.classList.add('d-none');
        }

        input.addEventListener('change', function () {
            if (input.files && input.files.length > 0) { show(input.files[0]); } else { reset(); }
        });
        clear.addEventListener('click', reset);
    })();
</script>
}
