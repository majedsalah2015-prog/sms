@using System.Globalization
@using Sms.Domain.Parents
@using Sms.Domain.Students
@model StudentFileViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var s = Model.Student;
    var name = isRtl ? $"{s.FirstNameAr} {s.FatherNameAr} {s.GrandfatherNameAr} {s.FamilyNameAr}" : $"{s.FirstNameEn} {s.FatherNameEn} {s.GrandfatherNameEn} {s.FamilyNameEn}";
    ViewData["Title"] = s.StudentNo;
    ViewData["Breadcrumb"] = T("Students / ", "الطلاب / ") + s.StudentNo;
    var today = DateTime.UtcNow.ToString("yyyy-MM-dd");
    var tabs = new List<(string Key, string En, string Ar, string? Count)>
    {
        ("personal", "Personal", "الشخصية", null), ("guardians", "Parents & guardians", "أولياء الأمور", Model.Guardians.Count.ToString()), ("emergency", "Emergency contacts", "جهات الطوارئ", Model.EmergencyContacts.Count.ToString()),
        ("academic", "Academic history", "السجل الأكاديمي", Model.Enrollments.Count.ToString()), ("status", "Status", "الحالة", null), ("audit", "Audit", "التدقيق", Model.Audit.Count.ToString()),
        ("documents", "Documents", "المستندات", Model.Documents.Rows.Count.ToString()),
        ("attendance", "Attendance", "الحضور", Model.ReadThroughCounts.TryGetValue("attendance", out var at) ? at.ToString() : "0"), ("fees", "Fees", "الرسوم", Model.ReadThroughCounts.TryGetValue("charges", out var ch) ? ch.ToString() : "0"), ("certificates", "Certificates", "الشهادات", Model.ReadThroughCounts.TryGetValue("certificates", out var ce) ? ce.ToString() : "0"),
        ("more", "More…", "المزيد…", null),
    };
    // BR-GLB-072: a restricted category with its own permission. The tab is not rendered at all
    // without it — a disabled tab still tells the reader the data exists and who it is about.
    if (Model.CanSeeSocialProfile)
    {
        tabs.Insert(3, ("social", "Social profile", "البيانات الاجتماعية", null));
    }
    string Show(string k) => Model.ActiveTab == k ? "show active" : "";
    // A guardian's qualification is read here and written on the parent file — one place, so a
    // correction reaches every child at once instead of once per sibling.
    string? Education(int? id) => id == null ? null : Model.EducationLevels.Where(e => e.Id == id.Value).Select(e => isRtl ? e.Ar : e.En).FirstOrDefault();
    string Badge(StudentStatus st) => st switch { StudentStatus.Enrolled => "text-bg-success", StudentStatus.Suspended => "text-bg-warning", StudentStatus.Graduated or StudentStatus.Alumni => "text-bg-primary", _ => "text-bg-secondary" };
    var help = new HelpPanelViewModel
    {
        Id = "student-file-help",
        Title = T("Student file — help", "ملف الطالب — مساعدة"),
        Intro = T("Everything the school holds about one student, gathered from every module that knows anything about them (doc/Modules/08 §8). The tabs are not one screen split up — several of them read live from attendance, fees and certificates, which is why their counts can change while you have the page open.", "كل ما تحتفظ به المدرسة عن طالب واحد، مجموعاً من كل وحدة تعرف عنه شيئاً (الوثيقة 08 §8). والألسنة ليست شاشة واحدة مقسّمة — فبعضها يقرأ مباشرةً من الحضور والرسوم والشهادات، ولذلك قد تتغير أعدادها والصفحة مفتوحة أمامك."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("A tab you cannot see is not an empty tab", "اللسان الذي لا تراه ليس لساناً فارغاً"), T("The social profile is a restricted category with its own permission (BR-GLB-072), and without it the tab is not drawn at all rather than shown disabled. A greyed-out tab would still tell you sensitive data exists and whom it is about.", "البيانات الاجتماعية فئة مقيَّدة لها صلاحيتها (BR-GLB-072)، وبدونها لا يُرسم اللسان أصلاً بدل عرضه معطَّلاً. فاللسان الباهت يخبرك رغم ذلك بوجود بيانات حساسة وبمن تخصّ.")),
            new HelpPanelViewModel.Item(T("Status is a lifecycle, not a flag", "الحالة دورة حياة لا وسماً"), T("Enrolled, suspended, graduated, alumni and the rest each change what other modules will accept for this student — a suspended student is not a deleted one, and their history stays intact and readable throughout (BR-STU-002).", "«ملتحق» و«موقوف» و«متخرج» و«خريج» وغيرها، كل منها يغيّر ما تقبله الوحدات الأخرى لهذا الطالب — فالطالب الموقوف ليس محذوفاً، ويبقى سجله سليماً مقروءاً طوال الوقت (BR-STU-002).")),
            new HelpPanelViewModel.Item(T("The audit tab answers \"who changed this\"", "لسان التدقيق يجيب «من غيّر هذا»"), T("Identity edits on a student are captured field by field with the old and new value, in the same transaction as the change itself. Nothing is written there by hand and nothing can be removed from it.", "تُلتقط تعديلات هوية الطالب حقلاً حقلاً بالقيمة القديمة والجديدة، في المعاملة نفسها مع التغيير. ولا يُكتب فيه شيء يدوياً ولا يُنزع منه شيء.")),
            new HelpPanelViewModel.Item(T("Guardians are people, not fields", "أولياء الأمور أشخاص لا حقول"), T("A parent is a record in their own right and is linked to the student, which is what lets siblings share one father and one portal account. Correct a guardian's details on the parent's own file, not by re-typing them here.", "ولي الأمر سجل قائم بذاته ومرتبط بالطالب، وهذا ما يتيح للإخوة أن يشتركوا في أبٍ واحد وحساب بوابة واحد. فصحّح بيانات ولي الأمر في ملفه هو لا بإعادة كتابتها هنا.")),
            new HelpPanelViewModel.Item(T("Correcting a grade is not moving a student", "تصحيح الصف ليس نقلاً للطالب"), T("The ✎ on an academic-history row changes the grade the record should have carried all along, within the same academic year. Moving a child to the next year is the rollover, and it is refused here (BR-GLB-023). A child sitting in a section cannot have their grade corrected underneath them, because the section belongs to that grade — take them out of the section first with the ⬆ button on the same row, correct the grade, then seat them again.", "زر ✎ في سطر السجل الأكاديمي يغيّر الصف الذي كان ينبغي أن يحمله القيد منذ البداية، ضمن العام الدراسي نفسه. أما نقل الطفل إلى العام التالي فهو الترحيل، ويُرفض من هنا (BR-GLB-023). والطالب الجالس في شعبة لا يُصحَّح صفه من تحته، لأن الشعبة تتبع ذلك الصف — أخرِجه من الشعبة أولاً بزر ⬆ في السطر نفسه، ثم صحّح الصف، ثم أعِد إسناده.")),
            new HelpPanelViewModel.Item(T("A record is removed only while it is still only a typing mistake", "لا يُحذف السجل إلا ما دام مجرد خطأ إدخال"), T("The 🗑 on an academic-history row removes an enrollment nothing has ever been recorded against, and asks why — the reason is written to the audit trail, which is all that will be left of it. One attendance day, one mark, one charge, and the button greys out and names what is in the way: that enrollment is history now, and history is closed by withdrawal rather than removed (BR-GLB-005).", "زر 🗑 في سطر السجل الأكاديمي يحذف قيداً لم يُسجَّل عليه شيء قط، ويسأل عن السبب — ويُكتب السبب في سجل التدقيق، وهو كل ما سيبقى منه. ويكفي يوم حضور واحد أو درجة واحدة أو رسم واحد ليبهت الزر ويسمّي ما يمنعه: صار ذلك القيد سجلاً تاريخياً، والسجل التاريخي يُغلق بالانسحاب لا يُحذف (BR-GLB-005).")),
        },
    };
}

<div class="sms-page-head">
    <div><div class="text-muted small"><code>@s.StudentNo</code> · @Model.NationalityName · @(s.Gender == Sms.Domain.Common.Gender.Male ? T("Male", "ذكر") : T("Female", "أنثى")) · @s.DateOfBirth.ToString("yyyy-MM-dd")</div>
        <h1 class="sms-page-title">@name <span class="badge fs-6 @Badge(s.Status)">@s.Status</span></h1></div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1 @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i>@T("List", "القائمة")</a>
        <partial name="_HelpModal" model="help" />
    </div>
</div>

<div class="sms-card">
    <ul class="nav nav-tabs px-3 pt-2 flex-nowrap overflow-auto">@foreach (var t in tabs) { <li class="nav-item"><button class="nav-link text-nowrap @(Model.ActiveTab == t.Key ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-@t.Key" type="button">@(isRtl ? t.Ar : t.En)@if (t.Count != null) { <span class="badge rounded-pill text-bg-light border ms-1">@t.Count</span> }</button></li> }</ul>
    <div class="tab-content p-4">
        <div class="tab-pane fade @Show("personal")" id="tab-personal">
            @* The photograph sits beside the identity fields rather than inside their form: it is
               uploaded on its own, and a file input inside the identity form would mean saving a
               name change every time somebody wanted to replace a picture. *@
            <div class="row g-4">
            <div class="col-md-3 col-lg-2">
                <partial name="_PhotoPanel" model="@(new PhotoPanelViewModel {
                    Id = "student-photo", PersonName = name,
                    HasPhoto = s.PhotoAttachmentId != null,
                    PhotoUrl = Url.Action("Photo", "Students", new { id = s.Id }),
                    UploadUrl = Url.Action("UploadPhoto", "Students", new { id = s.Id }),
                    RemoveUrl = Url.Action("RemovePhoto", "Students", new { id = s.Id }),
                    CanEdit = true })" />
            </div>
            <div class="col-md-9 col-lg-10">
            <form method="post" asp-action="Edit" asp-route-id="@s.Id">
                @* The English quad name is filled from the Arabic one by the helper button of
                   docs/UI/01 §"Bilingual entry pattern" — assist only. Imported students carry the
                   register's own Arabic text in both columns on purpose (see Import's help panel),
                   so this screen is where that gets turned into a name an English report can use. *@
                <div class="sms-bilingual mb-3" id="stu-name-block">
                    <div><label class="form-label small" for="stu-FirstNameAr">@T("Name (Arabic)", "الاسم (عربي)")</label><div class="row g-1"><div class="col-3"><input name="FirstNameAr" id="stu-FirstNameAr" class="form-control form-control-sm" dir="rtl" value="@s.FirstNameAr" aria-label="@T("First name (Arabic)", "الاسم الأول (عربي)")" /></div><div class="col-3"><input name="FatherNameAr" id="stu-FatherNameAr" class="form-control form-control-sm" dir="rtl" value="@s.FatherNameAr" aria-label="@T("Father name (Arabic)", "اسم الأب (عربي)")" /></div><div class="col-3"><input name="GrandfatherNameAr" id="stu-GrandfatherNameAr" class="form-control form-control-sm" dir="rtl" value="@s.GrandfatherNameAr" aria-label="@T("Grandfather name (Arabic)", "اسم الجد (عربي)")" /></div><div class="col-3"><input name="FamilyNameAr" id="stu-FamilyNameAr" class="form-control form-control-sm" dir="rtl" value="@s.FamilyNameAr" aria-label="@T("Family name (Arabic)", "اسم العائلة (عربي)")" /></div></div></div>
                    <div><div class="d-flex align-items-center justify-content-between gap-2"><label class="form-label small mb-1" for="stu-FirstNameEn">@T("Name (English)", "الاسم (إنجليزي)")</label><button type="button" class="btn btn-link btn-sm p-0 mb-1 text-decoration-none" data-translit-fill="#stu-name-block" title="@T("Transliterate the four Arabic names into the English boxes. Check the result before saving — it is a starting point, not an authority.", "نقحرة الأسماء العربية الأربعة إلى الخانات الإنجليزية. راجع الناتج قبل الحفظ — فهو نقطة بداية لا مرجع.")">@T("Fill from Arabic", "تعبئة من العربي")</button></div><div class="row g-1"><div class="col-3"><input name="FirstNameEn" id="stu-FirstNameEn" class="form-control form-control-sm" dir="ltr" value="@s.FirstNameEn" data-translit-from="#stu-FirstNameAr" aria-label="@T("First name (English)", "الاسم الأول (إنجليزي)")" /></div><div class="col-3"><input name="FatherNameEn" class="form-control form-control-sm" dir="ltr" value="@s.FatherNameEn" data-translit-from="#stu-FatherNameAr" aria-label="@T("Father name (English)", "اسم الأب (إنجليزي)")" /></div><div class="col-3"><input name="GrandfatherNameEn" class="form-control form-control-sm" dir="ltr" value="@s.GrandfatherNameEn" data-translit-from="#stu-GrandfatherNameAr" aria-label="@T("Grandfather name (English)", "اسم الجد (إنجليزي)")" /></div><div class="col-3"><input name="FamilyNameEn" class="form-control form-control-sm" dir="ltr" value="@s.FamilyNameEn" data-translit-from="#stu-FamilyNameAr" aria-label="@T("Family name (English)", "اسم العائلة (إنجليزي)")" /></div></div></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-2"><label class="form-label small" for="stu-Gender">@T("Gender", "الجنس")</label><select name="Gender" id="stu-Gender" class="form-select form-select-sm"><option value="Male" selected="@(s.Gender == Sms.Domain.Common.Gender.Male)">@T("Male", "ذكر")</option><option value="Female" selected="@(s.Gender == Sms.Domain.Common.Gender.Female)">@T("Female", "أنثى")</option></select></div>
                    <div class="col-md-2"><label class="form-label small" for="stu-DateOfBirth">@T("Date of birth", "الميلاد")</label><input name="DateOfBirth" id="stu-DateOfBirth" type="date" class="form-control form-control-sm" value="@s.DateOfBirth.ToString("yyyy-MM-dd")" /></div>
                    <div class="col-md-3"><label class="form-label small" for="stu-NationalityLookupId">@T("Nationality", "الجنسية")</label><select name="NationalityLookupId" id="stu-NationalityLookupId" class="form-select form-select-sm">@foreach (var n in Model.Nationalities) { <option value="@n.Id" selected="@(n.Id == s.NationalityLookupId)">@(isRtl ? n.Ar : n.En)</option> }</select></div>
                    <div class="col-md-2"><label class="form-label small" for="stu-PrimaryIdTypeLookupId">@T("ID type", "نوع الهوية")</label><select name="PrimaryIdTypeLookupId" id="stu-PrimaryIdTypeLookupId" class="form-select form-select-sm"><option value="">—</option>@foreach (var t in Model.IdTypes) { <option value="@t.Id" selected="@(t.Id == s.PrimaryIdTypeLookupId)">@(isRtl ? t.Ar : t.En)</option> }</select></div>
                    <div class="col-md-2"><label class="form-label small" for="stu-PrimaryIdNo">@T("ID number", "رقم الهوية")</label><input name="PrimaryIdNo" id="stu-PrimaryIdNo" class="form-control form-control-sm" dir="ltr" value="@s.PrimaryIdNo" /></div>
                    <div class="col-md-1"><label class="form-label small" for="stu-PrimaryIdExpiry">@T("Expiry", "الانتهاء")</label><input name="PrimaryIdExpiry" id="stu-PrimaryIdExpiry" type="date" class="form-control form-control-sm" value="@s.PrimaryIdExpiry?.ToString("yyyy-MM-dd")" /></div>
                </div>
                <div class="d-flex gap-2 align-items-end"><div style="max-width:420px" class="flex-grow-1"><label class="form-label small" for="stu-Reason">@T("Reason (required when identity fields change — BR-STU-002, T1)", "السبب (مطلوب عند تغيير حقول الهوية — BR-STU-002)")</label><input name="Reason" id="stu-Reason" class="form-control form-control-sm" /></div><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-save me-1" aria-hidden="true"></i>@T("Save", "حفظ")</button></div>
            </form>

            @* Where the student lives (owner request, 2026-08-31). A second form rather than three
               more boxes inside the identity one: the identity form demands a reason on every save
               because BR-STU-002 makes those fields T1-with-reason, and a family that moved house
               has nothing to justify. Its own post also means a refused address does not throw away
               a name correction typed above it. *@
            @* The three pickers below are filled from constants that used to have no screen behind
               them, so a quarter the seeded pack never listed could not be recorded at all and the
               registrar wrote it into the nearest locality instead. The button opens where they are
               authored, at the level already chosen here, and comes back to this file. Drawn only
               for a reader who may open that screen (BR-SEC-010). *@
            <div class="d-flex align-items-center justify-content-between gap-2 mt-4">
                <h3 class="h6 mb-0">@T("Residence", "السكن")</h3>
                @if (Model.CanManageResidenceLists)
                {
                    <a id="stu-res-manage" class="btn btn-sm btn-outline-secondary"
                       href="@Url.Action("Residence", "Setup", new { governorateId = Model.CurrentGovernorateId, localityId = Model.CurrentResidenceAreaId })"
                       title="@T("Governorate, locality and quarter are maintained in System Setup", "المحافظة والمنطقة والحي تُدار في إعداد النظام")">
                        <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>@T("Add / edit these lists", "إضافة أو تعديل الثوابت")
                    </a>
                }
            </div>
            <form method="post" asp-action="SaveResidence" asp-route-id="@s.Id">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small" for="stu-res-gov">@T("Governorate", "المحافظة")</label>
                        <select id="stu-res-gov" class="form-select form-select-sm" aria-label="@T("Governorate", "المحافظة")">
                            <option value="">@T("— choose —", "— اختر —")</option>
                            @foreach (var g in Model.Governorates)
                            {
                                <option value="@g.Id" selected="@(Model.CurrentGovernorateId == g.Id)">@(isRtl ? g.Name.NameAr : g.Name.NameEn)</option>
                            }
                        </select>
                        <div class="form-text">@T("Not stored — it is walked up to from the locality.", "لا تُخزَّن — بل يُصعَد إليها من المنطقة.")</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small" for="stu-res-area">@T("Locality", "المنطقة")</label>
                        <select id="stu-res-area" name="residenceAreaId" class="form-select form-select-sm">
                            <option value="">@T("— choose —", "— اختر —")</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small" for="stu-res-hood">@T("Quarter", "الحي")</label>
                        <select id="stu-res-hood" name="neighbourhoodId" class="form-select form-select-sm">
                            <option value="">@T("— none recorded —", "— لا يوجد —")</option>
                        </select>
                        <div class="form-text">@T("Only some localities have quarters; elsewhere the locality is the address.", "الأحياء مسجَّلة لبعض المناطق فقط؛ وفي غيرها المنطقة هي العنوان.")</div>
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <span class="form-label small">@T("Recorded", "المسجَّل")</span>
                        <span class="small text-truncate" title="@Model.CurrentResidencePath"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@(Model.CurrentResidencePath ?? T("not recorded", "غير مسجَّل"))</span>
                        <button class="btn btn-sm btn-primary mt-2 align-self-start" type="submit"><i class="bi bi-save me-1" aria-hidden="true"></i>@T("Save residence", "حفظ السكن")</button>
                    </div>
                </div>
                <div class="form-text">@T("This is the student's own address. The guardian's is on the guardian's file, and the two are independent — correcting one does not correct the other.", "هذا عنوان الطالب نفسه. وعنوان ولي الأمر في ملفه هو، وهما مستقلان — تصحيح أحدهما لا يصحّح الآخر.")</div>
            </form>
            </div>
            </div>
        </div>
        <div class="tab-pane fade @Show("guardians")" id="tab-guardians">
            <table class="table table-sm sms-table mb-3"><caption class="visually-hidden">@T("Parents & guardians", "أولياء الأمور")</caption><thead><tr><th scope="col">@T("Parent", "ولي الأمر")</th><th scope="col">@T("Relationship", "القرابة")</th><th scope="col">@T("Primary", "أساسي")</th><th scope="col">@T("Financial", "مالي")</th><th scope="col">@T("Pickup", "استلام")</th><th scope="col">@T("Portal", "بوابة")</th><th scope="col">@T("Since", "منذ")</th><th scope="col"></th></tr></thead>
                <tbody>@foreach (var g in Model.Guardians) { <tr><td>
                    @* Four different facts about one person used to arrive as one dot-separated
                       string — a number, a job and a degree with nothing to say which was which, and
                       an ID that read as a phone number until you counted the digits. Each fact now
                       carries its own icon and its own label, so the row is scanned rather than
                       parsed. The label is read out loud and drawn as a tooltip; the icon alone
                       would leave a screen reader with a bare string again. *@
                    <div class="fw-semibold"><a asp-controller="Parents" asp-action="File" asp-route-id="@g.Parent.Id">@(isRtl ? g.Parent.NameAr : g.Parent.NameEn)</a>
                        <span class="text-muted small ms-1"><code>@g.Parent.ParentFileNo</code></span>
                        @* The parent's life status is shown here rather than on the social tab: it is one fact
                           about one person, so it belongs on the row that is that person. Only when it is not
                           Alive — the cases that carry an entitlement are the ones worth a glance on a list. *@
                        @if (g.Parent.LifeStatus != ParentLifeStatus.Alive) { <span class="badge @SocialProfileLabels.ParentStatusBadge(g.Parent.LifeStatus)">@SocialProfileLabels.ParentStatus(g.Parent.LifeStatus, isRtl)</span> }
                    </div>
                    @{
                        // Icon, label, value, and whether the value is a number that stays LTR in
                        // both directions. Blank facts are dropped rather than shown empty.
                        var facts = new (string Icon, string Label, string? Value, bool Ltr)[]
                        {
                            ("bi-telephone", T("Mobile", "الجوال"), g.Parent.PrimaryMobile, true),
                            ("bi-person-vcard", T("ID number", "رقم الهوية"), g.Parent.PrimaryIdNo, true),
                            ("bi-briefcase", T("Occupation", "المهنة"), g.Parent.OccupationEmployer, false),
                            ("bi-mortarboard", T("Qualification", "المؤهل العلمي"), Education(g.Parent.EducationLookupId), false),
                        };
                    }
                    <div class="sms-facts small text-muted">
                        @foreach (var f in facts.Where(f => !string.IsNullOrWhiteSpace(f.Value)))
                        {
                            <span class="sms-fact" title="@f.Label"><i class="bi @f.Icon" aria-hidden="true"></i><span class="visually-hidden">@f.Label:</span><span dir="@(f.Ltr ? "ltr" : null)">@f.Value</span></span>
                        }
                    </div></td><td>@g.Relationship</td><td><span aria-hidden="true">@(g.Link.IsPrimaryContact ? "✓" : "—")</span><span class="visually-hidden">@(g.Link.IsPrimaryContact ? T("yes", "نعم") : T("no", "لا"))</span></td><td><span aria-hidden="true">@(g.Link.IsFinanciallyResponsible ? "✓" : "—")</span><span class="visually-hidden">@(g.Link.IsFinanciallyResponsible ? T("yes", "نعم") : T("no", "لا"))</span></td><td><span aria-hidden="true">@(g.Link.IsPickupAuthorized ? "✓" : "—")</span><span class="visually-hidden">@(g.Link.IsPickupAuthorized ? T("yes", "نعم") : T("no", "لا"))</span></td><td><span aria-hidden="true">@(g.Link.IsPortalVisible ? "✓" : "—")</span><span class="visually-hidden">@(g.Link.IsPortalVisible ? T("yes", "نعم") : T("no", "لا"))</span></td><td>@g.Link.EffectiveFromUtc.ToString("yyyy-MM-dd")</td>
                    <td class="text-end"><form method="post" asp-action="UnlinkGuardian" asp-route-id="@s.Id" asp-route-linkId="@g.Link.Id" class="d-inline-flex gap-1"><input name="effectiveTo" type="date" class="form-control form-control-sm" value="@today" style="width:9.5rem" aria-label="@T("Link end date", "تاريخ إنهاء الربط")" /><button class="btn btn-sm btn-outline-danger" type="submit" title="@T("End link", "إنهاء الربط")" aria-label="@T("End link", "إنهاء الربط")"><i class="bi bi-person-dash" aria-hidden="true"></i></button></form></td></tr> }
                @if (Model.Guardians.Count == 0) { <tr><td colspan="8" class="text-center text-warning-emphasis py-3">@T("No guardian linked — at least one financially-responsible parent is required (BR-GLB-004).", "لا ولي أمر مرتبط — يلزم ولي أمر مسؤول مالياً واحد على الأقل (BR-GLB-004).")</td></tr> }</tbody></table>
            @if (Model.PastGuardians.Count > 0) { <div class="small text-muted mb-3">@T("Past links:", "روابط سابقة:") @string.Join(" · ", Model.PastGuardians.Select(g => $"{(isRtl ? g.Parent.NameAr : g.Parent.NameEn)} ({g.Link.EffectiveFromUtc:yyyy-MM-dd} → {g.Link.EffectiveToUtc:yyyy-MM-dd})"))</div> }
            <form method="post" asp-action="LinkGuardian" asp-route-id="@s.Id" class="row g-2 align-items-end">
                <div class="col-md-4"><partial name="_ParentPicker" model="@(new ParentPickerViewModel { Id = "link-parentId", Name = "parentId", Label = T("Parent", "ولي الأمر"), Parents = Model.Parents })" /></div>
                <div class="col-md-2"><label class="form-label small" for="link-relationshipId">@T("Relationship", "القرابة")</label><select name="relationshipId" id="link-relationshipId" class="form-select form-select-sm">@foreach (var r in Model.Relationships) { <option value="@r.Id">@(isRtl ? r.Ar : r.En)</option> }</select></div>
                <div class="col-md-4 d-flex flex-wrap gap-2 small"><label><input type="checkbox" name="isPrimary" value="true" class="form-check-input" checked /> @T("primary", "أساسي")</label><label><input type="checkbox" name="isFinancial" value="true" class="form-check-input" checked /> @T("financial", "مالي")</label><label><input type="checkbox" name="isPickup" value="true" class="form-check-input" checked /> @T("pickup", "استلام")</label><label><input type="checkbox" name="isPortal" value="true" class="form-check-input" checked /> @T("portal", "بوابة")</label></div>
                <div class="col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>@T("Link", "ربط")</button></div>
            </form>
        </div>
        <div class="tab-pane fade @Show("emergency")" id="tab-emergency">
            <table class="table table-sm sms-table mb-3"><caption class="visually-hidden">@T("Emergency contacts", "جهات الطوارئ")</caption><thead><tr><th scope="col">@T("Name", "الاسم")</th><th scope="col">@T("Phone", "الهاتف")</th><th scope="col">@T("Pickup", "استلام")</th></tr></thead><tbody>@foreach (var c in Model.EmergencyContacts) { <tr><td>@(isRtl ? c.NameAr : c.NameEn)</td><td dir="ltr">@c.Phone</td><td><span aria-hidden="true">@(c.IsPickupAuthorized ? "✓" : "—")</span><span class="visually-hidden">@(c.IsPickupAuthorized ? T("yes", "نعم") : T("no", "لا"))</span></td></tr> }@if (Model.EmergencyContacts.Count == 0) { <tr><td colspan="3" class="text-center text-warning-emphasis py-3">@T("At least one emergency contact is required (§9).", "يلزم جهة اتصال طوارئ واحدة على الأقل (§9).")</td></tr> }</tbody></table>
            <form method="post" asp-action="AddEmergencyContact" asp-route-id="@s.Id" class="row g-2 align-items-end"><div class="col-md-3"><input name="nameAr" class="form-control form-control-sm" dir="rtl" placeholder="الاسم بالعربية" aria-label="@T("Contact name (Arabic)", "اسم جهة الاتصال (عربي)")" /></div><div class="col-md-3"><input name="nameEn" class="form-control form-control-sm" dir="ltr" placeholder="Name (English)" aria-label="@T("Contact name (English)", "اسم جهة الاتصال (إنجليزي)")" /></div><div class="col-md-2"><input name="phone" class="form-control form-control-sm" dir="ltr" placeholder="05xxxxxxxx" aria-label="@T("Contact phone", "هاتف جهة الاتصال")" /></div><div class="col-md-2"><select name="relationshipId" class="form-select form-select-sm" aria-label="@T("Contact relationship", "قرابة جهة الاتصال")"><option value="">@T("relationship", "القرابة")</option>@foreach (var r in Model.Relationships) { <option value="@r.Id">@(isRtl ? r.Ar : r.En)</option> }</select></div><div class="col-md-1 small"><label><input type="checkbox" name="isPickup" value="true" class="form-check-input" /> @T("pickup", "استلام")</label></div><div class="col-md-1"><button class="btn btn-sm btn-primary w-100" type="submit" aria-label="@T("Add emergency contact", "إضافة جهة طوارئ")"><i class="bi bi-plus-lg" aria-hidden="true"></i></button></div></form>
        </div>
        @if (Model.CanSeeSocialProfile)
        {
        <div class="tab-pane fade @Show("social")" id="tab-social">
            <fieldset disabled="@(!Model.CanEditSocialProfile)">
            <form method="post" asp-action="UpdateSocialProfile" asp-route-id="@s.Id">
                <p class="text-muted small">@T("Recorded as the documents arrive — nothing here is required to register a student. Every field is audited with a reason, because each one supports a decision the school has to defend.", "تُسجَّل مع وصول المستندات — لا شيء هنا مطلوب لتسجيل الطالب. وكل حقل مدقَّق بسبب، لأن كلاً منها يسند قراراً على المدرسة أن تدافع عنه.")</p>
                <p class="small"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@T("Nothing about a parent is entered here. Each one's name, ID number, mobile, occupation, qualification and status — alive, deceased, martyr, missing — is on their own file, reached from the Parents & guardians tab, where one correction reaches every one of their children at once.", "لا تُدخَل هنا أي بيانات عن ولي الأمر. فاسم كلٍّ منهما ورقم هويته وجواله ومهنته ومؤهله العلمي وحالته — على قيد الحياة أو متوفى أو شهيد أو مفقود — في ملفه هو، تصل إليه من تبويب أولياء الأمور، حيث يبلغ التعديل الواحد كل أبنائه دفعة واحدة.")</p>

                <h3 class="h6 mt-3">@T("Family", "الأسرة")</h3>
                <div class="row g-3 mb-3">
                    <div class="col-md-2"><label class="form-label small" for="so-FamilySize">@T("Family size", "عدد أفراد الأسرة")</label><input name="FamilySize" id="so-FamilySize" type="number" min="1" max="40" class="form-control form-control-sm" value="@s.FamilySize" /></div>
                    <div class="col-md-2"><label class="form-label small" for="so-BirthOrder">@T("Birth order", "ترتيب الطالب")</label><input name="BirthOrder" id="so-BirthOrder" type="number" min="1" max="40" class="form-control form-control-sm" value="@s.BirthOrder" /></div>
                    <div class="col-md-2"><label class="form-label small" for="so-SiblingCount">@T("Siblings", "عدد الأخوة")</label><input name="SiblingCount" id="so-SiblingCount" type="number" min="0" max="40" class="form-control form-control-sm" value="@s.SiblingCount" /></div>
                    <div class="col-md-4"><label class="form-label small" for="so-PlaceOfBirth">@T("Place of birth", "مكان الميلاد")</label><input name="PlaceOfBirth" id="so-PlaceOfBirth" class="form-control form-control-sm" value="@s.PlaceOfBirth" /></div>
                    <div class="col-md-3"><label class="form-label small" for="so-Mobile">@T("Student's mobile", "جوال الطالب")</label><input name="Mobile" id="so-Mobile" type="tel" dir="ltr" maxlength="20" class="form-control form-control-sm" value="@s.Mobile" /></div>
                </div>

                <h3 class="h6 mt-3">@T("Standing", "الوضع")</h3>
                <div class="row g-3 mb-3">
                    <div class="col-md-2"><label class="form-label small" for="so-Religion">@T("Religion", "الديانة")</label>
                        <select name="Religion" id="so-Religion" class="form-select form-select-sm">
                            <option value="">@T("— not recorded —", "— غير مسجَّل —")</option>
                            @foreach (var v in Enum.GetValues<Religion>()) { <option value="@v" selected="@(s.Religion == v)">@SocialProfileLabels.Religion(v, isRtl)</option> }
                        </select>
                    </div>
                    <div class="col-md-2"><label class="form-label small" for="so-ResidencyStatus">@T("Residency", "الإقامة")</label>
                        <select name="ResidencyStatus" id="so-ResidencyStatus" class="form-select form-select-sm">
                            <option value="">@T("— not recorded —", "— غير مسجَّل —")</option>
                            @foreach (var v in Enum.GetValues<ResidencyStatus>()) { <option value="@v" selected="@(s.ResidencyStatus == v)">@SocialProfileLabels.Residency(v, isRtl)</option> }
                        </select>
                    </div>
                    <div class="col-md-3"><label class="form-label small" for="so-RationCardNo">@T("Ration card number", "رقم بطاقة التموين")</label><input name="RationCardNo" id="so-RationCardNo" class="form-control form-control-sm" dir="ltr" value="@s.RationCardNo" /></div>
                    <div class="col-md-2"><label class="form-label small" for="so-FinancialStatus">@T("Means", "الوضع المادي")</label>
                        <select name="FinancialStatus" id="so-FinancialStatus" class="form-select form-select-sm">
                            <option value="">@T("— not assessed —", "— غير مقيَّم —")</option>
                            @foreach (var v in Enum.GetValues<FinancialStatus>()) { <option value="@v" selected="@(s.FinancialStatus == v)">@SocialProfileLabels.Financial(v, isRtl)</option> }
                        </select>
                    </div>
                </div>

                @* Residence moved to the parent file: where a family lives is the family's fact, and
                   keeping a copy per child meant three siblings could disagree about one address.
                   The guardians tab is one click away, and the picker lives there. *@

                <div class="mb-3"><label class="form-label small" for="so-Reason">@T("Reason (recorded in the audit trail)", "السبب (يُسجَّل في سجل التدقيق)")</label><input name="Reason" id="so-Reason" class="form-control form-control-sm" /></div>
                <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-save" aria-hidden="true"></i> @T("Save social profile", "حفظ البيانات الاجتماعية")</button>
            </form>
            </fieldset>
        </div>
        }

        <div class="tab-pane fade @Show("academic")" id="tab-academic">
            @*  Each row now answers three questions besides "what does the record say": may this
                grade be corrected, may this enrollment be taken off the record, and may this child
                leave their section. The controls are drawn from the permission flags and the usage
                guard, so a button that could only refuse is never offered (BR-SEC-010, and the same
                reasoning applied to the guard). The correction form opens under its own row rather
                than on a screen of its own — the thing being corrected is the row above it, and a
                separate page would lose it.  *@
            @{
                var anyRowAction = Model.CanCorrectEnrollment || Model.CanRemoveEnrollment || Model.CanSeat;
                var actionCols = anyRowAction ? 7 : 6;
            }
            <div class="table-responsive">
            <table class="table table-sm sms-table mb-3"><caption class="visually-hidden">@T("Academic history", "السجل الأكاديمي")</caption><thead><tr><th scope="col">@T("Year", "العام")</th><th scope="col">@T("Grade", "الصف")</th><th scope="col">@T("Section", "الشعبة")</th><th scope="col">@T("Enrolled", "القيد")</th><th scope="col">@T("Source", "المصدر")</th><th scope="col">@T("Status", "الحالة")</th>@if (anyRowAction) { <th scope="col" class="text-end">@T("Actions", "إجراءات")</th> }</tr></thead>
                <tbody>
                @foreach (var e in Model.Enrollments)
                {
                    var en = e.Enrollment;
                    Model.EnrollmentActionsById.TryGetValue(en.Id, out var act);
                    var gradeName = $"{e.Grade.Code} {(isRtl ? e.Grade.Name.NameAr : e.Grade.Name.NameEn)}";
                    var yearName = isRtl ? e.Year.LabelAr : e.Year.LabelEn;
                    var identity = $"{gradeName} · {yearName}";
                    <tr>
                        <td>@yearName</td>
                        <td>@gradeName</td>
                        <td>@(e.Section == null ? "—" : (isRtl ? e.Section.NameAr : e.Section.NameEn))</td>
                        <td dir="ltr">@en.EnrollmentDate.ToString("yyyy-MM-dd")@(en.ExitDate == null ? "" : " → " + en.ExitDate?.ToString("yyyy-MM-dd"))</td>
                        <td>@en.SourceType</td>
                        <td>@en.Status</td>
                        @if (anyRowAction)
                        {
                            <td class="text-end text-nowrap">
                                @if (Model.CanCorrectEnrollment)
                                {
                                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#correct-@en.Id" aria-expanded="false" aria-controls="correct-@en.Id" title="@T("Correct the grade", "تصحيح الصف")" aria-label="@T($"Correct the enrollment {identity}", $"تصحيح القيد {identity}")"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                }
                                @if (Model.CanSeat && act != null && act.Seated)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#leave-@en.Id" aria-expanded="false" aria-controls="leave-@en.Id" title="@T("Leave the section", "الخروج من الشعبة")" aria-label="@T($"Take the student out of their section, {identity}", $"إخراج الطالب من شعبته، {identity}")"><i class="bi bi-box-arrow-up" aria-hidden="true"></i></button>
                                }
                                @if (Model.CanRemoveEnrollment && act != null && act.CanRemove)
                                {
                                    <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="collapse" data-bs-target="#remove-@en.Id" aria-expanded="false" aria-controls="remove-@en.Id" title="@T("Remove this enrollment", "حذف هذا القيد")" aria-label="@T($"Remove the enrollment {identity}", $"حذف القيد {identity}")"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                }
                                else if (Model.CanRemoveEnrollment && act != null)
                                {
                                    @*  Disabled rather than hidden, and it says why. A missing button reads as
                                        a missing feature; a disabled one that names the attendance and the
                                        charges tells the registrar this record is history, not a mistake.  *@
                                    <button class="btn btn-sm btn-outline-danger" type="button" disabled title="@T($"Cannot be removed — {act.Usage.Describe(arabic: false)} recorded against it.", $"لا يمكن حذفه — سُجِّل عليه {act.Usage.Describe(arabic: true)}.")" aria-label="@T($"The enrollment {identity} cannot be removed", $"القيد {identity} لا يمكن حذفه")"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                }
                            </td>
                        }
                    </tr>
                    @if (Model.CanCorrectEnrollment)
                    {
                        var options = Model.CorrectionOptionsByEnrollment.TryGetValue(en.Id, out var os) ? os : new List<GradeYearOption>();
                        <tr class="collapse" id="correct-@en.Id"><td colspan="@actionCols" class="bg-body-tertiary">
                            <form method="post" asp-action="CorrectEnrollment" asp-route-id="@s.Id" asp-route-enrollmentId="@en.Id" class="row g-2 align-items-end">
                                <div class="col-12"><div class="small text-muted">@T($"Correcting the enrollment recorded as {identity}. The year cannot change here — moving a student between years is the rollover (BR-GLB-023).", $"تصحيح القيد المسجَّل بوصفه {identity}. ولا يتغيّر العام من هنا — فانتقال الطالب بين الأعوام يتم بالترحيل (BR-GLB-023).")</div></div>
                                <div class="col-md-4">
                                    <label class="form-label small" for="correct-grade-@en.Id">@T("Grade it should have been", "الصف الصحيح") <span class="text-danger" aria-hidden="true">*</span></label>
                                    <select name="gradeYearProfileId" id="correct-grade-@en.Id" class="form-select form-select-sm" required aria-required="true">
                                        @foreach (var o in options) { <option value="@o.ProfileId" selected="@(o.ProfileId == en.GradeYearProfileId)">@o.Code @(isRtl ? o.NameAr : o.NameEn)</option> }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small" for="correct-date-@en.Id">@T("Date", "التاريخ")</label>
                                    <input name="enrollmentDate" id="correct-date-@en.Id" type="date" class="form-control form-control-sm" value="@en.EnrollmentDate.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small" for="correct-source-@en.Id">@T("Source", "المصدر")</label>
                                    <select name="sourceType" id="correct-source-@en.Id" class="form-select form-select-sm">
                                        @foreach (var st in Enum.GetValues<EnrollmentSourceType>()) { <option value="@st" selected="@(st == en.SourceType)">@st</option> }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small" for="correct-reason-@en.Id">@T("Reason (kept in the audit trail)", "السبب (يُحفظ في سجل التدقيق)")</label>
                                    <input name="reason" id="correct-reason-@en.Id" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-1"><button class="btn btn-sm btn-primary w-100" type="submit" aria-label="@T("Save the correction", "حفظ التصحيح")"><i class="bi bi-check-lg" aria-hidden="true"></i></button></div>
                                @if (act != null && act.Seated)
                                {
                                    <div class="col-12"><div class="form-text text-danger-emphasis">@T("The student is seated in a section of this grade, so the grade cannot be corrected yet — a section belongs to one grade-year. Take them out of the section first.", "الطالب مُسنَد إلى شعبة من هذا الصف، فلا يُصحَّح الصف بعد — إذ تتبع الشعبة صفاً سنوياً واحداً. أخرِجه من الشعبة أولاً.")</div></div>
                                }
                            </form>
                        </td></tr>
                    }
                    @if (Model.CanSeat && act != null && act.Seated)
                    {
                        <tr class="collapse" id="leave-@en.Id"><td colspan="@actionCols" class="bg-body-tertiary">
                            <form method="post" asp-action="LeaveSection" asp-route-id="@s.Id" asp-route-enrollmentId="@en.Id" class="row g-2 align-items-end">
                                <div class="col-12"><div class="small text-muted">@T("The membership is closed on the effective date and kept, so the register for the days already served still reads correctly (BR-SCN-006). No new section is opened.", "تُغلق العضوية في تاريخ السريان وتُحفَظ، فيبقى كشف الأيام المنقضية صحيحاً (BR-SCN-006). ولا تُفتح شعبة جديدة.")</div></div>
                                <div class="col-md-4">
                                    <label class="form-label small" for="leave-reason-@en.Id">@T("Reason", "السبب") <span class="text-danger" aria-hidden="true">*</span></label>
                                    <select name="reasonCode" id="leave-reason-@en.Id" class="form-select form-select-sm" required aria-required="true">
                                        @foreach (var code in SectionBoardViewModel.ReasonCodes) { <option value="@code">@SectionBoardViewModel.ReasonLabel(code, isRtl)</option> }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small" for="leave-date-@en.Id">@T("Effective", "تاريخ السريان")</label>
                                    <input name="effectiveDate" id="leave-date-@en.Id" type="date" class="form-control form-control-sm" value="@today" />
                                </div>
                                <div class="col-md-4"><button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-box-arrow-up me-1" aria-hidden="true"></i>@T("Leave the section", "الخروج من الشعبة")</button></div>
                            </form>
                        </td></tr>
                    }
                    @if (Model.CanRemoveEnrollment && act != null && act.CanRemove)
                    {
                        <tr class="collapse" id="remove-@en.Id"><td colspan="@actionCols" class="bg-body-tertiary">
                            <form method="post" asp-action="RemoveEnrollment" asp-route-id="@s.Id" asp-route-enrollmentId="@en.Id" class="row g-2 align-items-end" onsubmit="return confirm('@T($"Remove the enrollment {identity} for {s.StudentNo}? Nothing has been recorded against it, and the removal is written to the audit trail.", $"حذف القيد {identity} للطالب {s.StudentNo}؟ لم يُسجَّل عليه شيء، ويُكتب الحذف في سجل التدقيق.")');">
                                <div class="col-12"><div class="small text-muted">@T("Only an enrollment nothing has happened against can be removed — one that has been used is history and is closed by withdrawal instead (BR-GLB-005).", "لا يُحذف إلا قيد لم يحدث عليه شيء — أما ما استُخدم فهو سجل تاريخي يُغلق بالانسحاب (BR-GLB-005).")</div></div>
                                <div class="col-md-7">
                                    <label class="form-label small" for="remove-reason-@en.Id">@T("Why is it being removed?", "لماذا يُحذف؟") <span class="text-danger" aria-hidden="true">*</span></label>
                                    <input name="reason" id="remove-reason-@en.Id" class="form-control form-control-sm" required aria-required="true" placeholder="@T("e.g. keyed against the wrong student", "مثال: أُدخل على الطالب الخطأ")" />
                                </div>
                                <div class="col-md-4"><button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash me-1" aria-hidden="true"></i>@T("Remove the enrollment", "حذف القيد")</button></div>
                            </form>
                        </td></tr>
                    }
                }
                @if (Model.Enrollments.Count == 0) { <tr><td colspan="@actionCols" class="text-center text-muted py-3">@T("No enrollments.", "لا قيود.")</td></tr> }
                </tbody></table>
            </div>
            <form method="post" asp-action="Enroll" asp-route-id="@s.Id" class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label small" for="enroll-gradeYearProfileId">@T("Grade-year", "الصف السنوي")</label><select name="gradeYearProfileId" id="enroll-gradeYearProfileId" class="form-select form-select-sm"><option value="">—</option>@foreach (var p in Model.Profiles) { <option value="@p.ProfileId">@(isRtl ? p.GradeAr : p.GradeEn) · @(isRtl ? p.YearAr : p.YearEn)</option> }</select></div><div class="col-md-3"><label class="form-label small" for="enroll-enrollmentDate">@T("Date", "التاريخ")</label><input name="enrollmentDate" id="enroll-enrollmentDate" type="date" class="form-control form-control-sm" value="@today" /></div><div class="col-md-2"><label class="form-label small" for="enroll-sourceType">@T("Source", "المصدر")</label><select name="sourceType" id="enroll-sourceType" class="form-select form-select-sm"><option value="Admission">Admission</option><option value="Reinstatement">Reinstatement</option></select></div><div class="col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit">@T("Enroll", "قيد")</button></div></form>
            <div class="form-text">@T("Seating a student in a section is done on their placement screen or the section's own page; leaving one can be done from the row above. The rollover — not a correction — is what moves students between years (BR-GLB-023).", "إسناد الطالب إلى شعبة يتم من شاشة إسناده أو من صفحة الشعبة؛ أما الخروج منها فمن السطر أعلاه. والترحيل — لا التصحيح — هو ما ينقل الطلاب بين الأعوام (BR-GLB-023).")</div>
            <div class="form-text">@T("Closing an enrollment with an exit date is the withdrawal wizard's job (BR-STU-006), which arrives with its clearance board; it is not what the buttons above do.", "إغلاق القيد بتاريخ خروج من عمل معالج الانسحاب (BR-STU-006) الذي يأتي مع لوحة إخلاء الطرف؛ وليس هو ما تفعله الأزرار أعلاه.")</div>
        </div>
        <div class="tab-pane fade @Show("status")" id="tab-status">
            <div class="d-flex flex-wrap gap-2 mb-3">@foreach (var st in Model.AllowedTransitions) { <form method="post" asp-action="Status" asp-route-id="@s.Id" class="d-inline-flex gap-1"><input type="hidden" name="target" value="@st" /><input name="reason" class="form-control form-control-sm" placeholder="@T("reason", "السبب")" style="width:11rem" aria-label="@T($"Reason for changing status to {st}", $"سبب تغيير الحالة إلى {st}")" /><button class="btn btn-sm btn-outline-primary" type="submit">→ @st</button></form> }@if (Model.AllowedTransitions.Count == 0) { <span class="text-muted small">@T("Terminal status.", "حالة نهائية.")</span> }</div>
            <div class="form-text">@T("Withdrawal wizard with clearance board (finance veto) arrives with Fees screens; today Withdrawn is a plain transition.", "معالج الانسحاب مع لوحة إخلاء الطرف يأتي مع شاشات الرسوم؛ حالياً الانسحاب انتقال بسيط.")</div>
        </div>
        <div class="tab-pane fade @Show("audit")" id="tab-audit"><table class="table table-sm sms-table mb-0 small"><caption class="visually-hidden">@T("Audit trail", "سجل التدقيق")</caption><thead><tr><th scope="col">@T("When", "متى")</th><th scope="col">@T("Action", "الإجراء")</th><th scope="col">@T("Field", "الحقل")</th><th scope="col">@T("Old", "قبل")</th><th scope="col">@T("New", "بعد")</th><th scope="col">@T("Reason", "السبب")</th><th scope="col">@T("Actor", "المنفذ")</th></tr></thead><tbody>@foreach (var a in Model.Audit) { <tr><td>@a.At.ToString("yyyy-MM-dd HH:mm")</td><td>@a.Action</td><td>@a.Field</td><td>@a.Old</td><td>@a.New</td><td>@a.Reason</td><td>#@a.Actor</td></tr> }</tbody></table></div>
        @* doc 10 §5: everything filed against this student, and the one box the whole product uses
           to add another. The photograph on the Personal tab is the same mechanism with one slot. *@
        <div class="tab-pane fade @Show("documents")" id="tab-documents"><partial name="_EntityDocuments" model="Model.Documents" /></div>
        <div class="tab-pane fade @Show("attendance")" id="tab-attendance"><p class="text-muted small mb-0">@T("Read-through to Attendance (Module 14): summaries and patterns appear with its screens.", "قراءة من الحضور (الوحدة 14): الملخصات والأنماط مع شاشاتها.")</p></div>
        <div class="tab-pane fade @Show("fees")" id="tab-fees"><p class="text-muted small mb-0">@T("Read-through to Fees/Payments (Modules 19–21): statement, aging and plans appear with their screens.", "قراءة من الرسوم/المدفوعات (19–21): كشف الحساب والأعمار والخطط مع شاشاتها.")</p></div>
        <div class="tab-pane fade @Show("certificates")" id="tab-certificates"><p class="text-muted small mb-0">@T("Read-through to Certificates (Module 18).", "قراءة من الشهادات (الوحدة 18).")</p></div>
        <div class="tab-pane fade @Show("more")" id="tab-more"><ul class="small text-muted mb-0"><li>@T("Medical 🔒 (24), Transportation (23), Documents (doc 10), Achievements, Activities (29), Behavior 🔒 (25), Exemptions, Notes — open as those module screens land.", "الطبي 🔒 (24)، النقل (23)، المستندات، الإنجازات، الأنشطة (29)، السلوك 🔒 (25)، الإعفاءات، الملاحظات — تُفعَّل مع شاشات وحداتها.")</li></ul></div>
    </div>
</div>


@section Scripts {
<script>
(function () {
    // The two lower levels of the residence picker are fetched as the one above them changes —
    // the same three endpoints the parent file uses, against this controller's own routes so the
    // permission checked is the student file's.
    var gov = document.getElementById('stu-res-gov');
    var area = document.getElementById('stu-res-area');
    var hood = document.getElementById('stu-res-hood');
    if (!gov || !area || !hood) { return; }

    var isRtl = @Html.Raw(Json.Serialize(isRtl));
    var labels = {
        choose: @Html.Raw(Json.Serialize(T("— choose —", "— اختر —"))),
        none: @Html.Raw(Json.Serialize(T("— none recorded —", "— لا يوجد —")))
    };

    function fill(select, rows, placeholder, selectedId) {
        select.innerHTML = '';
        var blank = document.createElement('option');
        blank.value = '';
        blank.textContent = placeholder;
        select.appendChild(blank);
        rows.forEach(function (r) {
            var o = document.createElement('option');
            o.value = r.id;
            o.textContent = isRtl ? r.ar : r.en;
            if (selectedId && r.id === selectedId) { o.selected = true; }
            select.appendChild(o);
        });
    }

    async function loadAreas(governorateId, selectAreaId) {
        if (!governorateId) { fill(area, [], labels.choose); fill(hood, [], labels.none); return; }
        var rows = await fetch('@Url.Content("~/students/residence/areas")?governorateId=' + governorateId).then(function (r) { return r.json(); });
        fill(area, rows, labels.choose, selectAreaId);
        await loadHoods(area.value, currentHood);
    }

    async function loadHoods(areaId, selectHoodId) {
        if (!areaId) { fill(hood, [], labels.none); return; }
        var rows = await fetch('@Url.Content("~/students/residence/neighbourhoods")?areaId=' + areaId).then(function (r) { return r.json(); });
        fill(hood, rows, labels.none, selectHoodId);
    }

    // The link to where these lists are authored follows the pickers, so the setup screen opens on
    // the governorate and locality being looked at rather than on its own first column. Rebuilt from
    // the base href, not appended to, or a second change would stack a second query string on it.
    var manage = document.getElementById('stu-res-manage');
    var manageBase = manage ? manage.getAttribute('href').split('?')[0] : null;
    function syncManage() {
        if (!manage) { return; }
        var query = [];
        if (gov.value) { query.push('governorateId=' + encodeURIComponent(gov.value)); }
        if (area.value) { query.push('localityId=' + encodeURIComponent(area.value)); }
        manage.setAttribute('href', manageBase + (query.length ? '?' + query.join('&') : ''));
    }

    gov.addEventListener('change', function () { currentHood = null; loadAreas(gov.value, null).then(syncManage); });
    area.addEventListener('change', function () { currentHood = null; loadHoods(area.value, null).then(syncManage); });

    // Reopen on what is already recorded: all three levels were resolved server-side by walking up
    // from the stored locality, so the browser restores them rather than guessing.
    var currentHood = @Html.Raw(Json.Serialize(Model.Student.NeighbourhoodId));
    var currentArea = @Html.Raw(Json.Serialize(Model.CurrentResidenceAreaId));
    if (gov.value) { loadAreas(gov.value, currentArea).then(syncManage); }
})();
</script>
}
