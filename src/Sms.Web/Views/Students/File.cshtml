@using System.Globalization
@using Sms.Domain.Students
@model StudentFileViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var s = Model.Student;
    var name = isRtl ? $"{s.FirstNameAr} {s.FatherNameAr} {s.GrandfatherNameAr} {s.FamilyNameAr}" : $"{s.FirstNameEn} {s.FatherNameEn} {s.GrandfatherNameEn} {s.FamilyNameEn}";
    ViewData["Title"] = s.StudentNo;
    ViewData["Breadcrumb"] = T("Students / ", "الطلاب / ") + s.StudentNo;
    var today = DateTime.UtcNow.ToString("yyyy-MM-dd");
    var tabs = new (string Key, string En, string Ar, string? Count)[]
    {
        ("personal", "Personal", "الشخصية", null), ("guardians", "Parents & guardians", "أولياء الأمور", Model.Guardians.Count.ToString()), ("emergency", "Emergency contacts", "جهات الطوارئ", Model.EmergencyContacts.Count.ToString()),
        ("academic", "Academic history", "السجل الأكاديمي", Model.Enrollments.Count.ToString()), ("status", "Status", "الحالة", null), ("audit", "Audit", "التدقيق", Model.Audit.Count.ToString()),
        ("attendance", "Attendance", "الحضور", Model.ReadThroughCounts.TryGetValue("attendance", out var at) ? at.ToString() : "0"), ("fees", "Fees", "الرسوم", Model.ReadThroughCounts.TryGetValue("charges", out var ch) ? ch.ToString() : "0"), ("certificates", "Certificates", "الشهادات", Model.ReadThroughCounts.TryGetValue("certificates", out var ce) ? ce.ToString() : "0"),
        ("more", "More…", "المزيد…", null),
    };
    string Show(string k) => Model.ActiveTab == k ? "show active" : "";
    string Badge(StudentStatus st) => st switch { StudentStatus.Enrolled => "text-bg-success", StudentStatus.Suspended => "text-bg-warning", StudentStatus.Graduated or StudentStatus.Alumni => "text-bg-primary", _ => "text-bg-secondary" };
}

<div class="sms-page-head">
    <div><div class="text-muted small"><code>@s.StudentNo</code> · @Model.NationalityName · @(s.Gender == Sms.Domain.Common.Gender.Male ? T("Male", "ذكر") : T("Female", "أنثى")) · @s.DateOfBirth.ToString("yyyy-MM-dd")</div>
        <h1 class="sms-page-title">@name <span class="badge fs-6 @Badge(s.Status)">@s.Status</span></h1></div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1 @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i>@T("List", "القائمة")</a>
</div>

<div class="sms-card">
    <ul class="nav nav-tabs px-3 pt-2 flex-nowrap overflow-auto">@foreach (var t in tabs) { <li class="nav-item"><button class="nav-link text-nowrap @(Model.ActiveTab == t.Key ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-@t.Key" type="button">@(isRtl ? t.Ar : t.En)@if (t.Count != null) { <span class="badge rounded-pill text-bg-light border ms-1">@t.Count</span> }</button></li> }</ul>
    <div class="tab-content p-4">
        <div class="tab-pane fade @Show("personal")" id="tab-personal">
            <form method="post" asp-action="Edit" asp-route-id="@s.Id">
                <div class="sms-bilingual mb-3">
                    <div><label class="form-label small">@T("Name (Arabic)", "الاسم (عربي)")</label><div class="row g-1"><div class="col-3"><input name="FirstNameAr" class="form-control form-control-sm" dir="rtl" value="@s.FirstNameAr" /></div><div class="col-3"><input name="FatherNameAr" class="form-control form-control-sm" dir="rtl" value="@s.FatherNameAr" /></div><div class="col-3"><input name="GrandfatherNameAr" class="form-control form-control-sm" dir="rtl" value="@s.GrandfatherNameAr" /></div><div class="col-3"><input name="FamilyNameAr" class="form-control form-control-sm" dir="rtl" value="@s.FamilyNameAr" /></div></div></div>
                    <div><label class="form-label small">@T("Name (English)", "الاسم (إنجليزي)")</label><div class="row g-1"><div class="col-3"><input name="FirstNameEn" class="form-control form-control-sm" dir="ltr" value="@s.FirstNameEn" /></div><div class="col-3"><input name="FatherNameEn" class="form-control form-control-sm" dir="ltr" value="@s.FatherNameEn" /></div><div class="col-3"><input name="GrandfatherNameEn" class="form-control form-control-sm" dir="ltr" value="@s.GrandfatherNameEn" /></div><div class="col-3"><input name="FamilyNameEn" class="form-control form-control-sm" dir="ltr" value="@s.FamilyNameEn" /></div></div></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-2"><label class="form-label small">@T("Gender", "الجنس")</label><select name="Gender" class="form-select form-select-sm"><option value="Male" selected="@(s.Gender == Sms.Domain.Common.Gender.Male)">@T("Male", "ذكر")</option><option value="Female" selected="@(s.Gender == Sms.Domain.Common.Gender.Female)">@T("Female", "أنثى")</option></select></div>
                    <div class="col-md-2"><label class="form-label small">@T("Date of birth", "الميلاد")</label><input name="DateOfBirth" type="date" class="form-control form-control-sm" value="@s.DateOfBirth.ToString("yyyy-MM-dd")" /></div>
                    <div class="col-md-3"><label class="form-label small">@T("Nationality", "الجنسية")</label><select name="NationalityLookupId" class="form-select form-select-sm">@foreach (var n in Model.Nationalities) { <option value="@n.Id" selected="@(n.Id == s.NationalityLookupId)">@(isRtl ? n.Ar : n.En)</option> }</select></div>
                    <div class="col-md-2"><label class="form-label small">@T("ID type", "نوع الهوية")</label><select name="PrimaryIdTypeLookupId" class="form-select form-select-sm"><option value="">—</option>@foreach (var t in Model.IdTypes) { <option value="@t.Id" selected="@(t.Id == s.PrimaryIdTypeLookupId)">@(isRtl ? t.Ar : t.En)</option> }</select></div>
                    <div class="col-md-2"><label class="form-label small">@T("ID number", "رقم الهوية")</label><input name="PrimaryIdNo" class="form-control form-control-sm" dir="ltr" value="@s.PrimaryIdNo" /></div>
                    <div class="col-md-1"><label class="form-label small">@T("Expiry", "الانتهاء")</label><input name="PrimaryIdExpiry" type="date" class="form-control form-control-sm" value="@s.PrimaryIdExpiry?.ToString("yyyy-MM-dd")" /></div>
                </div>
                <div class="d-flex gap-2 align-items-end"><div style="max-width:420px" class="flex-grow-1"><label class="form-label small">@T("Reason (required when identity fields change — BR-STU-002, T1)", "السبب (مطلوب عند تغيير حقول الهوية — BR-STU-002)")</label><input name="Reason" class="form-control form-control-sm" /></div><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-save me-1" aria-hidden="true"></i>@T("Save", "حفظ")</button></div>
            </form>
            <div class="form-text mt-2">@T("Photo upload (BR-ATT rules) lands with the attachment screens.", "رفع الصورة يأتي مع شاشات المرفقات.")</div>
        </div>
        <div class="tab-pane fade @Show("guardians")" id="tab-guardians">
            <table class="table table-sm sms-table mb-3"><caption class="visually-hidden">@T("Parents & guardians", "أولياء الأمور")</caption><thead><tr><th scope="col">@T("Parent", "ولي الأمر")</th><th scope="col">@T("Relationship", "القرابة")</th><th scope="col">@T("Primary", "أساسي")</th><th scope="col">@T("Financial", "مالي")</th><th scope="col">@T("Pickup", "استلام")</th><th scope="col">@T("Portal", "بوابة")</th><th scope="col">@T("Since", "منذ")</th><th scope="col"></th></tr></thead>
                <tbody>@foreach (var g in Model.Guardians) { <tr><td><a asp-controller="Parents" asp-action="File" asp-route-id="@g.Parent.Id">@g.Parent.ParentFileNo · @(isRtl ? g.Parent.NameAr : g.Parent.NameEn)</a> <span class="small text-muted" dir="ltr">@g.Parent.PrimaryMobile</span></td><td>@g.Relationship</td><td><span aria-hidden="true">@(g.Link.IsPrimaryContact ? "✓" : "—")</span><span class="visually-hidden">@(g.Link.IsPrimaryContact ? T("yes", "نعم") : T("no", "لا"))</span></td><td><span aria-hidden="true">@(g.Link.IsFinanciallyResponsible ? "✓" : "—")</span><span class="visually-hidden">@(g.Link.IsFinanciallyResponsible ? T("yes", "نعم") : T("no", "لا"))</span></td><td><span aria-hidden="true">@(g.Link.IsPickupAuthorized ? "✓" : "—")</span><span class="visually-hidden">@(g.Link.IsPickupAuthorized ? T("yes", "نعم") : T("no", "لا"))</span></td><td><span aria-hidden="true">@(g.Link.IsPortalVisible ? "✓" : "—")</span><span class="visually-hidden">@(g.Link.IsPortalVisible ? T("yes", "نعم") : T("no", "لا"))</span></td><td>@g.Link.EffectiveFromUtc.ToString("yyyy-MM-dd")</td>
                    <td class="text-end"><form method="post" asp-action="UnlinkGuardian" asp-route-id="@s.Id" asp-route-linkId="@g.Link.Id" class="d-inline-flex gap-1"><input name="effectiveTo" type="date" class="form-control form-control-sm" value="@today" style="width:9.5rem" aria-label="@T("Link end date", "تاريخ إنهاء الربط")" /><button class="btn btn-sm btn-outline-danger" type="submit" title="@T("End link", "إنهاء الربط")" aria-label="@T("End link", "إنهاء الربط")"><i class="bi bi-person-dash" aria-hidden="true"></i></button></form></td></tr> }
                @if (Model.Guardians.Count == 0) { <tr><td colspan="8" class="text-center text-warning-emphasis py-3">@T("No guardian linked — at least one financially-responsible parent is required (BR-GLB-004).", "لا ولي أمر مرتبط — يلزم ولي أمر مسؤول مالياً واحد على الأقل (BR-GLB-004).")</td></tr> }</tbody></table>
            @if (Model.PastGuardians.Count > 0) { <div class="small text-muted mb-3">@T("Past links:", "روابط سابقة:") @string.Join(" · ", Model.PastGuardians.Select(g => $"{(isRtl ? g.Parent.NameAr : g.Parent.NameEn)} ({g.Link.EffectiveFromUtc:yyyy-MM-dd} → {g.Link.EffectiveToUtc:yyyy-MM-dd})"))</div> }
            <form method="post" asp-action="LinkGuardian" asp-route-id="@s.Id" class="row g-2 align-items-end">
                <div class="col-md-4"><label class="form-label small">@T("Parent", "ولي الأمر")</label><select name="parentId" class="form-select form-select-sm"><option value="">—</option>@foreach (var p in Model.Parents) { <option value="@p.Id">@p.ParentFileNo · @(isRtl ? p.NameAr : p.NameEn) · @p.PrimaryMobile</option> }</select></div>
                <div class="col-md-2"><label class="form-label small">@T("Relationship", "القرابة")</label><select name="relationshipId" class="form-select form-select-sm">@foreach (var r in Model.Relationships) { <option value="@r.Id">@(isRtl ? r.Ar : r.En)</option> }</select></div>
                <div class="col-md-4 d-flex flex-wrap gap-2 small"><label><input type="checkbox" name="isPrimary" value="true" class="form-check-input" checked /> @T("primary", "أساسي")</label><label><input type="checkbox" name="isFinancial" value="true" class="form-check-input" checked /> @T("financial", "مالي")</label><label><input type="checkbox" name="isPickup" value="true" class="form-check-input" checked /> @T("pickup", "استلام")</label><label><input type="checkbox" name="isPortal" value="true" class="form-check-input" checked /> @T("portal", "بوابة")</label></div>
                <div class="col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>@T("Link", "ربط")</button></div>
            </form>
        </div>
        <div class="tab-pane fade @Show("emergency")" id="tab-emergency">
            <table class="table table-sm sms-table mb-3"><caption class="visually-hidden">@T("Emergency contacts", "جهات الطوارئ")</caption><thead><tr><th scope="col">@T("Name", "الاسم")</th><th scope="col">@T("Phone", "الهاتف")</th><th scope="col">@T("Pickup", "استلام")</th></tr></thead><tbody>@foreach (var c in Model.EmergencyContacts) { <tr><td>@(isRtl ? c.NameAr : c.NameEn)</td><td dir="ltr">@c.Phone</td><td><span aria-hidden="true">@(c.IsPickupAuthorized ? "✓" : "—")</span><span class="visually-hidden">@(c.IsPickupAuthorized ? T("yes", "نعم") : T("no", "لا"))</span></td></tr> }@if (Model.EmergencyContacts.Count == 0) { <tr><td colspan="3" class="text-center text-warning-emphasis py-3">@T("At least one emergency contact is required (§9).", "يلزم جهة اتصال طوارئ واحدة على الأقل (§9).")</td></tr> }</tbody></table>
            <form method="post" asp-action="AddEmergencyContact" asp-route-id="@s.Id" class="row g-2 align-items-end"><div class="col-md-3"><input name="nameAr" class="form-control form-control-sm" dir="rtl" placeholder="الاسم بالعربية" /></div><div class="col-md-3"><input name="nameEn" class="form-control form-control-sm" dir="ltr" placeholder="Name (English)" /></div><div class="col-md-2"><input name="phone" class="form-control form-control-sm" dir="ltr" placeholder="05xxxxxxxx" /></div><div class="col-md-2"><select name="relationshipId" class="form-select form-select-sm"><option value="">@T("relationship", "القرابة")</option>@foreach (var r in Model.Relationships) { <option value="@r.Id">@(isRtl ? r.Ar : r.En)</option> }</select></div><div class="col-md-1 small"><label><input type="checkbox" name="isPickup" value="true" class="form-check-input" /> @T("pickup", "استلام")</label></div><div class="col-md-1"><button class="btn btn-sm btn-primary w-100" type="submit" aria-label="@T("Add emergency contact", "إضافة جهة طوارئ")"><i class="bi bi-plus-lg" aria-hidden="true"></i></button></div></form>
        </div>
        <div class="tab-pane fade @Show("academic")" id="tab-academic">
            <table class="table table-sm sms-table mb-3"><caption class="visually-hidden">@T("Academic history", "السجل الأكاديمي")</caption><thead><tr><th scope="col">@T("Year", "العام")</th><th scope="col">@T("Grade", "الصف")</th><th scope="col">@T("Section", "الشعبة")</th><th scope="col">@T("Enrolled", "القيد")</th><th scope="col">@T("Source", "المصدر")</th><th scope="col">@T("Status", "الحالة")</th></tr></thead>
                <tbody>@foreach (var e in Model.Enrollments) { <tr><td>@(isRtl ? e.Year.LabelAr : e.Year.LabelEn)</td><td>@e.Grade.Code @(isRtl ? e.Grade.Name.NameAr : e.Grade.Name.NameEn)</td><td>@(e.Section == null ? "—" : (isRtl ? e.Section.NameAr : e.Section.NameEn))</td><td>@e.Enrollment.EnrollmentDate.ToString("yyyy-MM-dd")@(e.Enrollment.ExitDate == null ? "" : " → " + e.Enrollment.ExitDate?.ToString("yyyy-MM-dd"))</td><td>@e.Enrollment.SourceType</td><td>@e.Enrollment.Status</td></tr> }@if (Model.Enrollments.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-3">@T("No enrollments.", "لا قيود.")</td></tr> }</tbody></table>
            <form method="post" asp-action="Enroll" asp-route-id="@s.Id" class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label small">@T("Grade-year", "الصف السنوي")</label><select name="gradeYearProfileId" class="form-select form-select-sm"><option value="">—</option>@foreach (var p in Model.Profiles) { <option value="@p.ProfileId">@(isRtl ? p.GradeAr : p.GradeEn) · @(isRtl ? p.YearAr : p.YearEn)</option> }</select></div><div class="col-md-3"><label class="form-label small">@T("Date", "التاريخ")</label><input name="enrollmentDate" type="date" class="form-control form-control-sm" value="@today" /></div><div class="col-md-2"><label class="form-label small">@T("Source", "المصدر")</label><select name="sourceType" class="form-select form-select-sm"><option value="Admission">Admission</option><option value="Reinstatement">Reinstatement</option></select></div><div class="col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit">@T("Enroll", "قيد")</button></div></form>
            <div class="form-text">@T("Section assignment happens on the section page; the rollover moves students between years (BR-GLB-023).", "إسناد الشعبة من صفحة الشعبة؛ والترحيل ينقل الطلاب بين الأعوام (BR-GLB-023).")</div>
        </div>
        <div class="tab-pane fade @Show("status")" id="tab-status">
            <div class="d-flex flex-wrap gap-2 mb-3">@foreach (var st in Model.AllowedTransitions) { <form method="post" asp-action="Status" asp-route-id="@s.Id" class="d-inline-flex gap-1"><input type="hidden" name="target" value="@st" /><input name="reason" class="form-control form-control-sm" placeholder="@T("reason", "السبب")" style="width:11rem" /><button class="btn btn-sm btn-outline-primary" type="submit">→ @st</button></form> }@if (Model.AllowedTransitions.Count == 0) { <span class="text-muted small">@T("Terminal status.", "حالة نهائية.")</span> }</div>
            <div class="form-text">@T("Withdrawal wizard with clearance board (finance veto) arrives with Fees screens; today Withdrawn is a plain transition.", "معالج الانسحاب مع لوحة إخلاء الطرف يأتي مع شاشات الرسوم؛ حالياً الانسحاب انتقال بسيط.")</div>
        </div>
        <div class="tab-pane fade @Show("audit")" id="tab-audit"><table class="table table-sm sms-table mb-0 small"><caption class="visually-hidden">@T("Audit trail", "سجل التدقيق")</caption><thead><tr><th scope="col">@T("When", "متى")</th><th scope="col">@T("Action", "الإجراء")</th><th scope="col">@T("Field", "الحقل")</th><th scope="col">@T("Old", "قبل")</th><th scope="col">@T("New", "بعد")</th><th scope="col">@T("Reason", "السبب")</th><th scope="col">@T("Actor", "المنفذ")</th></tr></thead><tbody>@foreach (var a in Model.Audit) { <tr><td>@a.At.ToString("yyyy-MM-dd HH:mm")</td><td>@a.Action</td><td>@a.Field</td><td>@a.Old</td><td>@a.New</td><td>@a.Reason</td><td>#@a.Actor</td></tr> }</tbody></table></div>
        <div class="tab-pane fade @Show("attendance")" id="tab-attendance"><p class="text-muted small mb-0">@T("Read-through to Attendance (Module 14): summaries and patterns appear with its screens.", "قراءة من الحضور (الوحدة 14): الملخصات والأنماط مع شاشاتها.")</p></div>
        <div class="tab-pane fade @Show("fees")" id="tab-fees"><p class="text-muted small mb-0">@T("Read-through to Fees/Payments (Modules 19–21): statement, aging and plans appear with their screens.", "قراءة من الرسوم/المدفوعات (19–21): كشف الحساب والأعمار والخطط مع شاشاتها.")</p></div>
        <div class="tab-pane fade @Show("certificates")" id="tab-certificates"><p class="text-muted small mb-0">@T("Read-through to Certificates (Module 18).", "قراءة من الشهادات (الوحدة 18).")</p></div>
        <div class="tab-pane fade @Show("more")" id="tab-more"><ul class="small text-muted mb-0"><li>@T("Medical 🔒 (24), Transportation (23), Documents (doc 10), Achievements, Activities (29), Behavior 🔒 (25), Exemptions, Notes — open as those module screens land.", "الطبي 🔒 (24)، النقل (23)، المستندات، الإنجازات، الأنشطة (29)، السلوك 🔒 (25)، الإعفاءات، الملاحظات — تُفعَّل مع شاشات وحداتها.")</li></ul></div>
    </div>
</div>
