@using System.Globalization
@using Sms.Domain.Grades
@model SectionListViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Sections", "الشعب");
    ViewData["Breadcrumb"] = T("Sections / List", "الشعب / القائمة");
    string Gender(GenderPolicy g) => g switch { GenderPolicy.Boys => T("Boys", "بنين"), GenderPolicy.Girls => T("Girls", "بنات"), _ => T("Mixed", "مختلط") };
    var yid = Model.Year?.Id;
    var help = new HelpPanelViewModel
    {
        Id = "sections-help",
        Title = T("Sections — help", "الشعب — مساعدة"),
        Intro = T("A section is a class group inside a grade for one academic year. This list shows every section of the selected year with its capacity meter, gender policy, homeroom teacher and room.", "الشعبة هي مجموعة صفية داخل صف لعام دراسي واحد. تعرض هذه القائمة شعب العام المختار مع مقياس السعة وسياسة الجنس ورائد الفصل والقاعة."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Create a section", "إنشاء شعبة"), T("Pick the grade (its grade-year profile must exist — Grades → Profile), give Arabic/English names, capacity and gender. Capacity can't exceed the grade plan's section size (BR-SCN-001) and gender may only narrow the grade's policy (BR-SCN-002/003).", "اختر الصف (يجب أن يكون ملفه السنوي معرّفاً — الصفوف → الملف)، وأدخل الاسمين والسعة والجنس. لا تتجاوز السعة حجم الشعبة في خطة الصف (BR-SCN-001) ويضيّق الجنس سياسة الصف فقط (BR-SCN-002/003).")),
            new HelpPanelViewModel.Item(T("Open", "فتح"), T("The section page: roster, assign / transfer students, homeroom teacher history, close.", "صفحة الشعبة: قائمة الطلاب، إسناد/نقل الطلاب، سجل رائد الفصل، الإغلاق.")),
            new HelpPanelViewModel.Item(T("Edit ✎", "تعديل ✎"), T("Change names, capacity, gender or default room. Capacity can't drop below the students currently assigned.", "تغيير الأسماء أو السعة أو الجنس أو القاعة الافتراضية. لا يمكن خفض السعة دون عدد الطلاب المسندين حالياً.")),
            new HelpPanelViewModel.Item(T("Delete 🗑", "حذف 🗑"), T("Only for a section that never had students or a homeroom teacher. A section with history is closed from its page instead — history is kept (BR-SCN-005/006/007).", "فقط لشعبة لم يُسند إليها طلاب أو رائد فصل قط. الشعبة التي لها سجل تُغلق من صفحتها بدلاً من الحذف مع حفظ السجل (BR-SCN-005/006/007).")),
            new HelpPanelViewModel.Item(T("Capacity meter", "مقياس السعة"), T("Current students / capacity; amber at 90 %, red when full.", "الطلاب الحاليون / السعة؛ برتقالي عند 90٪ وأحمر عند الامتلاء.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Per grade and year: capacity meters, gender, homeroom, room, student counts (BR-SCN-001/002/004).", "لكل صف وعام: مقاييس السعة، الجنس، رائد الفصل، القاعة، عدد الطلاب (BR-SCN-001/002/004).")</p></div>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" class="d-flex gap-2 align-items-center"><select name="year" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="@T("Year", "العام")">@foreach (var y in Model.Years) { <option value="@y.Id" selected="@(y.Id == yid)">@(isRtl ? y.LabelAr : y.LabelEn) · @Labels.YearStatus(y.Status, isRtl)</option> }</select></form>
        <partial name="_HelpModal" model="help" />
    </div></div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="sms-card">
            <div class="table-responsive"><table class="table sms-table mb-0">
                <caption class="visually-hidden">@T("Sections", "الشعب")</caption>
                <thead><tr><th scope="col">@T("Grade", "الصف")</th><th scope="col">@T("Section", "الشعبة")</th><th scope="col">@T("Gender", "الجنس")</th><th scope="col">@T("Homeroom", "رائد الفصل")</th><th scope="col">@T("Room", "القاعة")</th><th scope="col" style="min-width:10rem">@T("Students / capacity", "الطلاب / السعة")</th><th scope="col"><span class="visually-hidden">@T("Actions", "إجراءات")</span></th></tr></thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    var pct = r.Section.Capacity == 0 ? 0 : Math.Min(100, (int)Math.Round(100.0 * r.Members / r.Section.Capacity));
                    <tr class="@(r.Section.Status == Sms.Domain.Sections.SectionStatus.Closed ? "text-muted" : "")">
                        <td>@r.Grade.Code @(isRtl ? r.Grade.Name.NameAr : r.Grade.Name.NameEn)</td>
                        <td><a asp-action="Details" asp-route-id="@r.Section.Id" class="fw-semibold">@(isRtl ? r.Section.NameAr : r.Section.NameEn)</a>@if (r.Section.Status == Sms.Domain.Sections.SectionStatus.Closed) { <span class="badge text-bg-secondary ms-1">@T("closed", "مغلقة")</span> }</td>
                        <td>@Gender(r.Section.GenderPolicy)</td>
                        <td>@(r.HomeroomName ?? "—")</td>
                        <td>@(r.RoomName ?? "—")</td>
                        <td><div class="small">@r.Members / @r.Section.Capacity</div><div class="sms-progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="@T("Capacity", "السعة")"><span style="width:@(pct)%;@(pct >= 100 ? "background:#dc2626" : pct >= 90 ? "background:#f59e0b" : "")"></span></div></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@r.Section.Id">@T("Open", "فتح")</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Section.Id" title="@T("Edit section", "تعديل الشعبة")" aria-label="@T("Edit section", "تعديل الشعبة")"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            <form method="post" asp-action="Delete" asp-route-id="@r.Section.Id" class="d-inline" onsubmit="return confirm('@T("Delete this section? Only possible when it never had students.", "حذف هذه الشعبة؟ ممكن فقط إن لم يُسند إليها طلاب قط.")');">
                                <button class="btn btn-sm btn-outline-danger" type="submit" title="@(r.Members > 0 ? T("Section has students — close it instead", "للشعبة طلاب — أغلقها بدلاً من ذلك") : T("Delete section", "حذف الشعبة"))" aria-label="@(r.Members > 0 ? T("Section has students — close it instead", "للشعبة طلاب — أغلقها بدلاً من ذلك") : T("Delete section", "حذف الشعبة"))" disabled="@(r.Members > 0)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Rows.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">@T("No sections for this year yet.", "لا شعب لهذا العام بعد.")</td></tr> }
                </tbody>
            </table></div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="sms-card p-3">
            <h2 class="h6">@T("New section", "شعبة جديدة")</h2>
            @if (Model.Profiles.Count == 0) { <div class="small text-muted">@T("Define a grade-year profile for this year first (Grades → Profile).", "عرّف ملف الصف السنوي لهذا العام أولاً (الصفوف → الملف).")</div> }
            else
            {
                <form method="post" asp-action="Define" asp-route-year="@yid">
                    <div class="mb-2"><label asp-for="GradeYearProfileId" class="form-label small mb-1">@T("Grade", "الصف") <span class="text-danger" aria-hidden="true">*</span></label><select asp-for="GradeYearProfileId" class="form-select form-select-sm" required aria-required="true"><option value="">@T("— grade —", "— الصف —")</option>@foreach (var p in Model.Profiles) { <option value="@p.ProfileId">@(isRtl ? p.GradeAr : p.GradeEn) (@p.TargetSections × @p.TargetSize)</option> }</select></div>
                    <div class="row g-2 mb-2"><div class="col-6"><label asp-for="NameAr" class="form-label small mb-1">@T("Name (Arabic)", "الاسم (عربي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="NameAr" class="form-control form-control-sm" dir="rtl" placeholder="أول-أ" required aria-required="true" /></div><div class="col-6"><label asp-for="NameEn" class="form-label small mb-1">@T("Name (English)", "الاسم (إنجليزي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="NameEn" class="form-control form-control-sm" dir="ltr" placeholder="1-A" required aria-required="true" /></div></div>
                    <div class="row g-2 mb-2"><div class="col-5"><label asp-for="Capacity" class="form-label small">@T("Capacity", "السعة")</label><input asp-for="Capacity" class="form-control form-control-sm" type="number" min="1" /></div><div class="col-7"><label asp-for="GenderPolicy" class="form-label small">@T("Gender", "الجنس")</label><select asp-for="GenderPolicy" class="form-select form-select-sm">@foreach (GenderPolicy g in Enum.GetValues(typeof(GenderPolicy))) { <option value="@g">@Gender(g)</option> }</select></div></div>
                    <button class="btn btn-sm btn-primary w-100" type="submit">@T("Create section", "إنشاء شعبة")</button>
                    <div class="form-text">@T("Sections × size can't exceed the grade-year plan (BR-SCN-001); gender may only narrow the grade's policy (BR-SCN-002).", "الشعب × الحجم لا تتجاوز خطة الصف السنوية (BR-SCN-001)؛ الجنس يضيّق سياسة الصف فقط (BR-SCN-002).")</div>
                </form>

                <hr class="my-3" />

                @* A grade is planned as a number of sections, not as one section
                   repeated. Naming them by hand is the step that leaves "1-A", "1-b"
                   and "1 - C" in one grade by the third year. *@
                <h2 class="h6">@T("Open several at once", "فتح عدة شعب دفعة واحدة")</h2>
                <form method="post" asp-action="DefineMany" asp-route-year="@yid" id="bulk-form">
                    <div class="mb-2">
                        <label class="form-label small mb-1" for="bulk-grade">@T("Grade", "الصف") <span class="text-danger" aria-hidden="true">*</span></label>
                        <select name="gradeYearProfileId" id="bulk-grade" class="form-select form-select-sm" required aria-required="true">
                            <option value="">@T("— grade —", "— الصف —")</option>
                            @foreach (var p in Model.Profiles) { <option value="@p.ProfileId" data-planned="@p.TargetSections" data-size="@p.TargetSize">@(isRtl ? p.GradeAr : p.GradeEn) (@p.TargetSections × @p.TargetSize)</option> }
                        </select>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label small mb-1" for="bulk-count">@T("How many", "العدد")</label>
                            <input name="count" id="bulk-count" class="form-control form-control-sm" type="number" min="1" max="12" value="2" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small mb-1" for="bulk-capacity">@T("Capacity", "السعة")</label>
                            <input name="capacity" id="bulk-capacity" class="form-control form-control-sm" type="number" min="1" value="25" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small mb-1" for="bulk-gender">@T("Gender", "الجنس")</label>
                            <select name="genderPolicy" id="bulk-gender" class="form-select form-select-sm">@foreach (GenderPolicy g in Enum.GetValues(typeof(GenderPolicy))) { <option value="@g">@Gender(g)</option> }</select>
                        </div>
                    </div>

                    @* Named before they are written, not after: a batch that picks its
                       own names silently is one an operator undoes section by section. *@
                    <div class="small mb-2" id="bulk-preview" aria-live="polite"></div>

                    <button class="btn btn-sm btn-outline-primary w-100" type="submit">@T("Open sections", "فتح الشعب")</button>
                    <div class="form-text">@T("Names continue the grade's own pattern — letters where it uses letters, numbers where it numbers — and never reuse a name a closed section still holds (BR-SCN-001).", "تواصل المسميات نمط الصف نفسه — حروفاً حيث يستخدم الحروف، وأرقاماً حيث يرقّم — ولا تعيد استخدام اسم ما زالت تحمله شعبة مغلقة (BR-SCN-001).")</div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
// The preview is the point of the batch form: names are shown before anything is
// written, so a wrong pattern is caught here rather than undone section by section
// afterwards. Without script the form still works — the server names them the same
// way and the flash message lists what it opened.
(function () {
    var grade = document.getElementById('bulk-grade');
    var count = document.getElementById('bulk-count');
    var preview = document.getElementById('bulk-preview');
    if (!grade || !count || !preview) { return; }

    var labels = @Html.Raw(Json.Serialize(new {
        willOpen = T("Will open:", "سيفتح:"),
        pickGrade = T("Choose a grade to see the names.", "اختر صفاً لعرض المسميات."),
        overPlan = T("The grade plans {0} section(s); this would take it past that.", "الصف مخطَّط له {0} شعبة؛ وهذا يتجاوزها."),
    }));

    // Two in-flight previews can resolve out of order — picking a grade fires one
    // immediately and typing a count fires another — and the loser landing last
    // would leave the wrong names on screen. Only the newest request may paint.
    var timer = null;
    var sequence = 0;
    function refresh() {
        var mine = ++sequence;
        if (!grade.value) { preview.textContent = labels.pickGrade; return; }
        var n = parseInt(count.value, 10);
        if (!(n >= 1 && n <= 12)) { preview.textContent = ''; return; }

        fetch('@Url.Content("~/sections/bulk/preview")?gradeYearProfileId=' + grade.value + '&count=' + n)
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (rows) {
                if (mine !== sequence) { return; }
                var isRtl = document.documentElement.getAttribute('dir') === 'rtl';
                var names = rows.map(function (x) { return isRtl ? x.ar : x.en; }).join('، ');
                preview.textContent = names ? labels.willOpen + ' ' + names : '';

                // The plan is the school's own number; exceeding it is the engine's
                // refusal, so say it here rather than let the operator find out on submit.
                var option = grade.options[grade.selectedIndex];
                var planned = parseInt(option.getAttribute('data-planned'), 10);
                if (planned > 0 && rows.length > 0) {
                    var existing = @Html.Raw(Json.Serialize(Model.Rows.GroupBy(r => r.Profile.Id).ToDictionary(g => g.Key.ToString(), g => g.Count())));
                    var have = existing[grade.value] || 0;
                    if (have + rows.length > planned) {
                        preview.textContent += ' — ' + labels.overPlan.replace('{0}', planned);
                    }
                }
            });
    }

    function debounced() { clearTimeout(timer); timer = setTimeout(refresh, 150); }
    grade.addEventListener('change', refresh);
    count.addEventListener('input', debounced);
    refresh();
})();
</script>
}
