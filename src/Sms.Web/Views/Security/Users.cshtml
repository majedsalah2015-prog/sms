@using System.Globalization
@model Sms.Web.Models.UserRoleListViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("User role assignments", "إسناد الأدوار للمستخدمين");
    ViewData["Breadcrumb"] = T("System administration / User roles", "إدارة النظام / أدوار المستخدمين");
    var help = new HelpPanelViewModel
    {
        Id = "user-roles-help",
        Title = T("User role assignments — help", "إسناد الأدوار للمستخدمين — مساعدة"),
        Intro = T("Which person holds which role (doc/Modules/06 §8). This screen is the only route by which a permission reaches a human being: roles are defined next door, and here they are handed out.", "من يحمل أي دور (الوثيقة 06 §8). وهذه الشاشة هي الطريق الوحيد الذي تصل به صلاحية إلى إنسان: فالأدوار تُعرَّف في الشاشة المجاورة، وهنا تُوزَّع."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("An account with no role reaches nothing", "الحساب بلا دور لا يصل إلى شيء"), T("It can sign in successfully and then find every screen answering 404. That is working as designed, not a broken account — but it is also the single most common \"the system is broken\" report after a new hire starts, so check here first.", "يستطيع الدخول بنجاح ثم يجد كل شاشة تردّ 404. وهذا عمل صحيح لا حساب معطوب — لكنه أيضاً أكثر بلاغات «النظام لا يعمل» شيوعاً بعد التحاق موظف جديد، فابدأ التحقق من هنا.")),
            new HelpPanelViewModel.Item(T("Roles add up", "الأدوار تتراكم"), T("Holding two roles gives the union of their permissions, never the intersection. There is no deny that overrides a grant, so a narrow role cannot be used to take something away — remove the wider role instead.", "حمل دورين يمنح اتحاد صلاحياتهما لا تقاطعهما. ولا يوجد منع يتغلب على منح، فلا يمكن استخدام دور ضيّق لسحب شيء — بل احذف الدور الأوسع.")),
            new HelpPanelViewModel.Item(T("Changes land on the next request", "التغييرات تسري في الطلب التالي"), T("Assigning or removing a role does not wait for the person to sign out. Their next page load is evaluated against the new set — which matters most when you are removing access from someone who is currently signed in.", "إسناد دور أو نزعه لا ينتظر خروج الشخص. فتحميل صفحته التالي يُقيَّم بالمجموعة الجديدة — وهذا أهم ما يكون حين تنزع وصولاً عن شخص متصل الآن.")),
            new HelpPanelViewModel.Item(T("Staff and portal accounts are different animals", "حسابات الموظفين والبوابة نوعان مختلفان"), T("Parent and student accounts live in the portal and are redirected there; staff URLs answer 404 for them by design (BR-SEC-010). Do not try to fix a parent's access by granting them a staff role — the account type, not the role, is what routes them.", "حسابات أولياء الأمور والطلاب في البوابة ويُحوَّلون إليها؛ وروابط الموظفين تردّ لهم 404 بالتصميم (BR-SEC-010). فلا تحاول إصلاح وصول ولي أمر بمنحه دور موظف — فنوع الحساب لا الدور هو ما يوجّهه.")),
        },
    };
}

<div class="sms-page-head">
    <div>
        <h1 class="sms-page-title">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">
            @T("Permissions reach a person only through a role. An account with no role can sign in and reach nothing.",
               "الصلاحيات تصل الشخص عبر الدور فقط. الحساب بلا دور يستطيع الدخول ولا يصل إلى شيء.")
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.CanProvision)
        {
            <a class="btn btn-primary btn-sm" asp-action="NewUser">
                <i class="bi bi-person-plus" aria-hidden="true"></i> @T("New user", "مستخدم جديد")
            </a>
        }
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index">
            <i class="bi bi-shield-lock" aria-hidden="true"></i> @T("Roles", "الأدوار")
        </a>
        <partial name="_HelpModal" model="help" />
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}

@if (Model.JustProvisioned is { } provisioned)
{
    @* Shown here and nowhere else, ever: nothing stores this value and no screen can reproduce it
       (BR-SEC-005). If it is lost the answer is a new one, not a search. *@
    <div class="alert alert-warning" role="alert">
        <h2 class="h6">@T("Hand these over now", "سلّم هذه البيانات الآن")</h2>
        <div class="d-flex flex-wrap gap-4 my-2">
            <div>
                <div class="small text-muted">@T("User name", "اسم المستخدم")</div>
                <code class="fs-6" dir="ltr">@provisioned.UserName</code>
            </div>
            <div>
                <div class="small text-muted">@T("One-time password", "كلمة مرور لمرة واحدة")</div>
                <code class="fs-6" dir="ltr">@provisioned.TemporaryPassword</code>
            </div>
        </div>
        <p class="mb-0 small">
            @T("This password is not stored anywhere it can be read back from, and this is the only time it is shown. The holder must change it at their next sign-in.",
               "لا تُحفظ كلمة المرور هذه في أي مكان يمكن قراءتها منه، وهذه هي المرة الوحيدة التي تُعرض فيها. وعلى صاحبها تغييرها عند دخوله التالي.")
        </p>
    </div>
}

<form method="get" class="mb-3 d-flex gap-2" style="max-width:26rem">
    <label class="visually-hidden" for="q">@T("Search accounts", "بحث في الحسابات")</label>
    <input id="q" name="q" value="@Model.Search" class="form-control" placeholder="@T("Search by user name", "بحث باسم المستخدم")" />
    <button type="submit" class="btn btn-outline-secondary">@T("Search", "بحث")</button>
</form>

<div class="sms-card">
    <div class="table-responsive"><table class="table sms-table mb-0">
        <caption class="visually-hidden">@ViewData["Title"]</caption>
        <thead>
        <tr>
            <th scope="col">@T("Account", "الحساب")</th>
            <th scope="col">@T("Type", "النوع")</th>
            <th scope="col">@T("Roles", "الأدوار")</th>
            <th scope="col">@T("Assign", "إسناد")</th>
            @if (Model.CanResetPassword)
            {
                <th scope="col">@T("Password", "كلمة المرور")</th>
            }
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            <tr class="@(user.IsActive ? "" : "text-muted")">
                <td class="fw-semibold">
                    @user.UserName
                    @if (!user.IsActive)
                    {
                        <span class="badge text-bg-secondary ms-1">@T("inactive", "معطّل")</span>
                    }
                </td>
                <td class="small">@Labels.AccountType(user.AccountType, isRtl)</td>
                <td>
                    @if (user.Roles.Count == 0)
                    {
                        <span class="text-muted small">@T("none", "لا شيء")</span>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var role in user.Roles)
                            {
                                <form method="post" asp-action="Revoke" asp-route-userAccountId="@user.UserAccountId" asp-route-roleId="@role.RoleId" asp-route-q="@Model.Search" class="d-inline">
                                    <span class="badge @(role.CanAdministerPermissions ? "text-bg-warning" : "text-bg-light border") d-inline-flex align-items-center gap-1">
                                        @(isRtl ? role.NameAr : role.NameEn)
                                        <button type="submit" class="btn btn-link btn-sm p-0 lh-1 text-reset"
                                                title="@T("Revoke", "سحب")" aria-label="@T($"Revoke {role.Code}", $"سحب {role.Code}")">
                                            <i class="bi bi-x" aria-hidden="true"></i>
                                        </button>
                                    </span>
                                </form>
                            }
                        </div>
                    }
                </td>
                <td>
                    <form method="post" asp-action="Assign" asp-route-userAccountId="@user.UserAccountId" asp-route-q="@Model.Search" class="d-flex gap-1">
                        <label class="visually-hidden" for="role-@user.UserAccountId">@T("Role", "الدور")</label>
                        <select id="role-@user.UserAccountId" name="roleId" class="form-select form-select-sm" style="width:14rem">
                            @foreach (var role in Model.Roles.Where(r => r.IsActive && user.Roles.All(h => h.RoleId != r.Id)))
                            {
                                <option value="@role.Id">@(isRtl ? role.NameAr : role.NameEn)</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">@T("Assign", "إسناد")</button>
                    </form>
                </td>
                @if (Model.CanResetPassword)
                {
                    <td>
                        @* Offered only where it would work: a deactivated account has no sign-in for
                           a new password to be used at, and the port refuses it (BR-SEC-005). *@
                        @if (user.IsActive)
                        {
                            <form method="post" asp-action="ResetPassword" asp-route-userAccountId="@user.UserAccountId" asp-route-q="@Model.Search"
                                  class="d-inline"
                                  onsubmit="return confirm('@T($"Issue a new one-time password for {user.UserName}? The current one stops working immediately.", $"إصدار كلمة مرور جديدة لمرة واحدة لـ {user.UserName}؟ الحالية تتوقف فوراً.")');">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-key" aria-hidden="true"></i> @T("Reset", "إعادة تعيين")
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table></div>
</div>
