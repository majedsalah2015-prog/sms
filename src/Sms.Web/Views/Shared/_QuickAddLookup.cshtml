@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
}
@*
    One shared modal per page for "➕ add a lookup value without leaving the form".
    Trigger buttons: <button type="button" data-quickadd-category="JobTitle" data-quickadd-target="#PositionLookupId" data-quickadd-title="…">+</button>
    quickadd.js posts to /setup/lookups/quick-add and inserts + selects the new <option> in the target select.
*@
<div class="modal fade" id="sms-quickadd" tabindex="-1" aria-labelledby="sms-quickadd-title" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="sms-quickadd-form" autocomplete="off" data-url="@Url.Action("QuickAddLookupValue", "Setup")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="category" id="sms-quickadd-category" />
            <div class="modal-header"><h2 class="modal-title h6" id="sms-quickadd-title">@T("Add value", "إضافة قيمة")</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T("Close", "إغلاق")"></button></div>
            <div class="modal-body">
                <div class="alert alert-danger d-none py-2 small" id="sms-quickadd-error" role="alert"></div>
                <div class="mb-2"><label class="form-label small" for="sms-quickadd-ar">@T("Arabic name", "الاسم بالعربية")</label><input id="sms-quickadd-ar" name="nameAr" class="form-control form-control-sm" dir="rtl" required /></div>
                <div class="mb-2"><label class="form-label small" for="sms-quickadd-en">@T("English name", "الاسم بالإنجليزية")</label><input id="sms-quickadd-en" name="nameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#sms-quickadd-ar" required /></div>
                <div class="mb-1"><label class="form-label small" for="sms-quickadd-code">@T("Code (optional — generated from the English name)", "الرمز (اختياري — يُولَّد من الاسم الإنجليزي)")</label><input id="sms-quickadd-code" name="code" class="form-control form-control-sm" dir="ltr" maxlength="20" /></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@T("Cancel", "إلغاء")</button><button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("Add", "إضافة")</button></div>
        </form>
    </div>
</div>
