@using System.Collections.Generic
@using System.Globalization
@using Sms.Application.Security
@using Sms.Domain.Security
@inject Sms.Web.Services.SchoolBrandMark BrandMark
@inject Sms.Application.Security.IPermissionService Permissions
@{
    var culture = CultureInfo.CurrentUICulture;
    var isRtl = culture.TextInfo.IsRightToLeft;
    var lang = culture.TwoLetterISOLanguageName;
    var bootstrapCss = isRtl ? "~/lib/bootstrap/css/bootstrap.rtl.min.css" : "~/lib/bootstrap/css/bootstrap.min.css";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "";
    var isPortalAccount = Sms.Web.Security.PortalAreaFilter.IsPortalAccount(User.FindFirst(Sms.Web.Security.SmsClaimTypes.AccountType)?.Value);
    var tabs = new (string Action, string Screen, string En, string Ar, string Icon)[]
    {
        ("Index", ScreenCatalog.Portal.Home, "My family", "عائلتي", "bi-people"),
        ("Statement", ScreenCatalog.Portal.Statement, "My statement", "كشف حسابي", "bi-receipt"),
        ("Announcements", ScreenCatalog.Portal.Announcements, "Announcements", "الإعلانات", "bi-megaphone"),
    };

    // BR-SEC-010: the portal's own bar hides what this account cannot open, exactly as the staff
    // sidebar does. A student holds the portal home and the announcements but deliberately not the
    // family's statement, and a tab that answers not-found is the disclosure the rule exists to
    // prevent. One query answers all three — PermissionService caches per request.
    var visibleTabs = new List<(string Action, string Screen, string En, string Ar, string Icon)>();
    foreach (var tab in tabs)
    {
        if (await Permissions.HasPermissionAsync(ScreenCatalog.Modules.Portal, tab.Screen, ActionVerb.View))
        {
            visibleTabs.Add(tab);
        }
    }

    // BR-SCH-006: a parent signs in to their child's school, not to a product. The same mark the
    // staff shell wears, with the same generic fallback when nothing is uploaded.
    var logoVersion = await BrandMark.VersionAsync();
}
<!DOCTYPE html>
<html lang="@lang" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(isRtl ? "بوابة أولياء الأمور" : "Parent portal")</title>
    <link rel="stylesheet" href="@bootstrapCss" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body.sms-portal { background: var(--sms-body-bg); }
        .sms-portal-bar { background: var(--sms-surface); border-bottom: 1px solid var(--sms-sidebar-border); }
        .sms-portal-main { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
        .sms-portal-nav .nav-link { color: var(--sms-muted); border-radius: 999px; padding: .4rem .9rem; }
        .sms-portal-nav .nav-link.active { background: var(--sms-primary); color: #fff; }
    </style>
</head>
<body class="sms-portal">
    <a class="sms-skip-link" href="#sms-portal-main">@(isRtl ? "تخطي إلى المحتوى" : "Skip to content")</a>
    <header class="sms-portal-bar">
        <div class="d-flex align-items-center gap-3 px-3 py-2 flex-wrap" style="max-width:1100px;margin:0 auto">
            <a asp-controller="Portal" asp-action="Index" class="sms-brand text-decoration-none d-flex align-items-center gap-2"><span class="sms-brand__mark@(logoVersion.HasValue ? " sms-brand__mark--logo" : "")">@if (logoVersion is int uploaded) {<img src="@Url.Action("BrandLogo", "Home", new { v = uploaded })" alt="" class="sms-brand__logo" />} else {<i class="bi bi-mortarboard-fill" aria-hidden="true"></i>}</span><span class="fw-semibold">@(isRtl ? "بوابة أولياء الأمور والطلاب" : "Parent & student portal")</span></a>
            <nav aria-label="@(isRtl ? "أقسام البوابة" : "Portal sections")"><ul class="nav sms-portal-nav ms-lg-3">@foreach (var t in visibleTabs) { var active = string.Equals(action, t.Action, StringComparison.OrdinalIgnoreCase) || (t.Action == "Index" && action == "Student"); <li class="nav-item"><a class="nav-link @(active ? "active" : "")" aria-current="@(active ? "page" : null)" asp-controller="Portal" asp-action="@t.Action"><i class="bi @t.Icon me-1" aria-hidden="true"></i>@(isRtl ? t.Ar : t.En)</a></li> }</ul></nav>
            <div class="ms-auto d-flex align-items-center gap-2">
                @if (!isPortalAccount) { <a class="btn btn-sm btn-outline-secondary" asp-controller="Home" asp-action="Index" title="@(isRtl ? "شاشات الموظفين" : "Staff screens")"><i class="bi bi-arrow-left @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i> @(isRtl ? "الموظفون" : "Staff")</a> }
                <form asp-controller="Home" asp-action="SetLanguage" method="post" class="d-inline"><input type="hidden" name="returnUrl" value="@returnUrl" /><input type="hidden" name="culture" value="@(isRtl ? "en" : "ar")" /><button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-translate" aria-hidden="true"></i> <span lang="@(isRtl ? "en" : "ar")" dir="@(isRtl ? "ltr" : "rtl")">@(isRtl ? "English" : "العربية")</span></button></form>
                @* The portal's own guide — what these three pages are, and why a result the school
                   has not published is absent rather than missing (BR-SEC-012). A parent reaches the
                   portal without training and has nobody at the next desk to ask. *@
                <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Help" asp-action="Index" title="@(isRtl ? "دليل الاستخدام" : "User guide")" aria-label="@(isRtl ? "دليل الاستخدام" : "User guide")"><i class="bi bi-question-circle" aria-hidden="true"></i> <span class="d-none d-md-inline">@(isRtl ? "مساعدة" : "Help")</span></a>
                <div class="dropdown"><button class="btn btn-sm sms-user dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-label="@(isRtl ? "حسابي" : "My account")"><i class="bi bi-person-circle" aria-hidden="true"></i> <span class="d-none d-md-inline">@(User.Identity?.Name ?? "")</span></button>
                    <ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2" aria-hidden="true"></i>@(isRtl ? "تغيير كلمة المرور" : "Change password")</a></li><li><hr class="dropdown-divider" /></li><li><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2 @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i>@(isRtl ? "تسجيل الخروج" : "Sign out")</button></form></li></ul></div>
            </div>
        </div>
    </header>
    <main id="sms-portal-main" class="sms-portal-main" role="main">
        @if (TempData["Flash"] is string flash) { <div class="alert alert-success py-2" role="status"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>@flash</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-danger py-2" role="alert"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>@error</div> }
        @RenderBody()
    </main>
    <footer class="text-center text-muted small pb-4">&copy; 2026 SMS &middot; <a asp-controller="Home" asp-action="Privacy">@(isRtl ? "الخصوصية" : "Privacy")</a> &middot; @(isRtl ? "تُعرض البيانات المنشورة فقط (BR-SEC-012)" : "Published data only (BR-SEC-012)")</footer>
    @* BR-SEC-013 / WCAG 2.2.1: warn 2 minutes before the 15-minute idle sign-out and let the user extend with one click. *@
    <div id="sms-idle-dialog" role="alertdialog" aria-modal="true" aria-labelledby="sms-idle-title" aria-describedby="sms-idle-text" class="position-fixed top-50 start-50 translate-middle bg-body border rounded shadow p-4 d-none" style="z-index:2000;max-width:22rem">
        <h2 id="sms-idle-title" class="h6">@(isRtl ? "هل ما زلت هنا؟" : "Still there?")</h2>
        <p id="sms-idle-text" class="small mb-3">@(isRtl ? "ستُسجَّل خروجك خلال دقيقتين تقريباً بسبب عدم النشاط (BR-SEC-013)." : "You will be signed out in about 2 minutes due to inactivity (BR-SEC-013).")</p>
        <button type="button" id="sms-idle-stay" class="btn btn-primary btn-sm">@(isRtl ? "البقاء متصلاً" : "Stay signed in")</button>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var warnAfterMs = 13 * 60 * 1000; // IdleMinutes (15) minus a 2-minute warning window
            var dialog = document.getElementById('sms-idle-dialog');
            var stay = document.getElementById('sms-idle-stay');
            if (!dialog || !stay) return;
            var timer, lastFocus;
            function arm() { clearTimeout(timer); timer = setTimeout(show, warnAfterMs); }
            function show() { lastFocus = document.activeElement; dialog.classList.remove('d-none'); stay.focus(); }
            function hide() { dialog.classList.add('d-none'); if (lastFocus && lastFocus.focus) lastFocus.focus(); }
            function extend() {
                fetch('@Url.Action("Ping", "Portal")', { credentials: 'same-origin' }).then(function (r) {
                    if (r.status === 204) { hide(); arm(); }
                    else { location.reload(); } // session already expired server-side -> land on Login with the return URL
                }).catch(function () { location.reload(); });
            }
            stay.addEventListener('click', extend);
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !dialog.classList.contains('d-none')) extend(); });
            arm();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
