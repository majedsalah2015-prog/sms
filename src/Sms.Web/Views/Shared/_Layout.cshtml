@using System.Globalization
@using Sms.Web.Navigation
@using Sms.Application.Setup
@inject ISystemSetupAdmin SetupAdmin
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var culture = CultureInfo.CurrentUICulture;
    var isRtl = culture.TextInfo.IsRightToLeft;
    var lang = culture.TwoLetterISOLanguageName;
    var dir = isRtl ? "rtl" : "ltr";
    var bootstrapCss = isRtl ? "~/lib/bootstrap/css/bootstrap.rtl.min.css" : "~/lib/bootstrap/css/bootstrap.min.css";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var productName = isRtl ? "نظام إدارة المدارس" : "School Management System";
    // BR-SET-006: modules whose feature toggle is off vanish from the menu.
    var featureStates = await SetupAdmin.GetFeatureStatesAsync();
    var sidebar = ModuleCatalog.BuildSidebar(m => FeatureCatalog.ForModule(m.Code) is not { } f || featureStates[f.Code]);
    // Companion ERP2028 system; the link renders only when ExternalApps:ErpUrl is configured.
    var erpUrl = Configuration["ExternalApps:ErpUrl"];
    var erpTitle = isRtl ? "نظام تخطيط موارد المؤسسة" : "ERP System";
    // The embedded accounting modules render inside this same shell; their screens are the ones
    // served from an MVC area, which no screen of this system uses.
    var isErpArea = !string.IsNullOrEmpty(ViewContext.RouteData.Values["area"] as string);
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SMS</title>
    <link rel="stylesheet" href="@bootstrapCss" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isErpArea)
    {
        // The embedded ERP modules' design system, loaded only on their own screens. Site-wide it
        // would put two stylesheets in competition over the same Bootstrap components; scoped to the
        // area, each subsystem's screens look like themselves and neither restyles the other.
        <link rel="stylesheet" href="~/css/erp-theme.css" asp-append-version="true" />
    }
</head>
<body>
    <a class="sms-skip-link" href="#sms-main">@(isRtl ? "تخطي إلى المحتوى" : "Skip to content")</a>
    <div class="sms-shell" id="sms-shell">
        <script>
            (function () {
                // doc/DesignSystem/15: collapse state persists per device; applied pre-paint on desktop only.
                try {
                    if (localStorage.getItem('sms-sidebar-collapsed') === '1' && !window.matchMedia('(max-width: 991.98px)').matches) {
                        document.currentScript.parentElement.classList.add('is-collapsed');
                    }
                } catch (e) { }
            })();
        </script>

        <aside class="sms-sidebar" id="sms-sidebar">
            <div class="sms-sidebar__brand">
                <a asp-controller="Home" asp-action="Index" class="sms-brand">
                    <span class="sms-brand__mark"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i></span>
                    <span class="sms-brand__text">
                        <span class="sms-brand__name">SMS</span>
                        <span class="sms-brand__sub">@productName</span>
                    </span>
                </a>
            </div>
            <partial name="_Sidebar" model="sidebar" />
            <div class="sms-sidebar__foot">
                <button type="button" class="sms-nav-link sms-collapse-btn" id="sms-collapse-btn" aria-label="@(isRtl ? "طيّ القائمة" : "Collapse menu")">
                    <i class="sms-nav-icon bi bi-chevron-double-left" aria-hidden="true"></i>
                    <span class="sms-nav-label">@(isRtl ? "طيّ القائمة" : "Collapse")</span>
                </button>
            </div>
        </aside>
        <div class="sms-sidebar__backdrop" id="sms-backdrop"></div>

        <div class="sms-content">
            <header class="sms-topbar">
                <button type="button" class="btn sms-icon-btn d-lg-none" id="sms-menu-btn" aria-controls="sms-sidebar" aria-label="@(isRtl ? "القائمة" : "Menu")"><i class="bi bi-list" aria-hidden="true"></i></button>
                <div class="sms-topbar__title">
                    @if (ViewData["Breadcrumb"] is string crumb)
                    {
                        <span class="text-muted">@crumb</span>
                    }
                </div>
                <div class="sms-topbar__actions">
                    <form asp-controller="Home" asp-action="SetLanguage" method="post" class="d-inline">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="culture" value="@(isRtl ? "en" : "ar")" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary sms-lang-btn" title="@(isRtl ? "English" : "العربية")">
                            <i class="bi bi-translate" aria-hidden="true"></i> <span lang="@(isRtl ? "en" : "ar")" dir="@(isRtl ? "ltr" : "rtl")">@(isRtl ? "English" : "العربية")</span>
                        </button>
                    </form>
                    @if (!string.IsNullOrWhiteSpace(erpUrl))
                    {
                        <a class="btn btn-sm sms-icon-btn" href="@erpUrl" target="_blank" rel="noopener" title="@erpTitle" aria-label="@erpTitle"><i class="bi bi-building"></i></a>
                    }
                    <a class="btn btn-sm sms-icon-btn" href="/hangfire" title="@(isRtl ? "المهام الخلفية" : "Background jobs")" aria-label="@(isRtl ? "المهام الخلفية" : "Background jobs")"><i class="bi bi-activity" aria-hidden="true"></i></a>
                    <div class="dropdown">
                        <button class="btn sms-user dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@(isRtl ? "حساب المستخدم" : "User menu")">
                            <i class="bi bi-person-circle" aria-hidden="true"></i> <span class="d-none d-md-inline">@(User.Identity?.Name ?? "")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2" aria-hidden="true"></i>@(isRtl ? "تغيير كلمة المرور" : "Change password")</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2 @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i>@(isRtl ? "تسجيل الخروج" : "Sign out")</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>
            <main id="sms-main" class="sms-main" role="main">
                @if (TempData["Flash"] is string flash)
                {
                    <div class="alert alert-success py-2" role="alert"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>@flash</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger py-2" role="alert"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>@error</div>
                }
                @RenderBody()
            </main>
            <footer class="sms-footer text-muted">
                &copy; 2026 SMS &middot; <a asp-controller="Home" asp-action="Privacy">@(isRtl ? "الخصوصية" : "Privacy")</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/translit.js" asp-append-version="true"></script>
    <script src="~/js/quickadd.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
