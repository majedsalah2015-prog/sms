@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "";
    var tabs = new (string Action, string En, string Ar, string Icon)[]
    {
        ("Index", "Template designer", "مصمّم القوالب", "bi-diagram-2"),
        ("Assign", "Assignment console", "لوحة الإسناد", "bi-person-check"),
        ("Family", "Family schedule", "جدول الأسرة", "bi-people"),
        ("Cases", "Reschedule cases", "طلبات إعادة الجدولة", "bi-arrow-repeat"),
        ("Dunning", "Dunning console", "لوحة المطالبات", "bi-megaphone"),
    };
    // Schedule and Reschedule are drill-downs of the family screen; keeping that tab lit stops the
    // subnav from going blank the moment an officer opens one.
    bool Active(string a) => string.Equals(a, action, StringComparison.OrdinalIgnoreCase)
        || (a == "Family" && (action is "Schedule" or "Reschedule"));
}
<nav aria-label="@(isRtl ? "خطط التقسيط" : "Installment plans")">
<ul class="nav nav-pills sms-subnav mb-4">
    @foreach (var t in tabs)
    {
        var isActive = Active(t.Action);
        <li class="nav-item"><a class="nav-link @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)" asp-controller="Installments" asp-action="@t.Action"><i class="bi @t.Icon me-1" aria-hidden="true"></i>@(isRtl ? t.Ar : t.En)</a></li>
    }
</ul>
</nav>
