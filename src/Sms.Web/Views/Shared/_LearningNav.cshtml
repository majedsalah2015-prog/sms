@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "";
    var tabs = new (string Action, string En, string Ar, string Icon)[]
    {
        ("Index", "Lesson planner", "مخطط الدروس", "bi-calendar3-week"),
        ("Materials", "Materials", "مكتبة المواد", "bi-folder2-open"),
        ("Homework", "Homework desk", "مكتب الواجبات", "bi-journal-check"),
        ("QuestionBanks", "Question banks", "بنوك الأسئلة", "bi-patch-question"),
    };
    // The per-lesson library reached from the planner keeps the planner tab lit:
    // it is the same §8.2 data read from inside one lesson, and lighting the
    // Materials tab from there would say the teacher had left the planner.
    // The tracker and the marking queue are opened from a homework row and are
    // about that homework, so they keep the desk tab lit: a teacher who followed
    // a link out of the desk has not left it.
    bool Active(string a) => string.Equals(a, action, StringComparison.OrdinalIgnoreCase)
        || (a == "Index" && string.Equals(action, "Resources", StringComparison.OrdinalIgnoreCase))
        || (a == "Homework" && (string.Equals(action, "Submissions", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action, "Marking", StringComparison.OrdinalIgnoreCase)))
        // One bank and one question are both inside the bank list, reached from
        // it and returning to it.
        || (a == "QuestionBanks" && (string.Equals(action, "QuestionBankDetail", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action, "NewQuestion", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action, "ReviseQuestion", StringComparison.OrdinalIgnoreCase)
            // A paper is reached from its bank and belongs to it (BR-LRN-001).
            || string.Equals(action, "Papers", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action, "Paper", StringComparison.OrdinalIgnoreCase)));
}
<nav aria-label="@(isRtl ? "التعليم الإلكتروني" : "E-learning")">
<ul class="nav nav-pills sms-subnav mb-4">
    @foreach (var t in tabs) { var isActive = Active(t.Action); <li class="nav-item"><a class="nav-link @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)" asp-controller="Learning" asp-action="@t.Action"><i class="bi @t.Icon me-1" aria-hidden="true"></i>@(isRtl ? t.Ar : t.En)</a></li> }
</ul>
</nav>
