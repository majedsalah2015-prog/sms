@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "";
    var tabs = new (string Action, string En, string Ar, string Icon)[]
    {
        ("Index", "Grant desk", "مكتب المنح", "bi-award"),
        ("Types", "Type catalog", "فهرس الأنواع", "bi-list-check"),
        ("Scholarships", "Scholarship board", "لوحة المنح الدراسية", "bi-mortarboard"),
        ("Renewals", "Renewal queue", "قائمة التجديد", "bi-arrow-repeat"),
        ("Waivers", "Waiver desk", "مكتب الإعفاءات", "bi-receipt-cutoff"),
    };
    bool Active(string a) => string.Equals(a, action, StringComparison.OrdinalIgnoreCase);
}
<nav aria-label="@(isRtl ? "الخصومات والمنح" : "Discounts & Grants")">
<ul class="nav nav-pills sms-subnav mb-4">
    @foreach (var t in tabs)
    {
        var isActive = Active(t.Action);
        <li class="nav-item"><a class="nav-link @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)" asp-controller="Discounts" asp-action="@t.Action"><i class="bi @t.Icon me-1" aria-hidden="true"></i>@(isRtl ? t.Ar : t.En)</a></li>
    }
</ul>
</nav>
