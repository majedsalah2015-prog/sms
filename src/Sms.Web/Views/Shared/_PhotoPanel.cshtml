@using System.Globalization
@using Sms.Web.Services
@model PhotoPanelViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
}

<div class="sms-photo-panel text-center">
    @if (Model.CanEdit)
    {
        @* asp-antiforgery is not decoration. Writing `action` on a form switches the tag helper's
           antiforgery default off, so the hidden token is never emitted and every post to a
           [ValidateAntiForgeryToken] action comes back 400 — which is exactly how this panel
           silently refused every photograph it was given. The URLs are passed in rather than
           routed here because two controllers share the panel. *@
        <form method="post" action="@Model.UploadUrl" asp-antiforgery="true" enctype="multipart/form-data" class="d-grid gap-2">
            @* One frame: the photograph on file, replaced in place by the one about to be uploaded,
               so nobody submits a face they have not looked at. *@
            <partial name="_FileUploadField" model="@(new FileUploadFieldViewModel {
                Id = Model.Id + "-file", Name = "photo",
                AllowedFormats = PersonPhotoService.PhotoFormats,
                MaxBytes = PersonPhotoService.MaxPhotoBytes,
                Required = true,
                Shape = FileUploadShape.Portrait,
                CurrentImageUrl = Model.HasPhoto ? Model.PhotoUrl : null,
                Hint = T("Shown on the file, lists and printed cards.", "تظهر في الملف والقوائم والبطاقات المطبوعة.") })" />
            <button type="submit" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-upload me-1" aria-hidden="true"></i>@(Model.HasPhoto ? T("Replace", "استبدال") : T("Upload", "رفع"))
            </button>
        </form>
        @if (Model.HasPhoto)
        {
            <form method="post" action="@Model.RemoveUrl" asp-antiforgery="true" class="mt-1" onsubmit="return confirm('@T("Remove this photo?", "إزالة هذه الصورة؟")');">
                <button type="submit" class="btn btn-sm btn-link text-danger p-0">@T("Remove", "إزالة")</button>
            </form>
        }
    }
    else
    {
        @* The portal shows a photograph, it does not set one — a fixed frame whatever the file's
           shape, so a row of faces does not jump about as the photographs vary. *@
        <div class="sms-photo-frame mx-auto mb-2">
            @if (Model.HasPhoto)
            {
                <img src="@Model.PhotoUrl" alt="@T("Photo of", "صورة") @Model.PersonName" loading="lazy" />
            }
            else
            {
                <span class="sms-photo-empty" aria-hidden="true"><i class="bi bi-person"></i></span>
                <span class="visually-hidden">@T("No photo on file.", "لا توجد صورة في الملف.")</span>
            }
        </div>
    }
</div>
