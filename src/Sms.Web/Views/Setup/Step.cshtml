@using System.Globalization
@using Sms.Application.Setup
@using Sms.Domain.Setup
@model SetupStepViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var step = Model.State!.Step;
    var title = isRtl ? step.TitleAr : step.TitleEn;
    ViewData["Title"] = title;
    ViewData["Breadcrumb"] = T("System Setup / Setup wizard / ", "إعداد النظام / معالج الإعداد / ") + title;
    var done = Model.State.Status == SetupStepStatus.Completed;
    var days = new[] { DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };
    string DayName(DayOfWeek d) => isRtl ? CultureInfo.GetCultureInfo("ar-SA").DateTimeFormat.GetDayName(d) : d.ToString();
    var total = SetupWizardSteps.All.Count;
    var help = SetupHelp.ForStep(step.Code, isRtl);
}

<div class="sms-page-head">
    <div>
        <div class="text-muted small">@T("Step", "الخطوة") @step.Order @T("of", "من") @total</div>
        <h1 class="sms-page-title">@title</h1>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (done) { <span class="badge text-bg-success"><i class="bi bi-check2 me-1" aria-hidden="true"></i>@T("Completed", "مكتملة")</span> }
        else if (Model.State.IsReady) { <span class="badge text-bg-primary">@T("Ready", "جاهزة")</span> }
        else { <span class="badge text-bg-secondary">@T("Pending", "قيد الانتظار")</span> }
        <partial name="_HelpModal" model="help" />
    </div>
</div>

<partial name="_SetupNav" />

@* Where you are in the nine, without having to read the list on the side. *@
<div class="progress mb-3" role="progressbar" style="height:.4rem"
     aria-label="@T("Wizard progress", "تقدّم المعالج")" aria-valuenow="@step.Order" aria-valuemin="1" aria-valuemax="@total">
    <div class="progress-bar" style="width:@(step.Order * 100 / total)%"></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        @* The ladder the school already has, each row its own form. Outside the step's form
           because HTML has no nested forms, and editable because a stage entered once is lived
           with for years — the grid used to be append-only, so a typo could not be corrected
           without leaving the wizard for the grades module. *@
        @if (step.Code == SetupWizardSteps.StageStructure && Model.Stages.Count > 0)
        {
            <div class="sms-card mb-3">
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
                    <h2 class="h6 mb-0">@T("The ladder so far", "السلّم حتى الآن")</h2>
                    <span class="text-muted small">@Model.Stages.Count @T("stages", "مرحلة") · @Model.Stages.Sum(s => s.Grades.Count) @T("grades", "صفاً")</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm sms-table mb-0">
                        <caption class="visually-hidden">@T("Stages and grades, editable", "المراحل والصفوف، قابلة للتعديل")</caption>
                        <thead>
                            <tr>
                                <th scope="col" style="width:5rem">@T("Order", "الترتيب")</th>
                                <th scope="col">@T("Arabic", "عربي")</th>
                                <th scope="col">@T("English", "إنجليزي")</th>
                                <th scope="col" style="width:8rem">@T("Code", "الرمز")</th>
                                <th scope="col" style="width:6rem"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var s in Model.Stages)
                        {
                            <tr class="table-light">
                                <td colspan="5" class="py-1">
                                    <form method="post" asp-action="UpdateStage" asp-route-id="@s.Id" class="row g-1 align-items-center">
                                        <div class="col-auto" style="width:5rem"><input name="order" value="@s.Order" type="number" min="1" class="form-control form-control-sm" aria-label="@T("Stage order", "ترتيب المرحلة")" /></div>
                                        <div class="col"><input name="nameAr" value="@s.NameAr" dir="rtl" class="form-control form-control-sm fw-semibold" aria-label="@T("Stage name (Arabic)", "اسم المرحلة (عربي)")" /></div>
                                        <div class="col"><input name="nameEn" value="@s.NameEn" dir="ltr" class="form-control form-control-sm fw-semibold" aria-label="@T("Stage name (English)", "اسم المرحلة (إنجليزي)")" /></div>
                                        <div class="col-auto" style="width:8rem"><span class="badge text-bg-secondary">@T("stage", "مرحلة")</span></div>
                                        <div class="col-auto" style="width:6rem"><button class="btn btn-sm btn-outline-primary w-100" type="submit" title="@T("Save this stage", "حفظ هذه المرحلة")"><i class="bi bi-check2" aria-hidden="true"></i></button></div>
                                    </form>
                                </td>
                            </tr>
                            foreach (var g in s.Grades)
                            {
                                <tr>
                                    <td colspan="5" class="py-1">
                                        <form method="post" asp-action="UpdateGrade" asp-route-id="@g.Id" class="row g-1 align-items-center">
                                            <div class="col-auto" style="width:5rem"><input name="order" value="@g.Order" type="number" min="1" class="form-control form-control-sm" aria-label="@T("Grade order", "ترتيب الصف")" /></div>
                                            <div class="col"><input name="nameAr" value="@g.NameAr" dir="rtl" class="form-control form-control-sm" aria-label="@T("Grade name (Arabic)", "اسم الصف (عربي)")" /></div>
                                            <div class="col"><input name="nameEn" value="@g.NameEn" dir="ltr" class="form-control form-control-sm" aria-label="@T("Grade name (English)", "اسم الصف (إنجليزي)")" /></div>
                                            <div class="col-auto" style="width:8rem"><input name="code" value="@g.Code" dir="ltr" class="form-control form-control-sm" aria-label="@T("Grade code", "رمز الصف")" /></div>
                                            @* Only worth offering once there is somewhere else to move it to. *@
                                            @if (Model.StageOptions.Count > 1)
                                            {
                                                <div class="col-auto" style="width:9rem">
                                                    <select name="stageId" class="form-select form-select-sm" aria-label="@T("Move this grade to another stage", "نقل هذا الصف إلى مرحلة أخرى")">
                                                        @foreach (var opt in Model.StageOptions) { <option value="@opt.Id" selected="@(opt.Id == g.StageId)">@(isRtl ? opt.Ar : opt.En)</option> }
                                                    </select>
                                                </div>
                                            }
                                            <div class="col-auto" style="width:6rem"><button class="btn btn-sm btn-outline-primary w-100" type="submit" title="@T("Save this grade", "حفظ هذا الصف")"><i class="bi bi-check2" aria-hidden="true"></i></button></div>
                                        </form>
                                    </td>
                                </tr>
                            }
                            if (s.Grades.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center text-warning-emphasis small py-2">@T("No grades in this stage yet — add one below.", "لا صفوف في هذه المرحلة بعد — أضِف واحداً أدناه.")</td></tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        <div class="sms-card p-4">
            <form method="post" asp-action="Step" asp-route-code="@step.Code" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>

                @switch (step.Code)
                {
                    case SetupWizardSteps.Profile:
                        <p class="text-muted small">@T("Identity fields appear on official documents; later edits require an audit reason (BR-SCH-002).", "حقول الهوية تظهر في المستندات الرسمية؛ التعديلات اللاحقة تتطلب سبباً للتدقيق (BR-SCH-002).")</p>
                        <input type="hidden" asp-for="SchoolId" />
                        <div class="sms-bilingual mb-3">
                            <div><label class="form-label" asp-for="NameAr">@T("School name (Arabic)", "اسم المدرسة (عربي)")</label><input asp-for="NameAr" class="form-control" dir="rtl" /></div>
                            <div><label class="form-label" asp-for="NameEn">@T("School name (English)", "اسم المدرسة (إنجليزي)")</label><input asp-for="NameEn" class="form-control" dir="ltr" /></div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4"><label class="form-label" asp-for="LicenseNumber">@T("License number", "رقم الترخيص")</label><input asp-for="LicenseNumber" class="form-control" dir="ltr" /></div>
                            <div class="col-md-4"><label class="form-label" asp-for="MinistryCode">@T("Ministry code", "الرمز الوزاري")</label><input asp-for="MinistryCode" class="form-control" dir="ltr" /></div>
                            <div class="col-md-4"><label class="form-label" asp-for="LicenseExpiryDate">@T("License expiry", "انتهاء الترخيص")</label><input asp-for="LicenseExpiryDate" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" /></div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4"><label class="form-label" asp-for="City">@T("City", "المدينة")</label><input asp-for="City" class="form-control" /></div>
                            <div class="col-md-8"><label class="form-label" asp-for="AddressLine">@T("Address", "العنوان")</label><input asp-for="AddressLine" class="form-control" /></div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4"><label class="form-label" asp-for="ContactEmail">@T("Contact email", "البريد الإلكتروني")</label><input asp-for="ContactEmail" class="form-control" dir="ltr" type="email" /></div>
                            <div class="col-md-4"><label class="form-label" asp-for="ContactPhone">@T("Contact phone", "الهاتف")</label><input asp-for="ContactPhone" class="form-control" dir="ltr" /></div>
                            <div class="col-md-4"><label class="form-label" asp-for="Website">@T("Website", "الموقع الإلكتروني")</label><input asp-for="Website" class="form-control" dir="ltr" /></div>
                        </div>
                        break;

                    case SetupWizardSteps.CountryPack:
                        <p class="text-muted small">@T("The pack binds VAT default, ID-type requirements, Hijri display and retention defaults (BR-SET-004). Changing it after go-live needs product-support permission.", "تربط الحزمة افتراضيات الضريبة ومتطلبات الهوية وعرض الهجري والاحتفاظ (BR-SET-004). تغييرها بعد التشغيل يتطلب صلاحية دعم المنتج.")</p>
                        @foreach (var p in Model.Packs)
                        {
                            <label class="sms-card p-3 d-flex align-items-start gap-3 mb-2 @(Model.PackCode == p.Code ? "border-primary" : "")" for="pack-@p.Code">
                                <input class="form-check-input mt-1" type="radio" asp-for="PackCode" value="@p.Code" id="pack-@p.Code" />
                                <span>
                                    <span class="fw-semibold d-block">@(isRtl ? p.Name.NameAr : p.Name.NameEn) <span class="text-muted small">(@p.Code v@(p.Version))</span></span>
                                    <span class="small text-muted">@p.CountryIsoCode · @p.DefaultCurrencyCode · @T("VAT", "ض.ق.م") @((p.DefaultVatRate * 100).ToString("0.#"))% · @T("Hijri", "هجري"): @(p.HijriDisplayDefault ? T("on", "مفعّل") : T("off", "معطّل")) · @T("IDs", "الهويات"): @p.RequiredIdTypeCodes</span>
                                </span>
                            </label>
                        }
                        if (Model.Packs.Count == 0) { <div class="alert alert-warning small">@T("No country packs are defined — run the product seeder.", "لا توجد حزم دول معرّفة — شغّل بيانات المنتج.")</div> }
                        break;

                    case SetupWizardSteps.Currency:
                        <p class="text-muted small">@T("Picked from the ISO currency list (BR-GLB-112).", "تُختار من قائمة عملات ISO (BR-GLB-112).")</p>
                        <div class="mb-3" style="max-width:420px">
                            <label class="form-label" asp-for="CurrencyCode">@T("Currency", "العملة")</label>
                            <select asp-for="CurrencyCode" class="form-select">
                                @foreach (var c in Model.Currencies) { <option value="@c.Code">@c.Code — @(isRtl ? c.Name.NameAr : c.Name.NameEn)</option> }
                            </select>
                        </div>
                        break;

                    case SetupWizardSteps.TimeZone:
                        <div class="mb-3" style="max-width:520px">
                            <label class="form-label" asp-for="TimeZoneId">@T("Time zone", "المنطقة الزمنية")</label>
                            <select asp-for="TimeZoneId" class="form-select">
                                @foreach (var tz in Model.TimeZones) { <option value="@tz.Id">@tz.DisplayName</option> }
                            </select>
                        </div>
                        break;

                    case SetupWizardSteps.WorkingWeek:
                        <p class="text-muted small">@T("At least 4 working days. The rest are the weekend for the calendar and timetable.", "أربعة أيام عمل على الأقل. البقية عطلة نهاية الأسبوع للتقويم والجدول.")</p>
                        <div class="d-flex flex-wrap gap-3 mb-3">
                            @foreach (var d in days)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="WorkingDays" value="@d" id="wd-@d" @(Model.WorkingDays.Contains(d) ? "checked" : "") />
                                    <label class="form-check-label" for="wd-@d">@DayName(d)</label>
                                </div>
                            }
                        </div>
                        <div class="mb-3" style="max-width:320px">
                            <label class="form-label" asp-for="FirstDayOfWeek">@T("First day of week", "أول أيام الأسبوع")</label>
                            <select asp-for="FirstDayOfWeek" class="form-select">
                                @foreach (var d in days) { <option value="@d">@DayName(d)</option> }
                            </select>
                        </div>
                        break;

                    case SetupWizardSteps.Languages:
                        <div class="mb-3">
                            <label class="form-label d-block">@T("Enabled languages", "اللغات المفعّلة")</label>
                            @foreach (var l in SettingKeys.SupportedLanguages)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="EnabledLanguages" value="@l" id="lang-@l" @(Model.EnabledLanguages.Contains(l) ? "checked" : "") />
                                    <label class="form-check-label" for="lang-@l">@(l == "ar" ? "العربية" : "English")</label>
                                </div>
                            }
                        </div>
                        <div class="mb-3" style="max-width:320px">
                            <label class="form-label" asp-for="DefaultLanguage">@T("Default language", "اللغة الافتراضية")</label>
                            <select asp-for="DefaultLanguage" class="form-select"><option value="ar">العربية</option><option value="en">English</option></select>
                        </div>
                        break;

                    case SetupWizardSteps.CalendarType:
                        <div class="mb-3">
                            <label class="form-label d-block">@T("Calendar type", "نوع التقويم")</label>
                            @foreach (var c in SettingKeys.CalendarTypes)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="CalendarType" value="@c" id="cal-@c" />
                                    <label class="form-check-label" for="cal-@c">@(c == "Gregorian" ? T("Gregorian", "ميلادي") : c == "Hijri" ? T("Hijri", "هجري") : T("Both (dual display)", "كلاهما (عرض مزدوج)"))</label>
                                </div>
                            }
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="HijriDisplay" />
                            <label class="form-check-label" asp-for="HijriDisplay">@T("Show Hijri dates alongside Gregorian", "عرض التاريخ الهجري بجانب الميلادي")</label>
                        </div>
                        break;

                    case SetupWizardSteps.NumberingSeries:
                        <p class="text-muted small">@T("The doc 08 catalog ships with the product; confirm the series below exist for this school (E-006 registry manages formats and cutovers).", "كتالوج الوثيقة 08 يأتي مع المنتج؛ تأكد من وجود السلاسل أدناه لهذه المدرسة (سجل E-006 يدير الصيغ والتحويل).")</p>
                        @if (Model.NumberingSeriesCount == 0)
                        {
                            <div class="alert alert-warning small">@T("No numbering series exist yet — run the product seeder (doc 08 §4 catalog).", "لا توجد سلاسل ترقيم بعد — شغّل بيانات المنتج (كتالوج الوثيقة 08 §4).")</div>
                        }
                        else
                        {
                            <div class="table-responsive"><table class="table table-sm sms-table mb-3">
                                <caption class="visually-hidden">@T("Numbering series", "سلاسل الترقيم")</caption>
                                <thead><tr><th scope="col">@T("Code", "الرمز")</th><th scope="col">@T("Entity", "الكيان")</th><th scope="col">@T("Format", "الصيغة")</th></tr></thead>
                                <tbody>@foreach (var s in Model.NumberingSeries) { <tr><td><code>@s.Code</code></td><td>@s.Entity</td><td dir="ltr"><code>@s.Format</code></td></tr> }</tbody>
                            </table></div>
                        }
                        break;

                    case SetupWizardSteps.StageStructure:
                        <p class="text-muted small">@T("Define at least one stage and one grade. The full ladder (promotion targets, grade-year profiles) is Module 05.", "عرّف مرحلة واحدة وصفاً واحداً على الأقل. السلم الكامل (أهداف الترفيع، ملفات الصف السنوية) في الوحدة 05.")</p>
                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 small text-muted">@T("New stage (optional)", "مرحلة جديدة (اختياري)")</legend>
                            <div class="row g-3">
                                <div class="col-md-5"><label class="form-label" asp-for="StageNameAr">@T("Name (Arabic)", "الاسم (عربي)")</label><input asp-for="StageNameAr" class="form-control" dir="rtl" /></div>
                                <div class="col-md-5"><label class="form-label" asp-for="StageNameEn">@T("Name (English)", "الاسم (إنجليزي)")</label><input asp-for="StageNameEn" class="form-control" dir="ltr" /></div>
                                <div class="col-md-2"><label class="form-label" asp-for="StageOrder">@T("Order", "الترتيب")</label><input asp-for="StageOrder" class="form-control" type="number" min="1" /></div>
                            </div>
                        </fieldset>
                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 small text-muted">@T("New grade (optional)", "صف جديد (اختياري)")</legend>
                            <div class="row g-3">
                                <div class="col-md-3"><label class="form-label" asp-for="ExistingStageId">@T("Stage", "المرحلة")</label>
                                    <select asp-for="ExistingStageId" class="form-select"><option value="">@T("— the new stage above —", "— المرحلة الجديدة أعلاه —")</option>@foreach (var s in Model.StageOptions) { <option value="@s.Id">@(isRtl ? s.Ar : s.En)</option> }</select></div>
                                <div class="col-md-2"><label class="form-label" asp-for="GradeCode">@T("Code", "الرمز")</label><input asp-for="GradeCode" class="form-control" dir="ltr" placeholder="G1" /></div>
                                <div class="col-md-2"><label class="form-label" asp-for="GradeNameAr">@T("Name (Arabic)", "الاسم (عربي)")</label><input asp-for="GradeNameAr" class="form-control" dir="rtl" /></div>
                                <div class="col-md-3"><label class="form-label" asp-for="GradeNameEn">@T("Name (English)", "الاسم (إنجليزي)")</label><input asp-for="GradeNameEn" class="form-control" dir="ltr" /></div>
                                <div class="col-md-2"><label class="form-label" asp-for="GradeOrder">@T("Order", "الترتيب")</label><input asp-for="GradeOrder" class="form-control" type="number" min="1" /></div>
                            </div>
                        </fieldset>
                        break;
                }

                <div class="mb-3">
                    <label class="form-label" asp-for="Notes">@T("Note (optional)", "ملاحظة (اختياري)")</label>
                    <input asp-for="Notes" class="form-control" maxlength="500" />
                </div>

                @* Two saves, because a step that defines rows and a step that sets one value are
                   finished at different moments. "Continue" always moves forward by one step —
                   it used to jump to the first step still incomplete anywhere in the list. *@
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    @if (Model.PreviousStepCode != null)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Step" asp-route-code="@Model.PreviousStepCode">
                            <i class="bi bi-arrow-@(isRtl ? "right" : "left") me-1" aria-hidden="true"></i>@T("Previous", "السابقة")
                        </a>
                    }
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1" aria-hidden="true"></i>@(Model.NextStepCode == null ? T("Save & finish", "حفظ وإنهاء") : T("Save & continue", "حفظ ومتابعة"))
                    </button>
                    @if (Model.IsRowStep)
                    {
                        <button type="submit" name="AddAnother" value="true" class="btn btn-outline-primary">
                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("Save & add another", "حفظ وإضافة آخر")
                        </button>
                    }
                    <a class="btn btn-link text-decoration-none" asp-action="Index">@T("Back to wizard", "العودة للمعالج")</a>
                    @if (Model.NextStepCode != null)
                    {
                        <a class="ms-auto small" asp-action="Step" asp-route-code="@Model.NextStepCode">@T("Skip without saving", "التخطي دون حفظ") @(isRtl ? "←" : "→")</a>
                    }
                </div>
                @if (done)
                {
                    <p class="text-muted small mt-2 mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@T("This step is already complete. Saving again updates it and keeps it green.", "هذه الخطوة مكتملة بالفعل. والحفظ مجدداً يحدّثها ويُبقيها خضراء.")</p>
                }
            </form>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="sms-card p-4">
            <h2 class="h6 text-muted">@T("Steps", "الخطوات")</h2>
            <ol class="list-unstyled small mb-0">
                @foreach (var s in Model.AllStates)
                {
                    var isHere = s.Step.Code == step.Code;
                    var isDone = s.Status == SetupStepStatus.Completed;
                    <li class="d-flex align-items-center gap-2 py-1 @(isHere ? "fw-semibold" : "")">
                        @if (isDone)
                        {
                            <i class="bi bi-check-circle-fill text-success" aria-hidden="true"></i>
                            <span class="visually-hidden">@T("Completed", "مكتملة")</span>
                        }
                        else
                        {
                            <i class="bi bi-circle text-muted" aria-hidden="true"></i>
                            <span class="visually-hidden">@T("Not completed", "غير مكتملة")</span>
                        }
                        <a asp-action="Step" asp-route-code="@s.Step.Code" class="sms-inline-link p-0" aria-current="@(isHere ? "step" : null)">@(isRtl ? s.Step.TitleAr : s.Step.TitleEn)</a>
                        @if (!s.Step.IsMandatory) { <span class="badge text-bg-light border">@T("optional", "اختيارية")</span> }
                    </li>
                }
            </ol>
        </div>
    </div>
</div>
