@using System.Globalization
@using Sms.Domain.Lookups
@model LookupsViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Lookup lists", "القوائم المرجعية");
    ViewData["Breadcrumb"] = T("System Setup / Lookup lists", "إعداد النظام / القوائم المرجعية");
    var readOnly = Model.Selected?.Tier == LookupCategoryTier.ProductSeeded;
    var help = SetupHelp.Lookups(isRtl);
}

<div class="sms-page-head">
    <div>
        <h1 class="sms-page-title">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">@T("Two tiers (BR-SET-001): product-seeded lists are read-only for schools; school-managed lists are yours. Values are deactivated, never deleted (BR-SET-002).", "مستويان (BR-SET-001): القوائم المزوَّدة من المنتج للقراءة فقط؛ وقوائم المدرسة تخصكم. القيم تُعطَّل ولا تُحذف (BR-SET-002).")</p>
    </div>
    <partial name="_HelpModal" model="help" />
</div>
<partial name="_SetupNav" />

<div class="row g-3">
    <div class="col-lg-3">
        <div class="sms-card">
            <div class="p-2 border-bottom small text-muted fw-semibold">@T("Categories", "الفئات")</div>
            <div class="list-group list-group-flush">
                @foreach (var c in Model.Categories)
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(c.Id == Model.Selected?.Id ? "active" : "")" aria-current="@(c.Id == Model.Selected?.Id ? "true" : null)" asp-action="Lookups" asp-route-category="@c.Code">
                        <span>@(isRtl ? c.Name.NameAr : c.Name.NameEn)<br /><code class="small">@c.Code</code></span>
                        <span class="badge rounded-pill @(c.Tier == LookupCategoryTier.ProductSeeded ? "text-bg-light border" : "text-bg-primary")" title="@(c.Tier == LookupCategoryTier.ProductSeeded ? T("Product-seeded — read only (BR-SET-001)", "مزوَّدة من المنتج — للقراءة فقط (BR-SET-001)") : T("School-managed — you add and deactivate the values", "تديرها المدرسة — أنتم من يضيف القيم ويعطّلها"))">@(c.Tier == LookupCategoryTier.ProductSeeded ? T("product", "منتج") : T("school", "مدرسة"))</span>
                    </a>
                }
            </div>
            <form method="post" asp-action="DefineLookupCategory" class="p-3 border-top">
                <div class="small fw-semibold mb-2">@T("New school-managed category", "فئة جديدة تديرها المدرسة")</div>
                <input name="NewCategoryCode" id="new-category-code" class="form-control form-control-sm mb-1" placeholder="@T("Code", "الرمز")" aria-label="@T("New category code", "رمز الفئة الجديدة")" dir="ltr" />
                <input name="NewCategoryAr" id="new-category-ar" class="form-control form-control-sm mb-1" placeholder="@T("Arabic name", "الاسم بالعربية")" aria-label="@T("New category Arabic name", "اسم الفئة الجديدة بالعربية")" dir="rtl" />
                <input name="NewCategoryEn" id="new-category-en" class="form-control form-control-sm mb-2" placeholder="@T("English name", "الاسم بالإنجليزية")" aria-label="@T("New category English name", "اسم الفئة الجديدة بالإنجليزية")" dir="ltr" />
                <button class="btn btn-sm btn-outline-primary w-100" type="submit">@T("Create", "إنشاء")</button>
            </form>
        </div>
    </div>
    <div class="col-lg-9">
        @if (Model.Selected != null)
        {
            <div class="sms-card">
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
                    <h2 class="h6 mb-0">@(isRtl ? Model.Selected.Name.NameAr : Model.Selected.Name.NameEn) <code class="small text-muted">@Model.Selected.Code</code></h2>
                    @if (readOnly && Model.Selected.Code == "Nationality") { <a class="btn btn-sm btn-outline-primary" asp-action="Nationalities"><i class="bi bi-pencil me-1" aria-hidden="true"></i>@T("Edit on the Nationalities screen", "التعديل من شاشة الجنسيات")</a> }
                    else if (readOnly) { <span class="badge text-bg-light border"><i class="bi bi-lock me-1" aria-hidden="true"></i>@T("Product-seeded — read only", "مزوَّدة من المنتج — للقراءة فقط")</span> }
                </div>
                <div class="table-responsive"><table class="table sms-table mb-0">
                    <caption class="visually-hidden">@T("Lookup values", "قيم القائمة")</caption>
                    <thead><tr><th scope="col">#</th><th scope="col">@T("Code", "الرمز")</th><th scope="col">@T("Arabic", "عربي")</th><th scope="col">@T("English", "إنجليزي")</th><th scope="col">@T("Active", "فعّال")</th><th scope="col"></th></tr></thead>
                    <tbody>
                    @foreach (var v in Model.Values)
                    {
                        @* A product-seeded row is a statement; a school-managed one is a form.
                           The grid could only append and deactivate, so a misspelling could be
                           retired but never fixed — and the school's list then carried both. *@
                        if (readOnly)
                        {
                            // The product-seeded lists are the heavily referenced ones — a nationality
                            // or an ID type is held by half the register — so the count belongs here
                            // too, even though nothing on this row can retire it.
                            var readOnlyUses = Model.Usage.TryGetValue(v.Id, out var ru) ? ru : Array.Empty<Sms.Application.Lookups.LookupUsage>();
                            var readOnlyTotal = readOnlyUses.Sum(x => x.Count);
                            <tr class="@(v.IsActive ? "" : "text-muted")">
                                <td>@v.SortOrder</td><td><code>@v.Code</code></td><td dir="rtl">@v.Name.NameAr</td><td dir="ltr">@v.Name.NameEn</td>
                                <td><span aria-hidden="true">@(v.IsActive ? "✓" : "—")</span><span class="visually-hidden">@(v.IsActive ? T("Active", "فعّال") : T("Inactive", "معطَّل"))</span></td>
                                <td>
                                    @if (readOnlyTotal > 0)
                                    {
                                        <span class="badge text-bg-light border text-nowrap" title="@LookupUsageLabels.Summarize(readOnlyUses, isRtl)">
                                            <i class="bi bi-link-45deg me-1" aria-hidden="true"></i>@readOnlyTotal
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="@(v.IsActive ? "" : "table-light text-muted")">
                                <td colspan="6" class="py-1">
                                    <div class="row g-1 align-items-center">
                                        <form method="post" asp-action="UpdateLookupValue" asp-route-id="@v.Id" class="col d-flex gap-1 align-items-center mb-0">
                                            <input type="hidden" name="category" value="@Model.Selected.Code" />
                                            <input name="sortOrder" value="@v.SortOrder" type="number" min="0" class="form-control form-control-sm" style="width:4.5rem" aria-label="@T("Sort order", "الترتيب")" />
                                            <code class="small text-nowrap" style="width:7rem" title="@T("The code is the identity — rows elsewhere point at it (BR-SET-002)", "الرمز هو الهوية — سجلات أخرى تشير إليه (BR-SET-002)")">@v.Code</code>
                                            <input name="nameAr" value="@v.Name.NameAr" dir="rtl" class="form-control form-control-sm" aria-label="@T("Arabic name", "الاسم بالعربية")" />
                                            <input name="nameEn" value="@v.Name.NameEn" dir="ltr" class="form-control form-control-sm" aria-label="@T("English name", "الاسم بالإنجليزية")" />
                                            <button class="btn btn-sm btn-outline-primary text-nowrap" type="submit" title="@T("Save this value", "حفظ هذه القيمة")"><i class="bi bi-check2" aria-hidden="true"></i></button>
                                        </form>
                                        <div class="col-auto d-flex gap-1 align-items-center">
                                            @{
                                                // doc §9: what already points at this value, said before the
                                                // click rather than discovered after it.
                                                var uses = Model.Usage.TryGetValue(v.Id, out var u) ? u : Array.Empty<Sms.Application.Lookups.LookupUsage>();
                                                var total = uses.Sum(x => x.Count);
                                                var summary = LookupUsageLabels.Summarize(uses, isRtl);
                                            }
                                            @if (total > 0)
                                            {
                                                <span class="badge @(v.IsActive ? "text-bg-light border" : "text-bg-secondary") text-nowrap" title="@summary">
                                                    <i class="bi bi-link-45deg me-1" aria-hidden="true"></i>@total
                                                </span>
                                            }
                                            @if (v.IsActive)
                                            {
                                                var confirmText = total == 0
                                                    ? T("Deactivate this value? Nothing refers to it, so nothing will change except that it stops being offered.", "إلغاء تفعيل هذه القيمة؟ لا شيء يشير إليها، فلن يتغير سوى أنها تتوقف عن الظهور في الخيارات.")
                                                    : T($"Deactivate this value? {summary} already refer to it. Those records keep it — it only stops being offered to new ones (BR-SET-002).",
                                                        $"إلغاء تفعيل هذه القيمة؟ يشير إليها بالفعل: {summary}. وتلك السجلات تحتفظ بها — وإنما تتوقف عن الظهور للسجلات الجديدة (BR-SET-002).");
                                                <form method="post" asp-action="DeactivateLookupValue" class="mb-0" onsubmit="return confirm('@Html.Raw(confirmText.Replace("'", "\\'"))');">
                                                    <input type="hidden" name="id" value="@v.Id" /><input type="hidden" name="category" value="@Model.Selected.Code" />
                                                    <button class="btn btn-sm btn-outline-danger text-nowrap" type="submit">@T("Deactivate", "إلغاء التفعيل")</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" asp-action="ActivateLookupValue" class="mb-0">
                                                    <input type="hidden" name="id" value="@v.Id" /><input type="hidden" name="category" value="@Model.Selected.Code" />
                                                    <button class="btn btn-sm btn-outline-success text-nowrap" type="submit"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>@T("Reactivate", "إعادة التفعيل")</button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    @if (Model.Values.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">@T("This list has no values yet. Add the first one below — both languages are required.", "لا قيم في هذه القائمة بعد. أضِف الأولى أدناه — واللغتان مطلوبتان.")</td></tr>
                    }
                    </tbody>
                </table></div>
                @if (!readOnly)
                {
                    <form method="post" asp-action="DefineLookupValue" asp-route-category="@Model.Selected.Code" class="p-3 border-top">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-2"><label class="form-label small" for="new-value-code">@T("Code", "الرمز")</label><input name="Code" id="new-value-code" class="form-control form-control-sm" dir="ltr" /></div>
                            <div class="col-md-4"><label class="form-label small" for="new-value-ar">@T("Arabic name", "الاسم بالعربية")</label><input name="NameAr" id="new-value-ar" class="form-control form-control-sm" dir="rtl" /></div>
                            <div class="col-md-3"><label class="form-label small" for="new-value-en">@T("English name", "الاسم بالإنجليزية")</label><input name="NameEn" id="new-value-en" class="form-control form-control-sm" dir="ltr" /></div>
                            <div class="col-md-1"><label class="form-label small" for="new-value-sort">#</label><input name="SortOrder" id="new-value-sort" class="form-control form-control-sm" type="number" value="@Model.SortOrder" aria-label="@T("Sort order", "الترتيب")" /></div>
                            <div class="col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("Add", "إضافة")</button></div>
                        </div>
                    </form>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">@T("No lookup categories yet.", "لا توجد فئات بعد.")</div>
        }
    </div>
</div>
