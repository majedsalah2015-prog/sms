@using System.Globalization
@using Sms.Application.Setup
@model SettingsHubViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Settings hub", "مركز الإعدادات");
    ViewData["Breadcrumb"] = T("System Setup / Settings hub", "إعداد النظام / مركز الإعدادات");
    var groups = new (string Key, string En, string Ar)[] { ("Regional", "Regional", "إقليمي"), ("Financial", "Financial", "مالي"), ("Languages", "Languages", "اللغات"), ("Portal", "Portal", "البوابة") };
    string YearLabel(int? id) => id == null ? T("School default", "افتراضي المدرسة") : (Model.Years.FirstOrDefault(y => y.Id == id) is { } y ? (isRtl ? y.LabelAr : y.LabelEn) : id.ToString()!);
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Year-versionable keys keep history per academic year (BR-SET-005); every change is T1-audited and edits need a reason (BR-SET-007).", "المفاتيح القابلة للإصدار السنوي تحفظ تاريخاً لكل عام دراسي (BR-SET-005)؛ كل تغيير مدقَّق T1 والتعديلات تتطلب سبباً (BR-SET-007).")</p></div><partial name="_HelpModal" model="SetupHelp.Settings(isRtl)" /></div>
<partial name="_SetupNav" />

<ul class="nav nav-tabs mb-3">
    @foreach (var g in groups) { <li class="nav-item"><a class="nav-link @(Model.ActiveGroup == g.Key ? "active" : "")" asp-action="Settings" asp-route-group="@g.Key">@(isRtl ? g.Ar : g.En)</a></li> }
    <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Index" asp-route-code="NTF">@T("Notifications defaults", "افتراضيات الإشعارات") <i class="bi bi-box-arrow-up-right small" aria-hidden="true"></i></a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Index" asp-route-code="SYS">@T("Numbering", "الترقيم") <i class="bi bi-box-arrow-up-right small" aria-hidden="true"></i></a></li>
</ul>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="sms-card">
            <div class="table-responsive"><table class="table sms-table mb-0">
                <caption class="visually-hidden">@T("Settings", "الإعدادات")</caption>
                <thead><tr><th scope="col">@T("Setting", "الإعداد")</th><th scope="col">@T("Value", "القيمة")</th><th scope="col">@T("Scope", "النطاق")</th><th scope="col"></th></tr></thead>
                <tbody>
                @foreach (var d in Model.Definitions.Where(x => x.Group == Model.ActiveGroup))
                {
                    var rows = Model.Rows.Where(r => r.Key == d.Key).OrderBy(r => r.AcademicYearId.HasValue).ThenBy(r => r.AcademicYearId).ToList();
                    if (rows.Count == 0)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@SettingLabels.Name(d.Key, isRtl)@if (d.YearVersionable) { <span class="badge text-bg-light border ms-1">@T("per-year", "سنوي")</span> }</div>
                                <code class="small text-muted" dir="ltr">@d.Key</code>
                                @if (SettingLabels.Hint(d.Key, isRtl) is { } hint) { <div class="form-text mt-0">@hint</div> }
                            </td>
                            <td class="text-muted">—</td><td class="text-muted small">@T("not set", "غير محدد")</td>
                            <td class="text-end"><a class="small" asp-action="Settings" asp-route-group="@Model.ActiveGroup" asp-fragment="edit" asp-route-key="@d.Key">@T("Set", "تحديد")</a></td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in rows)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@SettingLabels.Name(d.Key, isRtl)@if (d.YearVersionable) { <span class="badge text-bg-light border ms-1">@T("per-year", "سنوي")</span> }</div>
                                    <code class="small text-muted" dir="ltr">@d.Key</code>
                                    @if (SettingLabels.Hint(d.Key, isRtl) is { } hint) { <div class="form-text mt-0">@hint</div> }
                                </td>
                                @* The reader's form first, the stored form beneath it: an administrator
                                   editing this has to know that "نعم" is the word "true" in the box. *@
                                <td>
                                    <div>@SettingLabels.Value(d.Key, r.Value, isRtl)</div>
                                    @if (SettingLabels.IsTranslated(d.Key)) { <code class="small text-muted" dir="ltr">@r.Value</code> }
                                </td>
                                <td class="small">@YearLabel(r.AcademicYearId)</td>
                                <td class="text-end"><a class="small" asp-action="Settings" asp-route-group="@Model.ActiveGroup" asp-route-key="@d.Key" asp-route-year="@r.AcademicYearId" asp-fragment="edit">@T("Edit", "تعديل")</a></td>
                            </tr>
                        }
                    }
                }
                </tbody>
            </table></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="sms-card p-4" id="edit">
            <h2 class="h6">@T("Set a value", "تحديد قيمة")</h2>
            <form method="post" asp-action="Settings">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
                <div class="mb-2"><label class="form-label" for="setting-key">@T("Key", "المفتاح")</label>
                    <select name="Key" id="setting-key" class="form-select">
                        @foreach (var d in Model.Definitions.Where(x => x.Group == Model.ActiveGroup)) { <option value="@d.Key" selected="@(d.Key == (Model.Key ?? Context.Request.Query["key"].ToString()))">@SettingLabels.Name(d.Key, isRtl) — @d.Key</option> }
                    </select></div>
                @* The value is stored in the form the engine validates — English words, "true",
                   day names. Offering that list is the difference between an administrator choosing
                   a value and guessing one, so the accepted values are listed with what each means. *@
                <div class="mb-2"><label class="form-label" for="setting-value">@T("Value", "القيمة")</label>
                    <input name="Value" id="setting-value" class="form-control" dir="ltr" list="setting-options" value="@Model.Value" />
                    <datalist id="setting-options"></datalist>
                    <div class="form-text" id="setting-help"></div>
                </div>
                <div class="mb-2"><label class="form-label" for="setting-year">@T("Academic year (per-year keys only)", "العام الدراسي (للمفاتيح السنوية فقط)")</label>
                    <select name="AcademicYearId" id="setting-year" class="form-select"><option value="">@T("School default", "افتراضي المدرسة")</option>@foreach (var y in Model.Years) { <option value="@y.Id" selected="@(y.Id.ToString() == Context.Request.Query["year"].ToString())">@(isRtl ? y.LabelAr : y.LabelEn) · @Labels.YearStatus(y.Status, isRtl)</option> }</select></div>
                <div class="mb-3"><label class="form-label" for="setting-reason">@T("Reason (required when editing an existing value)", "السبب (مطلوب عند تعديل قيمة قائمة)")</label><input name="Reason" id="setting-reason" class="form-control" value="@Model.Reason" /></div>
                <button class="btn btn-primary w-100" type="submit"><i class="bi bi-save me-1" aria-hidden="true"></i>@T("Save", "حفظ")</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var key = document.getElementById('setting-key');
    var options = document.getElementById('setting-options');
    var help = document.getElementById('setting-help');
    if (!key || !options || !help) { return; }

    // key -> { options: [raw...], labels: {raw: reader's word}, hint: "" }
    var CATALOGUE = @Html.Raw(Json.Serialize(
        Model.Definitions.Where(x => x.Group == Model.ActiveGroup).ToDictionary(
            d => d.Key,
            d => new
            {
                options = SettingLabels.Options(d.Key),
                labels = SettingLabels.Options(d.Key).ToDictionary(o => o, o => SettingLabels.Value(d.Key, o, isRtl)),
                hint = SettingLabels.Hint(d.Key, isRtl),
            })));

    function render() {
        var entry = CATALOGUE[key.value] || { options: [], labels: {}, hint: null };
        options.innerHTML = '';
        entry.options.forEach(function (raw) {
            var option = document.createElement('option');
            option.value = raw;
            option.label = entry.labels[raw] || raw;
            options.appendChild(option);
        });

        var accepted = entry.options.length
            ? @Html.Raw(Json.Serialize(T("Accepted:", "المقبول:"))) + ' ' +
              entry.options.map(function (raw) { return (entry.labels[raw] || raw) + ' (' + raw + ')'; }).join(' · ')
            : '';
        help.textContent = [entry.hint, accepted].filter(Boolean).join(' — ');
    }

    key.addEventListener('change', render);
    render();
})();
</script>
}
