@using System.Globalization
@using Sms.Application.Common.Exceptions
@model ResidenceCatalogViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Residence areas", "مناطق السكن");
    ViewData["Breadcrumb"] = T("System Setup / Residence areas", "إعداد النظام / مناطق السكن");

    var gid = Model.SelectedGovernorateId;
    var lid = Model.SelectedLocalityId;
    var selectedGovernorate = Model.Governorates.FirstOrDefault(g => g.Id == gid);
    var selectedLocality = Model.Localities.FirstOrDefault(a => a.Id == lid);
    string Name(Sms.Domain.Common.LocalizedName n) => isRtl ? n.NameAr : n.NameEn;

    var help = new HelpPanelViewModel
    {
        Id = "res-help",
        Title = T("Residence areas — help", "مناطق السكن — مساعدة"),
        Intro = T("These three lists are what a student's and a guardian's address is chosen from: governorate → locality → quarter.", "هذه القوائم الثلاث هي ما يُختار منه عنوان الطالب ووليّ الأمر: المحافظة ← المنطقة ← الحي."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("The three columns", "الأعمدة الثلاثة"), T("Pick a governorate to see its localities, and a locality to see its quarters. A locality with no quarters is normal — there, the locality is the whole address.", "اختر محافظة لترى مناطقها، واختر منطقة لترى أحياءها. والمنطقة بلا أحياء أمر معتاد — فهي عندئذٍ العنوان كله.")),
            new HelpPanelViewModel.Item(T("Add", "إضافة"), T("Use the form at the foot of each column. Leave the code empty and one is generated from the English name; the code is the stable key and cannot be changed afterwards.", "استخدم النموذج أسفل كل عمود. اترك الرمز فارغاً ليُولَّد من الاسم الإنجليزي؛ والرمز مفتاح ثابت لا يُغيَّر بعد الإضافة.")),
            new HelpPanelViewModel.Item(T("Edit", "تعديل"), T("Correct the Arabic or English name, or the order, in the row itself and press Save. Every address already recorded keeps pointing at the same row.", "صحّح الاسم العربي أو الإنجليزي أو الترتيب في الصف نفسه ثم اضغط حفظ. وتبقى كل العناوين المسجَّلة مشيرةً إلى الصف نفسه.")),
            new HelpPanelViewModel.Item(T("Deactivate", "إلغاء التفعيل"), T("Nothing here is deleted (BR-SET-002). A deactivated row leaves the address pickers and stays readable on every record that names it — the count beside it says how many those are — and the button puts it back.", "لا يُحذف شيء هنا (BR-SET-002). الصف المعطَّل يخرج من قوائم اختيار العناوين ويبقى مقروءاً في كل سجل يذكره — والعدد بجانبه يبيّن كم هي — والزر يعيده.")),
            new HelpPanelViewModel.Item(T("Where a row is not moved", "ما لا يُنقل"), T("A locality is not moved to another governorate, nor a quarter to another locality: the parent is what gives it its meaning, and moving it would rewrite the address of everyone recorded under it. Add it where it belongs and retire the one in the wrong place.", "لا تُنقل منطقة إلى محافظة أخرى، ولا حيّ إلى منطقة أخرى: الأصل هو ما يعطيها معناها، ونقلها يعيد كتابة عنوان كل من سُجِّل تحتها. أضِفها في موضعها الصحيح وعطِّل التي في الموضع الخطأ.")),
        },
    };
}

<div class="sms-page-head">
    <div>
        <h1 class="sms-page-title">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">@Model.Governorates.Count(g => g.IsActive) @T("governorates", "محافظة") · @Model.Localities.Count(a => a.IsActive) @T("localities here", "منطقة هنا") · @Model.Quarters.Count(n => n.IsActive) @T("quarters", "حي")</p>
    </div>
    <div class="d-flex gap-2"><partial name="_HelpModal" model="help" /></div>
</div>
<partial name="_SetupNav" />

<div class="row g-3">

    @* ------------------------------------------------------- المحافظات *@
    <div class="col-lg-4">
        <div class="sms-card h-100">
            <div class="p-3 border-bottom"><span class="fw-semibold"><i class="bi bi-map me-1" aria-hidden="true"></i>@T("Governorates", "المحافظات")</span></div>
            <div class="table-responsive"><table class="table table-sm sms-table mb-0 align-middle">
                <caption class="visually-hidden">@T("Governorates", "المحافظات")</caption>
                <thead><tr><th scope="col" style="width:4rem">#</th><th scope="col">@T("Arabic name", "الاسم بالعربية")</th><th scope="col">@T("English name", "الاسم بالإنجليزية")</th><th scope="col" class="text-end"></th></tr></thead>
                <tbody>
                @foreach (var g in Model.Governorates)
                {
                    var fid = $"gov-{g.Id}";
                    <tr class="@(g.Id == gid ? "table-active" : "") @(g.IsActive ? "" : "text-muted")">
                        <td><input form="@fid" name="sortOrder" type="number" class="form-control form-control-sm" value="@g.SortOrder" aria-label="@T($"Sort order — {g.Code}", $"الترتيب — {g.Code}")" /></td>
                        <td><input form="@fid" name="nameAr" class="form-control form-control-sm" dir="rtl" value="@g.Name.NameAr" required aria-label="@T($"Arabic name — {g.Code}", $"الاسم بالعربية — {g.Code}")" />
                            @if (!g.IsActive) { <span class="badge text-bg-secondary mt-1">@T("inactive", "معطَّلة")</span> }
                        </td>
                        <td><input form="@fid" name="nameEn" class="form-control form-control-sm" dir="ltr" value="@g.Name.NameEn" required aria-label="@T($"English name — {g.Code}", $"الاسم بالإنجليزية — {g.Code}")" /></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm @(g.Id == gid ? "btn-primary" : "btn-outline-secondary")" asp-action="Residence" asp-route-governorateId="@g.Id" title="@T("Show its localities", "عرض مناطقها")" aria-label="@T($"Show the localities of {Name(g.Name)}", $"عرض مناطق {Name(g.Name)}")"><i class="bi bi-chevron-@(isRtl ? "left" : "right")" aria-hidden="true"></i></a>
                            <form id="@fid" method="post" asp-action="UpdateResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="d-inline">
                                <input type="hidden" name="level" value="@ResidenceLevel.Governorate" /><input type="hidden" name="id" value="@g.Id" />
                                <button class="btn btn-sm btn-outline-primary" type="submit" title="@T("Save changes", "حفظ التعديلات")" aria-label="@T($"Save {Name(g.Name)}", $"حفظ {Name(g.Name)}")"><i class="bi bi-check-lg" aria-hidden="true"></i></button>
                            </form>
                            @if (g.IsActive)
                            {
                                <form method="post" asp-action="DeactivateResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="d-inline" onsubmit="return confirm('@T("Take this governorate out of the address lists? Records that name it still read.", "إخراج هذه المحافظة من قوائم العناوين؟ تبقى السجلات التي تذكرها مقروءة.")');">
                                    <input type="hidden" name="level" value="@ResidenceLevel.Governorate" /><input type="hidden" name="id" value="@g.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="@T("Deactivate", "إلغاء التفعيل")" aria-label="@T($"Deactivate {Name(g.Name)}", $"إلغاء تفعيل {Name(g.Name)}")"><i class="bi bi-slash-circle" aria-hidden="true"></i></button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="ActivateResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="d-inline">
                                    <input type="hidden" name="level" value="@ResidenceLevel.Governorate" /><input type="hidden" name="id" value="@g.Id" />
                                    <button class="btn btn-sm btn-outline-success" type="submit" title="@T("Reactivate", "إعادة التفعيل")" aria-label="@T($"Reactivate {Name(g.Name)}", $"إعادة تفعيل {Name(g.Name)}")"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Governorates.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">@T("No governorates yet — add the first one below.", "لا توجد محافظات بعد — أضف الأولى أدناه.")</td></tr> }
                </tbody>
            </table></div>
            <form method="post" asp-action="AddResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="p-3 border-top">
                <input type="hidden" name="level" value="@ResidenceLevel.Governorate" />
                <div class="small fw-semibold mb-2"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("Add governorate", "إضافة محافظة")</div>
                <div class="row g-2 align-items-end">
                    <div class="col-6"><label class="form-label small" for="NewGovAr">@T("Arabic name", "الاسم بالعربية")</label><input id="NewGovAr" name="nameAr" class="form-control form-control-sm" dir="rtl" required /></div>
                    <div class="col-6"><label class="form-label small" for="NewGovEn">@T("English name", "الاسم بالإنجليزية")</label><input id="NewGovEn" name="nameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#NewGovAr" required /></div>
                    <div class="col-6"><label class="form-label small" for="NewGovCode">@T("Code (optional)", "الرمز (اختياري)")</label><input id="NewGovCode" name="code" class="form-control form-control-sm" dir="ltr" maxlength="20" /></div>
                    <div class="col-3"><label class="form-label small" for="NewGovSort">#</label><input id="NewGovSort" name="sortOrder" type="number" class="form-control form-control-sm" value="@Model.NextGovernorateSort" /></div>
                    <div class="col-3"><button class="btn btn-sm btn-primary w-100" type="submit">@T("Add", "إضافة")</button></div>
                </div>
            </form>
        </div>
    </div>

    @* ------------------------------------------------------- المناطق *@
    <div class="col-lg-4">
        <div class="sms-card h-100">
            <div class="p-3 border-bottom">
                <span class="fw-semibold"><i class="bi bi-signpost-2 me-1" aria-hidden="true"></i>@T("Localities", "المناطق")</span>
                <span class="text-muted small ms-1">@(selectedGovernorate == null ? T("— choose a governorate", "— اختر محافظة") : Name(selectedGovernorate.Name))</span>
            </div>
            @if (selectedGovernorate == null)
            {
                <p class="text-muted text-center py-4 mb-0">@T("Choose a governorate on the left to see and add its localities.", "اختر محافظة لعرض مناطقها وإضافة غيرها.")</p>
            }
            else
            {
                <div class="table-responsive"><table class="table table-sm sms-table mb-0 align-middle">
                    <caption class="visually-hidden">@T("Localities", "المناطق")</caption>
                    <thead><tr><th scope="col" style="width:4rem">#</th><th scope="col">@T("Arabic name", "الاسم بالعربية")</th><th scope="col">@T("English name", "الاسم بالإنجليزية")</th><th scope="col" style="width:4rem" title="@T("People recorded here", "المسجَّلون هنا")"><i class="bi bi-people" aria-hidden="true"></i><span class="visually-hidden">@T("People recorded here", "المسجَّلون هنا")</span></th><th scope="col" class="text-end"></th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.Localities)
                    {
                        var fid = $"loc-{a.Id}";
                        var used = Model.LocalityUsage.TryGetValue(a.Id, out var n) ? n : 0;
                        <tr class="@(a.Id == lid ? "table-active" : "") @(a.IsActive ? "" : "text-muted")">
                            <td><input form="@fid" name="sortOrder" type="number" class="form-control form-control-sm" value="@a.SortOrder" aria-label="@T($"Sort order — {a.Code}", $"الترتيب — {a.Code}")" /></td>
                            <td><input form="@fid" name="nameAr" class="form-control form-control-sm" dir="rtl" value="@a.Name.NameAr" required aria-label="@T($"Arabic name — {a.Code}", $"الاسم بالعربية — {a.Code}")" />
                                @if (!a.IsActive) { <span class="badge text-bg-secondary mt-1">@T("inactive", "معطَّلة")</span> }
                            </td>
                            <td><input form="@fid" name="nameEn" class="form-control form-control-sm" dir="ltr" value="@a.Name.NameEn" required aria-label="@T($"English name — {a.Code}", $"الاسم بالإنجليزية — {a.Code}")" /></td>
                            <td class="text-center"><span class="badge @(used == 0 ? "text-bg-light" : "text-bg-secondary")">@used</span></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm @(a.Id == lid ? "btn-primary" : "btn-outline-secondary")" asp-action="Residence" asp-route-governorateId="@gid" asp-route-localityId="@a.Id" title="@T("Show its quarters", "عرض أحيائها")" aria-label="@T($"Show the quarters of {Name(a.Name)}", $"عرض أحياء {Name(a.Name)}")"><i class="bi bi-chevron-@(isRtl ? "left" : "right")" aria-hidden="true"></i></a>
                                <form id="@fid" method="post" asp-action="UpdateResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="d-inline">
                                    <input type="hidden" name="level" value="@ResidenceLevel.Locality" /><input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="parentId" value="@gid" />
                                    <button class="btn btn-sm btn-outline-primary" type="submit" title="@T("Save changes", "حفظ التعديلات")" aria-label="@T($"Save {Name(a.Name)}", $"حفظ {Name(a.Name)}")"><i class="bi bi-check-lg" aria-hidden="true"></i></button>
                                </form>
                                @if (a.IsActive)
                                {
                                    <form method="post" asp-action="DeactivateResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="d-inline" onsubmit="return confirm('@T($"Take this locality out of the address lists? {used} record(s) name it, and they still read.", $"إخراج هذه المنطقة من قوائم العناوين؟ يذكرها {used} سجلاً وتبقى مقروءة.")');">
                                        <input type="hidden" name="level" value="@ResidenceLevel.Locality" /><input type="hidden" name="id" value="@a.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="@T("Deactivate", "إلغاء التفعيل")" aria-label="@T($"Deactivate {Name(a.Name)}", $"إلغاء تفعيل {Name(a.Name)}")"><i class="bi bi-slash-circle" aria-hidden="true"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="ActivateResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="d-inline">
                                        <input type="hidden" name="level" value="@ResidenceLevel.Locality" /><input type="hidden" name="id" value="@a.Id" />
                                        <button class="btn btn-sm btn-outline-success" type="submit" title="@T("Reactivate", "إعادة التفعيل")" aria-label="@T($"Reactivate {Name(a.Name)}", $"إعادة تفعيل {Name(a.Name)}")"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Localities.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">@T("This governorate has no localities yet.", "لا مناطق لهذه المحافظة بعد.")</td></tr> }
                    </tbody>
                </table></div>
                <form method="post" asp-action="AddResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="p-3 border-top">
                    <input type="hidden" name="level" value="@ResidenceLevel.Locality" /><input type="hidden" name="parentId" value="@gid" />
                    <div class="small fw-semibold mb-2"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("Add locality to", "إضافة منطقة إلى") @Name(selectedGovernorate.Name)</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-6"><label class="form-label small" for="NewLocAr">@T("Arabic name", "الاسم بالعربية")</label><input id="NewLocAr" name="nameAr" class="form-control form-control-sm" dir="rtl" required /></div>
                        <div class="col-6"><label class="form-label small" for="NewLocEn">@T("English name", "الاسم بالإنجليزية")</label><input id="NewLocEn" name="nameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#NewLocAr" required /></div>
                        <div class="col-6"><label class="form-label small" for="NewLocCode">@T("Code (optional)", "الرمز (اختياري)")</label><input id="NewLocCode" name="code" class="form-control form-control-sm" dir="ltr" maxlength="20" /></div>
                        <div class="col-3"><label class="form-label small" for="NewLocSort">#</label><input id="NewLocSort" name="sortOrder" type="number" class="form-control form-control-sm" value="@Model.NextLocalitySort" /></div>
                        <div class="col-3"><button class="btn btn-sm btn-primary w-100" type="submit">@T("Add", "إضافة")</button></div>
                    </div>
                </form>
            }
        </div>
    </div>

    @* ------------------------------------------------------- الأحياء *@
    <div class="col-lg-4">
        <div class="sms-card h-100">
            <div class="p-3 border-bottom">
                <span class="fw-semibold"><i class="bi bi-house-door me-1" aria-hidden="true"></i>@T("Quarters", "الأحياء")</span>
                <span class="text-muted small ms-1">@(selectedLocality == null ? T("— choose a locality", "— اختر منطقة") : Name(selectedLocality.Name))</span>
            </div>
            @if (selectedLocality == null)
            {
                <p class="text-muted text-center py-4 mb-0">@T("Choose a locality in the middle column. Most localities have no quarters — there, the locality is the whole address.", "اختر منطقة من العمود الأوسط. ومعظم المناطق بلا أحياء — فتكون المنطقة هي العنوان كله.")</p>
            }
            else
            {
                <div class="table-responsive"><table class="table table-sm sms-table mb-0 align-middle">
                    <caption class="visually-hidden">@T("Quarters", "الأحياء")</caption>
                    <thead><tr><th scope="col" style="width:4rem">#</th><th scope="col">@T("Arabic name", "الاسم بالعربية")</th><th scope="col">@T("English name", "الاسم بالإنجليزية")</th><th scope="col" style="width:4rem" title="@T("People recorded here", "المسجَّلون هنا")"><i class="bi bi-people" aria-hidden="true"></i><span class="visually-hidden">@T("People recorded here", "المسجَّلون هنا")</span></th><th scope="col" class="text-end"></th></tr></thead>
                    <tbody>
                    @foreach (var q in Model.Quarters)
                    {
                        var fid = $"qtr-{q.Id}";
                        var used = Model.QuarterUsage.TryGetValue(q.Id, out var n) ? n : 0;
                        <tr class="@(q.IsActive ? "" : "text-muted")">
                            <td><input form="@fid" name="sortOrder" type="number" class="form-control form-control-sm" value="@q.SortOrder" aria-label="@T($"Sort order — {q.Code}", $"الترتيب — {q.Code}")" /></td>
                            <td><input form="@fid" name="nameAr" class="form-control form-control-sm" dir="rtl" value="@q.Name.NameAr" required aria-label="@T($"Arabic name — {q.Code}", $"الاسم بالعربية — {q.Code}")" />
                                @if (!q.IsActive) { <span class="badge text-bg-secondary mt-1">@T("inactive", "معطَّل")</span> }
                            </td>
                            <td><input form="@fid" name="nameEn" class="form-control form-control-sm" dir="ltr" value="@q.Name.NameEn" required aria-label="@T($"English name — {q.Code}", $"الاسم بالإنجليزية — {q.Code}")" /></td>
                            <td class="text-center"><span class="badge @(used == 0 ? "text-bg-light" : "text-bg-secondary")">@used</span></td>
                            <td class="text-end text-nowrap">
                                <form id="@fid" method="post" asp-action="UpdateResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="d-inline">
                                    <input type="hidden" name="level" value="@ResidenceLevel.Quarter" /><input type="hidden" name="id" value="@q.Id" /><input type="hidden" name="parentId" value="@lid" />
                                    <button class="btn btn-sm btn-outline-primary" type="submit" title="@T("Save changes", "حفظ التعديلات")" aria-label="@T($"Save {Name(q.Name)}", $"حفظ {Name(q.Name)}")"><i class="bi bi-check-lg" aria-hidden="true"></i></button>
                                </form>
                                @if (q.IsActive)
                                {
                                    <form method="post" asp-action="DeactivateResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="d-inline" onsubmit="return confirm('@T($"Take this quarter out of the address lists? {used} record(s) name it, and they still read.", $"إخراج هذا الحي من قوائم العناوين؟ يذكره {used} سجلاً وتبقى مقروءة.")');">
                                        <input type="hidden" name="level" value="@ResidenceLevel.Quarter" /><input type="hidden" name="id" value="@q.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="@T("Deactivate", "إلغاء التفعيل")" aria-label="@T($"Deactivate {Name(q.Name)}", $"إلغاء تفعيل {Name(q.Name)}")"><i class="bi bi-slash-circle" aria-hidden="true"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="ActivateResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="d-inline">
                                        <input type="hidden" name="level" value="@ResidenceLevel.Quarter" /><input type="hidden" name="id" value="@q.Id" />
                                        <button class="btn btn-sm btn-outline-success" type="submit" title="@T("Reactivate", "إعادة التفعيل")" aria-label="@T($"Reactivate {Name(q.Name)}", $"إعادة تفعيل {Name(q.Name)}")"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Quarters.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">@T("No quarters recorded for this locality.", "لا أحياء مسجَّلة لهذه المنطقة.")</td></tr> }
                    </tbody>
                </table></div>
                <form method="post" asp-action="AddResidenceRow" asp-route-governorateId="@gid" asp-route-localityId="@lid" class="p-3 border-top">
                    <input type="hidden" name="level" value="@ResidenceLevel.Quarter" /><input type="hidden" name="parentId" value="@lid" />
                    <div class="small fw-semibold mb-2"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("Add quarter to", "إضافة حي إلى") @Name(selectedLocality.Name)</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-6"><label class="form-label small" for="NewQtrAr">@T("Arabic name", "الاسم بالعربية")</label><input id="NewQtrAr" name="nameAr" class="form-control form-control-sm" dir="rtl" required /></div>
                        <div class="col-6"><label class="form-label small" for="NewQtrEn">@T("English name", "الاسم بالإنجليزية")</label><input id="NewQtrEn" name="nameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#NewQtrAr" required /></div>
                        <div class="col-6"><label class="form-label small" for="NewQtrCode">@T("Code (optional)", "الرمز (اختياري)")</label><input id="NewQtrCode" name="code" class="form-control form-control-sm" dir="ltr" maxlength="20" /></div>
                        <div class="col-3"><label class="form-label small" for="NewQtrSort">#</label><input id="NewQtrSort" name="sortOrder" type="number" class="form-control form-control-sm" value="@Model.NextQuarterSort" /></div>
                        <div class="col-3"><button class="btn btn-sm btn-primary w-100" type="submit">@T("Add", "إضافة")</button></div>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
