@using System.Globalization
@using Sms.Domain.Grades
@model StageEditViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Edit stage", "تعديل المرحلة");
    ViewData["Breadcrumb"] = T("Grades / Edit stage", "الصفوف / تعديل المرحلة");
    string Gender(GenderPolicy g) => g switch { GenderPolicy.Boys => T("Boys", "بنين"), GenderPolicy.Girls => T("Girls", "بنات"), _ => T("Mixed", "مختلط") };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Names, order and default gender policy. Narrowing the gender policy is refused while a grade-year profile of this stage would stop being a valid narrowing (BR-GRD-004).", "الأسماء والترتيب وسياسة الجنس الافتراضية. يُرفض تضييق سياسة الجنس إذا كان أحد ملفات الصفوف السنوية في هذه المرحلة سيصبح غير متوافق (BR-GRD-004).")</p></div></div>

<div class="sms-card p-4" style="max-width:640px">
    <form method="post" asp-action="EditStage" asp-route-id="@Model.Id" novalidate>
        <input type="hidden" asp-for="Year" />
        <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6"><label class="form-label">@T("Name (Arabic)", "الاسم (عربي)")</label><input asp-for="NameAr" class="form-control" dir="rtl" /></div>
            <div class="col-md-6"><label class="form-label">@T("Name (English)", "الاسم (إنجليزي)")</label><input asp-for="NameEn" class="form-control" dir="ltr" /></div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-4"><label class="form-label">@T("Order", "الترتيب")</label><input asp-for="Order" class="form-control" type="number" min="1" /></div>
            <div class="col-md-8"><label class="form-label">@T("Default gender policy", "سياسة الجنس الافتراضية")</label><select asp-for="Gender" class="form-select">@foreach (GenderPolicy g in Enum.GetValues(typeof(GenderPolicy))) { <option value="@g">@Gender(g)</option> }</select></div>
        </div>
        <div class="small text-muted mb-3"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@Model.GradeCount @T("grade(s) in this stage.", "صف/صفوف في هذه المرحلة.")</div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>@T("Save changes", "حفظ التعديلات")</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-year="@Model.Year">@T("Cancel", "إلغاء")</a>
    </form>
</div>
