@using System.Globalization
@using Sms.Domain.Grades
@model GradeLadderViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Grades", "الصفوف");
    ViewData["Breadcrumb"] = T("Grades / Ladder", "الصفوف / السلم الدراسي");
    string Gender(GenderPolicy g) => g switch { GenderPolicy.Boys => T("Boys", "بنين"), GenderPolicy.Girls => T("Girls", "بنات"), _ => T("Mixed", "مختلط") };
    var yid = Model.Year?.Id;
    var help = new HelpPanelViewModel
    {
        Id = "grades-help",
        Title = T("Grade ladder — help", "السلم الدراسي — مساعدة"),
        Intro = T("This screen defines the school's academic structure: stages, the grades inside each stage, how students are promoted, and the per-year profile (capacity, gender, curriculum, age rule) of every grade.", "تعرّف هذه الشاشة الهيكل الأكاديمي للمدرسة: المراحل، والصفوف داخل كل مرحلة، ومسار ترفيع الطلاب، والملف السنوي لكل صف (السعة والجنس والمنهج وقاعدة العمر)."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Stages", "المراحل"), T("Ordered groups such as KG / Elementary / Intermediate / Secondary. Create them from the 'New stage' card; use ✎ to rename/reorder and 🗑 to remove a stage that has no grades left (BR-GRD-001).", "مجموعات مرتبة مثل الروضة / الابتدائية / المتوسطة / الثانوية. أنشئها من بطاقة «مرحلة جديدة»؛ استخدم ✎ للتعديل و🗑 لحذف مرحلة لم يبقَ فيها صفوف (BR-GRD-001).")),
            new HelpPanelViewModel.Item(T("Grades", "الصفوف"), T("Each grade has a unique code, a stage and an order. ✎ edits code/name/stage/order; 🗑 deactivates a grade that has no enrollments, sections or feeder grades (BR-GRD-007/009).", "لكل صف رمز فريد ومرحلة وترتيب. ✎ يعدّل الرمز/الاسم/المرحلة/الترتيب؛ 🗑 يلغي تفعيل صف ليس له تسجيلات ولا شعب ولا صفوف ترفَّع إليه (BR-GRD-007/009).")),
            new HelpPanelViewModel.Item(T("Promotion path", "مسار الترفيع"), T("Every non-graduating grade must point to the next grade; the path cannot loop. A missing target blocks activating the year (BR-GRD-002, BR-AYR-004).", "كل صف غير تخرّجي يجب أن يشير إلى الصف التالي؛ ولا يجوز أن يشكّل المسار حلقة. غياب الهدف يمنع تفعيل العام (BR-GRD-002، BR-AYR-004).")),
            new HelpPanelViewModel.Item(T("Grade-year profile", "ملف الصف السنوي"), T("Per grade and academic year: gender policy (may only narrow the stage default), sections × section size = planned seats, curriculum and the age rule at the cutoff date. 'Profile' pre-selects the grade in the form; 🗑 removes a profile with no sections/enrollments (BR-GRD-003..006).", "لكل صف وعام دراسي: سياسة الجنس (تضيّق افتراضي المرحلة فقط)، الشعب × حجم الشعبة = المقاعد المخططة، المنهج وقاعدة العمر عند تاريخ القطع. زر «الملف» يختار الصف في النموذج؛ 🗑 يحذف ملفاً ليس له شعب أو تسجيلات (BR-GRD-003..006).")),
            new HelpPanelViewModel.Item(T("Capacity meter", "مقياس السعة"), T("Enrolled / planned seats for the selected year; red means the plan is full.", "المسجّلون / المقاعد المخططة للعام المختار؛ اللون الأحمر يعني اكتمال الخطة.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@T("Grade ladder", "السلم الدراسي")</h1><p class="text-muted mb-0">@T("Stages → grades in order, promotion arrows and graduating flags (BR-GRD-001/002); grade-year profiles hold curriculum, gender, age rule and capacity per year (BR-GRD-004).", "المراحل → الصفوف بالترتيب، أسهم الترفيع وعلامات التخرج (BR-GRD-001/002)؛ ملف الصف السنوي يحمل المنهج والجنس وقاعدة العمر والسعة لكل عام (BR-GRD-004).")</p></div>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" class="d-flex gap-2 align-items-center"><label class="small text-muted" for="grades-year">@T("Year", "العام")</label><select name="year" id="grades-year" class="form-select form-select-sm" onchange="this.form.submit()">@foreach (var y in Model.Years) { <option value="@y.Id" selected="@(y.Id == yid)">@(isRtl ? y.LabelAr : y.LabelEn) · @Labels.YearStatus(y.Status, isRtl)</option> }</select></form>
        <partial name="_HelpModal" model="help" />
    </div></div>

<div class="row g-3">
    <div class="col-xl-8">
        @foreach (var s in Model.Stages)
        {
            <div class="sms-card mb-3">
                <div class="p-3 border-bottom d-flex align-items-center gap-2"><span class="badge text-bg-light border">@s.Stage.SequenceOrder</span><h2 class="h6 mb-0">@(isRtl ? s.Stage.Name.NameAr : s.Stage.Name.NameEn)</h2><span class="small text-muted">· @Gender(s.Stage.DefaultGenderPolicy)</span>
                    <span class="ms-auto d-flex gap-1">
                        <a class="btn btn-sm btn-outline-primary" asp-action="EditStage" asp-route-id="@s.Stage.Id" asp-route-year="@yid" title="@T("Edit stage", "تعديل المرحلة")"><i class="bi bi-pencil" aria-hidden="true"></i> @T("Edit", "تعديل")</a>
                        <form method="post" asp-action="DeleteStage" asp-route-id="@s.Stage.Id" asp-route-year="@yid" class="d-inline" onsubmit="return confirm('@T("Remove this stage?", "حذف هذه المرحلة؟")');">
                            <button class="btn btn-sm btn-outline-danger" type="submit" title="@(s.Grades.Count > 0 ? T("Remove its grades first", "احذف صفوفها أولاً") : T("Remove stage", "حذف المرحلة"))" disabled="@(s.Grades.Count > 0)"><i class="bi bi-trash" aria-hidden="true"></i> @T("Delete", "حذف")</button>
                        </form>
                    </span>
                </div>
                <div class="table-responsive"><table class="table sms-table mb-0">
                    <caption class="visually-hidden">@T("Grades:", "صفوف:") @(isRtl ? s.Stage.Name.NameAr : s.Stage.Name.NameEn)</caption>
                    <thead><tr><th scope="col">#</th><th scope="col">@T("Grade", "الصف")</th><th scope="col">@T("Promotes to", "يرفَّع إلى")</th><th scope="col">@T("Profile", "الملف السنوي") (@(Model.Year == null ? "—" : (isRtl ? Model.Year.LabelAr : Model.Year.LabelEn)))</th><th scope="col">@T("Capacity", "السعة")</th><th scope="col"><span class="visually-hidden">@T("Actions", "إجراءات")</span></th></tr></thead>
                    <tbody>
                    @foreach (var g in s.Grades)
                    {
                        var planned = g.Profile == null ? 0 : g.Profile.TargetSections * g.Profile.TargetSectionSize;
                        var pct = planned == 0 ? 0 : Math.Min(100, (int)Math.Round(100.0 * g.Enrolled / planned));
                        <tr>
                            <td>@g.Grade.SequenceOrder</td>
                            <td><code>@g.Grade.Code</code> <span class="fw-semibold">@(isRtl ? g.Grade.Name.NameAr : g.Grade.Name.NameEn)</span></td>
                            <td>
                                <form method="post" asp-action="SetPath" asp-route-id="@g.Grade.Id" asp-route-year="@yid" class="d-flex gap-1 align-items-center">
                                    <select name="target" class="form-select form-select-sm" style="width:11rem" aria-label="@T("Promotion target:", "هدف الترفيع:") @g.Grade.Code"><option value="">—</option>@foreach (var o in Model.AllGrades.Where(x => x.Id != g.Grade.Id)) { <option value="@o.Id" selected="@(o.Id == g.Grade.PromotionTargetGradeLevelId)">@o.Code @(isRtl ? o.Name.NameAr : o.Name.NameEn)</option> }</select>
                                    <label class="small text-nowrap"><input type="checkbox" name="graduating" value="true" class="form-check-input" @(g.Grade.IsGraduating ? "checked" : "") /> @T("graduating", "تخرج")</label>
                                    <button class="btn btn-sm btn-outline-secondary" type="submit" title="@T("Save path", "حفظ المسار")" aria-label="@T("Save path", "حفظ المسار")"><i class="bi bi-arrow-right-short @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i></button>
                                </form>
                                @if (!g.Grade.IsGraduating && g.PromotionTarget == null) { <span class="small text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>@T("no target (blocks activation, BR-AYR-004)", "بلا هدف (يمنع التفعيل، BR-AYR-004)")</span> }
                            </td>
                            <td class="small">@if (g.Profile == null) { <span class="text-muted">@T("not defined", "غير معرَّف")</span> } else { <text>@Gender(g.Profile.GenderPolicy) · @g.Profile.TargetSections × @g.Profile.TargetSectionSize@if (g.Profile.MinAgeAtCutoff != null || g.Profile.MaxAgeAtCutoff != null) { <text> · @T("age", "العمر") <bdi dir="ltr">@g.Profile.MinAgeAtCutoff–@g.Profile.MaxAgeAtCutoff</bdi></text> }</text> }</td>
                            <td style="min-width:9rem">@if (g.Profile != null) { <div class="small">@g.Enrolled / @planned · @g.Sections @T("sec.", "شعب")</div><div class="sms-progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="@T("Capacity", "السعة")"><span style="width:@(pct)%;@(pct >= 100 ? "background:#dc2626" : "")"></span></div> }</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="#profile" onclick="document.getElementById('ProfileGradeId').value='@g.Grade.Id'" title="@T("Define / edit the grade-year profile", "تعريف / تعديل الملف السنوي")">@T("Profile", "الملف")</a>
                                @if (g.Profile != null)
                                {
                                    <form method="post" asp-action="DeleteProfile" asp-route-id="@g.Profile.Id" asp-route-year="@yid" class="d-inline" onsubmit="return confirm('@T("Remove this grade-year profile?", "حذف ملف الصف السنوي؟")');">
                                        <button class="btn btn-sm btn-outline-warning" type="submit" title="@(g.Enrolled > 0 || g.Sections > 0 ? T("Profile has sections/enrollments", "للملف شعب أو تسجيلات") : T("Remove profile", "حذف الملف"))" aria-label="@(g.Enrolled > 0 || g.Sections > 0 ? T("Profile has sections/enrollments", "للملف شعب أو تسجيلات") : T("Remove profile", "حذف الملف"))" disabled="@(g.Enrolled > 0 || g.Sections > 0)"><i class="bi bi-x-circle" aria-hidden="true"></i></button>
                                    </form>
                                }
                                <a class="btn btn-sm btn-outline-secondary" asp-action="EditGrade" asp-route-id="@g.Grade.Id" asp-route-year="@yid" title="@T("Edit grade", "تعديل الصف")" aria-label="@T("Edit grade", "تعديل الصف")"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                <form method="post" asp-action="DeleteGrade" asp-route-id="@g.Grade.Id" asp-route-year="@yid" class="d-inline" onsubmit="return confirm('@T("Remove this grade?", "حذف هذا الصف؟")');">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="@(g.Enrolled > 0 || g.Sections > 0 ? T("Grade has sections/enrollments", "للصف شعب أو تسجيلات") : T("Remove grade", "حذف الصف"))" aria-label="@(g.Enrolled > 0 || g.Sections > 0 ? T("Grade has sections/enrollments", "للصف شعب أو تسجيلات") : T("Remove grade", "حذف الصف"))" disabled="@(g.Enrolled > 0 || g.Sections > 0)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (s.Grades.Count == 0) { <tr><td colspan="6" class="text-muted small text-center py-3">@T("No grades in this stage yet.", "لا صفوف في هذه المرحلة بعد.")</td></tr> }
                    </tbody>
                </table></div>
            </div>
        }
        @if (Model.Stages.Count == 0) { <div class="sms-card p-4 text-center text-muted">@T("No stages yet — create the first one.", "لا مراحل بعد — أنشئ الأولى.")</div> }
    </div>
    <div class="col-xl-4">
        <div class="sms-card p-3 mb-3">
            <h2 class="h6">@T("New stage", "مرحلة جديدة")</h2>
            <form method="post" asp-action="DefineStage" asp-route-year="@yid">
                <div class="mb-2"><label asp-for="StageNameAr" class="form-label small mb-1">@T("Name (Arabic)", "الاسم (عربي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="StageNameAr" class="form-control form-control-sm" dir="rtl" placeholder="الاسم بالعربية" required aria-required="true" /></div>
                <div class="mb-2"><label asp-for="StageNameEn" class="form-label small mb-1">@T("Name (English)", "الاسم (إنجليزي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="StageNameEn" class="form-control form-control-sm" dir="ltr" placeholder="English name" required aria-required="true" /></div>
                <div class="row g-2 mb-2"><div class="col-5"><label asp-for="StageOrder" class="form-label small mb-1">@T("Order", "الترتيب")</label><input asp-for="StageOrder" class="form-control form-control-sm" type="number" min="1" /></div><div class="col-7"><label asp-for="StageGender" class="form-label small mb-1">@T("Gender", "الجنس")</label><select asp-for="StageGender" class="form-select form-select-sm">@foreach (GenderPolicy g in Enum.GetValues(typeof(GenderPolicy))) { <option value="@g">@Gender(g)</option> }</select></div></div>
                <button class="btn btn-sm btn-primary w-100" type="submit">@T("Create stage", "إنشاء مرحلة")</button>
            </form>
        </div>
        <div class="sms-card p-3 mb-3">
            <h2 class="h6">@T("New grade", "صف جديد")</h2>
            <form method="post" asp-action="DefineGrade" asp-route-year="@yid">
                <div class="mb-2"><label asp-for="GradeStageId" class="form-label small mb-1">@T("Stage", "المرحلة") <span class="text-danger" aria-hidden="true">*</span></label><select asp-for="GradeStageId" class="form-select form-select-sm" required aria-required="true"><option value="">@T("— stage —", "— المرحلة —")</option>@foreach (var s in Model.Stages) { <option value="@s.Stage.Id">@(isRtl ? s.Stage.Name.NameAr : s.Stage.Name.NameEn)</option> }</select></div>
                <div class="row g-2 mb-2"><div class="col-4"><label asp-for="GradeCode" class="form-label small mb-1">@T("Code", "الرمز") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="GradeCode" class="form-control form-control-sm" dir="ltr" placeholder="G1" required aria-required="true" /></div><div class="col-8"><label asp-for="GradeNameEn" class="form-label small mb-1">@T("Name (English)", "الاسم (إنجليزي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="GradeNameEn" class="form-control form-control-sm" dir="ltr" placeholder="Grade 1" required aria-required="true" /></div></div>
                <div class="mb-2"><label asp-for="GradeNameAr" class="form-label small mb-1">@T("Name (Arabic)", "الاسم (عربي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="GradeNameAr" class="form-control form-control-sm" dir="rtl" placeholder="الصف الأول" required aria-required="true" /></div>
                <div class="row g-2 mb-2"><div class="col-4"><label asp-for="GradeOrder" class="form-label small mb-1">@T("Order", "الترتيب")</label><input asp-for="GradeOrder" class="form-control form-control-sm" type="number" min="1" /></div><div class="col-8"><label asp-for="PromotionTargetId" class="form-label small mb-1">@T("Promotes to", "يرفَّع إلى")</label><select asp-for="PromotionTargetId" class="form-select form-select-sm"><option value="">@T("promotes to…", "يرفَّع إلى…")</option>@foreach (var o in Model.AllGrades) { <option value="@o.Id">@o.Code @(isRtl ? o.Name.NameAr : o.Name.NameEn)</option> }</select></div></div>
                <div class="form-check mb-2"><input asp-for="IsGraduating" class="form-check-input" /><label asp-for="IsGraduating" class="form-check-label small">@T("Graduating grade", "صف تخرج")</label></div>
                <button class="btn btn-sm btn-primary w-100" type="submit">@T("Create grade", "إنشاء صف")</button>
            </form>
        </div>
        <div class="sms-card p-3" id="profile">
            <h2 class="h6">@T("Grade-year profile", "ملف الصف السنوي") @(Model.Year == null ? "" : "· " + (isRtl ? Model.Year.LabelAr : Model.Year.LabelEn))</h2>
            @if (Model.Year == null) { <div class="small text-muted">@T("Define an academic year first.", "عرّف عاماً دراسياً أولاً.") </div> }
            else
            {
                <form method="post" asp-action="DefineProfile" asp-route-year="@yid" id="profile-form">
                    <div class="mb-2"><label asp-for="ProfileGradeId" class="form-label small mb-1">@T("Grade", "الصف") <span class="text-danger" aria-hidden="true">*</span></label><select asp-for="ProfileGradeId" class="form-select form-select-sm" id="ProfileGradeId" required aria-required="true"><option value="">@T("— grade —", "— الصف —")</option>@foreach (var o in Model.AllGrades) { <option value="@o.Id">@o.Code @(isRtl ? o.Name.NameAr : o.Name.NameEn)</option> }</select></div>
                    <div class="row g-2 mb-2"><div class="col-6"><label asp-for="ProfileGender" class="form-label small">@T("Gender", "الجنس")</label><select asp-for="ProfileGender" class="form-select form-select-sm">@foreach (GenderPolicy g in Enum.GetValues(typeof(GenderPolicy))) { <option value="@g">@Gender(g)</option> }</select></div>
                        <div class="col-6"><label asp-for="CurriculumId" class="form-label small">@T("Curriculum", "المنهج")</label><select asp-for="CurriculumId" class="form-select form-select-sm"><option value="">—</option>@foreach (var c in Model.Curricula) { <option value="@c.Id">@(isRtl ? c.Ar : c.En)</option> }</select></div></div>
                    <div class="row g-2 mb-2"><div class="col-6"><label asp-for="TargetSections" class="form-label small">@T("Sections", "الشعب")</label><input asp-for="TargetSections" class="form-control form-control-sm" type="number" min="1" oninput="seatMath()" /></div><div class="col-6"><label asp-for="TargetSectionSize" class="form-label small">@T("Section size", "حجم الشعبة")</label><input asp-for="TargetSectionSize" class="form-control form-control-sm" type="number" min="1" oninput="seatMath()" /></div></div>
                    <div class="small text-muted mb-2">@T("Planned seats:", "المقاعد المخططة:") <strong id="seats">@((Model.TargetSections ?? 0) * (Model.TargetSectionSize ?? 0))</strong></div>
                    <div class="row g-2 mb-2"><div class="col-4"><label asp-for="MinAge" class="form-label small">@T("Min age", "أدنى عمر")</label><input asp-for="MinAge" class="form-control form-control-sm" type="number" step="0.5" /></div><div class="col-4"><label asp-for="MaxAge" class="form-label small">@T("Max age", "أقصى عمر")</label><input asp-for="MaxAge" class="form-control form-control-sm" type="number" step="0.5" /></div><div class="col-4"><label asp-for="AgeCutoff" class="form-label small">@T("Cutoff", "تاريخ القطع")</label><input asp-for="AgeCutoff" asp-format="{0:yyyy-MM-dd}" class="form-control form-control-sm" type="date" /></div></div>
                    <button class="btn btn-sm btn-primary w-100" type="submit">@T("Save profile", "حفظ الملف")</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>function seatMath(){var a=+document.getElementById('TargetSections').value||0,b=+document.getElementById('TargetSectionSize').value||0;document.getElementById('seats').textContent=a*b;}</script>
}
