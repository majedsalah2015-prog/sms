@using System.Globalization
@using Sms.Application.Installments
@model AssignViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Assignment console", "لوحة الإسناد");
    ViewData["Breadcrumb"] = T("Installment plans / Assignment", "خطط التقسيط / الإسناد");
    var yid = Model.Year?.Id;
    var help = new HelpPanelViewModel
    {
        Id = "asg-help", Title = T("Assignment console — help", "لوحة الإسناد — مساعدة"),
        Intro = T("Assigning a template to a student generates the actual schedule from that student's posted charges, net of credit notes, for the selected year (BR-INS-002/004). Rounding lands in the last installment and due dates shift off non-working days.", "إسناد قالب لطالب يولّد الجدول الفعلي من رسومه المرحّلة، بعد خصم الإشعارات الدائنة، للعام المحدَّد (BR-INS-002/004). يقع الكسر في القسط الأخير، وتُزاح تواريخ الاستحقاق عن أيام العطل."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Payer, not parent", "الدافع لا ولي الأمر"), T("The schedule is addressed to the payer: every dunning message and statement goes to them. Guardians marked financially responsible are listed first.", "الجدول موجَّه للدافع: كل رسالة مطالبة وكل كشف حساب يذهب إليه. أولياء الأمور المسؤولون مالياً مُدرَجون أولاً.")),
            new HelpPanelViewModel.Item(T("Exception assignment", "إسناد استثنائي"), T("Use it when the plan departs from the template's own rules; a reason is mandatory and is kept on the assignment.", "استخدمه حين تخرج الخطة عن قواعد القالب؛ السبب إلزامي ويُحفظ على الإسناد.")),
            new HelpPanelViewModel.Item(T("No charges yet?", "لا رسوم بعد؟"), T("Post the student's fees first — there is nothing to split until charges exist.", "رحّل رسوم الطالب أولاً — لا شيء يُقسَّم قبل وجود رسوم.")),
            new HelpPanelViewModel.Item(T("A whole grade at once", "صف كامل دفعة واحدة"), T("The grade-wide card schedules mandatory fees only — the fees every child of the grade is billed. Optional services stay out of it, and a student who already has a plan is never rewritten. Preview first: the run generates one schedule per student.", "بطاقة إسناد الصف تجدول الرسوم الإلزامية فقط — الرسوم التي تُحمَّل على كل طالب في الصف. الخدمات الاختيارية خارجها، والطالب الذي له خطة لا تُعاد كتابتها. عايِن أولاً: التشغيل يولّد جدولاً لكل طالب.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Generate a student's schedule from an approved template.", "ولّد جدول الطالب من قالب معتمد.")</p></div><partial name="_HelpModal" model="help" /></div>
<partial name="_InstallmentsNav" />


@{
    // The selected student is loaded past the filter, so they may not be in the picker's own list.
    // Carry them as an extra option: a filter change must never silently drop the open panel.
    var selectedOutsideFilter = Model.Selected != null && !Model.Students.Any(s => s.Student.Id == Model.Selected.Id);
}

<form method="get" class="sms-card p-3 mb-3">
    @* Narrowing the student list must not throw away a grade-wide preview the officer is reading. *@
    <input type="hidden" name="bulkGradeId" value="@Model.BulkGradeId" />
    <input type="hidden" name="bulkTemplateId" value="@Model.BulkTemplateId" />
    <div class="d-flex flex-wrap gap-2 align-items-end">
        <div>
            <label for="year-pick" class="form-label small text-muted mb-0">@T("Academic year", "العام الدراسي")</label>
            <select id="year-pick" name="year" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                @foreach (var y in Model.Years) { <option value="@y.Id" selected="@(y.Id == yid)">@(isRtl ? y.LabelAr : y.LabelEn)</option> }
            </select>
        </div>
        <div>
            <label for="grade-pick" class="form-label small text-muted mb-0">@T("Grade", "الصف")</label>
            <select id="grade-pick" name="gradeId" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                <option value="">@T("All grades", "كل الصفوف")</option>
                @foreach (var g in Model.Grades)
                {
                    <option value="@g.Id" selected="@(Model.GradeId == g.Id)">@(isRtl ? g.Name.NameAr : g.Name.NameEn)</option>
                }
            </select>
        </div>
        @* The name box is the picker. Typing in it opens the matches underneath — the officer
           reads the name they are typing and picks it there, instead of typing here and then
           hunting the same name again in the list below. Enter with nothing highlighted still
           submits, which is what reaches past the picker's cap into the rest of the register. *@
        <div class="position-relative">
            <label for="q" class="form-label small text-muted mb-0">@T("Student", "الطالب")</label>
            <input type="search" id="q" name="q" value="@Model.Q" class="form-control form-control-sm" style="min-width:12rem"
                   autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="q-suggest"
                   placeholder="@T("Student no / name…", "رقم الطالب / الاسم…")" aria-label="@T("Filter by student", "فلترة بالطالب")" />
            <div id="q-suggest" class="list-group shadow position-absolute start-0 d-none" role="listbox"
                 aria-label="@T("Matching students", "الطلاب المطابقون")"
                 style="z-index:1056; max-height:16rem; overflow-y:auto; min-width:22rem;"></div>
        </div>
        <div>
            <label for="payerQ" class="form-label small text-muted mb-0">@T("Payer", "الدافع")</label>
            <input type="search" id="payerQ" name="payerQ" value="@Model.PayerQ" class="form-control form-control-sm" style="min-width:12rem"
                   placeholder="@T("Parent / file no / mobile…", "ولي أمر / رقم ملف / جوال…")" aria-label="@T("Filter by payer", "فلترة بالدافع")" />
        </div>
        <div>
            <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> @T("Filter", "فلترة")</button>
            @if (Model.HasFilter)
            {
                <a class="btn btn-sm btn-link" asp-action="Assign" asp-route-year="@yid" asp-route-studentId="@Model.Selected?.Id">@T("Clear", "مسح")</a>
            }
        </div>
    </div>

    @if (Model.PayerMatches.Count > 0)
    {
        <div class="small text-muted mt-2">
            @T("Families matched:", "الأُسر المطابقة:")
            @foreach (var p in Model.PayerMatches.Take(6))
            {
                <span class="badge text-bg-light border me-1">
                    @p.Label(isRtl)
                    <span class="text-muted">(@p.ChildCount)</span>
                    @if (p.Payer == null)
                    {
                        <i class="bi bi-exclamation-triangle text-warning ms-1" title="@T("No payer record yet", "لا سجل دافع بعد")" aria-hidden="true"></i>
                    }
                </span>
            }
            @if (Model.PayerMatches.Count > 6) { <span>+@(Model.PayerMatches.Count - 6)</span> }
        </div>
    }
    else if (Model.PayerQ != null)
    {
        <div class="small text-danger mt-2">@T("No family matched that search.", "لا أسرة مطابقة لهذا البحث.")</div>
    }

    <div class="mt-2">
        <label for="student-pick" class="form-label small text-muted mb-0">
            @T("Students", "الطلاب")
            <span class="ms-1">
                @if (Model.MatchCount == 0)
                {
                    @T("— none match", "— لا نتائج")
                }
                else if (Model.Truncated)
                {
                    @($"— {Model.MatchCount} " + T("match, showing the first", "مطابق، يُعرض أول") + $" {Model.Students.Count}")
                }
                else
                {
                    @($"— {Model.MatchCount}")
                }
            </span>
        </label>
        @* Two speeds, one box. The Student box above narrows this list as it is typed — no round
           trip, so the name appears while it is still being typed — and pressing Filter sends the
           same term to the server, which is what reaches past the picker's cap into the rest of
           the register. *@
        <select id="student-pick" name="studentId" class="form-select form-select-sm" style="max-width:32rem" onchange="this.form.submit()">
            <option value="">@T("— choose a student —", "— اختر طالباً —")</option>
            @if (selectedOutsideFilter && Model.Selected != null)
            {
                var outside = Model.Selected;
                var outsideKey = string.Join(" ", new[] { outside.StudentNo, outside.FirstNameAr, outside.FatherNameAr, outside.GrandfatherNameAr, outside.FamilyNameAr, outside.FirstNameEn, outside.FatherNameEn, outside.GrandfatherNameEn, outside.FamilyNameEn });
                <option value="@outside.Id" data-search="@outsideKey" selected>@outside.StudentNo · @FinanceLabels.StudentName(outside, isRtl) @T("(outside the current filter)", "(خارج الفلتر الحالي)")</option>
            }
            @foreach (var s in Model.Students)
            {
                var st = s.Student;
                var name = FinanceLabels.StudentName(st, isRtl);
                var grade = s.Grade == null ? "" : " — " + (isRtl ? s.Grade.Name.NameAr : s.Grade.Name.NameEn);
                // The option prints three of the four identity name parts in one language only, so
                // matching on its caption alone tells the clerk "no results" for the father's name
                // they can read on the student's own file. Every part, both languages, plus the
                // number and the grade — the same fields the server searches (BR-STU-001).
                var key = string.Join(" ", new[] { st.StudentNo, st.FirstNameAr, st.FatherNameAr, st.GrandfatherNameAr, st.FamilyNameAr, st.FirstNameEn, st.FatherNameEn, st.GrandfatherNameEn, st.FamilyNameEn })
                    + (s.Grade == null ? "" : " " + s.Grade.Name.NameAr + " " + s.Grade.Name.NameEn);
                <option value="@st.Id" data-search="@key" selected="@(Model.Selected?.Id == st.Id)">@st.StudentNo · @name@grade</option>
            }
        </select>
        <div class="form-text d-none" id="student-pick-count"></div>
        @if (Model.Truncated)
        {
            <div class="form-text">@T("Narrow the filter to reach the rest of the register.", "ضيّق الفلتر للوصول إلى بقية السجل.")</div>
        }
    </div>
</form>

@* The name box drives both the suggestion panel under it and the picker below, off one snapshot
   of the loaded options taken once. Options are rebuilt rather than hidden: a hidden option is
   still selectable by keyboard in several browsers. Arabic is folded before matching — a clerk
   who types "احمد" means "أحمد", and one who types ١٨ means the student numbered 18. *@
<script>
(function () {
    var select = document.getElementById('student-pick');
    var filter = document.getElementById('q');
    var panel = document.getElementById('q-suggest');
    var count = document.getElementById('student-pick-count');
    if (!select || !filter || !panel || !count || select.dataset.wired) { return; }
    select.dataset.wired = '1';

    var MAX_SUGGESTIONS = 12;
    var NONE_TEXT = @Html.Raw(Json.Serialize(T("Nobody in the loaded list matches — press Filter to search the whole register.", "لا أحد في القائمة المحمّلة يطابق — اضغط فلترة للبحث في السجل كاملاً.")));
    var MATCHING_TEXT = @Html.Raw(Json.Serialize(T("matching", "مطابق")));
    var MORE_TEXT = @Html.Raw(Json.Serialize(T("more…", "المزيد…")));

    function fold(text) {
        return String(text || '')
            .replace(/[ً-ْـ]/g, '')            // harakat and tatweel: decoration, never meaning
            .replace(/[أإآٱ]/g, 'ا') // every hamza carrier folds onto plain alef
            .replace(/ى/g, 'ي')                     // alef maqsura reads as ya
            .replace(/ة/g, 'ه')                     // ta marbuta reads as ha
            .replace(/ؤ/g, 'و')
            .replace(/ئ/g, 'ي')
            .replace(/[٠-٩]/g, function (d) { return String.fromCharCode(d.charCodeAt(0) - 0x0660 + 48); })
            .replace(/[۰-۹]/g, function (d) { return String.fromCharCode(d.charCodeAt(0) - 0x06F0 + 48); })
            .toLowerCase();
    }

    var all = Array.prototype.slice.call(select.options).map(function (o) {
        return { value: o.value, text: o.textContent.trim(), search: fold((o.dataset.search || '') + ' ' + o.textContent) };
    });
    var placeholder = all.length && all[0].value === '' ? all.shift() : null;
    var shown = [];
    var active = -1;

    // Each word narrows further rather than starting over, the same reading the server gives the
    // term — so what appears while typing cannot disagree with what Filter returns.
    function matchesFor(term) {
        var words = fold(term).split(' ').filter(function (w) { return w.length > 0; });
        if (words.length === 0) { return null; }
        return all.filter(function (o) {
            return words.every(function (w) { return o.search.indexOf(w) >= 0; });
        });
    }

    function closePanel() {
        panel.classList.add('d-none');
        panel.innerHTML = '';
        filter.setAttribute('aria-expanded', 'false');
        filter.removeAttribute('aria-activedescendant');
        shown = [];
        active = -1;
    }

    function highlight(index) {
        var items = panel.querySelectorAll('[role="option"]');
        for (var i = 0; i < items.length; i++) {
            var on = i === index;
            items[i].classList.toggle('active', on);
            items[i].setAttribute('aria-selected', on ? 'true' : 'false');
        }
        active = index;
        if (index >= 0 && items[index]) {
            filter.setAttribute('aria-activedescendant', items[index].id);
            items[index].scrollIntoView({ block: 'nearest' });
        } else {
            filter.removeAttribute('aria-activedescendant');
        }
    }

    // Choosing from the panel is choosing in the picker: the select is what the form posts, and
    // submitting is what opens the student's panel — the same gesture as picking from the list.
    function choose(value) {
        select.value = value;
        closePanel();
        if (select.form) { select.form.submit(); }
    }

    function openPanel(matches) {
        panel.innerHTML = '';
        shown = matches.slice(0, MAX_SUGGESTIONS);
        shown.forEach(function (o, i) {
            var item = document.createElement('button');
            item.type = 'button';
            item.id = 'q-suggest-' + i;
            item.className = 'list-group-item list-group-item-action py-1 small text-start';
            item.setAttribute('role', 'option');
            item.setAttribute('aria-selected', 'false');
            item.textContent = o.text;
            item.addEventListener('mousedown', function (e) { e.preventDefault(); choose(o.value); });
            item.addEventListener('mouseenter', function () { highlight(i); });
            panel.appendChild(item);
        });
        if (matches.length > shown.length) {
            var more = document.createElement('div');
            more.className = 'list-group-item py-1 small text-muted';
            more.textContent = '+' + (matches.length - shown.length) + ' ' + MORE_TEXT;
            panel.appendChild(more);
        }
        panel.classList.remove('d-none');
        filter.setAttribute('aria-expanded', 'true');
        highlight(-1);
    }

    function render(showPanel) {
        var matches = matchesFor(filter.value);
        var chosen = select.value;
        var list = matches === null ? all : matches;

        select.innerHTML = '';
        if (placeholder) { select.appendChild(new Option(placeholder.text, '')); }
        list.forEach(function (o) { select.appendChild(new Option(o.text, o.value)); });

        // Dropping the chosen student would post someone other than the panel open on screen, so
        // the choice stays in the list whether or not it matches.
        if (chosen && !list.some(function (o) { return o.value === chosen; })) {
            var kept = all.filter(function (o) { return o.value === chosen; })[0];
            if (kept) { select.appendChild(new Option(kept.text, kept.value)); }
        }
        select.value = chosen;

        if (matches === null) {
            count.textContent = '';
            count.classList.add('d-none');
            closePanel();
            return;
        }

        count.textContent = matches.length === 0 ? NONE_TEXT : MATCHING_TEXT + ': ' + matches.length + ' / ' + all.length;
        count.classList.remove('d-none');
        if (showPanel && matches.length > 0) { openPanel(matches); } else { closePanel(); }
    }

    filter.addEventListener('input', function () { render(true); });
    filter.addEventListener('focus', function () { render(true); });
    filter.addEventListener('blur', function () { window.setTimeout(closePanel, 150); });

    filter.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { closePanel(); return; }
        if (shown.length === 0) { return; }
        if (e.key === 'ArrowDown') { e.preventDefault(); highlight((active + 1) % shown.length); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(active <= 0 ? shown.length - 1 : active - 1); }
        else if (e.key === 'Enter' && active >= 0) {
            // Only a highlighted suggestion is taken here. With none highlighted the key keeps its
            // ordinary meaning and submits, which is the search across the whole register.
            e.preventDefault();
            choose(shown[active].value);
        }
    });
})();
</script>

@* doc/Modules/20 §8.2 "defaults per grade" (BR-INS-002). One template over a whole grade, mandatory
   fees only — the fees the school bills every child of the grade, as opposed to the optional
   services a family adds one at a time. Nothing runs without a preview first: this button writes a
   schedule per student, and thirty of them are not something to undo row by row. *@
@if (Model.Year != null)
{
    <div class="sms-card p-3 mb-3">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <h2 class="h6 mb-0">@T("Assign a plan to a whole grade", "إسناد خطة لصف كامل")</h2>
            <span class="badge text-bg-info">@T("Mandatory fees only", "الرسوم الإلزامية فقط")</span>
        </div>
        <p class="text-muted small mb-3">
            @T("Every actively-enrolled student of the grade gets a schedule over their posted mandatory charges, net of credit notes and discounts. Optional services — transport, books, activities — are left out; schedule those from the student's own panel.",
               "كل طالب مقيَّد فعلياً في الصف يحصل على جدول من رسومه الإلزامية المرحّلة، بعد خصم الإشعارات الدائنة والحسومات. الخدمات الاختيارية — نقل، كتب، أنشطة — خارج هذا الإسناد؛ جدولها من لوحة الطالب نفسه.")
        </p>

        @if (!Model.BulkAvailable)
        {
            <div class="alert alert-warning mb-0">
                @T("Grade-wide assignment writes into the working year, so it is only offered while that is the year selected above.",
                   "إسناد الصف يكتب في عام العمل، فلا يُتاح إلا حين يكون هو العام المحدَّد أعلاه.")
            </div>
        }
        else if (Model.Grades.Count == 0)
        {
            <div class="alert alert-warning mb-0">@T("No grade is running with enrolled students this year.", "لا صف قائم بطلاب مقيَّدين هذا العام.")</div>
        }
        else if (Model.ApprovedTemplates.Count == 0)
        {
            <div class="alert alert-warning mb-0">@T("No approved template for this year. Approve one in the Template designer first.", "لا قالب معتمد لهذا العام. اعتمد قالباً في مصمّم القوالب أولاً.")</div>
        }
        else
        {
            <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
                @* The filter above is the officer's working list; previewing must not reset it. *@
                <input type="hidden" name="year" value="@yid" />
                <input type="hidden" name="studentId" value="@Model.Selected?.Id" />
                <input type="hidden" name="q" value="@Model.Q" />
                <input type="hidden" name="payerQ" value="@Model.PayerQ" />
                <input type="hidden" name="gradeId" value="@Model.GradeId" />
                <div>
                    <label for="bulkGradeId" class="form-label small text-muted mb-0">@T("Grade", "الصف")</label>
                    <select id="bulkGradeId" name="bulkGradeId" class="form-select form-select-sm" style="width:auto" required>
                        <option value="">@T("— choose a grade —", "— اختر صفاً —")</option>
                        @foreach (var g in Model.Grades)
                        {
                            <option value="@g.Id" selected="@(Model.BulkGradeId == g.Id)">@(isRtl ? g.Name.NameAr : g.Name.NameEn)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="bulkTemplateId" class="form-label small text-muted mb-0">@T("Template", "القالب")</label>
                    <select id="bulkTemplateId" name="bulkTemplateId" class="form-select form-select-sm" style="width:auto" required>
                        <option value="">@T("— choose a template —", "— اختر قالباً —")</option>
                        @foreach (var t in Model.ApprovedTemplates)
                        {
                            <option value="@t.Id" selected="@(Model.BulkTemplateId == t.Id)">@(isRtl ? t.NameAr : t.NameEn)</option>
                        }
                    </select>
                </div>
                <div>
                    <button class="btn btn-sm btn-outline-primary" type="submit">
                        <i class="bi bi-list-check" aria-hidden="true"></i> @T("Preview the grade", "معاينة الصف")
                    </button>
                </div>
            </form>

            @if (Model.BulkError != null)
            {
                <div class="alert alert-danger mt-3 mb-0">@Model.BulkError</div>
            }
            else if (Model.HasBulkPreview)
            {
                var ready = Model.BulkCount(GradeAssignmentOutcome.Ready);
                <hr />
                @if (Model.BulkRows.Count == 0)
                {
                    <div class="alert alert-warning mb-0">@T("No student is actively enrolled in that grade this year.", "لا طالب مقيَّد فعلياً في هذا الصف هذا العام.")</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <span class="badge text-bg-primary">@T("Will be scheduled:", "سيُسنَد:") @ready</span>
                        @foreach (var outcome in new[] { GradeAssignmentOutcome.AlreadyPlanned, GradeAssignmentOutcome.NoMandatoryCharges, GradeAssignmentOutcome.PayerSplit })
                        {
                            var n = Model.BulkCount(outcome);
                            if (n > 0)
                            {
                                <span class="badge @InstallmentLabels.GradeOutcomeBadge(outcome)">@InstallmentLabels.GradeOutcome(outcome, isRtl): @n</span>
                            }
                        }
                        @if (ready > 0)
                        {
                            <span class="ms-auto small text-muted">@T("Total to schedule:", "الإجمالي المراد جدولته:") <span class="fw-semibold">@Model.BulkReadyTotal.ToString("N2")</span></span>
                        }
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-2">
                            <thead>
                                <tr>
                                    <th scope="col">@T("Student", "الطالب")</th>
                                    <th scope="col">@T("Payer", "الدافع")</th>
                                    <th scope="col" class="text-end">@T("Mandatory total", "إجمالي الإلزامي")</th>
                                    <th scope="col">@T("Outcome", "النتيجة")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.BulkRows)
                                {
                                    var hint = InstallmentLabels.GradeOutcomeHint(r.Line.Outcome, isRtl);
                                    <tr>
                                        <td>
                                            <span class="text-muted small">@r.Student.StudentNo</span>
                                            <span class="ms-1">@FinanceLabels.StudentName(r.Student, isRtl)</span>
                                        </td>
                                        <td>@(r.Payer == null ? "—" : FinanceLabels.ParentName(r.Payer, isRtl))</td>
                                        <td class="text-end">@(r.Line.MandatoryTotal > 0m ? r.Line.MandatoryTotal.ToString("N2") : "—")</td>
                                        <td>
                                            <span class="badge @InstallmentLabels.GradeOutcomeBadge(r.Line.Outcome)">@InstallmentLabels.GradeOutcome(r.Line.Outcome, isRtl)</span>
                                            @if (r.Line.Outcome == GradeAssignmentOutcome.AlreadyPlanned && r.Line.PlanAssignmentId is int existingId)
                                            {
                                                <a class="btn btn-sm btn-link p-0 ms-1" asp-action="Schedule" asp-route-id="@existingId">@T("Open", "فتح")</a>
                                            }
                                            @if (hint.Length > 0)
                                            {
                                                <div class="form-text mt-0">@hint</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (ready == 0)
                    {
                        <div class="alert alert-secondary mb-0">@T("Nothing left to schedule in this grade with this template.", "لا شيء متبقٍّ للجدولة في هذا الصف بهذا القالب.")</div>
                    }
                    else
                    {
                        <form method="post" asp-action="AssignGrade"
                              onsubmit="return confirm('@T($"Generate {ready} schedule(s) for this grade from its mandatory fees?", $"توليد {ready} جدولاً لهذا الصف من رسومه الإلزامية؟")');">
                            <input type="hidden" name="bulkGradeId" value="@Model.BulkGradeId" />
                            <input type="hidden" name="bulkTemplateId" value="@Model.BulkTemplateId" />
                            <input type="hidden" name="year" value="@yid" />
                            <input type="hidden" name="q" value="@Model.Q" />
                            <input type="hidden" name="payerQ" value="@Model.PayerQ" />
                            <input type="hidden" name="gradeId" value="@Model.GradeId" />
                            <button class="btn btn-primary btn-sm" type="submit">
                                <i class="bi bi-calendar-plus" aria-hidden="true"></i> @T($"Generate {ready} schedule(s)", $"توليد {ready} جدولاً")
                            </button>
                        </form>
                    }
                }
            }
        }
    </div>
}

@if (Model.Selected == null)
{
    <div class="sms-card p-4 text-center text-muted">@T("Choose a student to assign a plan.", "اختر طالباً لإسناد خطة.")</div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="sms-card p-3">
                <h2 class="h6 mb-3">@T("Assign a plan", "إسناد خطة")</h2>
                @if (Model.ApprovedTemplates.Count == 0)
                {
                    <div class="alert alert-warning mb-0">@T("No approved template for this year. Approve one in the Template designer first.", "لا قالب معتمد لهذا العام. اعتمد قالباً في مصمّم القوالب أولاً.")</div>
                }
                else if (Model.Payers.Count == 0)
                {
                    <div class="alert alert-warning mb-0">@T("This student has no linked guardian, so there is no payer to bill.", "لا ولي أمر مرتبط بهذا الطالب، فلا يوجد دافع تُوجَّه إليه الفاتورة.")</div>
                }
                else
                {
                    <form method="post" asp-action="AssignPlan" asp-route-year="@yid">
                        <input type="hidden" name="studentId" value="@Model.Selected.Id" />
                        <input type="hidden" name="q" value="@Model.Q" />
                        <input type="hidden" name="payerQ" value="@Model.PayerQ" />
                        <input type="hidden" name="gradeId" value="@Model.GradeId" />
                        <div class="mb-2">
                            <label class="form-label small" for="payerId">@T("Payer", "الدافع")</label>
                            <select class="form-select form-select-sm" id="payerId" name="payerId" required>
                                @foreach (var p in Model.Payers.Where(x => x.Payer != null))
                                {
                                    var pname = FinanceLabels.ParentName(p.Parent, isRtl);
                                    var tag = p.IsFinanciallyResponsible ? T(" (financially responsible)", " (مسؤول مالياً)") : "";
                                    <option value="@p.Payer!.Id" selected="@(Model.PreferredPayerId == p.Payer.Id)">@pname@tag</option>
                                }
                            </select>
                            @if (Model.PreferredPayerId != null)
                            {
                                <div class="form-text">@T("Preselected from the payer filter.", "مُختار مسبقاً من فلتر الدافع.")</div>
                            }
                            @if (!Model.Payers.Any(p => p.Payer != null))
                            {
                                <div class="form-text text-danger">@T("No payer record exists for this family yet — create one from the Fees screen.", "لا سجل دافع لهذه الأسرة بعد — أنشئه من شاشة الرسوم.")</div>
                            }
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="planTemplateId">@T("Template", "القالب")</label>
                            <select class="form-select form-select-sm" id="planTemplateId" name="planTemplateId" required>
                                @foreach (var t in Model.ApprovedTemplates) { <option value="@t.Id">@(isRtl ? t.NameAr : t.NameEn)</option> }
                            </select>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" value="true" id="isException" name="isException" onchange="document.getElementById('excWrap').hidden = !this.checked; document.getElementById('exceptionReason').required = this.checked;" />
                            <label class="form-check-label small" for="isException">@T("Exception assignment", "إسناد استثنائي")</label>
                        </div>
                        <div class="mb-3" id="excWrap" hidden>
                            <label class="form-label small" for="exceptionReason">@T("Reason (required for an exception)", "السبب (إلزامي للاستثناء)")</label>
                            @* The label said "required" and nothing enforced it; the engine's refusal is the real
                               guard (BR-INS-002), this only stops the officer making the round trip to hear it.
                               required is toggled with the checkbox, never left on a hidden field — the browser
                               refuses to submit a form whose invalid control cannot be focused, silently. *@
                            <input class="form-control form-control-sm" id="exceptionReason" name="exceptionReason" />
                        </div>
                        <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-calendar-plus" aria-hidden="true"></i> @T("Generate schedule", "توليد الجدول")</button>
                    </form>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="sms-card p-3">
                <h2 class="h6 mb-3">@T("Existing plans this year", "الخطط القائمة هذا العام")</h2>
                @if (Model.Existing.Count == 0)
                {
                    <p class="text-muted small mb-0">@T("None yet.", "لا شيء بعد.")</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var e in Model.Existing)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>
                                    @(isRtl ? e.Template.NameAr : e.Template.NameEn)
                                    @if (e.Assignment.IsException) { <span class="badge text-bg-warning ms-1">@T("Exception", "استثناء")</span> }
                                    @if (e.Assignment.RescheduleCount > 0) { <span class="badge text-bg-info ms-1">@T("Rescheduled", "أُعيدت جدولته") ×@e.Assignment.RescheduleCount</span> }
                                </span>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Schedule" asp-route-id="@e.Assignment.Id">@T("Open", "فتح")</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}
