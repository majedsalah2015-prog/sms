@using System.Globalization
@model YearDefinitionViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("New academic year", "عام دراسي جديد");
    ViewData["Breadcrumb"] = T("Academic Years / New", "الأعوام الدراسية / جديد");
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("6–14 months, no overlap with another year; labels are generated from the dates when left blank (BR-AYR-001). The year starts in Preparation.", "من 6 إلى 14 شهراً وبلا تداخل مع عام آخر؛ تُولَّد التسميات من التواريخ إن تُركت فارغة (BR-AYR-001). يبدأ العام في مرحلة الإعداد.")</p></div></div>

<div class="sms-card p-4" style="max-width:760px">
    <form method="post" asp-action="Define" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6"><label class="form-label" asp-for="StartDate">@T("Start date", "تاريخ البداية") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="StartDate" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" required aria-required="true" /></div>
            <div class="col-md-6"><label class="form-label" asp-for="EndDate">@T("End date", "تاريخ النهاية") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="EndDate" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" required aria-required="true" /></div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-4"><label class="form-label" asp-for="LabelEn">@T("Label (English)", "التسمية (إنجليزي)")</label><input asp-for="LabelEn" class="form-control" dir="ltr" placeholder="2027-2028" /></div>
            <div class="col-md-4"><label class="form-label" asp-for="LabelAr">@T("Label (Arabic)", "التسمية (عربي)")</label><input asp-for="LabelAr" class="form-control" dir="rtl" placeholder="2027-2028" /></div>
            <div class="col-md-4"><label class="form-label" asp-for="HijriLabel">@T("Hijri label", "التسمية الهجرية")</label><input asp-for="HijriLabel" class="form-control" dir="rtl" placeholder="1449هـ" /></div>
        </div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("Create year", "إنشاء العام")</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@T("Cancel", "إلغاء")</a>
    </form>
</div>
