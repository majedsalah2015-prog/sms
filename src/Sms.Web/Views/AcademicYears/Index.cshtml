@using System.Globalization
@using Sms.Domain.Schools
@model YearBoardViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Academic years", "الأعوام الدراسية");
    ViewData["Breadcrumb"] = T("Academic Years / Status board", "الأعوام الدراسية / لوحة الحالة");
    string Name(AcademicYearStatus s) => s switch { AcademicYearStatus.Preparation => T("Preparation", "إعداد"), AcademicYearStatus.Active => T("Active", "نشط"), AcademicYearStatus.Closing => T("Closing", "قيد الإغلاق"), AcademicYearStatus.Closed => T("Closed", "مغلق"), AcademicYearStatus.Archived => T("Archived", "مؤرشف"), _ => s.ToString() };
    string Badge(AcademicYearStatus s) => s switch { AcademicYearStatus.Active => "text-bg-success", AcademicYearStatus.Preparation => "text-bg-primary", AcademicYearStatus.Closing => "text-bg-warning", AcademicYearStatus.Closed => "text-bg-secondary", _ => "text-bg-dark" };
    var help = new HelpPanelViewModel
    {
        Id = "years-help",
        Title = T("Academic years — help", "الأعوام الدراسية — مساعدة"),
        Intro = T("The board every other module reads from (doc/Modules/03 §8). Almost everything in this system is scoped to a year — enrolments, marks, fees, timetables — so which year is Active and which year you are working in are two of the most consequential settings in the product.", "اللوحة التي تقرأ منها بقية الوحدات (الوثيقة 03 §8). فكل شيء تقريباً في هذا النظام مرتبط بعام — التسجيل والدرجات والرسوم والجداول — ولذلك فإن العام النشط والعام الذي تعمل فيه من أهم إعدادات المنتج أثراً."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("One Active, one in Preparation", "نشط واحد وإعداد واحد"), T("Exactly one year may be Active and at most one may be in Preparation (BR-AYR-002). That is what lets next year be built — semesters, sections, fee structures — while this year is still running, without either one having to guess which set of data it belongs to.", "يمكن أن يكون عام واحد فقط نشطاً وعام واحد على الأكثر في الإعداد (BR-AYR-002). وهذا ما يتيح بناء العام القادم — فصولاً وشعباً وهياكل رسوم — بينما العام الحالي يعمل، دون أن يضطر أحدهما إلى تخمين البيانات التي يخصّها.")),
            new HelpPanelViewModel.Item(T("Working year vs Active year", "عام العمل مقابل العام النشط"), T("They are not the same thing and the banner appears when they differ. The Active year is the school's operational reality; the working year is the one your screens are currently reading and writing. Preparing next year means deliberately working in a year that is not the active one — check the banner before wondering why today's marks are not showing.", "ليسا الشيء نفسه، ويظهر الشريط عند اختلافهما. فالعام النشط هو واقع المدرسة التشغيلي؛ وعام العمل هو الذي تقرأ منه شاشاتك وتكتب فيه الآن. وتحضير العام القادم يعني العمل قصداً في عام غير النشط — فانظر إلى الشريط قبل أن تتساءل لماذا لا تظهر درجات اليوم.")),
            new HelpPanelViewModel.Item(T("The status ladder only goes forward", "سلم الحالات يمضي إلى الأمام فقط"), T("Preparation → Active → Closing → Closed → Archived. Closing is the working phase where results are finalised and the year is rolled over; Closed and Archived are read-only. There is no step back, so activation and closure are decisions, not navigation.", "إعداد ← نشط ← قيد الإغلاق ← مغلق ← مؤرشف. ومرحلة «قيد الإغلاق» هي مرحلة العمل التي تُعتمد فيها النتائج ويُرحَّل العام؛ أما المغلق والمؤرشف فللقراءة فقط. ولا خطوة إلى الوراء، فالتفعيل والإغلاق قراران لا تنقُّل.")),
            new HelpPanelViewModel.Item(T("Before the first year can activate", "قبل تفعيل أول عام"), T("A school still in Setup cannot activate its first academic year (BR-SET-003) — finish the setup wizard's mandatory steps first. After that, activation is what opens enrolment, attendance and the fee calendar for the year.", "المدرسة التي لا تزال في حالة الإعداد لا يمكنها تفعيل أول عام دراسي (BR-SET-003) — فأكمل خطوات المعالج الإلزامية أولاً. وبعدها يكون التفعيل هو ما يفتح التسجيل والحضور وتقويم الرسوم للعام.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Preparation → Active → Closing → Closed → Archived; exactly one Active, at most one in Preparation (BR-AYR-002).", "إعداد → نشط → قيد الإغلاق → مغلق → مؤرشف؛ عام نشط واحد فقط وعام إعداد واحد على الأكثر (BR-AYR-002).")</p></div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-primary" asp-action="Define"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("New academic year", "عام دراسي جديد")</a>
        <partial name="_HelpModal" model="help" />
    </div></div>

@if (Model.WorkingYear != null && Model.ActiveYear != null && Model.WorkingYear.Id != Model.ActiveYear.Id)
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>@T("Your working year", "عام العمل الحالي") <strong>@(isRtl ? Model.WorkingYear.LabelAr : Model.WorkingYear.LabelEn)</strong> @T("is not the Active year (BR-AYR-010).", "ليس العام النشط (BR-AYR-010).")</div>
}
@if (!Model.SetupComplete && Model.Rows.All(r => r.Year.Status == AcademicYearStatus.Preparation))
{
    <div class="alert alert-info py-2"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@T("The first activation is gated on the Setup wizard (BR-SET-003).", "أول تفعيل مشروط باكتمال معالج الإعداد (BR-SET-003).") <a asp-controller="Setup" asp-action="Index">@T("Open wizard", "فتح المعالج")</a></div>
}

@if (Model.Rows.Count == 0)
{
    <div class="sms-card p-4 text-center text-muted">@T("No academic years yet.", "لا توجد أعوام دراسية بعد.")</div>
}
@foreach (var r in Model.Rows)
{
    var y = r.Year;
    <div class="sms-card mb-3">
        <div class="p-3 d-flex flex-wrap align-items-center gap-3">
            <div class="flex-grow-1">
                <a class="h5 mb-0 d-inline-block" asp-action="Details" asp-route-id="@y.Id">@(isRtl ? y.LabelAr : y.LabelEn)</a> <span class="text-muted">@y.HijriLabel</span>
                <span class="badge @Badge(y.Status) ms-2">@Name(y.Status)</span>
                @if (y.Id == Model.WorkingYearId) { <span class="badge text-bg-light border ms-1">@T("working year", "عام العمل")</span> }
                <div class="small text-muted mt-1"><bdi>@y.StartDate.ToString("yyyy-MM-dd") → @y.EndDate.ToString("yyyy-MM-dd")</bdi> · @r.Semesters @T("semesters", "فصول") · @r.Terms @T("terms", "فترات")@if (y.ClosingEndsOn != null) { <text> · @T("closing window ends", "تنتهي نافذة الإغلاق") <bdi>@y.ClosingEndsOn?.ToString("yyyy-MM-dd")</bdi></text> }</div>
            </div>
            <div class="d-flex gap-2 align-items-center">
                @if (y.Status == AcademicYearStatus.Preparation)
                {
                    <form method="post" asp-action="Activate" asp-route-id="@y.Id" class="d-flex gap-1"><input name="reason" id="activate-reason-@y.Id" class="form-control form-control-sm" placeholder="@T("reason", "السبب")" aria-label="@T($"Activation reason — {y.LabelEn}", $"سبب التفعيل — {y.LabelAr}")" style="width:11rem" /><button class="btn btn-sm btn-success" type="submit"><i class="bi bi-play-fill" aria-hidden="true"></i> @T("Activate", "تفعيل")</button></form>
                }
                else if (y.Status == AcademicYearStatus.Closing)
                {
                    <form method="post" asp-action="Close" asp-route-id="@y.Id" class="d-flex gap-1"><input name="reason" id="close-reason-@y.Id" class="form-control form-control-sm" placeholder="@T("reason", "السبب")" aria-label="@T($"Closing reason — {y.LabelEn}", $"سبب الإغلاق — {y.LabelAr}")" style="width:11rem" /><button class="btn btn-sm btn-warning" type="submit"><i class="bi bi-lock" aria-hidden="true"></i> @T("Close", "إغلاق")</button></form>
                }
                else if (y.Status == AcademicYearStatus.Closed)
                {
                    <form method="post" asp-action="Archive" asp-route-id="@y.Id" class="d-flex gap-1"><input name="reason" id="archive-reason-@y.Id" class="form-control form-control-sm" placeholder="@T("reason", "السبب")" aria-label="@T($"Archive reason — {y.LabelEn}", $"سبب الأرشفة — {y.LabelAr}")" style="width:11rem" /><button class="btn btn-sm btn-outline-dark" type="submit"><i class="bi bi-archive" aria-hidden="true"></i> @T("Archive", "أرشفة")</button></form>
                }
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@y.Id"><i class="bi bi-calendar-range" aria-hidden="true"></i> @T("Structure", "الهيكل")</a>
                @if (r.CanEditOrDelete)
                {
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@y.Id" title="@T("No students enrolled — the year can still be edited.", "لا يوجد طلاب مسجلون — يمكن تعديل العام.")"><i class="bi bi-pencil" aria-hidden="true"></i> @T("Edit", "تعديل")</a>
                    <form method="post" asp-action="Delete" asp-route-id="@y.Id" class="d-inline" onsubmit="return confirm('@T("Delete this academic year and its semesters/terms? This cannot be undone.", "حذف هذا العام الدراسي وفصوله وفتراته؟ لا يمكن التراجع.")');">
                        <button class="btn btn-sm btn-outline-danger" type="submit" title="@T("No students enrolled — the year can be deleted.", "لا يوجد طلاب مسجلون — يمكن حذف العام.")"><i class="bi bi-trash" aria-hidden="true"></i> @T("Delete", "حذف")</button>
                    </form>
                }
                else
                {
                    <span class="badge text-bg-light border" title="@T("Edit/delete are disabled because students are enrolled in this year.", "التعديل/الحذف معطّلان لوجود طلاب مسجلين في هذا العام.")"><i class="bi bi-people me-1" aria-hidden="true"></i>@r.Enrollments @T("enrolled", "مسجل")</span>
                }
            </div>
        </div>
        @if (r.OpeningChecklist.Count > 0 || r.ClosingChecklist.Count > 0)
        {
            var items = r.OpeningChecklist.Count > 0 ? r.OpeningChecklist : r.ClosingChecklist;
            <div class="px-3 pb-3">
                <div class="small fw-semibold text-muted mb-1">@(r.OpeningChecklist.Count > 0 ? T("Opening checklist (BR-AYR-004)", "قائمة الافتتاح (BR-AYR-004)") : T("Closing checklist (BR-AYR-005)", "قائمة الإغلاق (BR-AYR-005)"))</div>
                <div class="d-flex flex-wrap gap-2">@foreach (var i in items) { <span class="badge @(i.IsSatisfied ? "text-bg-success" : "text-bg-danger")" title="@i.Detail">@(i.IsSatisfied ? "✓" : "✗") @i.Code</span> }</div>
            </div>
        }
        else if (y.Status == AcademicYearStatus.Preparation && Model.Rows.Any(x => x.Year.Status == AcademicYearStatus.Active))
        {
            <div class="px-3 pb-3 small text-muted"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@T("Opening checklist appears once a rollover batch is opened from the Active year (WF-02 cockpit — E-801 screens).", "تظهر قائمة الافتتاح بعد فتح دفعة ترحيل من العام النشط (WF-02 — شاشات E-801).")</div>
        }
    </div>
}
