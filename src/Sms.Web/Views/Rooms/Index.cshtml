@using System.Globalization
@using Sms.Domain.Grades
@model RoomCatalogViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Classrooms", "القاعات الدراسية");
    ViewData["Breadcrumb"] = T("Classrooms / Catalog", "القاعات / الدليل");
    string Gender(GenderPolicy g) => g switch { GenderPolicy.Boys => T("Boys wing", "جناح بنين"), GenderPolicy.Girls => T("Girls wing", "جناح بنات"), _ => T("Mixed", "مشترك") };
    var help = new HelpPanelViewModel
    {
        Id = "rooms-help",
        Title = T("Classrooms — help", "القاعات الدراسية — مساعدة"),
        Intro = T("The room catalog is a building → floor → room tree. Every room has a unique code, a type, standard and exam capacities, a wing tag and feature tags; sections and bookings reference rooms from here.", "دليل القاعات شجرة مبنى → طابق → قاعة. لكل قاعة رمز فريد ونوع وسعة عادية وسعة اختبار ووسم جناح وتجهيزات؛ وتشير إليها الشعب والحجوزات."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Buildings & floors", "المباني والطوابق"), T("Create from the side cards. ✎ renames (and re-orders / re-parents a floor); 🗑 removes a building with no floors or a floor with no rooms.", "أنشئها من البطاقات الجانبية. ✎ يعيد التسمية (ويعيد ترتيب/نقل الطابق)؛ 🗑 يحذف مبنى بلا طوابق أو طابقاً بلا قاعات.")),
            new HelpPanelViewModel.Item(T("Rooms", "القاعات"), T("Code unique per school (BR-ROM-001); exam capacity ≤ standard capacity (BR-ROM-002); the wing tag limits which sections may use it (BR-ROM-003). 'Open' shows features, maintenance windows, bookings and the sections using it.", "الرمز فريد على مستوى المدرسة (BR-ROM-001)؛ سعة الاختبار ≤ السعة العادية (BR-ROM-002)؛ وسم الجناح يحدد الشعب التي يمكنها استخدامها (BR-ROM-003). «فتح» يعرض التجهيزات ونوافذ الصيانة والحجوزات والشعب المستخدمة.")),
            new HelpPanelViewModel.Item(T("Edit ✎ / Delete 🗑 a room", "تعديل ✎ / حذف 🗑 قاعة"), T("Edit changes floor, code, names, type, capacities and wing. Delete deactivates the room (bookings and history stay) and is refused while an active section uses it as its default classroom.", "التعديل يغيّر الطابق والرمز والأسماء والنوع والسعات والجناح. الحذف يلغي تفعيل القاعة (تبقى الحجوزات والسجل) ويُرفض ما دامت شعبة نشطة تستخدمها كقاعة افتراضية.")),
            new HelpPanelViewModel.Item(T("Unavailable today", "غير متاحة اليوم"), T("A maintenance / reserved window covers today (BR-ROM-004) — set from the room page; bookings inside such windows are refused.", "نافذة صيانة/حجز تغطي اليوم (BR-ROM-004) — تُضبط من صفحة القاعة؛ وتُرفض الحجوزات داخلها.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Building → floor → room tree with standard/exam capacity, wing tag and feature tags (BR-ROM-001/002/003).", "شجرة مبنى → طابق → قاعة مع السعة العادية/الاختبارية ووسم الجناح والتجهيزات (BR-ROM-001/002/003).") · @Model.TotalRooms @T("rooms", "قاعة") · @Model.TotalSeats @T("seats", "مقعد")</p></div>
    <partial name="_HelpModal" model="help" /></div>

<div class="row g-3">
    <div class="col-xl-8">
        @foreach (var b in Model.Buildings)
        {
            <div class="sms-card mb-3">
                <div class="p-3 border-bottom d-flex align-items-center gap-2"><h2 class="h6 mb-0"><i class="bi bi-building me-1" aria-hidden="true"></i>@(isRtl ? b.Building.Name.NameAr : b.Building.Name.NameEn)</h2>
                    <span class="ms-auto d-flex gap-1">
                        <a class="btn btn-sm btn-outline-primary" asp-action="EditBuilding" asp-route-id="@b.Building.Id" title="@T("Edit building", "تعديل المبنى")"><i class="bi bi-pencil" aria-hidden="true"></i> @T("Edit", "تعديل")</a>
                        <form method="post" asp-action="DeleteBuilding" asp-route-id="@b.Building.Id" class="d-inline" onsubmit="return confirm('@T("Remove this building?", "حذف هذا المبنى؟")');"><button class="btn btn-sm btn-outline-danger" type="submit" title="@(b.Floors.Count > 0 ? T("Remove its floors first", "احذف طوابقه أولاً") : T("Remove building", "حذف المبنى"))" disabled="@(b.Floors.Count > 0)"><i class="bi bi-trash" aria-hidden="true"></i> @T("Delete", "حذف")</button></form>
                    </span></div>
                @foreach (var f in b.Floors)
                {
                    <div class="px-3 pt-2 small fw-semibold text-muted d-flex align-items-center gap-2"><span><i class="bi bi-layers me-1" aria-hidden="true"></i>@(isRtl ? f.Floor.Name.NameAr : f.Floor.Name.NameEn)</span>
                        <span class="ms-auto d-flex gap-1">
                            <a class="btn btn-sm btn-link p-0" asp-action="EditFloor" asp-route-id="@f.Floor.Id" title="@T("Edit floor", "تعديل الطابق")" aria-label="@T("Edit floor", "تعديل الطابق")"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            <form method="post" asp-action="DeleteFloor" asp-route-id="@f.Floor.Id" class="d-inline" onsubmit="return confirm('@T("Remove this floor?", "حذف هذا الطابق؟")');"><button class="btn btn-sm btn-link text-danger p-0" type="submit" title="@(f.Rooms.Count > 0 ? T("Remove its rooms first", "احذف قاعاته أولاً") : T("Remove floor", "حذف الطابق"))" aria-label="@(f.Rooms.Count > 0 ? T("Remove its rooms first", "احذف قاعاته أولاً") : T("Remove floor", "حذف الطابق"))" disabled="@(f.Rooms.Count > 0)"><i class="bi bi-trash" aria-hidden="true"></i></button></form>
                        </span></div>
                    <div class="table-responsive"><table class="table table-sm sms-table mb-2">
                        <caption class="visually-hidden">@T("Rooms:", "قاعات:") @(isRtl ? f.Floor.Name.NameAr : f.Floor.Name.NameEn)</caption>
                        <thead><tr><th scope="col">@T("Code", "الرمز")</th><th scope="col">@T("Room", "القاعة")</th><th scope="col">@T("Type", "النوع")</th><th scope="col">@T("Std / exam", "عادية / اختبار")</th><th scope="col">@T("Wing", "الجناح")</th><th scope="col">@T("Features", "التجهيزات")</th><th scope="col">@T("Sections", "الشعب")</th><th scope="col"><span class="visually-hidden">@T("Actions", "إجراءات")</span></th></tr></thead>
                        <tbody>@foreach (var r in f.Rooms) { <tr class="@(r.Room.IsActive ? "" : "text-muted")"><td><code>@r.Room.Code</code></td><td><a asp-action="Details" asp-route-id="@r.Room.Id" class="fw-semibold">@(isRtl ? r.Room.Name.NameAr : r.Room.Name.NameEn)</a>@if (r.UnavailableNow) { <span class="badge text-bg-warning ms-1">@T("unavailable today", "غير متاحة اليوم")</span> }</td><td>@r.TypeName</td><td>@r.Room.StandardCapacity / @r.Room.ExamCapacity</td><td>@Gender(r.Room.WingTag)</td><td>@foreach (var ft in r.Features) { <span class="badge text-bg-light border me-1">@ft</span> }</td><td>@(r.SectionsUsing?.ToString() ?? "—")</td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@r.Room.Id">@T("Open", "فتح")</a> <a class="btn btn-sm btn-outline-primary" asp-action="EditRoom" asp-route-id="@r.Room.Id" title="@T("Edit room", "تعديل القاعة")" aria-label="@T("Edit room", "تعديل القاعة")"><i class="bi bi-pencil" aria-hidden="true"></i></a> <form method="post" asp-action="DeleteRoom" asp-route-id="@r.Room.Id" class="d-inline" onsubmit="return confirm('@T("Remove this room?", "حذف هذه القاعة؟")');"><button class="btn btn-sm btn-outline-danger" type="submit" title="@((r.SectionsUsing ?? 0) > 0 ? T("Sections use this room — reassign them first", "شعب تستخدم هذه القاعة — أعد إسنادها أولاً") : T("Remove room", "حذف القاعة"))" aria-label="@((r.SectionsUsing ?? 0) > 0 ? T("Sections use this room — reassign them first", "شعب تستخدم هذه القاعة — أعد إسنادها أولاً") : T("Remove room", "حذف القاعة"))" disabled="@((r.SectionsUsing ?? 0) > 0)"><i class="bi bi-trash" aria-hidden="true"></i></button></form></td></tr> }
                        @if (f.Rooms.Count == 0) { <tr><td colspan="8" class="small text-muted text-center py-2">@T("No rooms on this floor.", "لا قاعات في هذا الطابق.")</td></tr> }</tbody>
                    </table></div>
                }
                @if (b.Floors.Count == 0) { <div class="p-3 small text-muted">@T("No floors yet.", "لا طوابق بعد.")</div> }
            </div>
        }
        @if (Model.Buildings.Count == 0) { <div class="sms-card p-4 text-center text-muted">@T("No buildings yet — create the first one.", "لا مبانٍ بعد — أنشئ الأول.")</div> }
    </div>
    <div class="col-xl-4">
        <div class="sms-card p-3 mb-3"><h2 class="h6">@T("New building", "مبنى جديد")</h2>
            <form method="post" asp-action="DefineBuilding"><div class="row g-2 mb-2"><div class="col-6"><input asp-for="BuildingNameAr" class="form-control form-control-sm" dir="rtl" placeholder="المبنى الرئيسي" /></div><div class="col-6"><input asp-for="BuildingNameEn" class="form-control form-control-sm" dir="ltr" placeholder="Main building" /></div></div><button class="btn btn-sm btn-outline-primary w-100" type="submit">@T("Create building", "إنشاء مبنى")</button></form></div>
        <div class="sms-card p-3 mb-3"><h2 class="h6">@T("New floor", "طابق جديد")</h2>
            <form method="post" asp-action="DefineFloor"><div class="mb-2"><select asp-for="FloorBuildingId" class="form-select form-select-sm"><option value="">@T("— building —", "— المبنى —")</option>@foreach (var b in Model.Buildings) { <option value="@b.Building.Id">@(isRtl ? b.Building.Name.NameAr : b.Building.Name.NameEn)</option> }</select></div>
                <div class="row g-2 mb-2"><div class="col-5"><input asp-for="FloorNameAr" class="form-control form-control-sm" dir="rtl" placeholder="الطابق الأول" /></div><div class="col-5"><input asp-for="FloorNameEn" class="form-control form-control-sm" dir="ltr" placeholder="Floor 1" /></div><div class="col-2"><input asp-for="FloorOrder" class="form-control form-control-sm" type="number" min="0" /></div></div><button class="btn btn-sm btn-outline-primary w-100" type="submit">@T("Create floor", "إنشاء طابق")</button></form></div>
        <div class="sms-card p-3"><h2 class="h6">@T("New room", "قاعة جديدة")</h2>
            <form method="post" asp-action="DefineRoom">
                <div class="mb-2"><select asp-for="RoomFloorId" class="form-select form-select-sm"><option value="">@T("— floor —", "— الطابق —")</option>@foreach (var f in Model.Floors) { <option value="@f.Id">@(isRtl ? f.BuildingAr : f.BuildingEn) / @(isRtl ? f.Ar : f.En)</option> }</select></div>
                <div class="row g-2 mb-2"><div class="col-4"><input asp-for="RoomCode" class="form-control form-control-sm" dir="ltr" placeholder="A-101" /></div><div class="col-8"><select asp-for="RoomTypeId" class="form-select form-select-sm"><option value="">@T("— type —", "— النوع —")</option>@foreach (var t in Model.RoomTypes) { <option value="@t.Id">@(isRtl ? t.Ar : t.En)</option> }</select></div></div>
                <div class="row g-2 mb-2"><div class="col-6"><input asp-for="RoomNameAr" class="form-control form-control-sm" dir="rtl" placeholder="قاعة 101" /></div><div class="col-6"><input asp-for="RoomNameEn" class="form-control form-control-sm" dir="ltr" placeholder="Room 101" /></div></div>
                <div class="row g-2 mb-2"><div class="col-4"><label class="form-label small">@T("Std cap.", "سعة")</label><input asp-for="StandardCapacity" class="form-control form-control-sm" type="number" min="1" /></div><div class="col-4"><label class="form-label small">@T("Exam cap.", "اختبار")</label><input asp-for="ExamCapacity" class="form-control form-control-sm" type="number" min="1" /></div><div class="col-4"><label class="form-label small">@T("Wing", "الجناح")</label><select asp-for="WingTag" class="form-select form-select-sm">@foreach (GenderPolicy g in Enum.GetValues(typeof(GenderPolicy))) { <option value="@g">@Gender(g)</option> }</select></div></div>
                <button class="btn btn-sm btn-primary w-100" type="submit">@T("Create room", "إنشاء قاعة")</button>
                <div class="form-text">@T("Exam capacity ≤ standard capacity (BR-ROM-002).", "سعة الاختبار ≤ السعة العادية (BR-ROM-002).")</div>
            </form></div>
    </div>
</div>
