@using System.Globalization
@using Sms.Domain.Grades
@model RoomEditViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    string Gender(GenderPolicy g) => g switch { GenderPolicy.Boys => T("Boys wing", "جناح بنين"), GenderPolicy.Girls => T("Girls wing", "جناح بنات"), _ => T("Mixed", "مشترك") };
    var kindLabel = Model.Kind switch { "building" => T("building", "المبنى"), "floor" => T("floor", "الطابق"), _ => T("room", "القاعة") };
    ViewData["Title"] = T("Edit ", "تعديل ") + kindLabel + " — " + (isRtl ? Model.NameAr : Model.NameEn);
    ViewData["Breadcrumb"] = T("Classrooms / Edit", "القاعات / تعديل");
    var action = Model.Kind switch { "building" => "EditBuilding", "floor" => "EditFloor", _ => "EditRoom" };
    var help = new HelpPanelViewModel
    {
        Id = "room-edit-help",
        Title = T("Edit — help", "تعديل — مساعدة"),
        Intro = T("One node of the building → floor → room tree (doc/Modules/12 §8). The same form edits all three; which fields appear depends on what you opened.", "عقدة واحدة من شجرة مبنى ← طابق ← قاعة (الوثيقة 12 §8). والنموذج نفسه يعدّل الثلاثة؛ والحقول الظاهرة تتبع ما فتحته."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Room codes are unique per school", "رموز القاعات فريدة على مستوى المدرسة"), T("Not per floor or per building (BR-ROM-001) — the code is what people say out loud and write on a timetable, and two rooms sharing one is exactly the confusion the rule prevents.", "لا لكل طابق ولا لكل مبنى (BR-ROM-001) — فالرمز هو ما ينطق به الناس ويكتبونه في الجدول، وتشارك قاعتين فيه هو بالضبط اللبس الذي تمنعه القاعدة.")),
            new HelpPanelViewModel.Item(T("Exam capacity is not the same seat count", "سعة الاختبار ليست العدد نفسه"), T("It must be less than or equal to the standard capacity (BR-ROM-002), because exam seating spaces students out. Setting them equal is allowed but usually means the exam figure has not been thought about.", "يجب أن تكون أقل من أو تساوي السعة العادية (BR-ROM-002)، لأن جلوس الاختبارات يباعد بين الطلاب. وتساويهما مسموح لكنه يعني عادةً أن رقم الاختبار لم يُفكَّر فيه.")),
            new HelpPanelViewModel.Item(T("Moving a floor moves its rooms", "نقل الطابق ينقل قاعاته"), T("Re-parenting a floor to another building takes everything on it along. The room codes do not change — they were never scoped to the building in the first place.", "إعادة إسناد طابق إلى مبنى آخر تأخذ كل ما عليه معه. ورموز القاعات لا تتغير — فهي لم تكن مرتبطة بالمبنى أصلاً.")),
            new HelpPanelViewModel.Item(T("The wing tag limits who can use the room", "وسم الجناح يحدّد من يستخدم القاعة"), T("A boys-wing room cannot be the home room of a girls section (BR-ROM-003). Changing the tag on a room already in use is refused rather than silently breaking the section that depends on it.", "قاعة جناح البنين لا تصلح قاعةً أساسية لشعبة بنات (BR-ROM-003). وتغيير الوسم على قاعة قيد الاستخدام يُرفض بدل كسر الشعبة المعتمدة عليها بصمت.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">
    @if (Model.Kind == "room") { @T("Room code is unique per school (BR-ROM-001); exam capacity ≤ standard capacity (BR-ROM-002).", "رمز القاعة فريد على مستوى المدرسة (BR-ROM-001)؛ سعة الاختبار ≤ السعة العادية (BR-ROM-002).") }
    else if (Model.Kind == "floor") { @T("Floor names/order and the building it belongs to.", "أسماء الطابق وترتيبه والمبنى الذي يتبعه.") }
    else { @T("Building names.", "أسماء المبنى.") }
</p></div>
    <partial name="_HelpModal" model="help" /></div>

<div class="sms-card p-4" style="max-width:680px">
    <form method="post" asp-action="@action" asp-route-id="@Model.Id" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
        @if (Model.Kind == "floor")
        {
            <div class="row g-3 mb-3">
                <div class="col-md-8"><label class="form-label">@T("Building", "المبنى")</label><select asp-for="BuildingId" class="form-select"><option value="">@T("— building —", "— المبنى —")</option>@foreach (var b in Model.Buildings) { <option value="@b.Id">@(isRtl ? b.Name.NameAr : b.Name.NameEn)</option> }</select></div>
                <div class="col-md-4"><label class="form-label">@T("Order", "الترتيب")</label><input asp-for="Order" class="form-control" type="number" min="0" /></div>
            </div>
        }
        @if (Model.Kind == "room")
        {
            <div class="row g-3 mb-3">
                <div class="col-md-8"><label class="form-label">@T("Floor", "الطابق")</label><select asp-for="FloorId" class="form-select"><option value="">@T("— floor —", "— الطابق —")</option>@foreach (var f in Model.Floors) { <option value="@f.Id">@(isRtl ? f.BuildingAr : f.BuildingEn) / @(isRtl ? f.Ar : f.En)</option> }</select></div>
                <div class="col-md-4"><label class="form-label">@T("Code", "الرمز")</label><input asp-for="Code" class="form-control" dir="ltr" /></div>
            </div>
        }
        <div class="row g-3 mb-3">
            <div class="col-md-6"><label class="form-label">@T("Name (Arabic)", "الاسم (عربي)")</label><input asp-for="NameAr" class="form-control" dir="rtl" /></div>
            <div class="col-md-6"><label class="form-label">@T("Name (English)", "الاسم (إنجليزي)")</label><input asp-for="NameEn" class="form-control" dir="ltr" data-translit-from="#NameAr" data-translit-mode="term" /></div>
        </div>
        @if (Model.Kind == "room")
        {
            <div class="row g-3 mb-3">
                <div class="col-md-4"><label class="form-label">@T("Type", "النوع")</label><select asp-for="RoomTypeId" class="form-select"><option value="">@T("— type —", "— النوع —")</option>@foreach (var t in Model.RoomTypes) { <option value="@t.Id">@(isRtl ? t.Ar : t.En)</option> }</select></div>
                <div class="col-md-3"><label class="form-label">@T("Standard cap.", "السعة العادية")</label><input asp-for="StandardCapacity" class="form-control" type="number" min="1" /></div>
                <div class="col-md-2"><label class="form-label">@T("Exam cap.", "سعة الاختبار")</label><input asp-for="ExamCapacity" class="form-control" type="number" min="1" /></div>
                <div class="col-md-3"><label class="form-label">@T("Wing", "الجناح")</label><select asp-for="WingTag" class="form-select">@foreach (GenderPolicy g in Enum.GetValues(typeof(GenderPolicy))) { <option value="@g">@Gender(g)</option> }</select></div>
            </div>
        }
        <div class="small text-muted mb-3"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>
            @if (Model.Kind == "building") { <text>@Model.ChildCount @T("floor(s) in this building.", "طابق/طوابق في هذا المبنى.")</text> }
            else if (Model.Kind == "floor") { <text>@Model.ChildCount @T("room(s) on this floor.", "قاعة/قاعات في هذا الطابق.")</text> }
            else { <text>@Model.ChildCount @T("active section(s) use this room as default classroom.", "شعبة/شعب نشطة تستخدم هذه القاعة كقاعة افتراضية.")</text> }
        </div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>@T("Save changes", "حفظ التعديلات")</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@T("Cancel", "إلغاء")</a>
    </form>
</div>
