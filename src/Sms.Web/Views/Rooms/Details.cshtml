@using System.Globalization
@using Sms.Domain.Classrooms
@using Sms.Domain.Grades
@model RoomDetailViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var name = isRtl ? Model.Room.Name.NameAr : Model.Room.Name.NameEn;
    ViewData["Title"] = name;
    ViewData["Breadcrumb"] = T("Classrooms / ", "القاعات / ") + name;
    var today = DateTime.UtcNow.ToString("yyyy-MM-dd");
    string Gender(GenderPolicy g) => g switch { GenderPolicy.Boys => T("Boys wing", "جناح بنين"), GenderPolicy.Girls => T("Girls wing", "جناح بنات"), _ => T("Mixed", "مشترك") };
    var help = new HelpPanelViewModel
    {
        Id = "room-details-help",
        Title = T("Classroom — help", "القاعة — مساعدة"),
        Intro = T("One room, with everything that competes for it (doc/Modules/12 §8): its features, the windows it is unavailable in, its bookings, and the sections that call it home.", "قاعة واحدة، ومعها كل ما يتنافس عليها (الوثيقة 12 §8): تجهيزاتها ونوافذ عدم إتاحتها وحجوزاتها والشعب التي تتخذها قاعة أساسية."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Maintenance and reserved windows refuse bookings", "نوافذ الصيانة والحجز ترفض الحجوزات"), T("A window covering a date makes the room unavailable for it, and any booking inside that window is refused rather than warned about (BR-ROM-004). Close the window before trying to book through it.", "النافذة التي تغطي تاريخاً تجعل القاعة غير متاحة فيه، وأي حجز داخلها يُرفض لا يُنبَّه عليه (BR-ROM-004). فأغلق النافذة قبل محاولة الحجز خلالها.")),
            new HelpPanelViewModel.Item(T("Home room is not the same as booked", "القاعة الأساسية ليست الحجز"), T("A section's home room is where it sits by default; bookings are one-off claims on top of that. A room can be a home room and still be booked by someone else for a period the section does not use.", "قاعة الشعبة الأساسية هي مكانها الافتراضي؛ أما الحجوزات فمطالبات مفردة فوق ذلك. فقد تكون القاعة أساسية ومحجوزة لغيرها في حصة لا تستخدمها الشعبة.")),
            new HelpPanelViewModel.Item(T("Two capacities, two purposes", "سعتان لغرضين"), T("Standard is teaching occupancy; exam is the spaced-out seating the exam timetable allocates against. Both are read by different modules, so neither is a rounded guess.", "العادية هي إشغال التدريس؛ والاختبار هو الجلوس المتباعد الذي يوزّع عليه جدول الاختبارات. وتقرأ كلاً منهما وحدة مختلفة، فليست إحداهما تقديراً مقرَّباً.")),
            new HelpPanelViewModel.Item(T("Retiring a room keeps its history", "تقاعد القاعة يبقي سجلها"), T("Deactivation is refused while an active section uses it as a home room. Once retired, past bookings and timetables still name it — nothing here is hard-deleted.", "يُرفض إلغاء التفعيل ما دامت شعبة نشطة تتخذها قاعة أساسية. وبعد التقاعد تظل الحجوزات والجداول السابقة تسمّيها — فلا شيء هنا يُحذف نهائياً.")),
        },
    };
}

<div class="sms-page-head">
    <div><div class="text-muted small">@(isRtl ? Model.Building.Name.NameAr : Model.Building.Name.NameEn) / @(isRtl ? Model.Floor.Name.NameAr : Model.Floor.Name.NameEn) · @Model.TypeName</div>
        <h1 class="sms-page-title"><code>@Model.Room.Code</code> @name</h1>
        <div class="small text-muted">@T("Standard", "عادية") @Model.Room.StandardCapacity · @T("Exam", "اختبار") @Model.Room.ExamCapacity · @Gender(Model.Room.WingTag) @if (Model.SectionsUsing.Count > 0) { <text>· @T("home room of", "قاعة") @string.Join(", ", Model.SectionsUsing.Select(s => isRtl ? s.NameAr : s.NameEn))</text> }</div></div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1 @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i>@T("Catalog", "الدليل")</a>
        <partial name="_HelpModal" model="help" />
    </div>
</div>

@{
    string DayName(DayOfWeek d) => d switch
    {
        DayOfWeek.Sunday => T("Sunday", "الأحد"),
        DayOfWeek.Monday => T("Monday", "الاثنين"),
        DayOfWeek.Tuesday => T("Tuesday", "الثلاثاء"),
        DayOfWeek.Wednesday => T("Wednesday", "الأربعاء"),
        DayOfWeek.Thursday => T("Thursday", "الخميس"),
        DayOfWeek.Friday => T("Friday", "الجمعة"),
        _ => T("Saturday", "السبت"),
    };
}

<div class="row g-3">
    <div class="col-xl-8">
        @* doc/Modules/08 §8.2's "sessions from timetable overlaid read-only". Nothing
           here edits: a room does not own its timetable, Module 15 does. It answers
           "what happens in here", which is what somebody standing in the doorway asks. *@
        <div class="sms-card mb-3">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">@T("This room's week", "أسبوع هذه القاعة")</h2>
                <span class="small text-muted">@T("from the published timetable", "من الجدول المنشور")</span>
            </div>
            @if (Model.Week.Count == 0)
            {
                <div class="p-3 small text-muted">@T("Nothing is timetabled in this room — either no version is published for the working year, or no class is placed here.", "لا شيء مجدول في هذه القاعة — إما لا نسخة منشورة للعام الجاري، أو لا صفّ موضوع هنا.")</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-sm sms-table mb-0">
                    <caption class="visually-hidden">@T("This room's week", "أسبوع هذه القاعة")</caption>
                    <thead><tr><th scope="col">@T("Day", "اليوم")</th><th scope="col">@T("Period", "الحصة")</th><th scope="col">@T("Time", "الوقت")</th><th scope="col">@T("Section", "الشعبة")</th><th scope="col">@T("Subject", "المادة")</th><th scope="col">@T("Teacher", "المعلم")</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.Week)
                    {
                        <tr>
                            <td>@DayName(s.Day)</td>
                            <td>@s.SequenceNumber</td>
                            <td dir="ltr">@s.StartTime.ToString(@"hh\:mm") – @s.EndTime.ToString(@"hh\:mm")</td>
                            <td>@(s.SectionName ?? "—")</td>
                            <td>@(s.SubjectName ?? "—")</td>
                            <td>@(s.TeacherName ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>

        <div class="sms-card mb-3">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center"><h2 class="h6 mb-0">@T("Maintenance / reserved windows", "فترات الصيانة / الحجز")</h2><span class="small text-muted">BR-ROM-004</span></div>
            <div class="table-responsive"><table class="table table-sm sms-table mb-0"><caption class="visually-hidden">@T("Maintenance / reserved windows", "فترات الصيانة / الحجز")</caption><thead><tr><th scope="col">@T("Reason", "السبب")</th><th scope="col">@T("From", "من")</th><th scope="col">@T("To", "إلى")</th><th scope="col">@T("Sessions affected", "الحصص المتأثرة")</th><th scope="col">@T("Notes", "ملاحظات")</th></tr></thead>
                <tbody>@foreach (var u in Model.Unavailability) { <tr><td><span class="badge @(u.Reason == RoomAvailabilityReason.Maintenance ? "text-bg-warning" : "text-bg-info")">@(u.Reason == RoomAvailabilityReason.Maintenance ? T("Maintenance", "صيانة") : T("Reserved", "محجوزة"))</span></td><td>@u.StartDate.ToString("yyyy-MM-dd")</td><td>@u.EndDate.ToString("yyyy-MM-dd")</td><td>@{ var hit = Model.ImpactedSessions.TryGetValue(u.Id, out var hits) ? hits : 0; }<span class="badge @(hit > 0 ? "text-bg-danger" : "text-bg-light border")" title="@T("Timetabled sessions this window covers — closing the room costs them (doc/Modules/08 §8.3).", "الحصص المجدولة التي تغطيها هذه الفترة — وإغلاق القاعة يكلّفها (الوحدة 08 §8.3).")">@hit</span></td><td class="small">@u.Notes</td></tr> }
                @if (Model.Unavailability.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3">@T("Always available.", "متاحة دائماً.")</td></tr> }</tbody></table></div>
        </div>
        <div class="sms-card">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center"><h2 class="h6 mb-0">@T("Bookings", "الحجوزات")</h2><span class="small text-muted">@T("Free slots auto-approve; maintenance/reserved windows reject; teaching-session collisions need Timetable (M15).", "الفترات الحرة تُعتمد تلقائياً؛ فترات الصيانة تُرفض؛ تعارض الحصص يحتاج الجدول (M15).")</span></div>
            <div class="table-responsive"><table class="table table-sm sms-table mb-0"><caption class="visually-hidden">@T("Bookings", "الحجوزات")</caption><thead><tr><th scope="col">@T("Purpose", "الغرض")</th><th scope="col">@T("Start", "البداية")</th><th scope="col">@T("End", "النهاية")</th><th scope="col">@T("Status", "الحالة")</th></tr></thead>
                <tbody>@foreach (var b in Model.Bookings) { <tr><td>@b.Purpose</td><td>@b.StartUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@b.EndUtc.ToString("yyyy-MM-dd HH:mm")</td><td><span class="badge @(b.Status == RoomBookingStatus.Approved ? "text-bg-success" : b.Status == RoomBookingStatus.Rejected ? "text-bg-danger" : "text-bg-secondary")">@(b.Status == RoomBookingStatus.Approved ? T("Approved", "معتمد") : b.Status == RoomBookingStatus.Rejected ? T("Rejected", "مرفوض") : T("Requested", "مطلوب"))</span></td></tr> }
                @if (Model.Bookings.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3">@T("No bookings.", "لا حجوزات.")</td></tr> }</tbody></table></div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="sms-card p-3 mb-3"><h2 class="h6">@T("Features", "التجهيزات")</h2>
            <div class="d-flex flex-wrap gap-1 mb-2">@foreach (var f in Model.Features) { <span class="badge text-bg-light border">@(isRtl ? f.Ar : f.En)</span> }@if (Model.Features.Count == 0) { <span class="small text-muted">@T("None yet.", "لا شيء بعد.")</span> }</div>
            @if (Model.AvailableFeatures.Count > 0) { <form method="post" asp-action="AddFeature" asp-route-id="@Model.Room.Id" class="d-flex gap-1"><select name="featureLookupId" class="form-select form-select-sm" aria-label="@T("Feature", "التجهيز")">@foreach (var f in Model.AvailableFeatures) { <option value="@f.Id">@(isRtl ? f.Ar : f.En)</option> }</select><button class="btn btn-sm btn-outline-primary" type="submit" aria-label="@T("Add feature", "إضافة ميزة")"><i class="bi bi-plus-lg" aria-hidden="true"></i></button></form> }</div>
        <div class="sms-card p-3 mb-3"><h2 class="h6">@T("Set unavailable", "تعيين عدم التوفر")</h2>
            <form method="post" asp-action="SetUnavailable" asp-route-id="@Model.Room.Id">
                <div class="mb-2"><select name="reason" class="form-select form-select-sm" aria-label="@T("Reason", "السبب")"><option value="Maintenance">@T("Maintenance", "صيانة")</option><option value="Reserved">@T("Reserved", "محجوزة")</option></select></div>
                <div class="row g-2 mb-2"><div class="col-6"><input name="startDate" type="date" class="form-control form-control-sm" value="@today" required aria-required="true" aria-label="@T("Start date", "تاريخ البداية")" /></div><div class="col-6"><input name="endDate" type="date" class="form-control form-control-sm" value="@today" required aria-required="true" aria-label="@T("End date", "تاريخ النهاية")" /></div></div>
                <div class="mb-2"><input name="notes" class="form-control form-control-sm" placeholder="@T("notes", "ملاحظات")" aria-label="@T("Notes", "ملاحظات")" /></div>
                <button class="btn btn-sm btn-warning w-100" type="submit"><i class="bi bi-tools me-1" aria-hidden="true"></i>@T("Record window", "تسجيل الفترة")</button>
            </form></div>
        <div class="sms-card p-3"><h2 class="h6">@T("Request booking", "طلب حجز")</h2>
            <form method="post" asp-action="RequestBooking" asp-route-id="@Model.Room.Id">
                <div class="mb-2"><input name="purpose" class="form-control form-control-sm" placeholder="@T("purpose", "الغرض")" required aria-required="true" aria-label="@T("Purpose", "الغرض")" /></div>
                <div class="mb-2"><select name="academicYearId" class="form-select form-select-sm" aria-label="@T("Academic year", "العام الدراسي")">@foreach (var y in Model.Years) { <option value="@y.Id" selected="@(y.Id == Model.WorkingYearId)">@(isRtl ? y.LabelAr : y.LabelEn)</option> }</select></div>
                <div class="row g-2 mb-2"><div class="col-6"><input name="start" type="datetime-local" class="form-control form-control-sm" required aria-required="true" aria-label="@T("Start", "البداية")" /></div><div class="col-6"><input name="end" type="datetime-local" class="form-control form-control-sm" required aria-required="true" aria-label="@T("End", "النهاية")" /></div></div>
                <button class="btn btn-sm btn-primary w-100" type="submit"><i class="bi bi-calendar-check me-1" aria-hidden="true"></i>@T("Request", "طلب")</button>
            </form></div>
    </div>
</div>
