@using System.Globalization
@using Sms.Web.Navigation
@model ModuleCatalog.ModuleInfo
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var title = isRtl ? Model.TitleAr : Model.TitleEn;
    ViewData["Title"] = title;
    ViewData["Breadcrumb"] = (isRtl ? "الوحدات" : "Modules") + " / " + title;
    string T(string en, string ar) => isRtl ? ar : en;
    var help = new HelpPanelViewModel
    {
        Id = "module-overview-help",
        Title = T("Module overview — help", "نظرة عامة على الوحدة — مساعدة"),
        Intro = T("A landing page for one of the product's numbered modules: what it is for, and the screens inside it you are allowed to open.", "صفحة وصول لإحدى وحدات المنتج المرقّمة: ما غايتها، والشاشات التي بداخلها ويُسمح لك بفتحها."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("The module number is not decoration", "رقم الوحدة ليس زينة"), T("It is the same number the specification uses. Module 17 on this page is doc/Modules/17 in the documentation and BR-GRA-### in the business rules, so a question about a rule can be taken straight to the right document.", "هو الرقم نفسه الذي تستخدمه المواصفة. فالوحدة 17 في هذه الصفحة هي doc/Modules/17 في التوثيق و BR-GRA-### في قواعد العمل، فيمكن أخذ السؤال عن قاعدة إلى الوثيقة الصحيحة مباشرة.")),
            new HelpPanelViewModel.Item(T("A short list is not a broken page", "القائمة القصيرة ليست صفحة معطوبة"), T("Screens you have no permission for are not listed — the product hides what you cannot open rather than showing it and refusing (BR-SEC-010). If a colleague sees more entries here than you do, that is a role difference, not a fault.", "الشاشات التي لا تملك صلاحيتها لا تُدرَج — فالمنتج يخفي ما لا تستطيع فتحه بدل عرضه ثم رفضه (BR-SEC-010). فإن رأى زميل مداخل أكثر مما ترى فذلك فرق أدوار لا خلل.")),
            new HelpPanelViewModel.Item(T("Where to go instead", "إلى أين تذهب بدلاً من ذلك"), T("The sidebar reaches the same screens, and the launcher groups them by department — by what a person came to do — rather than by module number. This page is the view from the specification's side.", "القائمة الجانبية تصل إلى الشاشات نفسها، ولوحة الإطلاق تجمعها بالأقسام — بما جاء الشخص ليفعله — لا برقم الوحدة. وهذه الصفحة هي المنظور من جهة المواصفة.")),
        },
    };
}

<div class="sms-page-head">
    <div class="d-flex align-items-center gap-3">
        <span class="sms-module-hero__icon"><i class="bi @Model.Icon" aria-hidden="true"></i></span>
        <div>
            <div class="text-muted small">@T("Module", "الوحدة") @Model.Number</div>
            <h1 class="sms-page-title mb-0">@title</h1>
        </div>
    </div>
    <partial name="_HelpModal" model="help" />
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="sms-card p-4">
            <h2 class="h5">@T("Screens pending", "الشاشات قيد الإنجاز")</h2>
            <p class="text-muted">
                @T($"The {Model.TitleEn} engine — domain model, business rules and admin services — was built in epic {Model.Epic} and is covered by the automated test suite. Its user screens are the next slice; this page stands in for them so the menu entry stays navigable.",
                   $"تم بناء محرك وحدة {Model.TitleAr} — نموذج البيانات وقواعد العمل وخدمات الإدارة — ضمن الحزمة {Model.Epic} وهو مغطى بالاختبارات الآلية. شاشات المستخدم هي المرحلة التالية؛ هذه الصفحة تنوب عنها مؤقتاً حتى تبقى القائمة قابلة للتصفح.")
            </p>
            <dl class="row mb-0 small">
                <dt class="col-sm-4">@T("Requirements", "المتطلبات")</dt>
                <dd class="col-sm-8"><code>docs/Modules/@Model.DocPath</code></dd>
                <dt class="col-sm-4">@T("Build epic", "حزمة البناء")</dt>
                <dd class="col-sm-8"><code>@Model.Epic</code></dd>
                <dt class="col-sm-4">@T("Rule prefix", "بادئة القواعد")</dt>
                <dd class="col-sm-8"><code>BR-@Model.Code</code></dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="sms-card p-4">
            <h2 class="h6 text-muted">@T("Other modules", "وحدات أخرى")</h2>
            <div class="d-flex flex-column gap-1">
                @foreach (var m in ModuleCatalog.Modules.Where(x => x.Group == Model.Group && x.Code != Model.Code))
                {
                    <a class="sms-inline-link" asp-controller="Modules" asp-action="Index" asp-route-code="@m.Code"><i class="bi @m.Icon me-2" aria-hidden="true"></i>@(isRtl ? m.TitleAr : m.TitleEn)</a>
                }
            </div>
        </div>
    </div>
</div>
