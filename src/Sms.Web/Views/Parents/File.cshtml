@using System.Globalization
@using Sms.Domain.Parents
@model ParentFileViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var p = Model.Parent;
    // A refused save comes back to this page rather than redirecting away from it, so the identity
    // inputs draw from what was submitted when there is a submission, and from the stored row
    // otherwise. Without that, the refusal would silently erase every correction being made.
    var f = Model.Submitted ?? ParentFormViewModel.Of(p);
    ViewData["Title"] = p.ParentFileNo;
    ViewData["Breadcrumb"] = T("Parents / ", "أولياء الأمور / ") + p.ParentFileNo;
    string Show(string k) => Model.ActiveTab == k ? "show active" : "";
    string SName(Sms.Domain.Students.Student s) => isRtl ? $"{s.FirstNameAr} {s.FatherNameAr} {s.FamilyNameAr}" : $"{s.FirstNameEn} {s.FatherNameEn} {s.FamilyNameEn}";
    var tabs = new (string Key, string En, string Ar, string? Count)[]
    {
        ("identity", "Identity & contacts", "الهوية والتواصل", null), ("children", "Children", "الأبناء", Model.Children.Count.ToString()), ("statement", "Family statement", "كشف الأسرة", null),
        ("portal", "Portal account", "حساب البوابة", null), ("dups", "Possible duplicates", "تكرارات محتملة", Model.PossibleDuplicates.Count.ToString()), ("audit", "Audit", "التدقيق", Model.Audit.Count.ToString()), ("more", "More…", "المزيد…", null),
    };
    var total = Model.FamilyStatement.Sum(l => l.Position);
    var help = new HelpPanelViewModel
    {
        Id = "parent-file-help",
        Title = T("Parent file — help", "ملف ولي الأمر — مساعدة"),
        Intro = T("One family, seen from the parent's side (doc/Modules/09 §8). The children, the money and the portal login all hang off this record, which is why keeping it single and correct matters more than the individual fields on it.", "أسرة واحدة منظوراً إليها من جهة ولي الأمر (الوثيقة 09 §8). فالأبناء والمال وحساب البوابة كلها معلّقة بهذا السجل، ولهذا فإن إبقاءه واحداً وصحيحاً أهم من الحقول المفردة عليه."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("The family statement is one balance, not several", "كشف الأسرة رصيد واحد لا عدة أرصدة"), T("Charges for every child are gathered into a single position (BR-FEE-008) so the family is billed and chased as one. A parent with two files gets two statements and pays neither in full — which is what the duplicate badge is warning you about.", "تُجمع رسوم كل الأبناء في مركز واحد (BR-FEE-008) لتُفوتر الأسرة وتُتابَع كوحدة. وولي الأمر بملفين يحصل على كشفين ولا يسدد أياً منهما كاملاً — وهذا ما يحذّر منه وسم التكرار.")),
            new HelpPanelViewModel.Item(T("The portal account is this parent's own", "حساب البوابة حساب ولي الأمر نفسه"), T("It shows exactly the children linked here and nothing else (BR-SEC-011). A parent reporting that a child is \"missing\" from their portal is almost always a linking problem on the children tab, not a portal fault.", "يعرض بالضبط الأبناء المرتبطين هنا ولا شيء غيرهم (BR-SEC-011). وبلاغ ولي أمر بأن ابناً «مفقود» من بوابته هو غالباً مشكلة ربط في لسان الأبناء لا خللاً في البوابة.")),
            new HelpPanelViewModel.Item(T("Notifications follow the preferred language", "الإشعارات تتبع اللغة المفضلة"), T("Every message this family receives is rendered in the language set on the identity tab (BR-NOT-007), regardless of the language the sending staff member is working in.", "كل رسالة تتلقاها هذه الأسرة تُعرض باللغة المضبوطة في لسان الهوية (BR-NOT-007)، بغضّ النظر عن لغة الموظف المرسِل.")),
            new HelpPanelViewModel.Item(T("The duplicates tab is a question, not a verdict", "لسان التكرارات سؤال لا حكم"), T("It lists files matching on mobile, name or email (BR-PAR-002/004). Two men can share a name; check the children before merging, because a merge is far harder to reverse than leaving two files alone for another day.", "يسرد الملفات المتطابقة في الجوال أو الاسم أو البريد (BR-PAR-002/004). وقد يتشارك رجلان اسماً؛ فافحص الأبناء قبل الدمج، لأن التراجع عن دمج أصعب بكثير من ترك ملفين يوماً آخر.")),
        },
    };
}

<div class="sms-page-head">
    <div><div class="text-muted small"><code>@p.ParentFileNo</code> · <span dir="ltr">@p.PrimaryMobile</span> @(string.IsNullOrEmpty(p.Email) ? "" : "· " + p.Email) · @(p.PreferredLanguage == "ar" ? "العربية" : "English")</div>
        <h1 class="sms-page-title">@(isRtl ? p.NameAr : p.NameEn) @if (Model.PossibleDuplicates.Count > 0) { <span class="badge fs-6 text-bg-warning">@T("possible duplicate", "تكرار محتمل")</span> }</h1></div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1 @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i>@T("Directory", "الدليل")</a>
        <partial name="_HelpModal" model="help" />
    </div>
</div>

<div class="sms-card">
    <ul class="nav nav-tabs px-3 pt-2 flex-nowrap overflow-auto">@foreach (var t in tabs) { <li class="nav-item"><button class="nav-link text-nowrap @(Model.ActiveTab == t.Key ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-@t.Key" type="button">@(isRtl ? t.Ar : t.En)@if (t.Count != null) { <span class="badge rounded-pill text-bg-light border ms-1">@t.Count</span> }</button></li> }</ul>
    <div class="tab-content p-4">
        <div class="tab-pane fade @Show("identity")" id="tab-identity">
            <form method="post" asp-action="Edit" asp-route-id="@p.Id">
                @* The English name is filled from the Arabic one by the helper button of
                   docs/UI/01 §"Bilingual entry pattern" — assist only, same as the student and
                   employee files. A guardian entered during admission or carried in by an import
                   often has the Arabic text sitting in both columns; this is where that is fixed. *@
                <div class="sms-bilingual mb-3" id="par-name-block">
                    <div><label class="form-label small" for="par-NameAr">@T("Name (Arabic)", "الاسم (عربي)")</label><input name="NameAr" id="par-NameAr" class="form-control form-control-sm" dir="rtl" value="@f.NameAr" /></div>
                    <div><div class="d-flex align-items-center justify-content-between gap-2"><label class="form-label small mb-1" for="par-NameEn">@T("Name (English)", "الاسم (إنجليزي)")</label><button type="button" class="btn btn-link btn-sm p-0 mb-1 text-decoration-none" data-translit-fill="#par-name-block" title="@T("Transliterate the Arabic name into the English box. Check the result before saving — it is a starting point, not an authority.", "نقحرة الاسم العربي إلى الخانة الإنجليزية. راجع الناتج قبل الحفظ — فهو نقطة بداية لا مرجع.")">@T("Fill from Arabic", "تعبئة من العربي")</button></div><input name="NameEn" id="par-NameEn" class="form-control form-control-sm" dir="ltr" value="@f.NameEn" data-translit-from="#par-NameAr" /></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-3"><label class="form-label small" for="par-PrimaryMobile">@T("Primary mobile", "الجوال الأساسي")</label><input name="PrimaryMobile" id="par-PrimaryMobile" class="form-control form-control-sm" dir="ltr" value="@f.PrimaryMobile" /></div>
                    <div class="col-md-4"><label class="form-label small" for="par-Email">@T("Email", "البريد")</label><input name="Email" id="par-Email" type="email" class="form-control form-control-sm" dir="ltr" value="@f.Email" /></div>
                    <div class="col-md-3"><label class="form-label small" for="par-OccupationEmployer">@T("Occupation / employer", "المهنة / جهة العمل")</label><input name="OccupationEmployer" id="par-OccupationEmployer" class="form-control form-control-sm" value="@f.OccupationEmployer" /></div>
                    <div class="col-md-3"><label class="form-label small" for="par-EducationLookupId">@T("Education level", "المؤهل العلمي")</label>
                        <select name="EducationLookupId" id="par-EducationLookupId" class="form-select form-select-sm">
                            <option value="">@T("— not recorded —", "— غير مسجَّل —")</option>
                            @foreach (var e in Model.EducationLevels) { <option value="@e.Id" selected="@(f.EducationLookupId == e.Id)">@(isRtl ? e.Ar : e.En)</option> }
                        </select>
                    </div>
                    <div class="col-md-2"><label class="form-label small" for="par-PreferredLanguage">@T("Preferred language", "لغة التواصل")</label><select name="PreferredLanguage" id="par-PreferredLanguage" class="form-select form-select-sm"><option value="ar" selected="@(f.PreferredLanguage == "ar")">العربية</option><option value="en" selected="@(f.PreferredLanguage == "en")">English</option></select></div>
                    <div class="col-md-8"><label class="form-label small" for="par-Address">@T("Address", "العنوان")</label><input name="Address" id="par-Address" class="form-control form-control-sm" value="@f.Address" /></div>

                    <div class="col-md-3"><label class="form-label small" for="par-IdType">@T("ID type", "نوع الهوية")</label>
                        <select name="PrimaryIdTypeLookupId" id="par-IdType" class="form-select form-select-sm">
                            <option value="">—</option>
                            @foreach (var t in Model.IdTypes) { <option value="@t.Id" selected="@(f.PrimaryIdTypeLookupId == t.Id)">@(isRtl ? t.Ar : t.En)</option> }
                        </select>
                    </div>
                    <div class="col-md-3"><label class="form-label small" for="par-IdNo">@T("ID number", "رقم الهوية")</label>
                        <input name="PrimaryIdNo" id="par-IdNo" class="form-control form-control-sm" dir="ltr" maxlength="30" value="@f.PrimaryIdNo" />
                        <div class="form-text">@T("Identity field — changing it needs the reason below (BR-PAR-009).", "حقل هوية — تغييره يحتاج السبب أدناه (BR-PAR-009).")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label small" for="par-LifeStatus">@T("Status", "الحالة")</label>
                        <select name="LifeStatus" id="par-LifeStatus" class="form-select form-select-sm">
                            @foreach (ParentLifeStatus s in Enum.GetValues(typeof(ParentLifeStatus)))
                            {
                                <option value="@s" selected="@(f.LifeStatus == s)">@SocialProfileLabels.ParentStatus(s, isRtl)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3" id="par-note-wrap"><label class="form-label small" for="par-LifeStatusNote">@T("Note", "بيان الحالة")</label>
                        <input name="LifeStatusNote" id="par-LifeStatusNote" class="form-control form-control-sm" maxlength="200" value="@f.LifeStatusNote" />
                    </div>
                    @* The hierarchy is edited on its own page — three dependent pickers do not belong
                       inside a form whose Save means something else. *@
                    <div class="col-md-4"><label class="form-label small" for="par-residence">@T("Residence", "السكن")</label>
                        <div class="d-flex gap-2 align-items-center">
                            <span id="par-residence" class="form-control form-control-sm bg-light text-truncate" title="@Model.ResidencePath">@(Model.ResidencePath ?? T("not recorded", "غير مسجَّل"))</span>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Residence" asp-route-id="@p.Id"><i class="bi bi-geo-alt" aria-hidden="true"></i> @T("Edit", "تعديل")</a>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-end"><div style="max-width:420px" class="flex-grow-1"><label class="form-label small" for="par-Reason">@T("Reason (required when the name changes — T1)", "السبب (مطلوب عند تغيير الاسم — T1)")</label><input name="Reason" id="par-Reason" class="form-control form-control-sm" value="@f.Reason" /></div><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-save me-1" aria-hidden="true"></i>@T("Save", "حفظ")</button></div>
            </form>
            <div class="form-text mt-2">@T("Mobile uniqueness is enforced (BR-PAR-002); contact changes need no reason, the name does.", "تفرد الجوال مفروض (BR-PAR-002)؛ تغيير التواصل لا يحتاج سبباً، الاسم يحتاج.")</div>
        </div>
        <div class="tab-pane fade @Show("children")" id="tab-children">
            <table class="table table-sm sms-table mb-3"><caption class="visually-hidden">@T("Linked children", "الأبناء المرتبطون")</caption><thead><tr><th scope="col">@T("Student", "الطالب")</th><th scope="col">@T("Grade", "الصف")</th><th scope="col">@T("Relationship", "القرابة")</th><th scope="col">@T("Primary", "أساسي")</th><th scope="col">@T("Financial", "مالي")</th><th scope="col">@T("Pickup", "استلام")</th><th scope="col">@T("Portal", "بوابة")</th><th scope="col">@T("Since", "منذ")</th></tr></thead>
                <tbody>@foreach (var c in Model.Children) { <tr><td><a asp-controller="Students" asp-action="File" asp-route-id="@c.Student.Id" asp-route-tab="guardians"><code>@c.Student.StudentNo</code> @SName(c.Student)</a></td><td>@(c.GradeName ?? "—")</td><td>@c.Relationship</td><td><span aria-hidden="true">@(c.Link.IsPrimaryContact ? "✓" : "—")</span><span class="visually-hidden">@(c.Link.IsPrimaryContact ? T("yes", "نعم") : T("no", "لا"))</span></td><td><span aria-hidden="true">@(c.Link.IsFinanciallyResponsible ? "✓" : "—")</span><span class="visually-hidden">@(c.Link.IsFinanciallyResponsible ? T("yes", "نعم") : T("no", "لا"))</span></td><td><span aria-hidden="true">@(c.Link.IsPickupAuthorized ? "✓" : "—")</span><span class="visually-hidden">@(c.Link.IsPickupAuthorized ? T("yes", "نعم") : T("no", "لا"))</span></td><td><span aria-hidden="true">@(c.Link.IsPortalVisible ? "✓" : "—")</span><span class="visually-hidden">@(c.Link.IsPortalVisible ? T("yes", "نعم") : T("no", "لا"))</span></td><td>@c.Link.EffectiveFromUtc.ToString("yyyy-MM-dd")</td></tr> }
                @if (Model.Children.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-3">@T("No linked children.", "لا أبناء مرتبطون.")</td></tr> }</tbody></table>
            @if (Model.PastChildren.Count > 0) { <div class="small text-muted mb-2">@T("Past links:", "روابط سابقة:") @string.Join(" · ", Model.PastChildren.Select(c => $"{SName(c.Student)} ({c.Link.EffectiveFromUtc:yyyy-MM-dd} → {c.Link.EffectiveToUtc:yyyy-MM-dd})"))</div> }
            <div class="form-text">@T("Link/unlink and flags are edited on the Student file → Parents & guardians (BR-STU-003); custody restrictions 🔒 per link (BR-SEC-011) arrive with the custody manager.", "الربط/الفك والأعلام من ملف الطالب → أولياء الأمور (BR-STU-003)؛ قيود الحضانة 🔒 لكل رابط (BR-SEC-011) مع مدير الحضانة.")</div>
        </div>
        <div class="tab-pane fade @Show("statement")" id="tab-statement">
            <table class="table table-sm sms-table mb-2"><caption class="visually-hidden">@T("Family statement", "كشف الأسرة")</caption><thead><tr><th scope="col">@T("Student", "الطالب")</th><th scope="col" class="text-end">@T("Posted", "مرحّل")</th><th scope="col" class="text-end">@T("Credit notes", "إشعارات دائنة")</th><th scope="col" class="text-end">@T("Discounts", "خصومات")</th><th scope="col" class="text-end">@T("Paid", "مدفوع")</th><th scope="col" class="text-end">@T("Balance", "الرصيد")</th></tr></thead>
                <tbody>@foreach (var l in Model.FamilyStatement) { <tr><td>@SName(l.Student) <span class="small text-muted">(@l.ChargeCount @T("invoices", "فاتورة"))</span></td><td class="text-end">@l.Gross.ToString("N2")</td><td class="text-end">@l.CreditNotes.ToString("N2")</td><td class="text-end">@l.Discounts.ToString("N2")</td><td class="text-end">@l.Paid.ToString("N2")</td><td class="text-end fw-semibold @(l.Position > 0 ? "text-danger" : "text-success")">@l.Position.ToString("N2")</td></tr> }
                @if (Model.FamilyStatement.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-3">@T("No linked children.", "لا أبناء مرتبطون.")</td></tr> }</tbody>
                <tfoot><tr><th colspan="5">@T("Family balance due", "رصيد الأسرة المستحق")</th><th class="text-end fs-6 @(total > 0 ? "text-danger" : "text-success")">@total.ToString("N2")</th></tr></tfoot></table>
            <div class="form-text">@T("Consolidated read-through of Fees/Payments (posted charges − credit notes − discounts − allocations, BR-FEE-008); the pay-ready statement with installments and aging opens with the Finance screens.", "قراءة موحدة من الرسوم/المدفوعات (المرحّل − الإشعارات الدائنة − الخصومات − المخصصات، BR-FEE-008)؛ الكشف الجاهز للسداد مع الأقساط والأعمار مع شاشات المالية.")</div>
        </div>
        <div class="tab-pane fade @Show("portal")" id="tab-portal">
            @if (Model.PortalUserName != null) { <p class="mb-1"><i class="bi bi-person-check text-success me-1" aria-hidden="true"></i>@T("Portal account:", "حساب البوابة:") <code>@Model.PortalUserName</code></p> } else { <p class="text-muted mb-1">@T("No portal account linked.", "لا حساب بوابة مرتبط.")</p> }
            <div class="form-text">@T("Account provisioning / reset / revoke land with System Administration (Module 36). The portal shows this parent exactly the children linked here with portal visibility on (BR-SEC-011).", "إنشاء/إعادة تعيين/إلغاء الحساب مع إدارة النظام (الوحدة 36). تعرض البوابة لولي الأمر الأبناء المرتبطين هنا مع تفعيل الظهور فقط (BR-SEC-011).") <a asp-controller="Portal" asp-action="Index">@T("Open portal →", "فتح البوابة ←")</a></div>
        </div>
        <div class="tab-pane fade @Show("dups")" id="tab-dups">
            <table class="table table-sm sms-table mb-2"><caption class="visually-hidden">@T("Possible duplicates", "تكرارات محتملة")</caption><thead><tr><th scope="col">@T("File no.", "رقم الملف")</th><th scope="col">@T("Name", "الاسم")</th><th scope="col">@T("Mobile", "الجوال")</th><th scope="col">@T("Email", "البريد")</th></tr></thead>
                <tbody>@foreach (var d in Model.PossibleDuplicates) { <tr><td><a asp-action="File" asp-route-id="@d.Id"><code>@d.ParentFileNo</code></a></td><td>@(isRtl ? d.NameAr : d.NameEn)</td><td dir="ltr">@d.PrimaryMobile</td><td>@(d.Email ?? "—")</td></tr> }@if (Model.PossibleDuplicates.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3">@T("No candidates (same mobile / name).", "لا مرشحين (نفس الجوال/الاسم).")</td></tr> }</tbody></table>
            <div class="form-text">@T("Merge with preview diff (BR-PAR-004) needs the merge-log engine — see the Dedup workbench for the whole queue.", "الدمج مع معاينة الفروق (BR-PAR-004) يحتاج محرك سجل الدمج — انظر طاولة التكرار للقائمة كاملة.") <a asp-action="Dedup">@T("Workbench →", "الطاولة ←")</a></div>
        </div>
        <div class="tab-pane fade @Show("audit")" id="tab-audit"><table class="table table-sm sms-table mb-0 small"><caption class="visually-hidden">@T("Audit trail", "سجل التدقيق")</caption><thead><tr><th scope="col">@T("When", "متى")</th><th scope="col">@T("Action", "الإجراء")</th><th scope="col">@T("Field", "الحقل")</th><th scope="col">@T("Old", "قبل")</th><th scope="col">@T("New", "بعد")</th><th scope="col">@T("Reason", "السبب")</th><th scope="col">@T("Actor", "المنفذ")</th></tr></thead><tbody>@foreach (var a in Model.Audit) { <tr><td>@a.At.ToString("yyyy-MM-dd HH:mm")</td><td>@a.Action</td><td>@a.Field</td><td>@a.Old</td><td>@a.New</td><td>@a.Reason</td><td>#@a.Actor</td></tr> }</tbody></table></div>
        <div class="tab-pane fade @Show("more")" id="tab-more"><ul class="small text-muted mb-0"><li>@T("Communications history (doc 09 log), Documents, custody restrictions 🔒, preferences / opt-outs (BR-NOT-007) — open as those module screens land.", "سجل المراسلات (الوثيقة 09)، المستندات، قيود الحضانة 🔒، التفضيلات/إلغاء الاشتراك (BR-NOT-007) — تُفعَّل مع شاشات وحداتها.")</li></ul></div>
    </div>
</div>
