@using System.Globalization
@model ParentFileViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var p = Model.Parent;
    ViewData["Title"] = p.ParentFileNo;
    ViewData["Breadcrumb"] = T("Parents / ", "أولياء الأمور / ") + p.ParentFileNo;
    string Show(string k) => Model.ActiveTab == k ? "show active" : "";
    string SName(Sms.Domain.Students.Student s) => isRtl ? $"{s.FirstNameAr} {s.FatherNameAr} {s.FamilyNameAr}" : $"{s.FirstNameEn} {s.FatherNameEn} {s.FamilyNameEn}";
    var tabs = new (string Key, string En, string Ar, string? Count)[]
    {
        ("identity", "Identity & contacts", "الهوية والتواصل", null), ("children", "Children", "الأبناء", Model.Children.Count.ToString()), ("statement", "Family statement", "كشف الأسرة", null),
        ("portal", "Portal account", "حساب البوابة", null), ("dups", "Possible duplicates", "تكرارات محتملة", Model.PossibleDuplicates.Count.ToString()), ("audit", "Audit", "التدقيق", Model.Audit.Count.ToString()), ("more", "More…", "المزيد…", null),
    };
    var total = Model.FamilyStatement.Sum(l => l.Position);
}

<div class="sms-page-head">
    <div><div class="text-muted small"><code>@p.ParentFileNo</code> · <span dir="ltr">@p.PrimaryMobile</span> @(string.IsNullOrEmpty(p.Email) ? "" : "· " + p.Email) · @(p.PreferredLanguage == "ar" ? "العربية" : "English")</div>
        <h1 class="sms-page-title">@(isRtl ? p.NameAr : p.NameEn) @if (Model.PossibleDuplicates.Count > 0) { <span class="badge fs-6 text-bg-warning">@T("possible duplicate", "تكرار محتمل")</span> }</h1></div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1 @(isRtl ? "sms-flip" : "")"></i>@T("Directory", "الدليل")</a>
</div>

<div class="sms-card">
    <ul class="nav nav-tabs px-3 pt-2 flex-nowrap overflow-auto">@foreach (var t in tabs) { <li class="nav-item"><button class="nav-link text-nowrap @(Model.ActiveTab == t.Key ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-@t.Key" type="button">@(isRtl ? t.Ar : t.En)@if (t.Count != null) { <span class="badge rounded-pill text-bg-light border ms-1">@t.Count</span> }</button></li> }</ul>
    <div class="tab-content p-4">
        <div class="tab-pane fade @Show("identity")" id="tab-identity">
            <form method="post" asp-action="Edit" asp-route-id="@p.Id">
                <div class="sms-bilingual mb-3">
                    <div><label class="form-label small">@T("Name (Arabic)", "الاسم (عربي)")</label><input name="NameAr" class="form-control form-control-sm" dir="rtl" value="@p.NameAr" /></div>
                    <div><label class="form-label small">@T("Name (English)", "الاسم (إنجليزي)")</label><input name="NameEn" class="form-control form-control-sm" dir="ltr" value="@p.NameEn" /></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-3"><label class="form-label small">@T("Primary mobile", "الجوال الأساسي")</label><input name="PrimaryMobile" class="form-control form-control-sm" dir="ltr" value="@p.PrimaryMobile" /></div>
                    <div class="col-md-4"><label class="form-label small">@T("Email", "البريد")</label><input name="Email" type="email" class="form-control form-control-sm" dir="ltr" value="@p.Email" /></div>
                    <div class="col-md-3"><label class="form-label small">@T("Occupation / employer", "المهنة / جهة العمل")</label><input name="OccupationEmployer" class="form-control form-control-sm" value="@p.OccupationEmployer" /></div>
                    <div class="col-md-2"><label class="form-label small">@T("Preferred language", "لغة التواصل")</label><select name="PreferredLanguage" class="form-select form-select-sm"><option value="ar" selected="@(p.PreferredLanguage == "ar")">العربية</option><option value="en" selected="@(p.PreferredLanguage == "en")">English</option></select></div>
                    <div class="col-12"><label class="form-label small">@T("Address", "العنوان")</label><input name="Address" class="form-control form-control-sm" value="@p.Address" /></div>
                </div>
                <div class="d-flex gap-2 align-items-end"><div style="max-width:420px" class="flex-grow-1"><label class="form-label small">@T("Reason (required when the name changes — T1)", "السبب (مطلوب عند تغيير الاسم — T1)")</label><input name="Reason" class="form-control form-control-sm" /></div><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-save me-1"></i>@T("Save", "حفظ")</button></div>
            </form>
            <div class="form-text mt-2">@T("Mobile uniqueness is enforced (BR-PAR-002); contact changes need no reason, the name does.", "تفرد الجوال مفروض (BR-PAR-002)؛ تغيير التواصل لا يحتاج سبباً، الاسم يحتاج.")</div>
        </div>
        <div class="tab-pane fade @Show("children")" id="tab-children">
            <table class="table table-sm sms-table mb-3"><thead><tr><th>@T("Student", "الطالب")</th><th>@T("Grade", "الصف")</th><th>@T("Relationship", "القرابة")</th><th>@T("Primary", "أساسي")</th><th>@T("Financial", "مالي")</th><th>@T("Pickup", "استلام")</th><th>@T("Portal", "بوابة")</th><th>@T("Since", "منذ")</th></tr></thead>
                <tbody>@foreach (var c in Model.Children) { <tr><td><a asp-controller="Students" asp-action="File" asp-route-id="@c.Student.Id" asp-route-tab="guardians"><code>@c.Student.StudentNo</code> @SName(c.Student)</a></td><td>@(c.GradeName ?? "—")</td><td>@c.Relationship</td><td>@(c.Link.IsPrimaryContact ? "✓" : "—")</td><td>@(c.Link.IsFinanciallyResponsible ? "✓" : "—")</td><td>@(c.Link.IsPickupAuthorized ? "✓" : "—")</td><td>@(c.Link.IsPortalVisible ? "✓" : "—")</td><td>@c.Link.EffectiveFromUtc.ToString("yyyy-MM-dd")</td></tr> }
                @if (Model.Children.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-3">@T("No linked children.", "لا أبناء مرتبطون.")</td></tr> }</tbody></table>
            @if (Model.PastChildren.Count > 0) { <div class="small text-muted mb-2">@T("Past links:", "روابط سابقة:") @string.Join(" · ", Model.PastChildren.Select(c => $"{SName(c.Student)} ({c.Link.EffectiveFromUtc:yyyy-MM-dd} → {c.Link.EffectiveToUtc:yyyy-MM-dd})"))</div> }
            <div class="form-text">@T("Link/unlink and flags are edited on the Student file → Parents & guardians (BR-STU-003); custody restrictions 🔒 per link (BR-SEC-011) arrive with the custody manager.", "الربط/الفك والأعلام من ملف الطالب → أولياء الأمور (BR-STU-003)؛ قيود الحضانة 🔒 لكل رابط (BR-SEC-011) مع مدير الحضانة.")</div>
        </div>
        <div class="tab-pane fade @Show("statement")" id="tab-statement">
            <table class="table table-sm sms-table mb-2"><thead><tr><th>@T("Student", "الطالب")</th><th class="text-end">@T("Posted", "مرحّل")</th><th class="text-end">@T("Credit notes", "إشعارات دائنة")</th><th class="text-end">@T("Discounts", "خصومات")</th><th class="text-end">@T("Paid", "مدفوع")</th><th class="text-end">@T("Balance", "الرصيد")</th></tr></thead>
                <tbody>@foreach (var l in Model.FamilyStatement) { <tr><td>@SName(l.Student) <span class="small text-muted">(@l.ChargeCount @T("invoices", "فاتورة"))</span></td><td class="text-end">@l.Gross.ToString("N2")</td><td class="text-end">@l.CreditNotes.ToString("N2")</td><td class="text-end">@l.Discounts.ToString("N2")</td><td class="text-end">@l.Paid.ToString("N2")</td><td class="text-end fw-semibold @(l.Position > 0 ? "text-danger" : "text-success")">@l.Position.ToString("N2")</td></tr> }
                @if (Model.FamilyStatement.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-3">@T("No linked children.", "لا أبناء مرتبطون.")</td></tr> }</tbody>
                <tfoot><tr><th colspan="5">@T("Family balance due", "رصيد الأسرة المستحق")</th><th class="text-end fs-6 @(total > 0 ? "text-danger" : "text-success")">@total.ToString("N2")</th></tr></tfoot></table>
            <div class="form-text">@T("Consolidated read-through of Fees/Payments (posted charges − credit notes − discounts − allocations, BR-FEE-008); the pay-ready statement with installments and aging opens with the Finance screens.", "قراءة موحدة من الرسوم/المدفوعات (المرحّل − الإشعارات الدائنة − الخصومات − المخصصات، BR-FEE-008)؛ الكشف الجاهز للسداد مع الأقساط والأعمار مع شاشات المالية.")</div>
        </div>
        <div class="tab-pane fade @Show("portal")" id="tab-portal">
            @if (Model.PortalUserName != null) { <p class="mb-1"><i class="bi bi-person-check text-success me-1"></i>@T("Portal account:", "حساب البوابة:") <code>@Model.PortalUserName</code></p> } else { <p class="text-muted mb-1">@T("No portal account linked.", "لا حساب بوابة مرتبط.")</p> }
            <div class="form-text">@T("Account provisioning / reset / revoke land with System Administration (Module 36). The portal shows this parent exactly the children linked here with portal visibility on (BR-SEC-011).", "إنشاء/إعادة تعيين/إلغاء الحساب مع إدارة النظام (الوحدة 36). تعرض البوابة لولي الأمر الأبناء المرتبطين هنا مع تفعيل الظهور فقط (BR-SEC-011).") <a asp-controller="Portal" asp-action="Index">@T("Open portal →", "فتح البوابة ←")</a></div>
        </div>
        <div class="tab-pane fade @Show("dups")" id="tab-dups">
            <table class="table table-sm sms-table mb-2"><thead><tr><th>@T("File no.", "رقم الملف")</th><th>@T("Name", "الاسم")</th><th>@T("Mobile", "الجوال")</th><th>@T("Email", "البريد")</th></tr></thead>
                <tbody>@foreach (var d in Model.PossibleDuplicates) { <tr><td><a asp-action="File" asp-route-id="@d.Id"><code>@d.ParentFileNo</code></a></td><td>@(isRtl ? d.NameAr : d.NameEn)</td><td dir="ltr">@d.PrimaryMobile</td><td>@(d.Email ?? "—")</td></tr> }@if (Model.PossibleDuplicates.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3">@T("No candidates (same mobile / name).", "لا مرشحين (نفس الجوال/الاسم).")</td></tr> }</tbody></table>
            <div class="form-text">@T("Merge with preview diff (BR-PAR-004) needs the merge-log engine — see the Dedup workbench for the whole queue.", "الدمج مع معاينة الفروق (BR-PAR-004) يحتاج محرك سجل الدمج — انظر طاولة التكرار للقائمة كاملة.") <a asp-action="Dedup">@T("Workbench →", "الطاولة ←")</a></div>
        </div>
        <div class="tab-pane fade @Show("audit")" id="tab-audit"><table class="table table-sm sms-table mb-0 small"><thead><tr><th>@T("When", "متى")</th><th>@T("Action", "الإجراء")</th><th>@T("Field", "الحقل")</th><th>@T("Old", "قبل")</th><th>@T("New", "بعد")</th><th>@T("Reason", "السبب")</th><th>@T("Actor", "المنفذ")</th></tr></thead><tbody>@foreach (var a in Model.Audit) { <tr><td>@a.At.ToString("yyyy-MM-dd HH:mm")</td><td>@a.Action</td><td>@a.Field</td><td>@a.Old</td><td>@a.New</td><td>@a.Reason</td><td>#@a.Actor</td></tr> }</tbody></table></div>
        <div class="tab-pane fade @Show("more")" id="tab-more"><ul class="small text-muted mb-0"><li>@T("Communications history (doc 09 log), Documents, custody restrictions 🔒, preferences / opt-outs (BR-NOT-007) — open as those module screens land.", "سجل المراسلات (الوثيقة 09)، المستندات، قيود الحضانة 🔒، التفضيلات/إلغاء الاشتراك (BR-NOT-007) — تُفعَّل مع شاشات وحداتها.")</li></ul></div>
    </div>
</div>
