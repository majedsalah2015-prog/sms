@using System.Globalization
@model ParentFormViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("New parent", "ولي أمر جديد");
    ViewData["Breadcrumb"] = T("Parents / New", "أولياء الأمور / جديد");
}
<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("An independent parent file (PAR series) that students link to; the primary mobile is the dedup key (BR-PAR-002).", "ملف ولي أمر مستقل (سلسلة PAR) يرتبط به الطلاب؛ الجوال الأساسي مفتاح منع التكرار (BR-PAR-002).")</p></div></div>
<form method="post" asp-action="Register">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
    <p class="form-text">@T("Fields marked * are required.", "الحقول المعلّمة بـ * إلزامية.")</p>
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="sms-card p-4">
                <div class="sms-bilingual mb-3">
                    <div><label class="form-label small" asp-for="NameAr">@T("Name (Arabic)", "الاسم (عربي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="NameAr" class="form-control form-control-sm" dir="rtl" required aria-required="true" /><span asp-validation-for="NameAr" class="text-danger small"></span></div>
                    <div><label class="form-label small" asp-for="NameEn">@T("Name (English)", "الاسم (إنجليزي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="NameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#NameAr" required aria-required="true" /><span asp-validation-for="NameEn" class="text-danger small"></span></div>
                </div>
                <div class="row g-3">
                    <div class="col-md-3"><label class="form-label small" asp-for="PrimaryMobile">@T("Primary mobile", "الجوال الأساسي") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="PrimaryMobile" class="form-control form-control-sm" dir="ltr" placeholder="05xxxxxxxx" required aria-required="true" /><span asp-validation-for="PrimaryMobile" class="text-danger small"></span></div>
                    <div class="col-md-4"><label class="form-label small" asp-for="Email">@T("Email", "البريد")</label><input asp-for="Email" type="email" class="form-control form-control-sm" dir="ltr" /></div>
                    <div class="col-md-3"><label class="form-label small" asp-for="OccupationEmployer">@T("Occupation / employer", "المهنة / جهة العمل")</label><input asp-for="OccupationEmployer" class="form-control form-control-sm" /></div>
                    <div class="col-md-2"><label class="form-label small" asp-for="PreferredLanguage">@T("Preferred language", "لغة التواصل")</label><select asp-for="PreferredLanguage" class="form-select form-select-sm"><option value="ar">العربية</option><option value="en">English</option></select></div>
                    <div class="col-12"><label class="form-label small" asp-for="Address">@T("Address", "العنوان")</label><input asp-for="Address" class="form-control form-control-sm" /></div>
                </div>
            </div>
        </div>
        <div class="col-xl-4"><div class="sms-card p-4"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-person-check me-1" aria-hidden="true"></i>@T("Create", "إنشاء")</button><a class="btn btn-outline-secondary w-100 mt-2" asp-action="Index">@T("Cancel", "إلغاء")</a><div class="form-text mt-3">@T("Link children from the Student file → Parents & guardians tab (relationship + flags, BR-STU-003).", "اربط الأبناء من ملف الطالب → تبويب أولياء الأمور (القرابة والأعلام، BR-STU-003).")</div></div></div>
    </div>
</form>
