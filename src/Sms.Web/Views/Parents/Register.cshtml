@using System.Globalization
@using Sms.Domain.Parents
@model ParentFormViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("New parent", "ولي أمر جديد");
    ViewData["Breadcrumb"] = T("Parents / New", "أولياء الأمور / جديد");
    var help = new HelpPanelViewModel
    {
        Id = "parent-register-help",
        Title = T("New parent — help", "ولي أمر جديد — مساعدة"),
        Intro = T("A parent is a record in their own right, not a set of fields on a student (doc/Modules/09 §8). That is what lets four siblings share one father, one fee statement and one portal login instead of four half-matching copies of the same man.", "ولي الأمر سجل قائم بذاته لا مجموعة حقول على الطالب (الوثيقة 09 §8). وهذا ما يتيح لأربعة إخوة أن يشتركوا في أبٍ واحد وكشف رسوم واحد وحساب بوابة واحد بدل أربع نسخ نصف متطابقة للرجل نفسه."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("The primary mobile is the identity", "الجوال الأساسي هو الهوية"), T("It is the key duplicates are detected on (BR-PAR-002) and the number notifications are sent to. Enter the parent's own number, not the school's and not a relative's — a shared number is how two families end up merged into one file.", "هو المفتاح الذي تُكتشف به التكرارات (BR-PAR-002) والرقم الذي تُرسل إليه الإشعارات. فأدخل رقم ولي الأمر نفسه لا رقم المدرسة ولا رقم قريب — فالرقم المشترك هو ما يجعل أسرتين تنتهيان في ملف واحد.")),
            new HelpPanelViewModel.Item(T("Check before you create", "افحص قبل أن تنشئ"), T("If the family already has a child in the school, the parent almost certainly exists. Search the directory first and link the new student to the existing file; the dedup workbench exists because this step gets skipped.", "إن كان للأسرة ابن في المدرسة فولي الأمر موجود على الأرجح. فابحث في الدليل أولاً واربط الطالب الجديد بالملف الموجود؛ فطاولة التكرار وُجدت لأن هذه الخطوة تُتخطّى.")),
            new HelpPanelViewModel.Item(T("Preferred language is not cosmetic", "اللغة المفضلة ليست شكلية"), T("It decides which language this parent's notifications, statements and portal are rendered in — independently of what language the staff member entering the record happens to be using.", "تقرّر اللغة التي تُعرض بها إشعارات ولي الأمر وكشوفه وبوابته — مستقلةً عن اللغة التي يستخدمها الموظف المُدخِل للسجل.")),
            new HelpPanelViewModel.Item(T("The file number is issued", "رقم الملف يُصدَر"), T("The PAR series produces it when the record is saved. It is not typed, not reused, and stays with the family for as long as they are with the school.", "سلسلة PAR تنتجه عند حفظ السجل. فلا يُكتب ولا يُعاد استخدامه، ويبقى مع الأسرة ما بقيت مع المدرسة.")),
        },
    };
}
<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("An independent parent file (PAR series) that students link to; the primary mobile is the dedup key (BR-PAR-002).", "ملف ولي أمر مستقل (سلسلة PAR) يرتبط به الطلاب؛ الجوال الأساسي مفتاح منع التكرار (BR-PAR-002).")</p></div>
    <partial name="_HelpModal" model="help" /></div>
<form method="post" asp-action="Register">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
    <p class="form-text">@T("Fields marked * are required.", "الحقول المعلّمة بـ * إلزامية.")</p>
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="sms-card p-4">
                <div class="sms-bilingual mb-3">
                    <div><label class="form-label small" asp-for="NameAr">@T("Name (Arabic)", "الاسم (عربي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="NameAr" class="form-control form-control-sm" dir="rtl" required aria-required="true" /><span asp-validation-for="NameAr" class="text-danger small"></span></div>
                    <div><label class="form-label small" asp-for="NameEn">@T("Name (English)", "الاسم (إنجليزي)") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="NameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#NameAr" required aria-required="true" /><span asp-validation-for="NameEn" class="text-danger small"></span></div>
                </div>
                <div class="row g-3">
                    <div class="col-md-3"><label class="form-label small" asp-for="PrimaryMobile">@T("Primary mobile", "الجوال الأساسي") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="PrimaryMobile" class="form-control form-control-sm" dir="ltr" placeholder="05xxxxxxxx" required aria-required="true" /><span asp-validation-for="PrimaryMobile" class="text-danger small"></span></div>
                    <div class="col-md-4"><label class="form-label small" asp-for="Email">@T("Email", "البريد")</label><input asp-for="Email" type="email" class="form-control form-control-sm" dir="ltr" /></div>
                    <div class="col-md-3"><label class="form-label small" asp-for="OccupationEmployer">@T("Occupation / employer", "المهنة / جهة العمل")</label><input asp-for="OccupationEmployer" class="form-control form-control-sm" /></div>
                    <div class="col-md-3"><label class="form-label small" asp-for="EducationLookupId">@T("Education level", "المؤهل العلمي")</label>
                        <select asp-for="EducationLookupId" class="form-select form-select-sm">
                            <option value="">@T("— not recorded —", "— غير مسجَّل —")</option>
                            @foreach (var e in Model.EducationLevels) { <option value="@e.Id" selected="@(e.Id == Model.EducationLookupId)">@(isRtl ? e.Ar : e.En)</option> }
                        </select>
                    </div>
                    <div class="col-md-2"><label class="form-label small" asp-for="PreferredLanguage">@T("Preferred language", "لغة التواصل")</label><select asp-for="PreferredLanguage" class="form-select form-select-sm"><option value="ar">العربية</option><option value="en">English</option></select></div>
                    <div class="col-12"><label class="form-label small" asp-for="Address">@T("Address", "العنوان")</label><input asp-for="Address" class="form-control form-control-sm" placeholder="@T("street, building, landmark", "الشارع والعمارة وعلامة مميزة")" /></div>
                </div>

                <hr class="my-4" />

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small" asp-for="PrimaryIdTypeLookupId">@T("ID type", "نوع الهوية")</label>
                        <select asp-for="PrimaryIdTypeLookupId" class="form-select form-select-sm">
                            <option value="">—</option>
                            @foreach (var t in Model.IdTypes) { <option value="@t.Id">@(isRtl ? t.Ar : t.En)</option> }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small" asp-for="PrimaryIdNo">@T("ID number", "رقم الهوية")</label>
                        <input asp-for="PrimaryIdNo" class="form-control form-control-sm" dir="ltr" inputmode="numeric" maxlength="30" />
                        <div class="form-text">@T("Checked against the register before the file is created — two people share a household phone far more often than an ID (BR-PAR-002).", "يُفحص أمام السجل قبل إنشاء الملف — فمشاركة جوال البيت أشيع كثيراً من مشاركة رقم الهوية (BR-PAR-002).")</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small" asp-for="LifeStatus">@T("Status", "الحالة")</label>
                        <select asp-for="LifeStatus" class="form-select form-select-sm" id="LifeStatus">
                            @foreach (ParentLifeStatus s in Enum.GetValues(typeof(ParentLifeStatus)))
                            {
                                <option value="@s">@SocialProfileLabels.ParentStatus(s, isRtl)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3" id="life-status-note-wrap">
                        <label class="form-label small" asp-for="LifeStatusNote">@T("Note", "بيان الحالة")</label>
                        <input asp-for="LifeStatusNote" class="form-control form-control-sm" maxlength="200" placeholder="@T("what \"other\" means here", "ما المقصود بـ«غير ذلك»")" />
                    </div>
                    <div class="col-12">
                        <div class="form-text">
                            @T("Martyr and missing are recorded separately from deceased on purpose: they carry different entitlements — fee exemptions, ministry reporting, benevolent-fund eligibility — and collapsing them would put those out of reach of anyone reading the file later.",
                               "يُسجَّل الشهيد والمفقود منفصلَين عن المتوفى عن قصد: فلكلٍّ منهما استحقاقات مختلفة — إعفاءات من الرسوم، وتبليغ وزاري، وأهلية لصناديق الإحسان — ودمجها يضعها بعيداً عن متناول من يقرأ الملف لاحقاً.")
                        </div>
                    </div>
                </div>

                @* Where the family lives belongs to the family, so it is recorded once here rather
                   than once per child. The address line above still says which house. *@
                <h3 class="h6 mt-4">@T("Residence", "السكن")</h3>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small" for="res-gov">@T("Governorate", "المحافظة")</label>
                        <select id="res-gov" class="form-select form-select-sm" aria-label="@T("Governorate", "المحافظة")">
                            <option value="">@T("— choose —", "— اختر —")</option>
                            @foreach (var g in Model.Governorates)
                            {
                                <option value="@g.Id">@(isRtl ? g.Name.NameAr : g.Name.NameEn)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small" asp-for="ResidenceAreaId">@T("Locality", "المنطقة")</label>
                        <select asp-for="ResidenceAreaId" id="res-area" class="form-select form-select-sm">
                            <option value="">@T("— choose —", "— اختر —")</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small" asp-for="NeighbourhoodId">@T("Quarter", "الحي")</label>
                        <select asp-for="NeighbourhoodId" id="res-hood" class="form-select form-select-sm">
                            <option value="">@T("— none recorded —", "— لا يوجد —")</option>
                        </select>
                        <div class="form-text">@T("Only some localities have quarters recorded.", "الأحياء مسجَّلة لبعض المناطق فقط.")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4"><div class="sms-card p-4"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-person-check me-1" aria-hidden="true"></i>@T("Create", "إنشاء")</button><a class="btn btn-outline-secondary w-100 mt-2" asp-action="Index">@T("Cancel", "إلغاء")</a><div class="form-text mt-3">@T("Link children from the Student file → Parents & guardians tab (relationship + flags, BR-STU-003).", "اربط الأبناء من ملف الطالب → تبويب أولياء الأمور (القرابة والأعلام، BR-STU-003).")</div></div></div>
    </div>
</form>

@section Scripts {
<script>
(function () {
    var gov = document.getElementById('res-gov');
    var area = document.getElementById('res-area');
    var hood = document.getElementById('res-hood');
    if (!gov || !area || !hood) { return; }
    var isRtl = @Html.Raw(Json.Serialize(isRtl));
    var labels = {
        choose: @Html.Raw(Json.Serialize(T("— choose —", "— اختر —"))),
        none: @Html.Raw(Json.Serialize(T("— none recorded —", "— لا يوجد —")))
    };

    function fill(select, rows, placeholder) {
        select.innerHTML = '';
        var blank = document.createElement('option');
        blank.value = '';
        blank.textContent = placeholder;
        select.appendChild(blank);
        rows.forEach(function (r) {
            var o = document.createElement('option');
            o.value = r.id;
            o.textContent = isRtl ? r.ar : r.en;
            select.appendChild(o);
        });
    }

    gov.addEventListener('change', function () {
        if (!gov.value) { fill(area, [], labels.choose); fill(hood, [], labels.none); return; }
        fetch('@Url.Content("~/parents/residence/areas")?governorateId=' + gov.value)
            .then(function (r) { return r.json(); })
            .then(function (rows) { fill(area, rows, labels.choose); fill(hood, [], labels.none); });
    });

    area.addEventListener('change', function () {
        if (!area.value) { fill(hood, [], labels.none); return; }
        fetch('@Url.Content("~/parents/residence/neighbourhoods")?areaId=' + area.value)
            .then(function (r) { return r.json(); })
            .then(function (rows) { fill(hood, rows, labels.none); });
    });

    // The note only means anything for "Other". Hidden rather than removed, so a
    // form posted with scripting off still carries whatever was typed and the admin
    // still drops it — the rule lives on the server either way.
    var status = document.getElementById("LifeStatus");
    var noteWrap = document.getElementById("life-status-note-wrap");
    if (status && noteWrap) {
        var syncNote = function () { noteWrap.style.display = status.value === "Other" ? "" : "none"; };
        status.addEventListener("change", syncNote);
        syncNote();
    }
})();
</script>
}
