@using System.Globalization
@using Sms.Domain.Attendance
@model PortalStudentViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var s = Model.Student;
    var name = isRtl ? $"{s.FirstNameAr} {s.FatherNameAr} {s.GrandfatherNameAr} {s.FamilyNameAr}" : $"{s.FirstNameEn} {s.FatherNameEn} {s.GrandfatherNameEn} {s.FamilyNameEn}";
    ViewData["Title"] = name;
    string Show(string k) => Model.ActiveTab == k ? "show active" : "";
    string Act(string k) => Model.ActiveTab == k ? "active" : "";
    string Sel(string k) => Model.ActiveTab == k ? "true" : "false";
    string DayLabel(AttendanceStatus st) => st switch
    {
        AttendanceStatus.Present => T("Present", "حاضر"), AttendanceStatus.Late => T("Late", "متأخر"), AttendanceStatus.AbsentExcused => T("Absent (excused)", "غائب بعذر"),
        AttendanceStatus.AbsentUnexcused => T("Absent", "غائب"), AttendanceStatus.MedicalLeave => T("Medical leave", "إجازة مرضية"), AttendanceStatus.Permission => T("Permission", "استئذان"),
        AttendanceStatus.EarlyLeave => T("Early leave", "انصراف مبكر"), AttendanceStatus.Exempted => T("Exempted", "معفى"), _ => st.ToString(),
    };
    string DayBadge(AttendanceStatus st) => st switch { AttendanceStatus.Present => "text-bg-success", AttendanceStatus.Late or AttendanceStatus.EarlyLeave or AttendanceStatus.Permission => "text-bg-warning", AttendanceStatus.Exempted => "text-bg-light border", _ => "text-bg-danger" };
    var att = Model.Attendance;
    var help = new HelpPanelViewModel
    {
        Id = "portal-student-help",
        Title = T("Student profile — help", "ملف الطالب — مساعدة"),
        Intro = T("What the school has published about this student for the current academic year — attendance, results and fees. Read-only: the portal shows the school's record and does not edit it.", "ما نشرته المدرسة عن هذا الطالب للعام الدراسي الحالي — الحضور والنتائج والرسوم. للقراءة فقط: فالبوابة تعرض سجل المدرسة ولا تعدّله."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Attendance is what was recorded, not what was excused later", "الحضور هو ما سُجِّل لا ما عُذر لاحقاً"), T("An absence marked unexcused becomes excused once the school accepts a justification (BR-ATD-009). If you have sent one and the day still shows as unexcused, it has not been processed yet — the correction happens at the school, not here.", "الغياب المسجَّل بلا عذر يصير بعذر متى قبلت المدرسة المبرر (BR-ATD-009). فإن أرسلت واحداً وما زال اليوم بلا عذر فلم يُعالَج بعد — والتصحيح يتم في المدرسة لا هنا.")),
            new HelpPanelViewModel.Item(T("Results appear only once published", "النتائج تظهر بعد نشرها فقط"), T("Marks are entered, reviewed and then published as a set. A subject missing from the results is not a lost mark — that subject's marksheet has not reached the published stage yet.", "تُدخل الدرجات وتُراجع ثم تُنشر مجموعةً واحدة. فالمادة الغائبة من النتائج ليست درجة ضائعة — بل كشف درجاتها لم يبلغ مرحلة النشر بعد.")),
            new HelpPanelViewModel.Item(T("Fees here are this child's share", "الرسوم هنا حصة هذا الابن"), T("The family statement is the one to pay from — it gathers every child into a single balance. This tab is the breakdown for this student alone, shown gross with the discount separate (BR-DIS-010).", "كشف الأسرة هو ما يُسدَّد منه — فهو يجمع كل الأبناء في رصيد واحد. وهذا اللسان تفصيل لهذا الطالب وحده، يُعرض إجمالياً والخصم منفصل (BR-DIS-010).")),
            new HelpPanelViewModel.Item(T("\"Not enrolled this year\" is a real state", "«غير مقيّد هذا العام» حالة حقيقية"), T("A student can exist without a current-year enrolment — a transfer, a gap, or a year not yet started. Their history stays readable throughout (BR-STU-002); only this year's grade and section are absent.", "قد يوجد طالب بلا قيد لهذا العام — نقل أو انقطاع أو عام لم يبدأ بعد. ويبقى سجله مقروءاً طوال الوقت (BR-STU-002)؛ والغائب هو صف هذا العام وشعبته فقط.")),
        },
    };
}

<div class="sms-page-head">
    @if (s.PhotoAttachmentId != null)
    {
        @* Read-only here: a portal shows the school's record, it does not edit it. *@
        <img class="sms-photo-inline me-3" src="@Url.Action("StudentPhoto", new { id = s.Id })" alt="@T("Photo of", "صورة") @name" loading="lazy" />
    }
    <div><div class="text-muted small"><code>@s.StudentNo</code> · @(Model.Grade == null ? T("not enrolled this year", "غير مقيّد هذا العام") : $"{Model.Grade.Code} {(isRtl ? Model.Grade.Name.NameAr : Model.Grade.Name.NameEn)}{(Model.Section == null ? "" : " / " + (isRtl ? Model.Section.NameAr : Model.Section.NameEn))}") · @(Model.Year == null ? "" : (isRtl ? Model.Year.LabelAr : Model.Year.LabelEn))</div>
        <h1 class="sms-page-title">@name @if (Model.IsSelf) { <span class="badge fs-6 text-bg-light border">@T("me", "أنا")</span> }</h1></div>
    <div class="d-flex gap-2">
        @if (Model.Section != null) { <a class="btn btn-outline-primary" asp-action="Timetable" asp-route-id="@s.Id"><i class="bi bi-table me-1" aria-hidden="true"></i>@T("Timetable", "الجدول")</a> }
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1 @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i>@T("My family", "عائلتي")</a>
        <partial name="_HelpModal" model="help" />
    </div>
</div>

<div class="sms-card">
    <ul class="nav nav-tabs px-3 pt-2" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link @Act("attendance")" data-bs-toggle="tab" data-bs-target="#tab-attendance" type="button" role="tab" id="tab-attendance-btn" aria-controls="tab-attendance" aria-selected="@Sel("attendance")"><i class="bi bi-check2-square me-1" aria-hidden="true"></i>@T("Attendance", "الحضور")</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link @Act("results")" data-bs-toggle="tab" data-bs-target="#tab-results" type="button" role="tab" id="tab-results-btn" aria-controls="tab-results" aria-selected="@Sel("results")"><i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i>@T("Results", "النتائج") <span class="badge rounded-pill text-bg-light border ms-1">@Model.Results.Count</span></button></li>
        <li class="nav-item" role="presentation"><button class="nav-link @Act("fees")" data-bs-toggle="tab" data-bs-target="#tab-fees" type="button" role="tab" id="tab-fees-btn" aria-controls="tab-fees" aria-selected="@Sel("fees")"><i class="bi bi-receipt me-1" aria-hidden="true"></i>@T("Fees", "الرسوم")</button></li>
    </ul>
    <div class="tab-content p-4">
        <div class="tab-pane fade @Show("attendance")" id="tab-attendance" role="tabpanel" aria-labelledby="tab-attendance-btn" tabindex="0">
            @if (att.ScheduledDays == 0) { <p class="text-muted mb-0">@T("No attendance recorded this year yet.", "لم يُسجَّل حضور هذا العام بعد.")</p> }
            else
            {
                <div class="row g-3 text-center mb-3">
                    <div class="col-6 col-md-3"><div class="sms-card p-3"><div class="fs-3 fw-bold @(att.AttendancePercent >= 90 ? "text-success" : att.AttendancePercent >= 75 ? "sms-amber" : "text-danger")">@att.AttendancePercent.ToString("0.#")%</div><div class="small text-muted">@T("attendance (BR-ATD-009)", "نسبة الحضور (BR-ATD-009)")</div></div></div>
                    <div class="col-6 col-md-3"><div class="sms-card p-3"><div class="fs-3 fw-bold">@att.ScheduledDays</div><div class="small text-muted">@T("scheduled days", "أيام مجدولة")</div></div></div>
                    <div class="col-6 col-md-3"><div class="sms-card p-3"><div class="fs-3 fw-bold text-danger">@att.AbsentDays</div><div class="small text-muted">@T("absent days", "أيام غياب")</div></div></div>
                    <div class="col-6 col-md-3"><div class="sms-card p-3"><div class="fs-3 fw-bold">@att.ExemptedDays</div><div class="small text-muted">@T("exempted", "معفاة")</div></div></div>
                </div>
                <h2 class="h6">@T("Recent days", "الأيام الأخيرة")</h2>
                <div class="d-flex flex-wrap gap-1">@foreach (var d in Model.RecentDays) { <span class="badge @DayBadge(d.Status)">@d.Date.ToString("MM-dd") · @DayLabel(d.Status)</span> }</div>
            }
        </div>
        <div class="tab-pane fade @Show("results")" id="tab-results" role="tabpanel" aria-labelledby="tab-results-btn" tabindex="0">
            @if (Model.ResultsHidden) { <div class="alert alert-warning mb-0">@T("Results are not visible while the student is suspended (BR-STU-002).", "النتائج غير ظاهرة أثناء إيقاف الطالب (BR-STU-002).")</div> }
            else if (Model.Results.Count == 0) { <p class="text-muted mb-0">@T("No published results yet — results appear here once the school publishes a term's marksheets (BR-SEC-012).", "لا نتائج منشورة بعد — تظهر هنا بعد نشر المدرسة لكشوف الفترة (BR-SEC-012).")</p> }
            else
            {
                foreach (var tg in Model.Results.GroupBy(r => r.Term.Id))
                {
                    var term = tg.First().Term;
                    <h2 class="h6 mt-2">@(isRtl ? term.NameAr : term.NameEn)</h2>
                    <table class="table table-sm sms-table mb-3"><caption class="visually-hidden">@T("Published results for the term", "النتائج المنشورة للفترة")</caption><thead><tr><th scope="col">@T("Subject", "المادة")</th><th scope="col" class="text-center">%</th><th scope="col" class="text-center">@T("Band", "التقدير")</th><th scope="col" class="text-end">@T("Published", "النشر")</th></tr></thead>
                        <tbody>@foreach (var r in tg) { <tr><td><code>@r.Subject.Code</code> @(isRtl ? r.Subject.Name.NameAr : r.Subject.Name.NameEn)</td><td class="text-center fw-semibold">@r.Result.ScorePercent.ToString("0.00")</td><td class="text-center">@(r.Result.BandCode ?? "—")</td><td class="text-end small text-muted">@r.Result.PublishedAtUtc.ToString("yyyy-MM-dd")</td></tr> }</tbody></table>
                }
                <div class="form-text">@T("Report-card download and appeal requests arrive with the report-card center (O6 PDF engine).", "تنزيل بطاقة التقرير وطلبات التظلم تأتي مع مركز بطاقات التقرير (محرك O6).")</div>
            }
        </div>
        <div class="tab-pane fade @Show("fees")" id="tab-fees" role="tabpanel" aria-labelledby="tab-fees-btn" tabindex="0">
            <div class="row g-3 text-center mb-3">
                <div class="col-4"><div class="sms-card p-3"><div class="fs-4 fw-bold">@Model.Fees.GrossCharges.ToString("N2")</div><div class="small text-muted">@T("posted charges", "رسوم مرحّلة")</div></div></div>
                <div class="col-4"><div class="sms-card p-3"><div class="fs-4 fw-bold text-success">@Model.Fees.Discounts.ToString("N2")</div><div class="small text-muted">@T("discounts (BR-DIS-010)", "خصومات (BR-DIS-010)")</div></div></div>
                <div class="col-4"><div class="sms-card p-3"><div class="fs-4 fw-bold @(Model.Fees.Position > 0 ? "text-danger" : "text-success")">@Model.Fees.Position.ToString("N2") <span class="visually-hidden">@(Model.Fees.Position > 0 ? T("due", "مستحق") : T("settled", "مسدّد"))</span></div><div class="small text-muted">@T("balance due", "الرصيد المستحق")</div></div></div>
            </div>
            <table class="table table-sm sms-table mb-2"><caption class="visually-hidden">@T("Posted invoices", "الفواتير المرحّلة")</caption><thead><tr><th scope="col">@T("Invoice", "الفاتورة")</th><th scope="col">@T("Posted", "التاريخ")</th><th scope="col" class="text-end">@T("Amount", "المبلغ")</th></tr></thead>
                <tbody>@foreach (var c in Model.Fees.Charges.OrderByDescending(c => c.PostedAtUtc)) { <tr><td><code>@c.ChargeNo</code></td><td>@c.PostedAtUtc.ToString("yyyy-MM-dd")</td><td class="text-end">@c.GrossAmount.ToString("N2")</td></tr> }@if (Model.Fees.Charges.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-3">@T("No posted invoices.", "لا فواتير مرحّلة.")</td></tr> }</tbody></table>
            <div class="form-text">@T("Posted invoices only (BR-SEC-012). Online payment (BR-PAY-007) is not enabled; pay at the school cashier.", "الفواتير المرحّلة فقط (BR-SEC-012). الدفع الإلكتروني (BR-PAY-007) غير مفعّل؛ السداد لدى أمين الصندوق.") <a asp-action="Statement">@T("Family statement →", "كشف حساب العائلة →")</a></div>
        </div>
    </div>
</div>
