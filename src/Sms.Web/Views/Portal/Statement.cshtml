@using System.Globalization
@model PortalStatementViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("My statement", "كشف حسابي");
    var help = new HelpPanelViewModel
    {
        Id = "portal-statement-help",
        Title = T("My statement — help", "كشف حسابي — مساعدة"),
        Intro = T("One account for the whole family (BR-SEC-013). Every child's posted invoices are gathered here, because the school bills the family rather than each child separately."
            , "حساب واحد للأسرة كلها (BR-SEC-013). فتُجمع هنا الفواتير المرحّلة لكل الأبناء، لأن المدرسة تفوتر الأسرة لا كل ابن على حدة."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Gross, discount and balance are separate on purpose", "الإجمالي والخصم والرصيد منفصلة قصداً"), T("The full fee is shown before any discount, then the discount, then what is left (BR-DIS-010). A scholarship or sibling discount is visible as a line rather than folded silently into a smaller number, so you can check it was applied.", "يُعرض الرسم كاملاً قبل أي خصم، ثم الخصم، ثم المتبقي (BR-DIS-010). فالمنحة أو خصم الإخوة يظهر سطراً لا مطوياً بصمت في رقم أصغر، فيمكنك التحقق من تطبيقه.")),
            new HelpPanelViewModel.Item(T("Only posted invoices appear", "تظهر الفواتير المرحّلة فقط"), T("A charge the school has prepared but not yet posted is not on this statement and is not owed yet. Nothing here is an estimate — every line is a real, issued document.", "الرسم الذي أعدّته المدرسة ولم تُرحّله بعد ليس في هذا الكشف وليس مستحقاً بعد. ولا شيء هنا تقدير — فكل سطر مستند حقيقي صادر.")),
            new HelpPanelViewModel.Item(T("Payments appear once they are receipted", "الدفعات تظهر بعد إيصالها"), T("A payment shows after the school records it against your account and issues a receipt (BR-PAY-007). A transfer made this morning may not have been receipted yet — that is a timing gap, not a lost payment.", "تظهر الدفعة بعد أن تسجّلها المدرسة على حسابك وتُصدر إيصالاً (BR-PAY-007). فالحوالة الصباحية قد لا تكون أُوصلت بعد — وهذه فجوة توقيت لا دفعة ضائعة.")),
            new HelpPanelViewModel.Item(T("Printing gives you the same document", "الطباعة تعطيك المستند نفسه"), T("The print button produces the statement as shown, without the navigation. Amounts stay in Latin digits and right-aligned in both languages so the figures read the same on paper.", "زر الطباعة ينتج الكشف كما يظهر بلا عناصر التنقل. وتبقى المبالغ بأرقام لاتينية ومحاذاة يمين في اللغتين لتُقرأ الأرقام كما هي على الورق.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("All children, posted invoices only — gross, discounts and balance shown separately (BR-DIS-010).", "كل الأبناء، الفواتير المرحّلة فقط — الإجمالي والخصومات والرصيد معروضة منفصلة (BR-DIS-010).")</p></div><div class="d-flex align-items-center gap-2 d-print-none"><button class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer me-1" aria-hidden="true"></i>@T("Print", "طباعة")</button><partial name="_HelpModal" model="help" /></div></div>

<div class="sms-card">
    <div class="table-responsive"><table class="table sms-table mb-0">
        <caption class="visually-hidden">@T("Family statement: posted invoices per child", "كشف حساب العائلة: الفواتير المرحّلة لكل ابن")</caption>
        <thead><tr><th scope="col">@T("Student", "الطالب")</th><th scope="col">@T("Invoice", "الفاتورة")</th><th scope="col">@T("Posted", "التاريخ")</th><th scope="col" class="text-end">@T("Amount", "المبلغ")</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Lines)
        {
            var s = l.Student; var name = isRtl ? $"{s.FirstNameAr} {s.FamilyNameAr}" : $"{s.FirstNameEn} {s.FamilyNameEn}";
            var charges = l.Position.Charges.OrderBy(c => c.PostedAtUtc).ToList();
            var first = true;
            @* th scope=rowgroup + rowspan keeps every invoice row programmatically tied to its child (WCAG 1.3.1) — rowspan covers the charge rows plus the summary row. *@
            foreach (var c in charges) { <tr>@if (first) { <th scope="rowgroup" rowspan="@(charges.Count + 1)" class="fw-normal align-top">@name</th> }<td><code>@c.ChargeNo</code></td><td>@c.PostedAtUtc.ToString("yyyy-MM-dd")</td><td class="text-end">@c.GrossAmount.ToString("N2")</td></tr> first = false; }
            <tr class="table-light">@if (first) { <th scope="rowgroup" class="fw-semibold">@name</th> }<td colspan="2" class="small text-muted">@T("gross", "الإجمالي") @l.Position.GrossCharges.ToString("N2") · @T("discounts", "الخصومات") @l.Position.Discounts.ToString("N2")</td><td class="text-end fw-semibold @(l.Position.Position > 0 ? "text-danger" : "text-success")">@l.Position.Position.ToString("N2") <span class="visually-hidden">@(l.Position.Position > 0 ? T("due", "مستحق") : T("settled", "مسدّد"))</span></td></tr>
        }
        @if (Model.Lines.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">@T("No students linked to this account.", "لا طلاب مرتبطون بهذا الحساب.")</td></tr> }
        </tbody>
        <tfoot><tr><th colspan="3">@T("Family balance due", "رصيد العائلة المستحق")</th><th class="text-end fs-5 @(Model.Total > 0 ? "text-danger" : "text-success")">@Model.Total.ToString("N2") <span class="visually-hidden">@(Model.Total > 0 ? T("due", "مستحق") : T("settled", "مسدّد"))</span></th></tr></tfoot>
    </table></div>
    <div class="p-3 small text-muted">@T("This page requires re-authentication after 15 idle minutes (BR-SEC-013). Online payment is not enabled (BR-PAY-007).", "تتطلب هذه الصفحة إعادة تسجيل الدخول بعد 15 دقيقة خمول (BR-SEC-013). الدفع الإلكتروني غير مفعّل (BR-PAY-007).")</div>
</div>
