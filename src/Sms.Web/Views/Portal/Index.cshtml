@using System.Globalization
@model PortalHomeViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("My family", "عائلتي");
    var who = isRtl ? Model.ParentNameAr : Model.ParentNameEn;
    var help = new HelpPanelViewModel
    {
        Id = "portal-home-help",
        Title = T("My family — help", "عائلتي — مساعدة"),
        Intro = T("Your children, and what the school has published about each of them. The portal is read-only by design: it shows you the school's records, and everything on it is corrected by the school rather than here.", "أبناؤك وما نشرته المدرسة عن كل منهم. والبوابة للقراءة فقط بالتصميم: تعرض لك سجلات المدرسة، وكل ما فيها يُصحَّح لدى المدرسة لا من هنا."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("A missing child is a linking question", "الابن الغائب مسألة ربط"), T("You see exactly the students linked to your account (BR-SEC-011). If a child is missing, their record has not been linked to you yet — the school's office adds the link; nothing you can do on this page will make them appear.", "ترى بالضبط الطلاب المرتبطين بحسابك (BR-SEC-011). فإن غاب ابن فسجله لم يُربط بك بعد — وإدارة المدرسة تضيف الربط؛ ولا شيء تفعله في هذه الصفحة يُظهره.")),
            new HelpPanelViewModel.Item(T("You are seeing published, not draft", "أنت ترى المنشور لا المسوّدة"), T("Results appear only after the school publishes them, and fees only after they are posted. A mark your child has been told about that is not here yet has not been published — it is not lost.", "تظهر النتائج بعد نشر المدرسة لها فقط، والرسوم بعد ترحيلها فقط. فالدرجة التي أُخبر بها ابنك ولم تظهر هنا بعد لم تُنشر — وليست ضائعة.")),
            new HelpPanelViewModel.Item(T("The academic year matters", "العام الدراسي مهم"), T("The year shown at the top is the one everything on this page belongs to. Attendance and fees from a previous year are not missing; they belong to that year's records.", "العام المعروض في الأعلى هو الذي ينتمي إليه كل ما في هذه الصفحة. فحضور العام السابق ورسومه ليست مفقودة؛ بل تخصّ سجلات ذلك العام.")),
            new HelpPanelViewModel.Item(T("The language is yours to set", "اللغة لك أن تضبطها"), T("The portal follows the preferred language on your file, and the switch at the top changes it for this visit. Dates stay Gregorian in both — the calendar does not change with the language.", "تتبع البوابة اللغة المفضلة في ملفك، والمبدّل في الأعلى يغيّرها لهذه الزيارة. وتبقى التواريخ ميلادية في اللغتين — فالتقويم لا يتغير بتغير اللغة.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@(string.IsNullOrEmpty(who) ? T("My family", "عائلتي") : T($"Welcome, {who}", $"مرحباً، {who}"))</h1><p class="text-muted mb-0">@(Model.Year == null ? "" : (isRtl ? Model.Year.LabelAr : Model.Year.LabelEn)) · @T("Attendance, published results and posted fees for each child.", "الحضور والنتائج المنشورة والرسوم المرحّلة لكل ابن/ابنة.")</p></div>
    <partial name="_HelpModal" model="help" /></div>

@if (Model.Children.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>@T("No students are linked to this account yet.", "لا طلاب مرتبطون بهذا الحساب بعد.")
        @if (!Model.IsPortalAccount) { <span class="text-muted">@T("(You are signed in with a staff account — the portal shows a parent's linked children or a student's own record; see BR-SEC-011.)", "(أنت مسجّل بحساب موظف — تعرض البوابة أبناء ولي الأمر المرتبطين أو سجل الطالب نفسه؛ انظر BR-SEC-011.)")</span> }
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var c in Model.Children)
        {
            var s = c.Student;
            var name = isRtl ? $"{s.FirstNameAr} {s.FatherNameAr} {s.FamilyNameAr}" : $"{s.FirstNameEn} {s.FatherNameEn} {s.FamilyNameEn}";
            var att = c.Attendance?.ScheduledDays > 0 ? c.Attendance.AttendancePercent : (decimal?)null;
            <div class="col-md-6 col-xl-4">
                <a class="sms-card p-3 h-100 text-decoration-none" asp-action="Student" asp-route-id="@s.Id" aria-label="@T($"Open {name}'s file", $"فتح ملف {name}")">
                    <div class="d-flex align-items-center gap-3 mb-3"><span class="sms-brand__mark" style="width:48px;height:48px;font-size:1.4rem"><i class="bi bi-person" aria-hidden="true"></i></span><div><div class="fw-semibold">@name @if (c.IsSelf) { <span class="badge text-bg-light border">@T("me", "أنا")</span> }</div><div class="small text-muted"><code>@s.StudentNo</code> · @(c.Grade == null ? T("not enrolled this year", "غير مقيّد هذا العام") : $"{c.Grade.Code} {(isRtl ? c.Grade.Name.NameAr : c.Grade.Name.NameEn)}{(c.Section == null ? "" : " / " + (isRtl ? c.Section.NameAr : c.Section.NameEn))}")</div></div></div>
                    <div class="row g-2 text-center small">
                        <div class="col-4"><div class="fw-semibold fs-5">@(att == null ? "—" : att.Value.ToString("0.#") + "%")</div><div class="text-muted">@T("attendance", "الحضور")</div></div>
                        <div class="col-4"><div class="fw-semibold fs-5">@c.PublishedResults</div><div class="text-muted">@T("results", "نتائج")</div></div>
                        <div class="col-4"><div class="fw-semibold fs-5 @(c.FeePosition > 0 ? "text-danger" : "text-success")">@(c.FeePosition?.ToString("N2") ?? "—") <span class="visually-hidden">@(c.FeePosition > 0 ? T("due", "مستحق") : T("settled", "مسدّد"))</span></div><div class="text-muted">@T("due", "مستحق")</div></div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<div class="sms-card">
    <div class="p-3 border-bottom d-flex align-items-center"><h2 class="h6 mb-0"><i class="bi bi-megaphone me-1" aria-hidden="true"></i>@T("Announcements", "الإعلانات")</h2><a class="ms-auto small" asp-action="Announcements">@T("All →", "الكل →")</a></div>
    <div class="list-group list-group-flush">
        @foreach (var a in Model.Announcements) { <div class="list-group-item"><div class="fw-semibold">@(isRtl ? a.TitleAr : a.TitleEn)</div><div class="small text-muted">@(a.SentAtUtc?.ToString("yyyy-MM-dd") ?? "")</div><div class="small mt-1">@(isRtl ? a.BodyAr : a.BodyEn)</div></div> }
        @if (Model.Announcements.Count == 0) { <div class="list-group-item text-muted small">@T("No announcements yet.", "لا إعلانات بعد.")</div> }
    </div>
</div>
