@using System.Globalization
@model ReceiptViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var r = Model.Receipt;
    ViewData["Title"] = T("Receipt", "سند قبض") + " · " + r.ReceiptNo;
    ViewData["Breadcrumb"] = T("Payments / Cashier / Receipt", "المدفوعات / الصندوق / سند");
    var help = new HelpPanelViewModel
    {
        Id = "receipt-help",
        Title = T("Receipt — help", "سند القبض — مساعدة"),
        Intro = T("Proof that money was taken, and the record of what it paid for (doc/Modules/20 §8). The number and the allocation below it were both created in the same transaction as the payment — neither can exist without the other.", "إثبات أن مالاً قُبض، وسجل ما سُدِّد به (الوثيقة 20 §8). فالرقم والتخصيص تحته أُنشئا في المعاملة نفسها مع الدفعة — ولا يوجد أحدهما بلا الآخر."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Allocation is oldest-first, automatically", "التخصيص للأقدم أولاً تلقائياً"), T("The payment is applied to the oldest outstanding charges until it runs out. That is deliberate: it keeps the ageing of a family's balance honest instead of letting a payment be aimed at whichever invoice is most convenient.", "تُطبَّق الدفعة على أقدم الرسوم المستحقة حتى تنفد. وهذا مقصود: فهو يبقي تقادم رصيد الأسرة صادقاً بدل توجيه الدفعة إلى الفاتورة الأنسب.")),
            new HelpPanelViewModel.Item(T("The RCP number is issued, never chosen", "رقم السند يُصدَر ولا يُختار"), T("It comes from the receipt numbering series and materialises with the receipt it stamps. There are no gaps to fill and no number to reserve in advance.", "يأتي من سلسلة ترقيم السندات ويتجسّد مع السند الذي يختمه. فلا فجوات تُملأ ولا رقم يُحجز مسبقاً.")),
            new HelpPanelViewModel.Item(T("Correcting a receipt means reversing it", "تصحيح السند إبطاله"), T("A receipt is never edited. It is reversed, which unwinds its allocation, and a correct one is taken — both stay in the record. Money that moved leaves a trail in this product by design.", "السند لا يُعدَّل أبداً. بل يُعكس فيُفكّ تخصيصه، ويُقبض سند صحيح — ويبقى كلاهما في السجل. فالمال الذي تحرك يترك أثراً في هذا المنتج بالتصميم.")),
            new HelpPanelViewModel.Item(T("Print gives the payer's copy", "الطباعة تعطي نسخة الدافع"), T("The print view is the receipt alone, without the navigation around it. Amounts stay in Latin digits and right-aligned in both languages.", "عرض الطباعة هو السند وحده بلا عناصر التنقل حوله. وتبقى المبالغ بأرقام لاتينية ومحاذاة يمين في اللغتين.")),
        },
    };
}
<style>
    .rc-sheet { background: #fff; color: #111; max-width: 720px; margin: 0 auto; padding: 1.5rem 2rem; border: 1px solid #ddd; }
    .rc-table th, .rc-table td { border: 1px solid #cbd5e1; padding: .3rem .5rem; font-size: .9rem; }
    .rc-table th { background: #f1f5f9; }
    @@media print { body * { visibility: hidden; } .rc-print, .rc-print * { visibility: visible; } .rc-print { position: absolute; left: 0; top: 0; width: 100%; } .rc-sheet { border: 0; } }
</style>

<div class="sms-page-head d-print-none"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Numbered receipt (RCP) with its automatic oldest-first allocation.", "سند مرقّم (RCP) مع تخصيصه التلقائي للأقدم أولاً.")</p></div>
    <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-primary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1" aria-hidden="true"></i>@T("Print", "طباعة")</button>
        <a class="btn btn-outline-success btn-sm" asp-action="Index" asp-route-payerId="@r.PayerId"><i class="bi bi-cash-coin me-1" aria-hidden="true"></i>@T("Another payment", "دفعة أخرى")</a>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Fees" asp-action="Position" asp-route-payerId="@r.PayerId"><i class="bi bi-journal-text me-1" aria-hidden="true"></i>@T("Statement", "كشف الحساب")</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="bi bi-arrow-left me-1 @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i>@T("Cashier", "الصندوق")</a>
        <partial name="_HelpModal" model="help" />
    </div></div>
<partial name="_FinanceNav" />

<div class="rc-print">
<div class="rc-sheet">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div dir="rtl" class="text-end"><div class="fw-bold fs-5">@Model.SchoolNameAr</div><div class="small text-muted">سند قبض</div></div>
        <div dir="ltr" class="text-start"><div class="fw-bold fs-5">@Model.SchoolNameEn</div><div class="small text-muted">Payment receipt</div></div>
    </div>
    <div class="row small mb-3">
        <div class="col-6" dir="ltr"><div><span class="text-muted">Receipt No.</span> <strong>@r.ReceiptNo</strong></div><div><span class="text-muted">Date</span> @r.IssuedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div><div><span class="text-muted">Method</span> @FinanceLabels.Method(r.Method, false) @(string.IsNullOrEmpty(r.MethodRefNo) ? "" : $"· ref {r.MethodRefNo}")</div>@if (Model.Session != null) { <div><span class="text-muted">Till</span> @Model.Session.TillCode</div> }</div>
        <div class="col-6 text-end" dir="rtl"><div><span class="text-muted">الدافع</span> <strong>@FinanceLabels.ParentName(Model.Payer.Parent, true)</strong> @(Model.Payer.Parent == null ? "" : $"· {Model.Payer.Parent.ParentFileNo}")</div><div dir="ltr" class="text-end"><span class="text-muted">Received from</span> @FinanceLabels.ParentName(Model.Payer.Parent, false)</div><div><span class="text-muted">الطريقة</span> @FinanceLabels.Method(r.Method, true)</div></div>
    </div>
    <div class="text-center my-3"><span class="text-muted small">Amount received / المبلغ المستلم</span><div class="fs-2 fw-bold">@r.Amount.ToString("N2")</div></div>
    <table class="rc-table w-100 mb-2">
        <caption class="visually-hidden">@T("Receipt allocation", "تخصيص السند")</caption>
        <thead><tr><th scope="col">Invoice / الفاتورة</th><th scope="col">Student / الطالب</th><th scope="col">Category / الفئة</th><th scope="col" class="text-end">Allocated / المخصّص</th></tr></thead>
        <tbody>
        @foreach (var (a, c, cat, s) in Model.Allocations) { <tr><td><a asp-controller="Fees" asp-action="Charge" asp-route-id="@c.Id"><code>@c.ChargeNo</code></a></td><td>@s.StudentNo · @FinanceLabels.StudentName(s, isRtl)</td><td>@(isRtl ? cat.NameAr : cat.NameEn)</td><td class="text-end">@a.AllocatedAmount.ToString("N2")</td></tr> }
        @if (Model.Allocations.Count == 0) { <tr><td colspan="4" class="text-center text-muted">No open invoices — held as advance / لا فواتير مفتوحة — مقدّم</td></tr> }
        </tbody>
        <tfoot>
            <tr><th colspan="3" class="text-end">Allocated / المخصّص</th><th class="text-end">@Model.Allocated.ToString("N2")</th></tr>
            @if (Model.Unallocated > 0) { <tr><th colspan="3" class="text-end">To advance balance / إلى الرصيد المقدّم</th><th class="text-end">@Model.Unallocated.ToString("N2")</th></tr> }
            <tr><th colspan="3" class="text-end">Payer position after / موقف الدافع بعد السند</th><th class="text-end @(Model.PositionAfter > 0 ? "text-danger" : "text-success")">@Model.PositionAfter.ToString("N2") <span class="visually-hidden">@(Model.PositionAfter > 0 ? T("due", "مستحق") : Model.PositionAfter < 0 ? T("credit", "دائن") : T("settled", "مسدّد"))</span></th></tr>
        </tfoot>
    </table>
    <div class="small text-muted">@(r.Status == Sms.Domain.Payments.ReceiptStatus.Void ? "VOID / ملغى" : "") Thank you / شكراً لكم</div>
</div>
</div>
