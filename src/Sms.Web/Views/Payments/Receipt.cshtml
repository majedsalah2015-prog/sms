@using System.Globalization
@model ReceiptViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var r = Model.Receipt;
    ViewData["Title"] = T("Receipt", "سند قبض") + " · " + r.ReceiptNo;
    ViewData["Breadcrumb"] = T("Payments / Cashier / Receipt", "المدفوعات / الصندوق / سند");
}
<style>
    .rc-sheet { background: #fff; color: #111; max-width: 720px; margin: 0 auto; padding: 1.5rem 2rem; border: 1px solid #ddd; }
    .rc-table th, .rc-table td { border: 1px solid #cbd5e1; padding: .3rem .5rem; font-size: .9rem; }
    .rc-table th { background: #f1f5f9; }
    @@media print { body * { visibility: hidden; } .rc-print, .rc-print * { visibility: visible; } .rc-print { position: absolute; left: 0; top: 0; width: 100%; } .rc-sheet { border: 0; } }
</style>

<div class="sms-page-head d-print-none"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Numbered receipt (RCP) with its automatic oldest-first allocation.", "سند مرقّم (RCP) مع تخصيصه التلقائي للأقدم أولاً.")</p></div>
    <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-primary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>@T("Print", "طباعة")</button>
        <a class="btn btn-outline-success btn-sm" asp-action="Index" asp-route-payerId="@r.PayerId"><i class="bi bi-cash-coin me-1"></i>@T("Another payment", "دفعة أخرى")</a>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Fees" asp-action="Position" asp-route-payerId="@r.PayerId"><i class="bi bi-journal-text me-1"></i>@T("Statement", "كشف الحساب")</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="bi bi-arrow-left me-1 @(isRtl ? "sms-flip" : "")"></i>@T("Cashier", "الصندوق")</a>
    </div></div>
<partial name="_FinanceNav" />

<div class="rc-print">
<div class="rc-sheet">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div dir="rtl" class="text-end"><div class="fw-bold fs-5">@Model.SchoolNameAr</div><div class="small text-muted">سند قبض</div></div>
        <div dir="ltr" class="text-start"><div class="fw-bold fs-5">@Model.SchoolNameEn</div><div class="small text-muted">Payment receipt</div></div>
    </div>
    <div class="row small mb-3">
        <div class="col-6" dir="ltr"><div><span class="text-muted">Receipt No.</span> <strong>@r.ReceiptNo</strong></div><div><span class="text-muted">Date</span> @r.IssuedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div><div><span class="text-muted">Method</span> @FinanceLabels.Method(r.Method, false) @(string.IsNullOrEmpty(r.MethodRefNo) ? "" : $"· ref {r.MethodRefNo}")</div>@if (Model.Session != null) { <div><span class="text-muted">Till</span> @Model.Session.TillCode</div> }</div>
        <div class="col-6 text-end" dir="rtl"><div><span class="text-muted">الدافع</span> <strong>@FinanceLabels.ParentName(Model.Payer.Parent, true)</strong> @(Model.Payer.Parent == null ? "" : $"· {Model.Payer.Parent.ParentFileNo}")</div><div dir="ltr" class="text-end"><span class="text-muted">Received from</span> @FinanceLabels.ParentName(Model.Payer.Parent, false)</div><div><span class="text-muted">الطريقة</span> @FinanceLabels.Method(r.Method, true)</div></div>
    </div>
    <div class="text-center my-3"><span class="text-muted small">Amount received / المبلغ المستلم</span><div class="fs-2 fw-bold">@r.Amount.ToString("N2")</div></div>
    <table class="rc-table w-100 mb-2">
        <thead><tr><th>Invoice / الفاتورة</th><th>Student / الطالب</th><th>Category / الفئة</th><th class="text-end">Allocated / المخصّص</th></tr></thead>
        <tbody>
        @foreach (var (a, c, cat, s) in Model.Allocations) { <tr><td><a asp-controller="Fees" asp-action="Charge" asp-route-id="@c.Id"><code>@c.ChargeNo</code></a></td><td>@s.StudentNo · @FinanceLabels.StudentName(s, isRtl)</td><td>@(isRtl ? cat.NameAr : cat.NameEn)</td><td class="text-end">@a.AllocatedAmount.ToString("N2")</td></tr> }
        @if (Model.Allocations.Count == 0) { <tr><td colspan="4" class="text-center text-muted">No open invoices — held as advance / لا فواتير مفتوحة — مقدّم</td></tr> }
        </tbody>
        <tfoot>
            <tr><th colspan="3" class="text-end">Allocated / المخصّص</th><th class="text-end">@Model.Allocated.ToString("N2")</th></tr>
            @if (Model.Unallocated > 0) { <tr><th colspan="3" class="text-end">To advance balance / إلى الرصيد المقدّم</th><th class="text-end">@Model.Unallocated.ToString("N2")</th></tr> }
            <tr><th colspan="3" class="text-end">Payer position after / موقف الدافع بعد السند</th><th class="text-end @(Model.PositionAfter > 0 ? "text-danger" : "text-success")">@Model.PositionAfter.ToString("N2")</th></tr>
        </tfoot>
    </table>
    <div class="small text-muted">@(r.Status == Sms.Domain.Payments.ReceiptStatus.Void ? "VOID / ملغى" : "") Thank you / شكراً لكم</div>
</div>
</div>
