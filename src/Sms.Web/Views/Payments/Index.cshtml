@using System.Globalization
@using Sms.Domain.Payments
@model CashierViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Cashier", "الصندوق");
    ViewData["Breadcrumb"] = T("Payments / Cashier", "المدفوعات / الصندوق");
    var sel = Model.Selected;
    var help = new HelpPanelViewModel
    {
        Id = "cash-help", Title = T("Cashier — help", "الصندوق — مساعدة"),
        Intro = T("Search the payer → see the position → enter amount and method → preview the oldest-first allocation → issue the receipt (RCP). Any surplus becomes advance balance (BR-PAY-003).", "ابحث عن الدافع ← اطّلع على الموقف ← أدخل المبلغ والطريقة ← عاين التخصيص للأقدم أولاً ← أصدر السند (RCP). أي فائض يصبح رصيداً مقدّماً (BR-PAY-003)."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Till session", "جلسة الصندوق"), T("Cash needs your open till session (Till console). Card / transfer / cheque need a reference.", "النقد يتطلب جلسة صندوق مفتوحة لك (وحدة الصندوق). البطاقة / التحويل / الشيك تتطلب مرجعاً.")),
            new HelpPanelViewModel.Item(T("PDC", "الشيكات الآجلة"), T("Post-dated cheques are lodged in the PDC registry and receipted on clearance — not here.", "الشيكات الآجلة تُسجَّل في سجل الشيكات ويصدر سندها عند التحصيل — ليس هنا.")),
            new HelpPanelViewModel.Item(T("Keyboard", "لوحة المفاتيح"), T("Search box is focused on load; Enter in the amount field submits.", "مربع البحث مُفعَّل عند التحميل؛ Enter في حقل المبلغ يُرسل.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Speed-critical capture: payer → position → amount → receipt.", "تحصيل سريع: الدافع ← الموقف ← المبلغ ← السند.")</p></div>
    <div class="d-flex gap-2 align-items-center">
        @if (Model.MySession != null) { <span class="badge text-bg-success"><i class="bi bi-safe2 me-1"></i>@T("Till", "الصندوق") @Model.MySession.TillCode · @T("open since", "مفتوح منذ") @Model.MySession.OpenedAtUtc.ToString("HH:mm")</span> }
        else { <a class="btn btn-outline-warning btn-sm" asp-action="Till"><i class="bi bi-safe2 me-1"></i>@T("No open till session", "لا جلسة صندوق مفتوحة")</a> }
        <partial name="_HelpModal" model="help" />
    </div></div>
<partial name="_FinanceNav" />

<div class="row g-3">
    <div class="col-lg-4">
        <div class="sms-card p-3 mb-3">
            <form method="get" class="d-flex gap-1"><input name="q" value="@Model.Q" class="form-control" placeholder="@T("payer name / file no / mobile / student no", "اسم الدافع / رقم الملف / الجوال / رقم الطالب")" autofocus /><button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button></form>
            @if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <div class="list-group list-group-flush mt-2">
                    @foreach (var p in Model.Matches) { <a class="list-group-item list-group-item-action small @(sel?.Payer.Id == p.Payer.Id ? "active" : "")" asp-action="Index" asp-route-q="@Model.Q" asp-route-payerId="@p.Payer.Id"><span class="fw-semibold">@FinanceLabels.ParentName(p.Parent, isRtl)</span> <span class="opacity-75">· @p.Parent?.ParentFileNo · @p.Parent?.PrimaryMobile</span><br /><span class="opacity-75">@string.Join(" · ", p.Children.Select(c => c.StudentNo))</span></a> }
                    @if (Model.Matches.Count == 0) { <div class="list-group-item small text-muted">@T("No payer matches — a payer record appears once the guardian has a charge.", "لا دافع مطابق — يظهر سجل الدافع بعد أول فاتورة لولي الأمر.")</div> }
                </div>
            }
        </div>
        <div class="sms-card">
            <div class="p-2 border-bottom small fw-semibold">@T("Recent receipts", "آخر السندات")</div>
            <ul class="list-group list-group-flush">
                @foreach (var (r, parent) in Model.RecentReceipts) { <li class="list-group-item small d-flex justify-content-between"><span><a asp-action="Receipt" asp-route-id="@r.Id"><code>@r.ReceiptNo</code></a> · @FinanceLabels.ParentName(parent, isRtl)<br /><span class="text-muted">@r.IssuedAtUtc.ToString("yyyy-MM-dd HH:mm") · @FinanceLabels.Method(r.Method, isRtl)</span></span><span class="fw-semibold">@r.Amount.ToString("N2")</span></li> }
                @if (Model.RecentReceipts.Count == 0) { <li class="list-group-item small text-muted">—</li> }
            </ul>
        </div>
    </div>
    <div class="col-lg-8">
        @if (sel == null) { <div class="alert alert-light border">@T("Search and pick a payer to start.", "ابحث واختر دافعاً للبدء.")</div> }
        else
        {
            <div class="sms-card mb-3">
                <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div><span class="fs-5 fw-semibold">@FinanceLabels.ParentName(sel.Parent, isRtl)</span> <span class="text-muted">· @sel.Parent?.ParentFileNo · @sel.Parent?.PrimaryMobile</span><br /><span class="small text-muted">@string.Join(" · ", sel.Children.Select(ch => $"{ch.StudentNo} {FinanceLabels.StudentName(ch, isRtl)}"))</span></div>
                    <div class="text-end"><div class="small text-muted">@T("Total due", "إجمالي المستحق")</div><div class="fs-4 fw-bold @(Model.TotalDue > 0 ? "text-danger" : "text-success")">@Model.TotalDue.ToString("N2")</div>@if (Model.AdvanceBalance > 0) { <div class="small text-success">@T("advance", "مقدّم") @Model.AdvanceBalance.ToString("N2")</div> }</div>
                </div>
                <div class="table-responsive"><table class="table table-sm sms-table mb-0 align-middle">
                    <thead><tr><th>@T("Invoice", "الفاتورة")</th><th>@T("Posted", "التاريخ")</th><th>@T("Student", "الطالب")</th><th>@T("Category", "الفئة")</th><th class="text-end">@T("Gross", "الإجمالي")</th><th class="text-end">@T("Remaining", "المتبقي")</th><th class="text-end">@T("Will allocate", "سيُخصّص")</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.OpenCharges)
                    {
                        var alloc = Model.Preview.FirstOrDefault(p => p.Row.Charge.Id == r.Charge.Id).Amount;
                        <tr class="@(alloc > 0 ? "table-success" : "")">
                            <td><a asp-controller="Fees" asp-action="Charge" asp-route-id="@r.Charge.Id"><code>@r.Charge.ChargeNo</code></a></td>
                            <td class="text-nowrap">@r.Charge.PostedAtUtc.ToString("yyyy-MM-dd")</td>
                            <td>@r.Student.StudentNo</td>
                            <td>@(isRtl ? r.Category.NameAr : r.Category.NameEn)</td>
                            <td class="text-end">@r.Charge.GrossAmount.ToString("N2")</td>
                            <td class="text-end text-danger">@r.Remaining.ToString("N2")</td>
                            <td class="text-end fw-semibold">@(alloc > 0 ? alloc.ToString("N2") : "")</td>
                        </tr>
                    }
                    @if (Model.OpenCharges.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">@T("No open invoices — any payment becomes advance balance.", "لا فواتير مفتوحة — أي دفعة تصبح رصيداً مقدّماً.")</td></tr> }
                    </tbody>
                    @if (Model.PreviewAmount > 0) { <tfoot><tr class="table-light"><th colspan="6" class="text-end">@T("Preview for", "معاينة لمبلغ") @Model.PreviewAmount?.ToString("N2") — @T("leftover to advance", "الفائض إلى المقدّم")</th><th class="text-end">@Model.PreviewLeftover.ToString("N2")</th></tr></tfoot> }
                </table></div>
            </div>

            <div class="sms-card p-3">
                <h2 class="h6 mb-3"><i class="bi bi-cash-coin me-1"></i>@T("Capture payment", "تسجيل دفعة")</h2>
                <form method="post" asp-action="Capture" asp-route-q="@Model.Q" class="row g-2 align-items-end" id="capture">
                    <input type="hidden" name="payerId" value="@sel.Payer.Id" />
                    <div class="col-md-3"><label class="form-label small mb-1">@T("Amount", "المبلغ")</label><input name="amount" type="number" step="0.01" min="0.01" class="form-control form-control-lg text-end" value="@Model.PreviewAmount?.ToString("0.##", CultureInfo.InvariantCulture)" required onchange="document.getElementById('previewLink').href = '@Url.Action("Index", new { q = Model.Q, payerId = sel.Payer.Id })' + '&amount=' + this.value" /></div>
                    <div class="col-md-3"><label class="form-label small mb-1">@T("Method", "الطريقة")</label><select name="method" class="form-select form-select-lg">@foreach (var mth in new[] { PaymentMethod.Cash, PaymentMethod.Card, PaymentMethod.BankTransfer, PaymentMethod.Cheque }) { <option value="@mth">@FinanceLabels.Method(mth, isRtl)</option> }</select></div>
                    <div class="col-md-3"><label class="form-label small mb-1">@T("Reference", "المرجع")</label><input name="methodRefNo" class="form-control form-control-lg" placeholder="@T("slip / transfer / cheque no.", "القسيمة / التحويل / رقم الشيك")" /></div>
                    <div class="col-md-3"><label class="form-label small mb-1">@T("Till session", "جلسة الصندوق")</label><select name="tillSessionId" class="form-select form-select-lg"><option value="">@T("— none (non-cash) —", "— بدون (غير نقدي) —")</option>@foreach (var s in Model.OpenSessions) { <option value="@s.Id" selected="@(s.Id == Model.MySession?.Id)">@s.TillCode @(s.Id == Model.MySession?.Id ? T("(mine)", "(جلستي)") : "")</option> }</select></div>
                    <div class="col-12 d-flex gap-2 mt-3">
                        <button class="btn btn-success btn-lg px-4" type="submit"><i class="bi bi-receipt-cutoff me-1"></i>@T("Issue receipt", "إصدار سند")</button>
                        <a id="previewLink" class="btn btn-outline-secondary btn-lg" href="@Url.Action("Index", new { q = Model.Q, payerId = sel.Payer.Id, amount = Model.PreviewAmount })"><i class="bi bi-eye me-1"></i>@T("Preview allocation", "معاينة التخصيص")</a>
                        <a class="btn btn-outline-secondary btn-lg ms-auto" asp-action="Pdc"><i class="bi bi-calendar-check me-1"></i>@T("Lodge PDC", "تسجيل شيك آجل")</a>
                    </div>
                </form>
            </div>
        }
    </div>
</div>
