@using System.Globalization
@using Sms.Domain.Payments
@model CashierViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Cashier", "الصندوق");
    ViewData["Breadcrumb"] = T("Payments / Cashier", "المدفوعات / الصندوق");
    var sel = Model.Selected;
    var help = new HelpPanelViewModel
    {
        Id = "cash-help", Title = T("Cashier — help", "الصندوق — مساعدة"),
        Intro = T("Search the payer → see the position → enter amount and method → preview the oldest-first allocation → issue the receipt (RCP). Any surplus becomes advance balance (BR-PAY-003).", "ابحث عن الدافع ← اطّلع على الموقف ← أدخل المبلغ والطريقة ← عاين التخصيص للأقدم أولاً ← أصدر السند (RCP). أي فائض يصبح رصيداً مقدّماً (BR-PAY-003)."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Till session", "جلسة الصندوق"), T("Cash needs your open till session (Till console). Card / transfer / cheque need a reference.", "النقد يتطلب جلسة صندوق مفتوحة لك (وحدة الصندوق). البطاقة / التحويل / الشيك تتطلب مرجعاً.")),
            new HelpPanelViewModel.Item(T("PDC", "الشيكات الآجلة"), T("Post-dated cheques are lodged in the PDC registry and receipted on clearance — not here.", "الشيكات الآجلة تُسجَّل في سجل الشيكات ويصدر سندها عند التحصيل — ليس هنا.")),
            new HelpPanelViewModel.Item(T("Keyboard", "لوحة المفاتيح"), T("Search box is focused on load; Enter in the amount field submits.", "مربع البحث مُفعَّل عند التحميل؛ Enter في حقل المبلغ يُرسل.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Speed-critical capture: payer → position → amount → receipt.", "تحصيل سريع: الدافع ← الموقف ← المبلغ ← السند.")</p></div>
    <div class="d-flex gap-2 align-items-center">
        @if (Model.MySession != null) { <span class="badge text-bg-success"><i class="bi bi-safe2 me-1" aria-hidden="true"></i>@T("Till", "الصندوق") @Model.MySession.TillCode · @T("open since", "مفتوح منذ") @Model.MySession.OpenedAtUtc.ToString("HH:mm")</span> }
        else { <a class="btn btn-outline-warning btn-sm" asp-action="Till"><i class="bi bi-safe2 me-1" aria-hidden="true"></i>@T("No open till session", "لا جلسة صندوق مفتوحة")</a> }
        <partial name="_HelpModal" model="help" />
    </div></div>
<partial name="_FinanceNav" />

<div class="row g-3">
    <div class="col-lg-4">
        <div class="sms-card p-3 mb-3">
            <form method="get" class="d-flex gap-1"><input name="q" value="@Model.Q" class="form-control" aria-label="@T("Search payer", "بحث عن دافع")" placeholder="@T("payer name / file no / mobile / student no", "اسم الدافع / رقم الملف / الجوال / رقم الطالب")" autofocus /><button class="btn btn-primary" type="submit" aria-label="@T("Search", "بحث")"><i class="bi bi-search" aria-hidden="true"></i></button></form>
            @if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <div class="list-group list-group-flush mt-2">
                    @* A student number matches every guardian who has ever been billed, so the row has to
                       say which of them the school bills — a name and a student number look identical on
                       the father and the mother of the same child (BR-FEE-004, BR-PAR-005). *@
                    @foreach (var p in Model.Matches)
                    {
                        <a class="list-group-item list-group-item-action small @(sel?.Payer.Id == p.Payer.Id ? "active" : "")" asp-action="Index" asp-route-q="@Model.Q" asp-route-payerId="@p.Payer.Id">
                            <span class="fw-semibold">@FinanceLabels.ParentName(p.Parent, isRtl)</span> <span class="opacity-75">· @p.Parent?.ParentFileNo · @p.Parent?.PrimaryMobile</span>
                            @foreach (var ch in p.Children)
                            {
                                <br />
                                <span class="opacity-75">@ch.Student.StudentNo @FinanceLabels.StudentName(ch.Student, isRtl)</span>
                                <span class="opacity-75">· @(ch.IsCurrentGuardian ? ch.Relationship(isRtl) : T("former guardian", "ولي أمر سابق"))</span>
                                @if (ch.IsFinanciallyResponsible) { <span class="badge text-bg-success">@T("billed", "المفوتر")</span> }
                            }
                            @if (p.IsResponsibleForNothing) { <br /><span class="badge text-bg-warning">@T("not the billed payer", "ليس الدافع المفوتر")</span> }
                        </a>
                    }
                    @if (Model.Matches.Count == 0) { <div class="list-group-item small text-muted">@T("No payer matches — a payer record appears once the guardian has a charge.", "لا دافع مطابق — يظهر سجل الدافع بعد أول فاتورة لولي الأمر.")</div> }
                </div>
            }
        </div>
        <div class="sms-card">
            <div class="p-2 border-bottom small fw-semibold">@T("Recent receipts", "آخر السندات")</div>
            <ul class="list-group list-group-flush">
                @foreach (var (r, parent) in Model.RecentReceipts) { <li class="list-group-item small d-flex justify-content-between"><span><a asp-action="Receipt" asp-route-id="@r.Id"><code>@r.ReceiptNo</code></a> · @FinanceLabels.ParentName(parent, isRtl)<br /><span class="text-muted">@r.IssuedAtUtc.ToString("yyyy-MM-dd HH:mm") · @FinanceLabels.Method(r.Method, isRtl)</span></span><span class="fw-semibold">@r.Amount.ToString("N2")</span></li> }
                @if (Model.RecentReceipts.Count == 0) { <li class="list-group-item small text-muted">—</li> }
            </ul>
        </div>
    </div>
    <div class="col-lg-8">
        @if (sel == null) { <div class="alert alert-light border">@T("Search and pick a payer to start.", "ابحث واختر دافعاً للبدء.")</div> }
        else
        {
            @* Anyone may hand money over — a grandfather settling his grandson's fees is ordinary, so this
               warns and never refuses. But a payer the school bills for none of these children has no open
               invoice to allocate against, so the whole amount becomes an advance balance on the wrong
               account while the child's fees stay open on the guardian who really owes them. The screen
               has to say so before the receipt prints, not after (BR-FEE-004, BR-PAY-003). *@
            @if (sel.IsResponsibleForNothing)
            {
                <div class="alert alert-warning d-flex gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <div>
                        <strong>@T("This is not the payer the school bills.", "هذا ليس الدافع الذي تفوتره المدرسة.")</strong>
                        <div class="small">@T("No child on this card is billed to this person, so a receipt here allocates to nothing and is held as advance balance — the fees stay open on whoever is financially responsible. Check the payer before issuing.", "لا يوجد ابن على هذه البطاقة مفوتر على هذا الشخص، فأي سند هنا لن يُخصّص ويُحفظ كرصيد مقدّم — وتبقى الرسوم مفتوحة على المسؤول مالياً. تحقّق من الدافع قبل الإصدار.")</div>
                    </div>
                </div>
            }
            else if (sel.HasSplitResponsibility)
            {
                <div class="alert alert-info small" role="alert">
                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>@T("Responsibility is split on this card — only the children marked \"billed to this payer\" carry invoices addressed here (BR-PAR-005).", "المسؤولية مقسّمة على هذه البطاقة — الأبناء المعلّمون بـ\"مفوتر على هذا الدافع\" وحدهم تحمل فواتيرهم اسمه (BR-PAR-005).")
                </div>
            }
            <div class="sms-card mb-3">
                <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <span class="fs-5 fw-semibold">@FinanceLabels.ParentName(sel.Parent, isRtl)</span> <span class="text-muted">· @sel.Parent?.ParentFileNo · @sel.Parent?.PrimaryMobile</span>
                        @* The children as faces, not just numbers: money is taken at this counter for
                           one child of several, and the sibling on the screen should be the sibling in
                           front of it. Names stay whether or not the photo does (BR-STU-008). Beside
                           each one, what this payer is to them and whether the school bills this payer
                           for them — BR-PAR-005 assigns that per child, so it differs sibling to sibling. *@
                        <div class="d-flex flex-wrap gap-3 mt-2">
                            @foreach (var pc in sel.Children)
                            {
                                var ch = pc.Student;
                                <span class="d-inline-flex align-items-center gap-2 small text-muted">
                                    @if (Model.CanSeeStudentPhotos && ch.PhotoAttachmentId != null)
                                    {
                                        <img class="sms-photo-inline is-sm" loading="lazy"
                                             src="@Url.Action("Photo", "Students", new { id = ch.Id })"
                                             alt="@T("Photo of", "صورة") @FinanceLabels.StudentName(ch, isRtl)" />
                                    }
                                    <span>
                                        @ch.StudentNo @FinanceLabels.StudentName(ch, isRtl)
                                        <span class="opacity-75">· @(pc.IsCurrentGuardian ? pc.Relationship(isRtl) : T("former guardian", "ولي أمر سابق"))</span>
                                        @if (pc.IsFinanciallyResponsible)
                                        {
                                            <span class="badge text-bg-success">@T("billed to this payer", "مفوتر على هذا الدافع")</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-light border">@T("billed to someone else", "مفوتر على غيره")</span>
                                        }
                                    </span>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="text-end"><div class="small text-muted">@T("Total due", "إجمالي المستحق")</div><div class="fs-4 fw-bold @(Model.TotalDue > 0 ? "text-danger" : "text-success")">@Model.TotalDue.ToString("N2") <span class="visually-hidden">@(Model.TotalDue > 0 ? T("due", "مستحق") : T("settled", "مسدّد"))</span></div>@if (Model.AdvanceBalance > 0) { <div class="small text-success">@T("advance", "مقدّم") @Model.AdvanceBalance.ToString("N2")</div> }</div>
                </div>
                <div class="table-responsive"><table class="table table-sm sms-table mb-0 align-middle">
                    <caption class="visually-hidden">@T("Open invoices for the selected payer", "الفواتير المفتوحة للدافع المحدد")</caption>
                    <thead><tr><th scope="col">@T("Invoice", "الفاتورة")</th><th scope="col">@T("Posted", "التاريخ")</th><th scope="col">@T("Student", "الطالب")</th><th scope="col">@T("Category", "الفئة")</th><th scope="col" class="text-end">@T("Gross", "الإجمالي")</th><th scope="col" class="text-end">@T("Remaining", "المتبقي")</th><th scope="col" class="text-end">@T("Will allocate", "سيُخصّص")</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.OpenCharges)
                    {
                        var alloc = Model.Preview.FirstOrDefault(p => p.Row.Charge.Id == r.Charge.Id).Amount;
                        <tr class="@(alloc > 0 ? "table-success" : "")">
                            <td><a asp-controller="Fees" asp-action="Charge" asp-route-id="@r.Charge.Id"><code>@r.Charge.ChargeNo</code></a></td>
                            <td class="text-nowrap">@r.Charge.PostedAtUtc.ToString("yyyy-MM-dd")</td>
                            <td>@r.Student.StudentNo</td>
                            <td>@(isRtl ? r.Category.NameAr : r.Category.NameEn)</td>
                            <td class="text-end">@r.Charge.GrossAmount.ToString("N2")</td>
                            <td class="text-end text-danger">@r.Remaining.ToString("N2")</td>
                            <td class="text-end fw-semibold">@(alloc > 0 ? alloc.ToString("N2") : "")</td>
                        </tr>
                    }
                    @if (Model.OpenCharges.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">@T("No open invoices — any payment becomes advance balance.", "لا فواتير مفتوحة — أي دفعة تصبح رصيداً مقدّماً.")</td></tr> }
                    </tbody>
                    @if (Model.PreviewAmount > 0) { <tfoot><tr class="table-light"><th colspan="6" class="text-end">@T("Preview for", "معاينة لمبلغ") @Model.PreviewAmount?.ToString("N2") — @T("leftover to advance", "الفائض إلى المقدّم")</th><th class="text-end">@Model.PreviewLeftover.ToString("N2")</th></tr></tfoot> }
                </table></div>
            </div>

            <div class="sms-card p-3">
                <h2 class="h6 mb-3"><i class="bi bi-cash-coin me-1" aria-hidden="true"></i>@T("Capture payment", "تسجيل دفعة")</h2>
                <form method="post" asp-action="Capture" asp-route-q="@Model.Q" class="row g-2 align-items-end" id="capture">
                    <input type="hidden" name="payerId" value="@sel.Payer.Id" />
                    <div class="col-md-3"><label class="form-label small mb-1" for="cap-amount">@T("Amount", "المبلغ")</label><input id="cap-amount" name="amount" type="number" step="0.01" min="0.01" class="form-control form-control-lg text-end" value="@Model.PreviewAmount?.ToString("0.##", CultureInfo.InvariantCulture)" required onchange="document.getElementById('previewLink').href = '@Url.Action("Index", new { q = Model.Q, payerId = sel.Payer.Id })' + '&amount=' + this.value" /></div>
                    <div class="col-md-3"><label class="form-label small mb-1" for="cap-method">@T("Method", "الطريقة")</label><select id="cap-method" name="method" class="form-select form-select-lg">@foreach (var mth in new[] { PaymentMethod.Cash, PaymentMethod.Card, PaymentMethod.BankTransfer, PaymentMethod.Cheque }) { <option value="@mth">@FinanceLabels.Method(mth, isRtl)</option> }</select></div>
                    @* Where the money is going (BR-PAY-002). Every account is rendered and the script
                       below hides the ones that do not suit the chosen method, so switching from cash
                       to transfer re-points the destination without a round trip. The selected
                       account's number appears under the row — that is what a cashier reads out to a
                       parent asking where to send a transfer. *@
                    <div class="col-md-3">
                        <label class="form-label small mb-1" for="cap-account"><span id="cap-account-label">@CollectionAccountLabels.Destination(PaymentMethod.Cash, isRtl)</span></label>
                        <select id="cap-account" name="collectionAccountId" class="form-select form-select-lg">
                            <option value="" data-kind="">@T("— none —", "— بدون —")</option>
                            @foreach (var acc in Model.CollectionAccounts)
                            {
                                <option value="@acc.Id" data-kind="@acc.Kind" data-default="@(acc.IsDefault ? "1" : "")" data-bank="@acc.Bank(isRtl)" data-no="@acc.AccountNo" data-iban="@acc.Iban">@acc.Name(isRtl) (@acc.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3"><label class="form-label small mb-1" for="cap-ref">@T("Reference", "المرجع")</label><input id="cap-ref" name="methodRefNo" class="form-control form-control-lg" placeholder="@T("slip / transfer / cheque no.", "القسيمة / التحويل / رقم الشيك")" /></div>
                    <div class="col-md-3"><label class="form-label small mb-1" for="cap-till">@T("Till session", "جلسة الصندوق")</label><select id="cap-till" name="tillSessionId" class="form-select form-select-lg"><option value="">@T("— none (non-cash) —", "— بدون (غير نقدي) —")</option>@foreach (var s in Model.OpenSessions) { <option value="@s.Id" selected="@(s.Id == Model.MySession?.Id)">@s.TillCode @(s.Id == Model.MySession?.Id ? T("(mine)", "(جلستي)") : "")</option> }</select></div>
                    <div class="col-12">
                        @if (Model.CollectionAccounts.Count == 0)
                        {
                            <div class="alert alert-warning py-2 px-3 small mb-0" role="alert">
                                <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>@T("No collection accounts are defined, so this receipt will not say where the money went.", "لا توجد حسابات تحصيل معرَّفة، فلن يذكر هذا السند إلى أين ذهب المال.")
                                <a asp-action="Accounts">@T("Define them", "عرّفها الآن")</a>
                            </div>
                        }
                        else
                        {
                            @* Reading the destination back to the cashier — and through them to the payer.
                               aria-live, because it changes when the method does and a screen reader user
                               has otherwise been told nothing about the account they just re-pointed to. *@
                            <div id="cap-account-detail" class="alert alert-light border py-2 px-3 small mb-0" role="status" aria-live="polite" hidden></div>
                        }
                    </div>
                    <div class="col-12 d-flex gap-2 mt-3">
                        <button class="btn btn-success btn-lg px-4" type="submit"><i class="bi bi-receipt-cutoff me-1" aria-hidden="true"></i>@T("Issue receipt", "إصدار سند")</button>
                        <a id="previewLink" class="btn btn-outline-secondary btn-lg" href="@Url.Action("Index", new { q = Model.Q, payerId = sel.Payer.Id, amount = Model.PreviewAmount })"><i class="bi bi-eye me-1" aria-hidden="true"></i>@T("Preview allocation", "معاينة التخصيص")</a>
                        <a class="btn btn-outline-secondary btn-lg ms-auto" asp-action="Pdc"><i class="bi bi-calendar-check me-1" aria-hidden="true"></i>@T("Lodge PDC", "تسجيل شيك آجل")</a>
                    </div>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // The destination list, narrowed to the method. Cash collects into a cash box; transfer,
        // card and cheque all end up on a bank statement, so all three offer the bank accounts —
        // the same rule CollectionAccountSelector.KindFor enforces on the server, mirrored here so
        // the cashier never sees a choice the capture would refuse.
        (function () {
            var method = document.getElementById('cap-method');
            var picker = document.getElementById('cap-account');
            var label = document.getElementById('cap-account-label');
            var detail = document.getElementById('cap-account-detail');
            if (!method || !picker) { return; }

            var rtl = document.documentElement.dir === 'rtl';
            var labels = @Html.Raw(Json.Serialize(new Dictionary<string, string>
            {
                ["Cash"] = CollectionAccountLabels.Destination(PaymentMethod.Cash, isRtl),
                ["Card"] = CollectionAccountLabels.Destination(PaymentMethod.Card, isRtl),
                ["BankTransfer"] = CollectionAccountLabels.Destination(PaymentMethod.BankTransfer, isRtl),
                ["Cheque"] = CollectionAccountLabels.Destination(PaymentMethod.Cheque, isRtl),
            }));
            var words = {
                bank: rtl ? 'البنك' : 'Bank',
                accountNo: rtl ? 'رقم الحساب' : 'Account no.',
                iban: 'IBAN',
                none: rtl ? 'لم يُحدَّد حساب لهذه الطريقة.' : 'No account chosen for this method.',
                cashBox: rtl ? 'يُستلم في هذا الصندوق.' : 'Received into this cash box.'
            };

            function kindFor(m) { return m === 'Cash' ? 'CashBox' : 'Bank'; }

            function describe() {
                if (!detail) { return; }
                var opt = picker.options[picker.selectedIndex];
                if (!opt || !opt.value) { detail.hidden = true; detail.textContent = ''; return; }
                var parts = [];
                if (opt.dataset.kind === 'CashBox') {
                    parts.push(words.cashBox);
                } else {
                    if (opt.dataset.bank) { parts.push(words.bank + ': ' + opt.dataset.bank); }
                    if (opt.dataset.iban) { parts.push(words.iban + ': ' + opt.dataset.iban); }
                    if (opt.dataset.no) { parts.push(words.accountNo + ': ' + opt.dataset.no); }
                }
                detail.hidden = parts.length === 0;
                detail.textContent = parts.join('  ·  ');
            }

            function sync() {
                var kind = kindFor(method.value);
                if (label && labels[method.value]) { label.textContent = labels[method.value]; }

                var keep = null, fallback = null;
                for (var i = 0; i < picker.options.length; i++) {
                    var opt = picker.options[i];
                    var suits = !opt.value || opt.dataset.kind === kind;
                    // Hidden alone is not enough in every browser, and a disabled option can never be
                    // submitted — which is the point: a cash receipt must not carry a bank account.
                    opt.hidden = !suits;
                    opt.disabled = !suits;
                    if (suits && opt.value) {
                        if (!fallback) { fallback = opt; }
                        if (opt.dataset.default) { keep = opt; }
                    }
                }
                var current = picker.options[picker.selectedIndex];
                if (!current || current.disabled) {
                    picker.value = (keep || fallback || picker.options[0]).value;
                }
                describe();
            }

            method.addEventListener('change', sync);
            picker.addEventListener('change', describe);
            sync();
        })();
    </script>
}
