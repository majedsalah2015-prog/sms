@using System.Globalization
@model LoginViewModel
@{
    Layout = "_LoginLayout";
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Sign in", "تسجيل الدخول");
}

<h2 class="sms-auth__title">@T("Sign in to your account", "تسجيل الدخول إلى حسابك")</h2>

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="mb-3">
        <label asp-for="UserName" class="form-label">@T("Username", "اسم المستخدم")</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person"></i></span>
            <input asp-for="UserName" class="form-control" autocomplete="username" autofocus dir="ltr" />
        </div>
        <span asp-validation-for="UserName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">@T("Password", "كلمة المرور")</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input asp-for="Password" class="form-control" autocomplete="current-password" dir="ltr" />
            <button class="btn btn-outline-secondary" type="button" data-password-toggle="Password" aria-label="@T("Show password", "إظهار كلمة المرور")"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">@T("Remember me", "تذكرني")</label>
        </div>
        <span class="small text-muted" title="@T("Contact your system administrator to reset your password (BR-SEC-005).", "تواصل مع مسؤول النظام لإعادة تعيين كلمة المرور.")">@T("Forgot password?", "نسيت كلمة المرور؟")</span>
    </div>

    <button type="submit" class="btn btn-primary w-100 sms-auth__submit"><i class="bi bi-box-arrow-in-right"></i> @T("Sign in", "تسجيل الدخول")</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
