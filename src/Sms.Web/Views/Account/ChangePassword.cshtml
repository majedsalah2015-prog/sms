@using System.Globalization
@model ChangePasswordViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Change password", "تغيير كلمة المرور");
    if (Model.IsForced)
    {
        Layout = "_LoginLayout";
    }
    else
    {
        ViewData["Breadcrumb"] = T("Account / Change password", "الحساب / تغيير كلمة المرور");
    }
}

@if (Model.IsForced)
{
    <h2 class="sms-auth__title">@T("Set a new password", "تعيين كلمة مرور جديدة")</h2>
    <p class="text-muted small">@T("Your password was issued by an administrator and must be changed before you continue.", "تم إصدار كلمة المرور من قبل المسؤول ويجب تغييرها قبل المتابعة.")</p>
}
else
{
    <div class="sms-page-head"><h1 class="sms-page-title">@ViewData["Title"]</h1></div>
}

<div class="@(Model.IsForced ? "" : "sms-card p-4") " style="@(Model.IsForced ? "" : "max-width:520px")">
    <form asp-action="ChangePassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label">@T("Current password", "كلمة المرور الحالية")</label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" dir="ltr" autofocus />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">@T("New password", "كلمة المرور الجديدة")</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" dir="ltr" />
            <span asp-validation-for="NewPassword" class="text-danger small d-block"></span>
            <div class="form-text">@T("At least 10 characters with upper- and lowercase letters, a digit and a symbol; not one of your last 5.", "10 أحرف على الأقل تتضمن حروفاً كبيرة وصغيرة ورقماً ورمزاً؛ وليست إحدى آخر 5 كلمات مرور.")</div>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">@T("Confirm new password", "تأكيد كلمة المرور الجديدة")</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" dir="ltr" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary @(Model.IsForced ? "w-100 sms-auth__submit" : "")"><i class="bi bi-key" aria-hidden="true"></i> @T("Change password", "تغيير كلمة المرور")</button>
    </form>
    @if (Model.IsForced)
    {
        <form asp-action="Logout" method="post" class="text-center mt-3"><button type="submit" class="btn btn-link btn-sm">@T("Sign out", "تسجيل الخروج")</button></form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
