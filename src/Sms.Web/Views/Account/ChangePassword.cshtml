@using System.Globalization
@model ChangePasswordViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Change password", "تغيير كلمة المرور");
    if (Model.IsForced)
    {
        Layout = "_LoginLayout";
    }
    else
    {
        ViewData["Breadcrumb"] = T("Account / Change password", "الحساب / تغيير كلمة المرور");
    }
    var help = new HelpPanelViewModel
    {
        Id = "change-password-help",
        Title = T("Change password — help", "تغيير كلمة المرور — مساعدة"),
        Intro = T("The policy every password in this product is held to (BR-SEC-001). It is checked on save, so a refusal here names what is missing rather than failing silently.", "السياسة التي تخضع لها كل كلمة مرور في هذا المنتج (BR-SEC-001). وتُفحص عند الحفظ، فالرفض هنا يسمّي ما ينقص بدل أن يفشل صامتاً."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("What the policy requires", "ما تشترطه السياسة"), T("At least ten characters, with an upper-case letter, a lower-case letter, a digit and a symbol. All four are required; length alone is not enough.", "عشرة أحرف على الأقل، مع حرف كبير وحرف صغير ورقم ورمز. والأربعة جميعاً مطلوبة؛ فالطول وحده لا يكفي.")),
            new HelpPanelViewModel.Item(T("Recent passwords cannot be reused", "لا يُعاد استخدام كلمات المرور الأخيرة"), T("The last few you have used are remembered as hashes and refused, including the one you are replacing right now. Cycling back to a favourite is exactly what the rule exists to stop.", "تُحفظ آخر كلمات استخدمتها مُجزَّأة وتُرفض، بما فيها التي تستبدلها الآن. والعودة الدورية إلى كلمة مفضّلة هي بالضبط ما وُجدت القاعدة لمنعه.")),
            new HelpPanelViewModel.Item(T("Why you may have been sent here", "لماذا قد تكون أُرسلت إلى هنا"), T("A password issued by an administrator is one-time (BR-SEC-005): you cannot reach any other screen until it is replaced. Once changed, you continue to wherever you were originally heading.", "كلمة المرور الصادرة من المسؤول لمرة واحدة (BR-SEC-005): فلا تصل إلى شاشة أخرى حتى تستبدلها. وبعد التغيير تتابع إلى حيث كنت متجهاً أصلاً.")),
            new HelpPanelViewModel.Item(T("Changing it ends nothing else", "التغيير لا يُنهي شيئاً آخر"), T("Your other sessions are not signed out by a password change. If you are changing it because someone else may know it, ask an administrator to review the account's sessions as well.", "جلساتك الأخرى لا تُنهى بتغيير كلمة المرور. فإن كنت تغيّرها لأن شخصاً آخر قد يعرفها فاطلب من المسؤول مراجعة جلسات الحساب أيضاً.")),
        },
    };
}

@if (Model.IsForced)
{
    <div class="d-flex align-items-start justify-content-between gap-2">
        <h2 class="sms-auth__title mb-0">@T("Set a new password", "تعيين كلمة مرور جديدة")</h2>
        <partial name="_HelpModal" model="help" />
    </div>
    <p class="text-muted small">@T("Your password was issued by an administrator and must be changed before you continue.", "تم إصدار كلمة المرور من قبل المسؤول ويجب تغييرها قبل المتابعة.")</p>
}
else
{
    <div class="sms-page-head"><h1 class="sms-page-title">@ViewData["Title"]</h1><partial name="_HelpModal" model="help" /></div>
}

<div class="@(Model.IsForced ? "" : "sms-card p-4") " style="@(Model.IsForced ? "" : "max-width:520px")">
    <form asp-action="ChangePassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label">@T("Current password", "كلمة المرور الحالية")</label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" dir="ltr" autofocus />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">@T("New password", "كلمة المرور الجديدة")</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" dir="ltr" />
            <span asp-validation-for="NewPassword" class="text-danger small d-block"></span>
            <div class="form-text">@T("At least 10 characters with upper- and lowercase letters, a digit and a symbol; not one of your last 5.", "10 أحرف على الأقل تتضمن حروفاً كبيرة وصغيرة ورقماً ورمزاً؛ وليست إحدى آخر 5 كلمات مرور.")</div>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">@T("Confirm new password", "تأكيد كلمة المرور الجديدة")</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" dir="ltr" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary @(Model.IsForced ? "w-100 sms-auth__submit" : "")"><i class="bi bi-key" aria-hidden="true"></i> @T("Change password", "تغيير كلمة المرور")</button>
    </form>
    @if (Model.IsForced)
    {
        <form asp-action="Logout" method="post" class="text-center mt-3"><button type="submit" class="btn btn-link btn-sm">@T("Sign out", "تسجيل الخروج")</button></form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
