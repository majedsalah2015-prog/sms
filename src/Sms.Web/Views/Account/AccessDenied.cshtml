@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = isRtl ? "غير مصرح" : "Access denied";
}
<div class="sms-page-head"><h1 class="sms-page-title">@ViewData["Title"]</h1></div>
<div class="sms-card p-4" style="max-width:560px">
    <p class="mb-0">@(isRtl ? "ليست لديك صلاحية الوصول إلى هذه الصفحة." : "You do not have permission to access this page.")</p>
</div>
