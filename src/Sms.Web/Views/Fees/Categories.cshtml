@using System.Globalization
@model FeeCategoryCatalogViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Fee categories & VAT mapping", "فئات الرسوم وربط الضريبة");
    ViewData["Breadcrumb"] = T("Fees / Categories", "الرسوم / الفئات");
    ViewData["FinanceYear"] = Model.Year?.Id;
    string Pct(decimal? r) => r == null ? "—" : (r.Value * 100m).ToString("0.##", CultureInfo.InvariantCulture) + " %";
    var help = new HelpPanelViewModel
    {
        Id = "cat-help", Title = T("Categories — help", "الفئات — مساعدة"),
        Intro = T("A fee category names what is charged (tuition, books, transport…) and carries its VAT rate, mandatory/refundable flags, service link and GL export code (BR-FEE-001, BR-GLB-061).", "فئة الرسوم تسمّي ما يُفوتر (دراسية، كتب، نقل…) وتحمل نسبة الضريبة وأعلام الإلزام/الاسترداد وربط الخدمة ورمز التصدير المحاسبي (BR-FEE-001، BR-GLB-061)."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("VAT", "الضريبة"), T("Enter 15 or 0.15; blank = exempt. Every charge snapshots the rate at posting — changing it later never rewrites history.", "أدخل 15 أو 0.15؛ الفراغ = معفاة. كل فاتورة تسجّل النسبة عند الترحيل — تغييرها لاحقاً لا يعدّل السابق.")),
            new HelpPanelViewModel.Item(T("Edit ✎ / Deactivate", "تعديل ✎ / إلغاء تفعيل"), T("Edit in place (T2, no reason). Deactivation is refused while structure lines or charges reference the category.", "تعديل مباشر (T2 بلا سبب). يُرفض إلغاء التفعيل ما دامت أسطر الهيكل أو الفواتير تشير للفئة.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("The catalog every structure line and charge references.", "الفهرس الذي تشير إليه كل أسطر الهيكل والفواتير.")</p></div><partial name="_HelpModal" model="help" /></div>
<partial name="_FinanceNav" />

<div class="row g-3">
    <div class="col-lg-8">
        <div class="sms-card">
            <div class="table-responsive"><table class="table table-sm sms-table mb-0 align-middle">
                <caption class="visually-hidden">@T("Fee categories", "فئات الرسوم")</caption>
                <thead><tr><th scope="col">@T("Name (Ar)", "الاسم (ع)")</th><th scope="col">@T("Name (En)", "الاسم (E)")</th><th scope="col">@T("VAT", "الضريبة")</th><th scope="col">@T("Flags", "الأعلام")</th><th scope="col">@T("GL code", "رمز GL")</th><th scope="col">@T("Usage", "الاستخدام")</th><th scope="col"><span class="visually-hidden">@T("Actions", "إجراءات")</span></th></tr></thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    var c = r.Category;
                    if (Model.EditId == c.Id)
                    {
                        var fid = $"edit{c.Id}";
                        <tr class="table-warning">
                            <td><input id="cat-ar-@c.Id" form="@fid" name="nameAr" class="form-control form-control-sm" dir="rtl" value="@c.NameAr" required aria-label="@T("Name (Arabic)", "الاسم بالعربية")" /></td>
                            @* The English half fills itself from the Arabic one, but only while it
                               is still empty — an existing category already has an English name a
                               school chose, and retyping the Arabic must not overwrite it. *@
                            <td><input form="@fid" name="nameEn" class="form-control form-control-sm" dir="ltr" value="@c.NameEn" required aria-label="@T("Name (English)", "الاسم بالإنجليزية")" data-translit-from="#cat-ar-@c.Id" data-translit-mode="term" /></td>
                            <td><input form="@fid" name="vatRate" class="form-control form-control-sm" style="width:5.5rem" value="@(c.VatRate == null ? "" : (c.VatRate.Value * 100m).ToString("0.##", CultureInfo.InvariantCulture))" placeholder="15" aria-label="@T("VAT %", "الضريبة %")" /></td>
                            <td class="text-nowrap small">
                                <label class="me-2"><input form="@fid" type="checkbox" name="isMandatory" value="true" class="form-check-input" checked="@c.IsMandatory" /> @T("mandatory", "إلزامي")</label>
                                <label class="me-2"><input form="@fid" type="checkbox" name="isRefundable" value="true" class="form-check-input" checked="@c.IsRefundable" /> @T("refundable", "قابل للاسترداد")</label>
                                <label><input form="@fid" type="checkbox" name="isServiceLinked" value="true" class="form-check-input" checked="@c.IsServiceLinked" /> @T("service", "خدمة")</label>
                            </td>
                            <td><input form="@fid" name="glExportCode" class="form-control form-control-sm" style="width:6rem" value="@c.GlExportCode" aria-label="@T("GL export code", "رمز التصدير المحاسبي")" /></td>
                            <td class="small text-muted">@r.LineCount / @r.ChargeCount</td>
                            <td class="text-end text-nowrap"><form id="@fid" method="post" asp-action="EditCategory" asp-route-id="@c.Id" class="d-inline"><button class="btn btn-sm btn-primary" type="submit" aria-label="@T("Save", "حفظ")"><i class="bi bi-check-lg" aria-hidden="true"></i></button></form> <a class="btn btn-sm btn-outline-secondary" asp-action="Categories" aria-label="@T("Cancel", "إلغاء")"><i class="bi bi-x-lg" aria-hidden="true"></i></a></td>
                        </tr>
                    }
                    else
                    {
                        <tr class="@(c.IsActive ? "" : "text-muted")">
                            <td dir="rtl">@c.NameAr</td>
                            <td dir="ltr">@c.NameEn @if (!c.IsActive) { <span class="badge text-bg-secondary ms-1">@T("inactive", "غير مفعّلة")</span> }</td>
                            <td>@Pct(c.VatRate)</td>
                            <td class="small">@if (c.IsMandatory) { <span class="badge text-bg-dark me-1">@T("mandatory", "إلزامي")</span> } @if (c.IsRefundable) { <span class="badge text-bg-info me-1">@T("refundable", "قابل للاسترداد")</span> } @if (c.IsServiceLinked) { <span class="badge text-bg-light border">@T("service-linked", "مرتبط بخدمة")</span> }</td>
                            <td><code>@(c.GlExportCode ?? "—")</code></td>
                            <td class="small text-muted" title="@T("structure lines / charges", "أسطر الهيكل / الفواتير")">@r.LineCount @T("lines", "سطر") · @r.ChargeCount @T("charges", "فاتورة")</td>
                            <td class="text-end text-nowrap">
                                @if (c.IsActive)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Categories" asp-route-edit="@c.Id" title="@T("Edit", "تعديل")" aria-label="@T("Edit", "تعديل")"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <form method="post" asp-action="DeactivateCategory" asp-route-id="@c.Id" class="d-inline" onsubmit="return confirm('@T("Deactivate this category?", "إلغاء تفعيل هذه الفئة؟")');"><button class="btn btn-sm btn-outline-danger" type="submit" @(r.LineCount + r.ChargeCount > 0 ? "disabled" : "") title="@(r.LineCount + r.ChargeCount > 0 ? T("In use", "مستخدمة") : T("Deactivate", "إلغاء التفعيل"))" aria-label="@(r.LineCount + r.ChargeCount > 0 ? T("In use", "مستخدمة") : T("Deactivate", "إلغاء التفعيل"))"><i class="bi bi-trash" aria-hidden="true"></i></button></form>
                                }
                            </td>
                        </tr>
                    }
                }
                @if (Model.Rows.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">@T("No categories yet — add the first one.", "لا فئات بعد — أضف الأولى.")</td></tr> }
                </tbody>
            </table></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="sms-card p-3">
            <h2 class="h6 mb-3"><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>@T("New category", "فئة جديدة")</h2>
            <form method="post" asp-action="CreateCategory" class="d-grid gap-2">
                <div class="sms-bilingual"><input id="cat-new-ar" name="nameAr" class="form-control form-control-sm" dir="rtl" placeholder="الاسم بالعربية" required aria-required="true" aria-label="@T("Name (Arabic)", "الاسم بالعربية")" /><input name="nameEn" class="form-control form-control-sm" dir="ltr" placeholder="Name (English)" required aria-required="true" aria-label="@T("Name (English)", "الاسم بالإنجليزية")" data-translit-from="#cat-new-ar" data-translit-mode="term" /></div>
                <div class="form-text">@T("Type the Arabic name and the English one fills itself — a fee category's English name is what a parent reads on an invoice, so it is translated, not spelled out letter by letter. Correct it whenever the suggestion is wrong.", "اكتب الاسم بالعربية ويُملأ الإنجليزي تلقائياً — فالاسم الإنجليزي لفئة الرسوم هو ما يقرأه ولي الأمر على الفاتورة، ولذلك يُترجَم ولا يُكتب بحروف لاتينية. صحّحه متى كان الاقتراح خاطئاً.")</div>
                <div class="input-group input-group-sm"><span class="input-group-text" id="cat-vat-lbl">@T("VAT %", "الضريبة %")</span><input name="vatRate" class="form-control" aria-labelledby="cat-vat-lbl" placeholder="@(Model.DefaultVatRate == null ? "15" : (Model.DefaultVatRate.Value * 100m).ToString("0.##", CultureInfo.InvariantCulture))" /><span class="input-group-text text-muted small">@T("blank = exempt", "فارغ = معفاة")</span></div>
                <div class="d-flex flex-wrap gap-3 small">
                    <label><input type="checkbox" name="isMandatory" value="true" class="form-check-input" /> @T("Mandatory", "إلزامي")</label>
                    <label><input type="checkbox" name="isRefundable" value="true" class="form-check-input" /> @T("Refundable", "قابل للاسترداد")</label>
                    <label><input type="checkbox" name="isServiceLinked" value="true" class="form-check-input" /> @T("Service-linked", "مرتبط بخدمة")</label>
                </div>
                <input name="glExportCode" class="form-control form-control-sm" aria-label="@T("GL export code", "رمز التصدير المحاسبي")" placeholder="@T("GL export code (optional)", "رمز التصدير المحاسبي (اختياري)")" />
                <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("Add", "إضافة")</button>
            </form>
            @if (Model.DefaultVatRate != null) { <div class="small text-muted mt-2">@T("School default VAT rate", "نسبة الضريبة الافتراضية للمدرسة"): @Pct(Model.DefaultVatRate) (Financial.VatRate)</div> }
        </div>
    </div>
</div>
