@using System.Globalization
@using Sms.Domain.Fees
@model FeeStructureViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Fee structure workbench", "منضدة هيكل الرسوم");
    ViewData["Breadcrumb"] = T("Fees / Fee structure", "الرسوم / هيكل الرسوم");
    ViewData["FinanceYear"] = Model.Year?.Id;
    var yid = Model.Year?.Id;
    var help = new HelpPanelViewModel
    {
        Id = "fs-help", Title = T("Fee structure — help", "هيكل الرسوم — مساعدة"),
        Intro = T("One amount per grade-year × category. A line starts Draft, becomes Approved (immutable) and only then can be charged (BR-FEE-002).", "مبلغ واحد لكل صف-عام × فئة. يبدأ السطر مسودة ثم يُعتمد (ثابت) وعندها فقط يُفوتر (BR-FEE-002)."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Grid", "الشبكة"), T("Rows are the year's grade profiles, columns the active categories. Type the amounts along a grade's row, then Save beside its total (↵ in any cell does the same); a draft cell can also be approved ✓ or removed 🗑 on its own.", "الصفوف ملفات الصفوف للعام والأعمدة الفئات الفعّالة. اكتب المبالغ على امتداد سطر الصف ثم احفظ بجوار المجموع (أو اضغط ↵ في أي خلية)؛ ويمكن اعتماد ✓ خلية المسودة أو حذفها 🗑 وحدها.")),
            new HelpPanelViewModel.Item(T("Save / Clear a row", "حفظ / تصفير سطر"), T("Save writes the whole row at once: an empty cell with an amount becomes a Draft line, a changed draft amount is updated against the reason typed beside it (T1), a blank cell changes nothing, and an approved price is left alone. Clear removes the row's draft lines only — an approved price leaves the list by withdrawal, with a reason (BR-GLB-005).", "يكتب الحفظ السطر كاملاً: الخلية الفارغة ذات المبلغ تصبح سطر مسودة، ومبلغ المسودة المتغيّر يُحدَّث بالسبب المكتوب بجواره (T1)، والخلية الفارغة لا تغيّر شيئاً، والسعر المعتمد يبقى كما هو. أما التصفير فيحذف مسودات السطر فقط — إذ لا يخرج السعر المعتمد إلا بالسحب مع ذكر السبب (BR-GLB-005).")),
            new HelpPanelViewModel.Item(T("Copy from last year", "نسخ من العام السابق"), T("Copies every approved line of the source year into this year's matching grades (by grade level) as Draft, with an optional % uplift. Existing pairs are skipped.", "ينسخ كل الأسطر المعتمدة من العام المصدر إلى صفوف هذا العام المطابقة كمسودات مع نسبة رفع اختيارية. الأزواج الموجودة تُتخطى.")),
            new HelpPanelViewModel.Item(T("Approve all", "اعتماد الكل"), T("Approves every Draft line of the year in one go — use after review.", "يعتمد كل مسودات العام دفعة واحدة — بعد المراجعة.")),
        },
    };
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Grade-year × category grid; approve before the registration wave.", "شبكة صف-عام × فئة؛ اعتمد قبل موجة التسجيل.")</p></div>
    <div class="d-flex gap-2 align-items-center"><form method="get" class="d-flex gap-2"><select name="year" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="@T("Academic year", "العام الدراسي")">@foreach (var y in Model.Years) { <option value="@y.Id" selected="@(y.Id == yid)">@(isRtl ? y.LabelAr : y.LabelEn)</option> }</select></form><partial name="_HelpModal" model="help" /></div></div>
<partial name="_FinanceNav" />

@if (Model.Year == null) { <div class="alert alert-info">@T("Define an academic year first.", "عرّف عاماً دراسياً أولاً.")</div> }
else if (Model.Categories.Count == 0) { <div class="alert alert-warning">@T("No fee categories yet —", "لا فئات رسوم بعد —") <a asp-action="Categories">@T("define the catalog first", "عرّف الفهرس أولاً")</a>.</div> }
else if (Model.Profiles.Count == 0) { <div class="alert alert-warning">@T("This year has no grade-year profiles yet — set them up under Grades.", "لا ملفات صفوف لهذا العام بعد — أعدّها من الصفوف.")</div> }
else
{
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <span class="badge text-bg-warning">@Model.DraftCount @T("draft", "مسودة")</span>
        <span class="badge text-bg-success">@Model.ApprovedCount @T("approved", "معتمد")</span>
        <span class="text-muted small">· @(Model.Profiles.Count * Model.Categories.Count - Model.Lines.Count) @T("empty cells", "خلية فارغة")</span>
        <span class="ms-auto"></span>
        @if (Model.DraftCount > 0)
        {
            <form method="post" asp-action="ApproveAll" asp-route-year="@yid" onsubmit="return confirm('@T("Approve every draft line of this year?", "اعتماد كل مسودات هذا العام؟")');"><button class="btn btn-sm btn-success" type="submit"><i class="bi bi-check2-all me-1" aria-hidden="true"></i>@T("Approve all drafts", "اعتماد كل المسودات")</button></form>
        }
        <form method="post" asp-action="CopyStructure" asp-route-year="@yid" class="d-flex gap-1 align-items-center">
            <select name="sourceYear" class="form-select form-select-sm" style="width:auto" aria-label="@T("Source year", "العام المصدر")">@foreach (var y in Model.Years.Where(y => y.Id != yid)) { <option value="@y.Id" selected="@(y.Id == Model.PreviousYear?.Id)">@(isRtl ? y.LabelAr : y.LabelEn)</option> }</select>
            <div class="input-group input-group-sm" style="width:9rem"><input name="uplift" type="number" step="0.01" class="form-control" value="0" aria-label="@T("Uplift %", "نسبة الرفع %")" /><span class="input-group-text" aria-hidden="true">%</span></div>
            <button class="btn btn-sm btn-outline-primary" type="submit" @(Model.Years.Count < 2 ? "disabled" : "")><i class="bi bi-files me-1" aria-hidden="true"></i>@T("Copy from year", "نسخ من عام")</button>
        </form>
    </div>

    <div class="sms-card">
        <div class="table-responsive"><table class="table table-sm sms-table mb-0 align-middle">
            <caption class="visually-hidden">@T("Fee structure grid: grade-year rows by fee category columns", "شبكة هيكل الرسوم: صفوف الأعوام حسب أعمدة فئات الرسوم")</caption>
            <thead><tr><th scope="col">@T("Grade", "الصف")</th><th scope="col" class="text-muted small">@T("enrolled", "مقيّد")</th>@foreach (var c in Model.Categories) { <th scope="col" class="text-center" style="min-width:9rem">@(isRtl ? c.NameAr : c.NameEn)<br /><span class="small text-muted fw-normal">@(c.VatRate == null ? T("exempt", "معفاة") : (c.VatRate.Value * 100m).ToString("0.##") + " %")</span></th> }<th scope="col" class="text-end">@T("Total", "المجموع")</th></tr></thead>
            <tbody>
            @foreach (var p in Model.Profiles)
            {
                var rowTotal = Model.Categories.Sum(c => Model.Lines.TryGetValue((p.Profile.Id, c.Id), out var l) ? l.Amount : 0m);
                @* Every editable cell in the row posts to one form, which lives beside the total.
                   A grade is priced across all its categories in a single sitting, and one save
                   per cell meant a page reload between each figure. *@
                var rid = $"fsrow{p.Profile.Id}";
                <tr>
                    <th scope="row"><span class="fw-semibold">@(isRtl ? p.Grade.Name.NameAr : p.Grade.Name.NameEn)</span><br /><span class="small text-muted">@(isRtl ? p.Stage.Name.NameAr : p.Stage.Name.NameEn)</span></th>
                    <td class="small text-muted">@p.Enrolled</td>
                    @foreach (var c in Model.Categories)
                    {
                        <td class="text-center">
                        @if (Model.Lines.TryGetValue((p.Profile.Id, c.Id), out var line))
                        {
                            if (line.Status == FeeStructureLineStatus.Withdrawn)
                            {
                                <div class="text-muted" title="@T("Withdrawn — no longer charged to this grade", "مسحوب — لم يعد يُحمَّل على هذا الصف")">
                                    <s>@line.Amount.ToString("N2")</s>
                                    <div class="small">@T("withdrawn", "مسحوب")</div>
                                </div>
                            }
                            else if (line.Status == FeeStructureLineStatus.Approved)
                            {
                                var wid = $"wd{line.Id}";
                                <div class="fw-semibold text-success" title="@T("Approved", "معتمد")">@line.Amount.ToString("N2") <i class="bi bi-lock-fill small" aria-hidden="true"></i><span class="visually-hidden">@T("approved", "معتمد")</span></div>
                                @* BR-FEE-002 keeps the amount immutable; the only exit an approved price
                                   has is to leave the list, with the reason on the record. Refused once
                                   anything has been billed from it. *@
                                <div class="d-flex gap-1 justify-content-center align-items-center mt-1">
                                    <input form="@wid" name="reason" class="form-control form-control-sm" style="width:6rem" required
                                           placeholder="@T("reason", "السبب")"
                                           aria-label="@T($"Reason for withdrawing {p.Grade.Name.NameEn} × {c.NameEn}", $"سبب سحب {p.Grade.Name.NameAr} × {c.NameAr}")" />
                                    <form id="@wid" method="post" asp-action="WithdrawLine" asp-route-id="@line.Id" asp-route-year="@yid" class="d-inline"
                                          onsubmit="return confirm('@T("Withdraw this price? The line stays on the record and stops being charged to this grade.", "سحب هذا السعر؟ يبقى السطر في السجل ويتوقف عن التحميل على هذا الصف.")');">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="@T("Withdraw", "سحب")" aria-label="@T("Withdraw", "سحب")"><i class="bi bi-x-octagon" aria-hidden="true"></i></button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex gap-1 justify-content-center align-items-center">
                                    <input form="@rid" name="amount_@c.Id" type="number" step="0.01" min="0" class="form-control form-control-sm text-end" style="width:6.5rem" value="@line.Amount.ToString("0.##", CultureInfo.InvariantCulture)" aria-label="@T($"Amount — {p.Grade.Name.NameEn} × {c.NameEn}", $"المبلغ — {p.Grade.Name.NameAr} × {c.NameAr}")" />
                                    <input form="@rid" name="reason_@c.Id" class="form-control form-control-sm" style="width:6rem" placeholder="@T("reason", "السبب")" title="@T("Reason for amount change (T1)", "سبب تغيير المبلغ (T1)")" aria-label="@T($"Reason — {p.Grade.Name.NameEn} × {c.NameEn}", $"السبب — {p.Grade.Name.NameAr} × {c.NameAr}")" />
                                    <form method="post" asp-action="ApproveLine" asp-route-id="@line.Id" asp-route-year="@yid" class="d-inline"><button class="btn btn-sm btn-outline-success" type="submit" title="@T("Approve", "اعتماد")" aria-label="@T("Approve", "اعتماد")"><i class="bi bi-check-lg" aria-hidden="true"></i></button></form>
                                    <form method="post" asp-action="DeleteLine" asp-route-id="@line.Id" asp-route-year="@yid" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit" title="@T("Remove draft", "حذف المسودة")" aria-label="@T("Remove draft", "حذف المسودة")"><i class="bi bi-trash" aria-hidden="true"></i></button></form>
                                </div>
                                <div class="small text-warning-emphasis">@T("draft", "مسودة")</div>
                            }
                        }
                        else
                        {
                            <div class="d-flex justify-content-center"><input form="@rid" name="amount_@c.Id" type="number" step="0.01" min="0" class="form-control form-control-sm text-end" style="width:6.5rem" placeholder="—" title="@T("Type an amount and save the row", "اكتب مبلغاً واحفظ السطر")" aria-label="@T($"Amount — {p.Grade.Name.NameEn} × {c.NameEn}", $"المبلغ — {p.Grade.Name.NameAr} × {c.NameAr}")" /></div>
                        }
                        </td>
                    }
                    <td class="text-end fw-semibold">
                        <div>@rowTotal.ToString("N2")</div>
                        <div class="d-flex gap-1 justify-content-end mt-1">
                            @* The save form owns every amount and reason field in the row (they carry
                               form="@rid"), so ↵ in any cell submits the whole line. Clearing is a
                               second form because it is a different act on the same row — drafts only,
                               since an approved price leaves the list by withdrawal alone (BR-GLB-005). *@
                            <form id="@rid" method="post" asp-action="SaveRow" asp-route-profileId="@p.Profile.Id" asp-route-year="@yid" class="d-inline">
                                <button class="btn btn-sm btn-primary" type="submit" title="@T("Save this row", "حفظ هذا السطر")" aria-label="@T($"Save row — {p.Grade.Name.NameEn}", $"حفظ سطر — {p.Grade.Name.NameAr}")"><i class="bi bi-save me-1" aria-hidden="true"></i>@T("Save", "حفظ")</button>
                            </form>
                            <form method="post" asp-action="ResetRow" asp-route-profileId="@p.Profile.Id" asp-route-year="@yid" class="d-inline"
                                  onsubmit="return confirm('@T("Clear every draft amount in this row? Approved prices stay.", "تصفير كل مبالغ المسودة في هذا السطر؟ تبقى الأسعار المعتمدة.")');">
                                <button class="btn btn-sm btn-outline-danger" type="submit" title="@T("Clear this row's drafts", "تصفير مسودات هذا السطر")" aria-label="@T($"Clear row — {p.Grade.Name.NameEn}", $"تصفير سطر — {p.Grade.Name.NameAr}")"><i class="bi bi-eraser me-1" aria-hidden="true"></i>@T("Clear", "تصفير")</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
        <div class="p-2 small text-muted">@T("Amounts are net of VAT; the VAT rate is applied from the category at posting time and snapshotted on each invoice (BR-GLB-061).", "المبالغ صافية قبل الضريبة؛ تُطبَّق نسبة الضريبة من الفئة عند الترحيل وتُسجَّل على كل فاتورة (BR-GLB-061).")</div>
    </div>
}
