@using System.Globalization
@using Sms.Domain.Fees
@model ChargeDocumentViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var c = Model.Charge;
    ViewData["Title"] = T("Tax invoice", "فاتورة ضريبية") + " · " + c.ChargeNo;
    ViewData["Breadcrumb"] = T("Fees / Charges / Document", "الرسوم / الفواتير / المستند");
    ViewData["FinanceYear"] = c.AcademicYearId;
    var s = Model.Student;
    var isVat = c.VatRateSnapshot != null;
    var voided = c.Status == ChargeStatus.Void;
}
<style>
    .inv-sheet { background: #fff; color: #111; max-width: 860px; margin: 0 auto; padding: 1.75rem 2.25rem; border: 1px solid #ddd; position: relative; }
    .inv-sheet .inv-water { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 5rem; font-weight: 800; color: rgba(220, 38, 38, .12); transform: rotate(-25deg); pointer-events: none; }
    .inv-table th, .inv-table td { border: 1px solid #cbd5e1; padding: .35rem .5rem; font-size: .9rem; }
    .inv-table th { background: #f1f5f9; }
    .inv-meta { font-size: .85rem; }
    .inv-qr { font-family: monospace; font-size: .65rem; word-break: break-all; max-width: 16rem; }
    @@media print { body * { visibility: hidden; } .inv-print, .inv-print * { visibility: visible; } .inv-print { position: absolute; left: 0; top: 0; width: 100%; } .inv-sheet { border: 0; } }
</style>

<div class="sms-page-head d-print-none"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("Bilingual tax-invoice layout (BR-FEE-005, ZATCA Phase-1 QR payload). The stored PDF is pending the O6 engine decision.", "تنسيق فاتورة ضريبية ثنائي اللغة (BR-FEE-005، حمولة QR لهيئة الزكاة المرحلة 1). ملف PDF المخزّن بانتظار قرار محرك O6.")</p></div>
    <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-primary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1" aria-hidden="true"></i>@T("Print", "طباعة")</button>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Position" asp-route-payerId="@c.PayerId"><i class="bi bi-journal-text me-1" aria-hidden="true"></i>@T("Payer statement", "كشف حساب الدافع")</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-year="@c.AcademicYearId"><i class="bi bi-arrow-left me-1 @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i>@T("Charges", "الفواتير")</a>
    </div></div>
<partial name="_FinanceNav" />

<div class="row g-3">
    <div class="col-lg-8">
        <div class="inv-print">
        <div class="inv-sheet">
            @if (voided) { <div class="inv-water">@T("VOID", "ملغاة")</div> }
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div dir="rtl" class="text-end"><div class="fw-bold fs-5">@Model.SchoolNameAr</div><div class="small text-muted">@Model.SchoolAddress</div>@if (!string.IsNullOrWhiteSpace(Model.VatRegistrationNumber)) { <div class="small">الرقم الضريبي: @Model.VatRegistrationNumber</div> }</div>
                <div dir="ltr" class="text-start"><div class="fw-bold fs-5">@Model.SchoolNameEn</div><div class="small text-muted">@Model.SchoolAddress</div>@if (!string.IsNullOrWhiteSpace(Model.VatRegistrationNumber)) { <div class="small">VAT No.: @Model.VatRegistrationNumber</div> }</div>
            </div>
            <div class="text-center my-2"><span class="fs-5 fw-bold">@(isVat ? "فاتورة ضريبية · Tax Invoice" : "فاتورة · Invoice")</span></div>
            <div class="row inv-meta mb-3">
                <div class="col-6" dir="ltr">
                    <div><span class="text-muted">Invoice No.</span> <strong>@c.ChargeNo</strong></div>
                    <div><span class="text-muted">Date</span> @c.PostedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
                    <div><span class="text-muted">UUID</span> <code class="small">@c.InvoiceUuid</code></div>
                    <div><span class="text-muted">Academic year</span> @Model.Year.LabelEn</div>
                    <div><span class="text-muted">Source</span> @FinanceLabels.ChargeSource(c.SourceType, false)</div>
                </div>
                <div class="col-6 text-end" dir="rtl">
                    <div><span class="text-muted">الدافع</span> <strong>@FinanceLabels.ParentName(Model.Payer, true)</strong> @(Model.Payer == null ? "" : $"· {Model.Payer.ParentFileNo}")</div>
                    <div><span class="text-muted">الطالب</span> @FinanceLabels.StudentName(s, true) · @s.StudentNo</div>
                    @if (Model.Grade != null) { <div><span class="text-muted">الصف</span> @Model.Grade.Name.NameAr</div> }
                    <div dir="ltr" class="text-end"><span class="text-muted">Payer</span> @FinanceLabels.ParentName(Model.Payer, false) · <span class="text-muted">Student</span> @FinanceLabels.StudentName(s, false)</div>
                </div>
            </div>
            <table class="inv-table w-100 mb-3">
                <caption class="visually-hidden">@T("Invoice lines", "بنود الفاتورة")</caption>
                <thead><tr><th scope="col">#</th><th scope="col">@Model.Category.NameAr · @Model.Category.NameEn</th><th scope="col" class="text-end">Net / الصافي</th><th scope="col" class="text-end">VAT % / الضريبة</th><th scope="col" class="text-end">VAT / الضريبة</th><th scope="col" class="text-end">Gross / الإجمالي</th></tr></thead>
                <tbody><tr><td>1</td><td>@(isRtl ? Model.Category.NameAr : Model.Category.NameEn) @(c.SourceType == ChargeSourceType.OpeningBalance ? $"(opening balance / رصيد افتتاحي, year {c.SourceAcademicYearId})" : "")</td><td class="text-end">@c.NetAmount.ToString("N2")</td><td class="text-end">@(isVat ? (c.VatRateSnapshot!.Value * 100m).ToString("0.##") + " %" : "—")</td><td class="text-end">@c.VatAmount.ToString("N2")</td><td class="text-end fw-semibold">@c.GrossAmount.ToString("N2")</td></tr></tbody>
                <tfoot>
                    <tr><th colspan="5" class="text-end">Total excl. VAT / المجموع قبل الضريبة</th><th class="text-end">@c.NetAmount.ToString("N2")</th></tr>
                    <tr><th colspan="5" class="text-end">VAT / ضريبة القيمة المضافة</th><th class="text-end">@c.VatAmount.ToString("N2")</th></tr>
                    <tr><th colspan="5" class="text-end">Total incl. VAT / الإجمالي شامل الضريبة</th><th class="text-end fs-6">@c.GrossAmount.ToString("N2")</th></tr>
                </tfoot>
            </table>
            <div class="d-flex justify-content-between align-items-end inv-meta">
                <div>
                    @if (Model.Credited > 0 || Model.Discounted > 0 || Model.Allocated > 0)
                    {
                        <div class="small"><span class="text-muted">Credit notes / إشعارات دائنة</span> <bdi dir="ltr">−@Model.Credited.ToString("N2")</bdi> · <span class="text-muted">Discounts / خصومات</span> <bdi dir="ltr">−@Model.Discounted.ToString("N2")</bdi> · <span class="text-muted">Paid / مدفوع</span> <bdi dir="ltr">−@Model.Allocated.ToString("N2")</bdi></div>
                        <div class="fw-semibold">Balance due / المتبقي: @Model.Remaining.ToString("N2")</div>
                    }
                    <div class="small text-muted mt-1">Hash: <code class="small">@(c.InvoiceHash?[..Math.Min(16, c.InvoiceHash.Length)])…</code> @(c.PreviousInvoiceHash == null ? "(chain genesis)" : "")</div>
                </div>
                <div class="text-end">
                    @if (Model.ZatcaQrPayload != null)
                    {
                        <div class="small text-muted">ZATCA Phase-1 QR (TLV base64)</div><div class="inv-qr">@Model.ZatcaQrPayload</div>
                    }
                    else if (isVat) { <div class="small text-warning-emphasis">@T("Set Financial.VatRegistrationNumber in Setup to emit the QR.", "اضبط Financial.VatRegistrationNumber في الإعداد لإصدار رمز QR.")</div> }
                </div>
            </div>
        </div>
        </div>
    </div>
    <div class="col-lg-4 d-print-none">
        <div class="sms-card mb-3">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center"><h2 class="h6 mb-0"><i class="bi bi-arrow-return-left me-1" aria-hidden="true"></i>@T("Credit notes", "الإشعارات الدائنة")</h2><span class="badge text-bg-light border">@Model.CreditNotes.Count</span></div>
            @if (Model.CreditNotes.Count > 0)
            {
                <ul class="list-group list-group-flush">@foreach (var n in Model.CreditNotes) { <li class="list-group-item small d-flex justify-content-between"><span><code>@n.CreditNoteNo</code> · @n.IssuedAtUtc.ToString("yyyy-MM-dd")<br /><span class="text-muted">@n.Reason</span> @if (n.IsCarryForward) { <span class="badge text-bg-secondary">carry-forward</span> }</span><span class="fw-semibold"><bdi dir="ltr">−@n.Amount.ToString("N2")</bdi></span></li> }</ul>
            }
            <div class="p-3">
                @if (!voided && c.GrossAmount - Model.Credited > 0)
                {
                    <form method="post" asp-action="IssueCreditNote" asp-route-id="@c.Id" class="d-grid gap-2">
                        <div class="input-group input-group-sm"><span class="input-group-text">@T("Amount", "المبلغ")</span><input name="amount" type="number" step="0.01" min="0.01" max="@((c.GrossAmount - Model.Credited).ToString("0.##", CultureInfo.InvariantCulture))" class="form-control" required /><span class="input-group-text small text-muted">≤ @((c.GrossAmount - Model.Credited).ToString("N2"))</span></div>
                        <input name="reason" class="form-control form-control-sm" placeholder="@T("Reason (mandatory)", "السبب (إلزامي)")" required />
                        <button class="btn btn-outline-danger btn-sm" type="submit" onclick="return confirm('@T("Issue a credit note against this invoice?", "إصدار إشعار دائن على هذه الفاتورة؟")');"><i class="bi bi-file-earmark-minus me-1" aria-hidden="true"></i>@T("Issue credit note", "إصدار إشعار دائن")</button>
                    </form>
                }
                else { <div class="small text-muted">@(voided ? T("Voided invoice.", "فاتورة ملغاة.") : T("Nothing left to credit.", "لا متبقٍ للإشعار."))</div> }
            </div>
        </div>
        <div class="sms-card">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center"><h2 class="h6 mb-0"><i class="bi bi-cash-coin me-1" aria-hidden="true"></i>@T("Payments allocated", "المدفوعات المخصّصة")</h2><span class="badge text-bg-light border">@Model.Allocations.Count</span></div>
            <ul class="list-group list-group-flush">
                @foreach (var (a, r) in Model.Allocations) { <li class="list-group-item small d-flex justify-content-between"><span><a asp-controller="Payments" asp-action="Receipt" asp-route-id="@r.Id"><code>@r.ReceiptNo</code></a> · @r.IssuedAtUtc.ToString("yyyy-MM-dd") · @FinanceLabels.Method(r.Method, isRtl)</span><span class="fw-semibold text-success">@a.AllocatedAmount.ToString("N2")</span></li> }
                @if (Model.Allocations.Count == 0) { <li class="list-group-item small text-muted">@T("No payments yet.", "لا مدفوعات بعد.")</li> }
            </ul>
            <div class="p-3 d-flex justify-content-between"><span>@T("Remaining", "المتبقي")</span><span class="fw-bold @(Model.Remaining > 0 ? "text-danger" : "text-success")">@Model.Remaining.ToString("N2") <span class="visually-hidden">@(Model.Remaining > 0 ? T("due", "مستحق") : T("settled", "مسدّد"))</span></span></div>
            @if (Model.Remaining > 0) { <div class="px-3 pb-3"><a class="btn btn-success btn-sm w-100" asp-controller="Payments" asp-action="Index" asp-route-payerId="@c.PayerId" asp-route-amount="@Model.Remaining.ToString("0.##", CultureInfo.InvariantCulture)"><i class="bi bi-cash me-1" aria-hidden="true"></i>@T("Collect at cashier", "تحصيل في الصندوق")</a></div> }
        </div>
    </div>
</div>
