@using System.Globalization
@model ApplicationFormViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("New application", "طلب قبول جديد");
    ViewData["Breadcrumb"] = T("Admissions / New application", "القبول / طلب جديد");
}

<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@Model.CampaignLabel · @T("Counter capture: bilingual quad name, DOB, gender, nationality; parent linked or created with a mobile-based dedup step (BR-GLB-003/004); duplicates and age eligibility are checked by the engine (BR-ADM-002, BR-GRD-005).", "إدخال من الشباك: الاسم الرباعي بالعربية والإنجليزية، الميلاد، الجنس، الجنسية؛ يُربط ولي الأمر أو يُنشأ مع فحص التكرار بالجوال (BR-GLB-003/004)؛ يفحص المحرك التكرار وأهلية العمر (BR-ADM-002، BR-GRD-005).")</p></div></div>
<partial name="_AdmissionsNav" />
@{ var quickHelp = new HelpPanelViewModel { Id = "adm-quick-help", Title = T("Admissions — help", "القبول والتسجيل — مساعدة"), Intro = T("Pipeline: Draft → Submitted → Under review → Recommended → Approve / Reject / Waitlist → Registered (WF-01). Full guidance is on the Campaigns page help.", "المسار: مسودة → مقدَّم → مراجعة → موصى به → اعتماد / رفض / انتظار → مسجَّل (WF-01). الإرشاد الكامل في مساعدة صفحة الحملات."), Items = new[] { new HelpPanelViewModel.Item(T("Decisions", "القرارات"), T("Only legal moves are offered; Approved unlocks registration (needs a linked parent and a section with a seat).", "تُعرض الانتقالات المشروعة فقط؛ الاعتماد يفتح التسجيل (يحتاج ولي أمر مرتبطاً وشعبة بها مقعد).")), new HelpPanelViewModel.Item(T("Waiting list", "قائمة الانتظار"), T("Offer a seat with an expiry, then record accepted / declined (BR-ADM-006).", "اعرض مقعداً بمهلة ثم سجّل القبول/الرفض (BR-ADM-006).")) } }; }
<div class="mb-3 text-end"><partial name="_HelpModal" model="quickHelp" /></div>

<form method="post" asp-action="Apply">
    <input type="hidden" asp-for="CampaignId" />
    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
    <p class="form-text">@T("Fields marked * are required.", "الحقول المعلّمة بـ * إلزامية.")</p>
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="sms-card p-4 mb-3">
                <h2 class="h6 mb-3">@T("Applicant", "المتقدم")</h2>
                <div class="sms-bilingual mb-3">
                    <div><label class="form-label small" asp-for="FirstNameAr">@T("Name (Arabic): first / father / grandfather / family", "الاسم بالعربية: الأول / الأب / الجد / العائلة") <span class="text-danger" aria-hidden="true">*</span></label>
                        <div class="row g-1"><div class="col-3"><input asp-for="FirstNameAr" class="form-control form-control-sm" dir="rtl" placeholder="الأول" required aria-required="true" aria-label="@T("First name (Arabic)", "الاسم الأول (عربي)")" /><span asp-validation-for="FirstNameAr" class="text-danger small"></span></div><div class="col-3"><input asp-for="FatherNameAr" class="form-control form-control-sm" dir="rtl" placeholder="الأب" required aria-required="true" aria-label="@T("Father name (Arabic)", "اسم الأب (عربي)")" /><span asp-validation-for="FatherNameAr" class="text-danger small"></span></div><div class="col-3"><input asp-for="GrandfatherNameAr" class="form-control form-control-sm" dir="rtl" placeholder="الجد" required aria-required="true" aria-label="@T("Grandfather name (Arabic)", "اسم الجد (عربي)")" /><span asp-validation-for="GrandfatherNameAr" class="text-danger small"></span></div><div class="col-3"><input asp-for="FamilyNameAr" class="form-control form-control-sm" dir="rtl" placeholder="العائلة" required aria-required="true" aria-label="@T("Family name (Arabic)", "اسم العائلة (عربي)")" /><span asp-validation-for="FamilyNameAr" class="text-danger small"></span></div></div></div>
                    <div><label class="form-label small" asp-for="FirstNameEn">@T("Name (English): first / father / grandfather / family", "الاسم بالإنجليزية: الأول / الأب / الجد / العائلة") <span class="text-danger" aria-hidden="true">*</span></label>
                        <div class="row g-1"><div class="col-3"><input asp-for="FirstNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#FirstNameAr" placeholder="First" required aria-required="true" aria-label="@T("First name (English)", "الاسم الأول (إنجليزي)")" /><span asp-validation-for="FirstNameEn" class="text-danger small"></span></div><div class="col-3"><input asp-for="FatherNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#FatherNameAr" placeholder="Father" required aria-required="true" aria-label="@T("Father name (English)", "اسم الأب (إنجليزي)")" /><span asp-validation-for="FatherNameEn" class="text-danger small"></span></div><div class="col-3"><input asp-for="GrandfatherNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#GrandfatherNameAr" placeholder="Grandfather" required aria-required="true" aria-label="@T("Grandfather name (English)", "اسم الجد (إنجليزي)")" /><span asp-validation-for="GrandfatherNameEn" class="text-danger small"></span></div><div class="col-3"><input asp-for="FamilyNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#FamilyNameAr" placeholder="Family" required aria-required="true" aria-label="@T("Family name (English)", "اسم العائلة (إنجليزي)")" /><span asp-validation-for="FamilyNameEn" class="text-danger small"></span></div></div></div>
                </div>
                <div class="row g-3">
                    <div class="col-md-3"><label class="form-label small" asp-for="Gender">@T("Gender", "الجنس")</label><select asp-for="Gender" class="form-select form-select-sm"><option value="Male">@T("Male", "ذكر")</option><option value="Female">@T("Female", "أنثى")</option></select></div>
                    <div class="col-md-3"><label class="form-label small" asp-for="DateOfBirth">@T("Date of birth", "تاريخ الميلاد") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="DateOfBirth" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control form-control-sm" required aria-required="true" /><span asp-validation-for="DateOfBirth" class="text-danger small"></span></div>
                    <div class="col-md-6"><label class="form-label small" asp-for="NationalityLookupId">@T("Nationality", "الجنسية") <span class="text-danger" aria-hidden="true">*</span></label><select asp-for="NationalityLookupId" class="form-select form-select-sm" required aria-required="true"><option value="">—</option>@foreach (var n in Model.Nationalities) { <option value="@n.Id">@(isRtl ? n.Ar : n.En)</option> }</select><span asp-validation-for="NationalityLookupId" class="text-danger small"></span></div>
                </div>
            </div>
            <div class="sms-card p-4">
                <h2 class="h6 mb-3">@T("Family (BR-GLB-004)", "الأسرة (BR-GLB-004)")</h2>
                <div class="row g-3">
                    <div class="col-md-6"><partial name="_ParentPicker" model="@(new ParentPickerViewModel { Id = "apply-parent", Name = "ParentId", Label = T("Existing parent", "ولي أمر موجود"), SelectedId = Model.ParentId, Parents = Model.Parents, EmptyLabel = T("— none / create below —", "— لا شيء / أنشئ أدناه —") })" /></div>
                    <div class="col-md-6"><label class="form-label small" asp-for="NewParentMobile">@T("…or new parent — mobile (dedup key)", "…أو ولي أمر جديد — الجوال (مفتاح التكرار)")</label><input asp-for="NewParentMobile" class="form-control form-control-sm" dir="ltr" placeholder="05xxxxxxxx" /></div>
                    <div class="col-md-4"><input asp-for="NewParentNameAr" class="form-control form-control-sm" dir="rtl" placeholder="اسم ولي الأمر (عربي)" aria-label="@T("New parent name (Arabic)", "اسم ولي الأمر الجديد (عربي)")" /></div>
                    <div class="col-md-4"><input asp-for="NewParentNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#NewParentNameAr" placeholder="Parent name (English)" aria-label="@T("New parent name (English)", "اسم ولي الأمر الجديد (إنجليزي)")" /></div>
                    <div class="col-md-4"><input asp-for="NewParentEmail" class="form-control form-control-sm" dir="ltr" placeholder="email (optional)" aria-label="@T("New parent email (optional)", "بريد ولي الأمر الجديد (اختياري)")" /></div>
                </div>
                <div class="form-text">@T("If the mobile already belongs to a parent, the application links to that parent instead of creating a duplicate.", "إذا كان الجوال لولي أمر موجود يُربط الطلب به بدلاً من إنشاء نسخة مكررة.")</div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="sms-card p-4">
                <div class="form-check mb-3"><input asp-for="SubmitImmediately" class="form-check-input" /><label asp-for="SubmitImmediately" class="form-check-label">@T("Submit immediately (else keep as Draft)", "تقديم فوري (وإلا يبقى مسودة)")</label></div>
                <button class="btn btn-primary w-100" type="submit"><i class="bi bi-send me-1" aria-hidden="true"></i>@T("Capture application", "تسجيل الطلب")</button>
                <a class="btn btn-outline-secondary w-100 mt-2" asp-action="Board" asp-route-campaign="@Model.CampaignId">@T("Cancel", "إلغاء")</a>
                <div class="form-text mt-3">@T("Documents checklist and application-fee payment (Modules 10 §BR-ATT-006 / 19) are gated at approval, not capture — those screens follow.", "قائمة المستندات ورسم الطلب (الوحدتان 10/19) تُفحص عند الاعتماد لا الإدخال — شاشاتها لاحقاً.")</div>
            </div>
        </div>
    </div>
</form>
