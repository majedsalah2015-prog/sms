@using System.Globalization
@using Sms.Domain.Attendance
@model AttendanceGateViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Gate console", "شاشة البوابة");
    ViewData["Breadcrumb"] = T("Attendance / Gate", "الحضور / البوابة");
    ViewData["AttendanceYear"] = Model.Year?.Id;
    ViewData["AttendanceDate"] = Model.Date.ToString("yyyy-MM-dd");
    var yid = Model.Year?.Id;
    var d = Model.Date.ToString("yyyy-MM-dd");
    var help = new HelpPanelViewModel
    {
        Id = "gate-help", Title = T("Gate console — help", "شاشة البوابة — مساعدة"),
        Intro = T("Reception's desk: log a late arrival, release a student early to a verified adult, and run the leave-pass lifecycle. Every entry here is a gate log; marking the day's attendance from it is an explicit, opt-in tick, never a silent side effect.", "مكتب الاستقبال: سجّل وصولاً متأخراً، أو سلّم طالباً مبكراً لشخص موثّق، وأدر دورة الاستئذان. كل إدخال هنا سجل بوابة؛ وتسجيل حالة اليوم منه اختيار صريح لا أثر خفي."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Early release", "الخروج المبكر"), T("The list of authorized adults is the real one — guardians and emergency contacts flagged pickup-authorized (BR-PAR-008). Releasing to anyone else is an override that demands a reason and is audited as one (BR-ATD-004).", "قائمة المصرّح لهم حقيقية — أولياء الأمور وجهات الطوارئ المعلّمون بصلاحية الاستلام (BR-PAR-008). التسليم لغيرهم تجاوز يتطلب سبباً ويُسجَّل كذلك (BR-ATD-004).")),
            new HelpPanelViewModel.Item(T("Leave pass vs early leave", "الاستئذان مقابل الخروج المبكر"), T("A leave pass is in-day short leave and always expects a return; an early leave does not (BR-ATD-006). Approval is a supervisor step before release.", "الاستئذان خروج قصير أثناء اليوم ويُتوقَّع معه العودة؛ أما الخروج المبكر فلا (BR-ATD-006). والاعتماد خطوة مشرف قبل الخروج.")),
            new HelpPanelViewModel.Item(T("Times", "الأوقات"), T("Leave the time blank to stamp now. Times are stored in UTC, like every timestamp in the system.", "اترك الوقت فارغاً للتسجيل الآن. تُخزَّن الأوقات بتوقيت UTC كبقية الطوابع الزمنية.")),
        },
    };
}

<div class="sms-page-head">
    <div>
        <h1 class="sms-page-title">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">@T("Late arrivals, verified early releases, and leave passes.", "الوصول المتأخر، والخروج المبكر الموثّق، والاستئذانات.")</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" class="d-flex gap-2">
            <select name="year" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="@T("Academic year", "العام الدراسي")">
                @foreach (var y in Model.Years) { <option value="@y.Id" selected="@(y.Id == yid)">@(isRtl ? y.LabelAr : y.LabelEn)</option> }
            </select>
            <input type="date" name="date" value="@d" class="form-control form-control-sm" onchange="this.form.submit()" style="max-width:10rem" aria-label="@T("Date", "التاريخ")" />
        </form>
        <partial name="_HelpModal" model="help" />
    </div>
</div>
<partial name="_AttendanceNav" />

@if (Model.Year == null)
{
    <div class="alert alert-info">@T("Define an academic year first.", "عرّف عاماً دراسياً أولاً.")</div>
}
else
{
    <div class="row g-3">
        <div class="col-xl-5">
            <div class="sms-card mb-3">
                <div class="p-3">
                    <h2 class="h6 mb-2"><i class="bi bi-search me-1" aria-hidden="true"></i>@T("Find the student", "ابحث عن الطالب")</h2>
                    <form method="get" class="d-flex gap-2">
                        <input type="hidden" name="year" value="@yid" />
                        <input type="hidden" name="date" value="@d" />
                        <input type="search" name="q" value="@Model.Query" class="form-control form-control-sm" autofocus
                               aria-label="@T("Student number or name", "رقم الطالب أو الاسم")" placeholder="@T("Student number or name", "رقم الطالب أو الاسم")" />
                        <button class="btn btn-sm btn-primary" type="submit" aria-label="@T("Search", "بحث")"><i class="bi bi-search" aria-hidden="true"></i></button>
                    </form>
                    @if (Model.Hits.Count > 0 && Model.Selected == null)
                    {
                        <div class="list-group list-group-flush mt-2">
                            @foreach (var h in Model.Hits)
                            {
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                   asp-action="Gate" asp-route-year="@yid" asp-route-date="@d" asp-route-enrollment="@h.EnrollmentId" asp-route-q="@Model.Query">
                                    <span><code class="small">@h.Student.StudentNo</code> @AttendanceLabels.StudentName(h.Student, isRtl)</span>
                                    <span class="small text-muted">@(h.Section == null ? "" : (isRtl ? h.Section.NameAr : h.Section.NameEn))</span>
                                </a>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.Query) && Model.Hits.Count == 0)
                    {
                        <div class="alert alert-warning mt-2 mb-0 py-2 small">@T("No active enrolment matches.", "لا تسجيل نشط مطابق.")</div>
                    }
                </div>
            </div>

            @if (Model.Selected != null)
            {
                var sel = Model.Selected;
                <div class="sms-card mb-3">
                    <div class="p-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="h6 mb-1">@AttendanceLabels.StudentName(sel.Student, isRtl)</div>
                                <div class="small text-muted"><code>@sel.Student.StudentNo</code> · @sel.Grade?.Code @(sel.Section == null ? "" : (isRtl ? sel.Section.NameAr : sel.Section.NameEn))</div>
                            </div>
                            <div class="text-end">
                                @if (sel.Today == null)
                                {
                                    <span class="badge text-bg-light border">@T("not captured today", "غير مرصود اليوم")</span>
                                }
                                else
                                {
                                    <span class="badge @AttendanceLabels.StatusBadge(sel.Today.Status)">@AttendanceLabels.Status(sel.Today.Status, isRtl)</span>
                                    @if (sel.Today.IsLocked) { <i class="bi bi-lock text-muted ms-1" title="@T("Day closed", "اليوم مقفل")" aria-hidden="true"></i><span class="visually-hidden">@T("Day closed", "اليوم مقفل")</span> }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="p-3 border-bottom">
                        <h3 class="h6 mb-2"><i class="bi bi-clock me-1" aria-hidden="true"></i>@T("Late arrival", "وصول متأخر")</h3>
                        <form method="post" asp-action="RecordLate" asp-route-year="@yid" class="row g-2 align-items-end">
                            <input type="hidden" name="enrollmentId" value="@sel.EnrollmentId" />
                            <input type="hidden" name="date" value="@d" />
                            <div class="col-5"><label class="form-label small mb-1" for="late-time">@T("Arrival time", "وقت الوصول")</label><input type="time" name="time" id="late-time" class="form-control form-control-sm" /></div>
                            <div class="col-7">
                                <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="markDay" value="true" id="lateMark" checked /><label class="form-check-label small" for="lateMark">@T("Also mark the day Late", "وسجّل اليوم متأخراً")</label></div>
                                <button class="btn btn-sm btn-warning w-100" type="submit"><i class="bi bi-clock-history me-1" aria-hidden="true"></i>@T("Log late arrival", "تسجيل الوصول المتأخر")</button>
                            </div>
                        </form>
                    </div>

                    <div class="p-3 border-bottom">
                        <h3 class="h6 mb-2"><i class="bi bi-door-open me-1" aria-hidden="true"></i>@T("Early release", "خروج مبكر")</h3>
                        @if (Model.PickupList.Count == 0)
                        {
                            <div class="alert alert-warning py-2 small"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>@T("Nobody is flagged pickup-authorized for this student — any release will be an override.", "لا أحد مصرّح له باستلام هذا الطالب — أي تسليم سيكون تجاوزاً.")</div>
                        }
                        <form method="post" asp-action="RecordRelease" asp-route-year="@yid" class="row g-2">
                            <input type="hidden" name="enrollmentId" value="@sel.EnrollmentId" />
                            <input type="hidden" name="date" value="@d" />
                            <div class="col-12">
                                <label class="form-label small mb-1" for="pickupPick">@T("Collected by", "المستلم")</label>
                                <select class="form-select form-select-sm mb-2" id="pickupPick">
                                    <option value="">@T("— someone else (override) —", "— شخص آخر (تجاوز) —")</option>
                                    @foreach (var p in Model.PickupList)
                                    {
                                        <option value="@(isRtl ? p.NameAr : p.NameEn)">@(isRtl ? p.NameAr : p.NameEn) · @(p.Kind == "guardian" ? T("guardian", "ولي أمر") : T("emergency contact", "جهة طوارئ"))@(string.IsNullOrWhiteSpace(p.Phone) ? "" : " · " + p.Phone)</option>
                                    }
                                </select>
                                <input type="text" name="pickupPersonName" id="pickupName" class="form-control form-control-sm" aria-label="@T("Name of the person collecting", "اسم من يستلم الطالب")" placeholder="@T("Name of the person collecting", "اسم من يستلم الطالب")" required aria-required="true" />
                            </div>
                            <div class="col-5"><label class="form-label small mb-1" for="rel-time">@T("Time", "الوقت")</label><input type="time" name="time" id="rel-time" class="form-control form-control-sm" /></div>
                            <div class="col-7 d-flex align-items-end">
                                <div class="form-check"><input class="form-check-input" type="checkbox" name="markDay" value="true" id="relMark" checked /><label class="form-check-label small" for="relMark">@T("Also mark the day Early leave", "وسجّل اليوم خروجاً مبكراً")</label></div>
                            </div>
                            <div class="col-12">
                                <div class="form-check"><input class="form-check-input" type="checkbox" name="isOverride" value="true" id="ovr" /><label class="form-check-label small" for="ovr">@T("Not on the authorized list — override", "ليس في القائمة المصرّح بها — تجاوز")</label></div>
                                <input type="text" name="reason" id="ovrReason" class="form-control form-control-sm mt-1 d-none" aria-label="@T("Reason for the override", "سبب التجاوز")" placeholder="@T("Reason for the override (required)", "سبب التجاوز (مطلوب)")" />
                            </div>
                            <div class="col-12"><button class="btn btn-sm btn-danger w-100" type="submit"><i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>@T("Log release", "تسجيل الخروج")</button></div>
                        </form>
                    </div>

                    <div class="p-3">
                        <h3 class="h6 mb-2"><i class="bi bi-card-checklist me-1" aria-hidden="true"></i>@T("Request a leave pass", "طلب استئذان")</h3>
                        <form method="post" asp-action="RequestPass" asp-route-year="@yid" class="d-flex gap-2">
                            <input type="hidden" name="enrollmentId" value="@sel.EnrollmentId" />
                            <input type="hidden" name="date" value="@d" />
                            <input type="text" name="reason" class="form-control form-control-sm" aria-label="@T("Reason", "السبب")" placeholder="@T("Reason", "السبب")" required aria-required="true" />
                            <button class="btn btn-sm btn-outline-primary" type="submit">@T("Request", "طلب")</button>
                        </form>
                    </div>
                </div>

                <script>
                    (function () {
                        var pick = document.getElementById('pickupPick'), name = document.getElementById('pickupName');
                        var ovr = document.getElementById('ovr'), reason = document.getElementById('ovrReason');
                        function syncOverride() { reason.classList.toggle('d-none', !ovr.checked); reason.required = ovr.checked; }
                        pick.addEventListener('change', function () {
                            name.value = pick.value;
                            ovr.checked = !pick.value;
                            syncOverride();
                        });
                        ovr.addEventListener('change', syncOverride);
                        syncOverride();
                    })();
                </script>
            }
        </div>

        <div class="col-xl-7">
            <div class="sms-card mb-3">
                <div class="p-2 border-bottom d-flex align-items-center"><h2 class="h6 mb-0 me-auto"><i class="bi bi-card-checklist me-1" aria-hidden="true"></i>@T("Leave passes today", "استئذانات اليوم")</h2><span class="badge text-bg-light border">@Model.Passes.Count</span></div>
                <div class="table-responsive">
                    <table class="table sms-table table-sm mb-0">
                        <caption class="visually-hidden">@T("Leave passes today", "استئذانات اليوم")</caption>
                        <thead><tr><th scope="col">@T("Student", "الطالب")</th><th scope="col">@T("Reason", "السبب")</th><th scope="col">@T("Status", "الحالة")</th><th scope="col" class="text-end">@T("Next step", "الخطوة التالية")</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Passes)
                            {
                                <tr>
                                    <td>@(p.Student == null ? "—" : AttendanceLabels.StudentName(p.Student, isRtl))<div class="small text-muted">@(p.Section == null ? "" : (isRtl ? p.Section.NameAr : p.Section.NameEn))</div></td>
                                    <td class="small">@p.Pass.Reason</td>
                                    <td><span class="badge @AttendanceLabels.LeavePassBadge(p.Pass.Status)">@AttendanceLabels.LeavePass(p.Pass.Status, isRtl)</span></td>
                                    <td class="text-end">
                                        @{
                                            var next = p.Pass.Status switch
                                            {
                                                LeavePassStatus.Requested => (LeavePassStatus?)LeavePassStatus.Approved,
                                                LeavePassStatus.Approved => LeavePassStatus.Released,
                                                LeavePassStatus.Released => LeavePassStatus.Returned,
                                                _ => null,
                                            };
                                        }
                                        @if (next != null)
                                        {
                                            <form method="post" asp-action="ChangePass" asp-route-id="@p.Pass.Id" asp-route-year="@yid" class="d-inline">
                                                <input type="hidden" name="date" value="@d" />
                                                <input type="hidden" name="target" value="@next" />
                                                <button class="btn btn-sm btn-outline-primary" type="submit">@AttendanceLabels.LeavePass(next.Value, isRtl)</button>
                                            </form>
                                        }
                                        @if (p.Pass.Status == LeavePassStatus.Requested || p.Pass.Status == LeavePassStatus.Approved)
                                        {
                                            <form method="post" asp-action="ChangePass" asp-route-id="@p.Pass.Id" asp-route-year="@yid" class="d-inline ms-1">
                                                <input type="hidden" name="date" value="@d" />
                                                <input type="hidden" name="target" value="@LeavePassStatus.Rejected" />
                                                <button class="btn btn-sm btn-outline-danger" type="submit">@T("Reject", "رفض")</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (Model.Passes.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">@T("No leave pass requested today.", "لا استئذان مطلوب اليوم.")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="sms-card">
                <div class="p-2 border-bottom d-flex align-items-center"><h2 class="h6 mb-0 me-auto"><i class="bi bi-journal-text me-1" aria-hidden="true"></i>@T("Gate log", "سجل البوابة")</h2><span class="badge text-bg-light border">@Model.TodaysEvents.Count</span></div>
                <div class="table-responsive" style="max-height:24rem;overflow-y:auto">
                    <table class="table sms-table table-sm mb-0">
                        <caption class="visually-hidden">@T("Gate log for the day", "سجل البوابة لليوم")</caption>
                        <thead><tr><th scope="col">@T("Time", "الوقت")</th><th scope="col">@T("Student", "الطالب")</th><th scope="col">@T("Event", "الحدث")</th><th scope="col">@T("Collected by", "المستلم")</th></tr></thead>
                        <tbody>
                            @foreach (var e in Model.TodaysEvents)
                            {
                                <tr>
                                    <td class="small text-muted">@e.Event.EventTimeUtc.ToString("HH:mm")</td>
                                    <td>@(e.Student == null ? "—" : AttendanceLabels.StudentName(e.Student, isRtl))<div class="small text-muted">@(e.Section == null ? "" : (isRtl ? e.Section.NameAr : e.Section.NameEn))</div></td>
                                    <td><span class="badge @(e.Event.EventType == GateEventType.Late ? "text-bg-warning" : "text-bg-secondary")">@AttendanceLabels.GateEvent(e.Event.EventType, isRtl)</span></td>
                                    <td class="small">
                                        @(string.IsNullOrWhiteSpace(e.Event.PickupPersonName) ? "—" : e.Event.PickupPersonName)
                                        @if (e.Event.IsAuthorizedPickupOverride) { <span class="badge text-bg-danger ms-1"><i class="bi bi-shield-exclamation" aria-hidden="true"></i> @T("override", "تجاوز")</span> }
                                    </td>
                                </tr>
                            }
                            @if (Model.TodaysEvents.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">@T("Nothing logged at the gate today.", "لا شيء مُسجَّل في البوابة اليوم.")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
