@using System.Globalization
@using Sms.Web.Navigation
@model Sms.Web.Navigation.WorkspaceBuilder.VisibleWorkspace
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var title = isRtl ? Model.Info.TitleAr : Model.Info.TitleEn;
    ViewData["Title"] = title;
    ViewData["Breadcrumb"] = title;
    string T(string en, string ar) => isRtl ? ar : en;
    var help = new HelpPanelViewModel
    {
        Id = "department-help",
        Title = T("Department — help", "القسم — مساعدة"),
        Intro = T("One department's screens, gathered by the job they do rather than by the module they belong to. Finance, students, the secretariat and the rest each pull from several modules, because that is how the work actually divides in a school.", "شاشات قسم واحد، مجموعةً بالعمل الذي تؤديه لا بالوحدة التي تنتمي إليها. فالمالية والطلاب والسكرتارية وغيرها يسحب كل منها من عدة وحدات، لأن هكذا ينقسم العمل في المدرسة فعلاً."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("The list is yours, not the department's", "القائمة قائمتك لا قائمة القسم"), T("Tiles you have no permission for are not drawn (BR-SEC-010), so two people in the same department can see different lists here. A missing tile is a role question, not a missing feature.", "البطاقات التي لا تملك صلاحيتها لا تُرسم (BR-SEC-010)، فقد يرى شخصان في القسم نفسه قائمتين مختلفتين هنا. والبطاقة الغائبة سؤال أدوار لا ميزة ناقصة.")),
            new HelpPanelViewModel.Item(T("A screen can sit in more than one department", "الشاشة قد تقع في أكثر من قسم"), T("Departments are an index over the same screens, not folders that own them. Finding the fee ledger under finance and again beside the student file is deliberate — both people need it and neither should have to know which module it came from.", "الأقسام فهرس على الشاشات نفسها لا مجلدات تملكها. ووجود دفتر الرسوم تحت المالية ومرة أخرى بجانب ملف الطالب مقصود — فكلاهما يحتاجه ولا ينبغي لأحدهما أن يعرف من أي وحدة جاء.")),
            new HelpPanelViewModel.Item(T("Where the module numbers live", "أين أرقام الوحدات"), T("The home page's module list is the other index — the product as the specification describes it, numbered 01 to 36. Use it when you are chasing a documented rule; use departments when you are doing a job.", "قائمة الوحدات في الصفحة الرئيسية هي الفهرس الآخر — المنتج كما تصفه المواصفة، مرقّماً من 01 إلى 36. استخدمها حين تتعقّب قاعدة موثّقة، واستخدم الأقسام حين تؤدي عملاً.")),
        },
    };
}

<div class="sms-page-head">
    <div>
        <h1 class="sms-page-title">
            <i class="bi @Model.Info.Icon me-2 text-muted" aria-hidden="true"></i>@title
        </h1>
        <p class="text-muted mb-0">@(isRtl ? Model.Info.BlurbAr : Model.Info.BlurbEn)</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-grid" aria-hidden="true"></i> @T("All departments", "كل الأقسام")
        </a>
        <partial name="_HelpModal" model="help" />
    </div>
</div>

<div class="row g-3">
    @foreach (var link in Model.Links)
    {
        <div class="col-12 col-sm-6 col-lg-4 col-xxl-3">
            @* asp-area="" on every link: without it Url.Action inherits the current request's area,
               and this page is reachable while an embedded ERP screen is the referrer. *@
            <a class="sms-card sms-module-card" asp-area="" asp-controller="@link.Controller" asp-action="@link.Action">
                <span class="sms-module-card__icon"><i class="bi @link.Icon" aria-hidden="true"></i></span>
                <span class="sms-module-card__body">
                    <span class="sms-module-card__title">@(isRtl ? link.TitleAr : link.TitleEn)</span>
                </span>
                <i class="bi bi-chevron-right sms-module-card__chevron" aria-hidden="true"></i>
            </a>
        </div>
    }
</div>

@if (Model.ErpGroups.Count > 0)
{
    @* The embedded ERP, grouped as it groups itself. Listed here rather than folded into the cards
       above because these are a different subsystem's screens — they open in its design system, and
       pretending otherwise would make the seam invisible right up until the first one looks wrong. *@
    <h2 class="sms-section-title mt-4">@T("Accounting", "المحاسبة")</h2>
    @foreach (var group in Model.ErpGroups)
    {
        <h3 class="h6 text-muted mt-3 mb-2">
            <i class="bi @group.Icon me-1" aria-hidden="true"></i>@group.Title(isRtl)
        </h3>
        <div class="row g-2">
            @foreach (var item in group.Items)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xxl-3">
                    @{
                        var href = item.Url is { } explicitUrl
                            ? (explicitUrl.StartsWith("/") ? Url.Content("~" + explicitUrl) : explicitUrl)
                            : Url.Action(item.Action, item.Controller, NavLinks.RouteValuesFor(item)) ?? "#";
                    }
                    <a class="sms-card sms-module-card sms-module-card--compact" href="@href">
                        <span class="sms-module-card__icon"><i class="bi @item.Icon" aria-hidden="true"></i></span>
                        <span class="sms-module-card__body">
                            <span class="sms-module-card__title">@item.Title(isRtl)</span>
                        </span>
                        <i class="bi bi-chevron-right sms-module-card__chevron" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
    }
}
