@using System.Globalization
@model EmployeeFormViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Register employee", "تسجيل موظف");
    ViewData["Breadcrumb"] = T("Employees / Register", "الموظفون / تسجيل");
    var help = new HelpPanelViewModel
    {
        Id = "employee-register-help",
        Title = T("Register employee — help", "تسجيل موظف — مساعدة"),
        Intro = T("Creates the person, once and for their whole history with the school (doc/Modules/11 §8, BR-EMP-001). Positions, contracts and teaching assignments are all attached afterwards and can come and go; this record does not.", "ينشئ الشخص مرة واحدة ولكامل تاريخه مع المدرسة (الوثيقة 11 §8، BR-EMP-001). أما المناصب والعقود وإسنادات التدريس فتُلحق بعد ذلك وتأتي وتذهب؛ وهذا السجل لا."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("A rehire is not a new employee", "إعادة التعيين ليست موظفاً جديداً"), T("Someone returning after leaving keeps their original record and EMP number (BR-EMP-001) — search the directory first, including inactive staff. Creating a second record splits their service history and their qualifications across two files that will never be reconciled.", "العائد بعد ترك العمل يحتفظ بسجله ورقمه الأصلي (BR-EMP-001) — فابحث في الدليل أولاً، وشمل غير النشطين. وإنشاء سجل ثانٍ يشطر تاريخ خدمته ومؤهلاته بين ملفين لن يُوفَّق بينهما أبداً.")),
            new HelpPanelViewModel.Item(T("Registering does not employ anyone", "التسجيل لا يوظّف أحداً"), T("This screen creates the person. Giving them a position, an org unit and a contract is a separate step on their file — which is exactly what lets you enter a new hire before their start date without them appearing as current staff.", "هذه الشاشة تنشئ الشخص. أما منحه منصباً ووحدة تنظيمية وعقداً فخطوة منفصلة في ملفه — وهذا بالضبط ما يتيح إدخال موظف جديد قبل تاريخ مباشرته دون أن يظهر ضمن الموظفين الحاليين.")),
            new HelpPanelViewModel.Item(T("Teachers are employees first", "المعلمون موظفون أولاً"), T("There is no separate teacher registration. Register the person here, then add the teaching profile on their file; that is what keeps one human being from having both an employee record and an unconnected teacher record.", "لا يوجد تسجيل منفصل للمعلمين. فسجّل الشخص هنا ثم أضف ملف التدريس في ملفه؛ وهذا ما يمنع أن يكون لإنسان واحد سجل موظف وسجل معلم غير مرتبط به.")),
            new HelpPanelViewModel.Item(T("Names and dates follow the same rules as everywhere", "الأسماء والتواريخ تتبع القواعد نفسها"), T("Four name parts in Arabic and English, both required (BR-GLB-001) because both appear on contracts and official letters. Dates are Gregorian in both interface languages.", "أربعة أجزاء للاسم بالعربية والإنجليزية، وكلاهما مطلوب (BR-GLB-001) لأنهما يظهران في العقود والخطابات الرسمية. والتواريخ ميلادية في لغتي الواجهة.")),
        },
    };
}
<div class="sms-page-head"><div><h1 class="sms-page-title">@ViewData["Title"]</h1><p class="text-muted mb-0">@T("One permanent record and EMP number per person — rehires reuse it (BR-EMP-001).", "سجل واحد دائم ورقم EMP لكل شخص — إعادة التعيين تعيد استخدامه (BR-EMP-001).")</p></div>
    <partial name="_HelpModal" model="help" /></div>
<partial name="_StaffNav" />
<form method="post" asp-action="Register" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
    <p class="form-text">@T("Fields marked * are required.", "الحقول المعلّمة بـ * إلزامية.")</p>
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="sms-card p-4 mb-3">
                <h2 class="h6 mb-3">@T("Identity", "الهوية")</h2>
                <div class="sms-bilingual mb-3">
                    <div><label class="form-label small" asp-for="FirstNameAr">@T("Name (Arabic): first / father / grandfather / family", "الاسم بالعربية: الأول / الأب / الجد / العائلة") <span class="text-danger" aria-hidden="true">*</span></label><div class="row g-1"><div class="col-3"><input asp-for="FirstNameAr" class="form-control form-control-sm" dir="rtl" required aria-required="true" aria-label="@T("First name (Arabic)", "الاسم الأول (عربي)")" /><span asp-validation-for="FirstNameAr" class="text-danger small"></span></div><div class="col-3"><input asp-for="FatherNameAr" class="form-control form-control-sm" dir="rtl" required aria-required="true" aria-label="@T("Father name (Arabic)", "اسم الأب (عربي)")" /><span asp-validation-for="FatherNameAr" class="text-danger small"></span></div><div class="col-3"><input asp-for="GrandfatherNameAr" class="form-control form-control-sm" dir="rtl" required aria-required="true" aria-label="@T("Grandfather name (Arabic)", "اسم الجد (عربي)")" /><span asp-validation-for="GrandfatherNameAr" class="text-danger small"></span></div><div class="col-3"><input asp-for="FamilyNameAr" class="form-control form-control-sm" dir="rtl" required aria-required="true" aria-label="@T("Family name (Arabic)", "اسم العائلة (عربي)")" /><span asp-validation-for="FamilyNameAr" class="text-danger small"></span></div></div></div>
                    <div><label class="form-label small" asp-for="FirstNameEn">@T("Name (English)", "الاسم بالإنجليزية") <span class="text-danger" aria-hidden="true">*</span></label><div class="row g-1"><div class="col-3"><input asp-for="FirstNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#FirstNameAr" required aria-required="true" aria-label="@T("First name (English)", "الاسم الأول (إنجليزي)")" /><span asp-validation-for="FirstNameEn" class="text-danger small"></span></div><div class="col-3"><input asp-for="FatherNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#FatherNameAr" required aria-required="true" aria-label="@T("Father name (English)", "اسم الأب (إنجليزي)")" /><span asp-validation-for="FatherNameEn" class="text-danger small"></span></div><div class="col-3"><input asp-for="GrandfatherNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#GrandfatherNameAr" required aria-required="true" aria-label="@T("Grandfather name (English)", "اسم الجد (إنجليزي)")" /><span asp-validation-for="GrandfatherNameEn" class="text-danger small"></span></div><div class="col-3"><input asp-for="FamilyNameEn" class="form-control form-control-sm" dir="ltr" data-translit-from="#FamilyNameAr" required aria-required="true" aria-label="@T("Family name (English)", "اسم العائلة (إنجليزي)")" /><span asp-validation-for="FamilyNameEn" class="text-danger small"></span></div></div></div>
                </div>
                <div class="row g-3">
                    <div class="col-md-2"><label class="form-label small" asp-for="Gender">@T("Gender", "الجنس")</label><select asp-for="Gender" class="form-select form-select-sm"><option value="Male">@T("Male", "ذكر")</option><option value="Female">@T("Female", "أنثى")</option></select></div>
                    <div class="col-md-3"><label class="form-label small" asp-for="DateOfBirth">@T("Date of birth", "تاريخ الميلاد") <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="DateOfBirth" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control form-control-sm" required aria-required="true" /><span asp-validation-for="DateOfBirth" class="text-danger small"></span></div>
                    <div class="col-md-3"><label class="form-label small" asp-for="NationalityLookupId">@T("Nationality", "الجنسية") <span class="text-danger" aria-hidden="true">*</span></label><div class="input-group input-group-sm"><select asp-for="NationalityLookupId" class="form-select form-select-sm" required aria-required="true"><option value="">—</option>@foreach (var n in Model.Nationalities) { <option value="@n.Id">@(isRtl ? n.Ar : n.En)</option> }</select><button type="button" class="btn btn-outline-secondary" data-quickadd-category="Nationality" data-quickadd-target="#NationalityLookupId" data-quickadd-title="@T("Add nationality", "إضافة جنسية")" title="@T("Add nationality", "إضافة جنسية")" aria-label="@T("Add nationality", "إضافة جنسية")"><i class="bi bi-plus-lg" aria-hidden="true"></i></button></div><span asp-validation-for="NationalityLookupId" class="text-danger small"></span></div>
                    <div class="col-md-2"><label class="form-label small" asp-for="PrimaryIdTypeLookupId">@T("ID type", "نوع الهوية")</label><select asp-for="PrimaryIdTypeLookupId" class="form-select form-select-sm"><option value="">—</option>@foreach (var t in Model.IdTypes) { <option value="@t.Id">@(isRtl ? t.Ar : t.En)</option> }</select></div>
                    <div class="col-md-2"><label class="form-label small" asp-for="PrimaryIdNo">@T("ID number", "رقم الهوية")</label><input asp-for="PrimaryIdNo" class="form-control form-control-sm" dir="ltr" /></div>
                    <div class="col-md-2"><label class="form-label small" asp-for="PrimaryIdExpiry">@T("ID expiry", "انتهاء الهوية")</label><input asp-for="PrimaryIdExpiry" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control form-control-sm" /></div>
                </div>
            </div>
            <div class="sms-card p-4">
                <h2 class="h6 mb-3">@T("First position (optional now — BR-EMP-002)", "المنصب الأول (اختياري الآن — BR-EMP-002)")</h2>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label small" asp-for="OrgUnitId">@T("Org unit", "الوحدة التنظيمية")</label><select asp-for="OrgUnitId" class="form-select form-select-sm"><option value="">—</option>@foreach (var u in Model.OrgUnits) { <option value="@u.Id">@(isRtl ? u.NameAr : u.NameEn)</option> }</select></div>
                    <div class="col-md-4"><label class="form-label small" asp-for="PositionLookupId">@T("Job title", "المسمى الوظيفي")</label><div class="input-group input-group-sm"><select asp-for="PositionLookupId" class="form-select form-select-sm"><option value="">—</option>@foreach (var p in Model.Positions) { <option value="@p.Id">@(isRtl ? p.Ar : p.En)</option> }</select><button type="button" class="btn btn-outline-secondary" data-quickadd-category="JobTitle" data-quickadd-target="#PositionLookupId" data-quickadd-title="@T("Add job title", "إضافة مسمى وظيفي")" title="@T("Add job title", "إضافة مسمى وظيفي")" aria-label="@T("Add job title", "إضافة مسمى وظيفي")"><i class="bi bi-plus-lg" aria-hidden="true"></i></button></div></div>
                    <div class="col-md-4"><label class="form-label small" asp-for="ManagerEmployeeId">@T("Reports to", "يرفع إلى")</label><select asp-for="ManagerEmployeeId" class="form-select form-select-sm"><option value="">—</option>@foreach (var m in Model.Managers) { <option value="@m.Id">@m.EmployeeNo · @(isRtl ? $"{m.FirstNameAr} {m.FamilyNameAr}" : $"{m.FirstNameEn} {m.FamilyNameEn}")</option> }</select></div>
                </div>
                <div class="form-text mt-2">@T("No org units yet? Build the tree under Org chart first.", "لا وحدات بعد؟ أنشئ الهيكل من «الهيكل التنظيمي» أولاً.")</div>
            </div>
        </div>
        <div class="col-xl-4">
            @* The photograph is taken while the new employee is still at the HR desk, so it belongs
               on this form rather than only on the file screen afterwards — whoever has to come back
               for it usually does not. It posts with the rest of the form and is attached the moment
               the record exists (doc/Modules/12 §8.1–8.2). *@
            <div class="sms-card p-4 mb-3">
                <h2 class="h6 mb-3">@T("Photograph", "الصورة الشخصية")</h2>
                <div class="sms-photo-panel text-center" data-photo-preview>
                    <div class="sms-photo-frame mx-auto mb-2">
                        <img data-photo-preview-image alt="@T("Chosen photo", "الصورة المختارة")" hidden />
                        <span class="sms-photo-empty" data-photo-preview-placeholder aria-hidden="true"><i class="bi bi-person"></i></span>
                    </div>
                    <label class="visually-hidden" asp-for="Photo">@T("Photo file", "ملف الصورة")</label>
                    <input asp-for="Photo" type="file" accept="image/jpeg,image/png" class="form-control form-control-sm" data-photo-preview-input />
                    <div class="form-text">@T("JPEG or PNG, up to 2 MB. Optional — it can also be added from the employee file later.", "JPEG أو PNG، حتى 2 ميغابايت. اختيارية — ويمكن إضافتها لاحقاً من ملف الموظف.")</div>
                    @* A browser never re-sends a file after a failed post, so the box above comes
                       back empty even though a photograph was chosen. Saying so beats letting the
                       registrar submit twice and wonder where it went. *@
                    @if (!ViewData.ModelState.IsValid) { <div class="form-text fw-semibold">@T("Choose the photo again — a browser does not resend it after an error.", "اختر الصورة مرة أخرى — فالمتصفح لا يعيد إرسالها بعد الخطأ.")</div> }
                </div>
            </div>
            <div class="sms-card p-4"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-person-check me-1" aria-hidden="true"></i>@T("Register", "تسجيل")</button><a class="btn btn-outline-secondary w-100 mt-2" asp-action="Index">@T("Cancel", "إلغاء")</a><div class="form-text mt-3">@T("Contracts, qualifications and teacher designation are added from the Employee file after registration.", "تُضاف العقود والمؤهلات وتعيين المعلم من ملف الموظف بعد التسجيل.")</div></div></div>
    </div>
</form>
<partial name="_QuickAddLookup" />
