@using System.Globalization
@using Sms.Domain.Employees
@using Sms.Domain.Teachers
@model EmployeeFileViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    var e = Model.Employee;
    var name = isRtl ? $"{e.FirstNameAr} {e.FatherNameAr} {e.GrandfatherNameAr} {e.FamilyNameAr}" : $"{e.FirstNameEn} {e.FatherNameEn} {e.GrandfatherNameEn} {e.FamilyNameEn}";
    ViewData["Title"] = e.EmployeeNo;
    ViewData["Breadcrumb"] = T("Employees / ", "الموظفون / ") + e.EmployeeNo;
    var today = DateTime.UtcNow.ToString("yyyy-MM-dd");
    string Show(string k) => Model.ActiveTab == k ? "show active" : "";
    var current = Model.Assignments.FirstOrDefault(a => a.Assignment.EffectiveToUtc == null);
    var tabs = new (string Key, string En, string Ar, string? Count)[]
    {
        ("personal", "Personal", "الشخصية", null), ("position", "Position & org", "المنصب والهيكل", Model.Assignments.Count.ToString()), ("contracts", "Contracts 🔒", "العقود 🔒", Model.Contracts.Count.ToString()),
        ("qualifications", "Qualifications", "المؤهلات", Model.Qualifications.Count.ToString()), ("teaching", "Teaching", "التدريس", Model.TeacherProfile == null ? null : Model.Teaching.Count(t => t.Assignment.EffectiveToUtc == null).ToString()),
        ("documents", "Documents", "المستندات", Model.Documents.Rows.Count.ToString()),
        ("status", "Status", "الحالة", null), ("audit", "Audit", "التدقيق", Model.Audit.Count.ToString()), ("more", "More…", "المزيد…", null),
    };
    var help = new HelpPanelViewModel
    {
        Id = "employee-file-help",
        Title = T("Employee file — help", "ملف الموظف — مساعدة"),
        Intro = T("One person's whole history with the school (doc/Modules/11 §8). Most of what is here is effective-dated rather than current-only: the file answers what someone's position was in 2024 as readily as what it is today.", "تاريخ شخص واحد كاملاً مع المدرسة (الوثيقة 11 §8). ومعظم ما هنا مؤرَّخ السريان لا حاليّاً فقط: فالملف يجيب عن منصب شخص عام 2024 كما يجيب عن منصبه اليوم."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Positions are dated, not replaced", "المناصب مؤرَّخة لا مستبدَلة"), T("A promotion adds an assignment and closes the previous one; it does not overwrite it (BR-EMP-002). The row with no end date is the current one. That is what lets a certificate reissued for last year name the position that was actually held then.", "الترقية تضيف إسناداً وتغلق السابق؛ ولا تكتب فوقه (BR-EMP-002). والصف بلا تاريخ انتهاء هو الحالي. وهذا ما يتيح لشهادة يُعاد إصدارها عن العام الماضي أن تسمّي المنصب الذي كان مشغولاً فعلاً حينها.")),
            new HelpPanelViewModel.Item(T("The contracts tab is restricted", "لسان العقود مقيَّد"), T("Salary and contract terms are a restricted category with their own permission (BR-GLB-072). The padlock is not decoration — without the grant the tab's contents are not sent to the browser at all.", "الراتب وشروط العقد فئة مقيَّدة لها صلاحيتها (BR-GLB-072). والقفل ليس زينة — فبدون المنح لا تُرسل محتويات اللسان إلى المتصفح أصلاً.")),
            new HelpPanelViewModel.Item(T("Teaching is a profile on top of the employee", "التدريس ملف فوق الموظف"), T("The teaching tab appears once the person has a teacher profile. Subject qualifications there are what the timetable checks before it will let someone be assigned a class (BR-TCH-001, BR-SUB-006) — an unqualified assignment is refused there, not here.", "يظهر لسان التدريس متى صار للشخص ملف معلم. ومؤهلات المواد فيه هي ما يفحصه الجدول قبل أن يسمح بإسناد حصة لأحد (BR-TCH-001، BR-SUB-006) — فالإسناد غير المؤهَّل يُرفض هناك لا هنا.")),
            new HelpPanelViewModel.Item(T("Ending service does not remove the person", "إنهاء الخدمة لا يزيل الشخص"), T("Status moves them out of the active directory and leaves everything they did in place — a rehire picks their old record back up intact. Ending service is never a delete; the delete on the qualifications tab is a correction to that one row, not to the person.", "الحالة تُخرجه من الدليل النشط وتترك كل ما فعله في مكانه — فالعائد يستأنف سجله القديم سليماً. وإنهاء الخدمة ليس حذفاً أبداً؛ أما الحذف في لسان المؤهلات فتصحيح لذلك السطر وحده لا للشخص.")),
        },
    };
}

<div class="sms-page-head">
    <div><div class="text-muted small"><code>@e.EmployeeNo</code> · @Model.NationalityName · @(e.Gender == Sms.Domain.Common.Gender.Male ? T("Male", "ذكر") : T("Female", "أنثى")) · @e.DateOfBirth.ToString("yyyy-MM-dd")@(current == null ? "" : $" · {current.Position ?? "?"} · {(current.OrgUnit == null ? "?" : (isRtl ? current.OrgUnit.NameAr : current.OrgUnit.NameEn))}")</div>
        <h1 class="sms-page-title">@name <span class="badge fs-6 @StaffLabels.EmployeeBadge(e.Status)">@StaffLabels.EmployeeStatus(e.Status, isRtl)</span> @if (Model.TeacherProfile != null) { <span class="badge fs-6 text-bg-info">@T("teacher", "معلم")</span> }</h1></div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1 @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i>@T("Directory", "الدليل")</a>
        <partial name="_HelpModal" model="help" />
    </div>
</div>
<partial name="_StaffNav" />

<div class="sms-card">
    <ul class="nav nav-tabs px-3 pt-2 flex-nowrap overflow-auto">@foreach (var t in tabs) { <li class="nav-item"><button class="nav-link text-nowrap @(Model.ActiveTab == t.Key ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-@t.Key" type="button">@(isRtl ? t.Ar : t.En)@if (t.Count != null) { <span class="badge rounded-pill text-bg-light border ms-1">@t.Count</span> }</button></li> }</ul>
    <div class="tab-content p-4">
        <div class="tab-pane fade @Show("personal")" id="tab-personal">
            @* Uploaded on its own rather than inside the identity form, which needs a reason to save. *@
            <div class="row g-4">
            <div class="col-md-3 col-lg-2">
                <partial name="_PhotoPanel" model="@(new PhotoPanelViewModel {
                    Id = "employee-photo", PersonName = name,
                    HasPhoto = e.PhotoAttachmentId != null,
                    PhotoUrl = Url.Action("Photo", "Employees", new { id = e.Id }),
                    UploadUrl = Url.Action("UploadPhoto", "Employees", new { id = e.Id }),
                    RemoveUrl = Url.Action("RemovePhoto", "Employees", new { id = e.Id }),
                    CanEdit = true })" />
            </div>
            <div class="col-md-9 col-lg-10">
            <form method="post" asp-action="Edit" asp-route-id="@e.Id">
                @* The English quad name is filled from the Arabic one by the helper button of
                   docs/UI/01 §"Bilingual entry pattern" — assist only. Imported staff carry the
                   register's own Arabic text in both columns on purpose (see Import's help panel),
                   so this screen is where that gets turned into a name an English report can use. *@
                <div class="sms-bilingual mb-3" id="emp-name-block">
                    <div><label class="form-label small" for="emp-FirstNameAr">@T("Name (Arabic)", "الاسم (عربي)")</label><div class="row g-1"><div class="col-3"><input name="FirstNameAr" id="emp-FirstNameAr" class="form-control form-control-sm" dir="rtl" value="@e.FirstNameAr" aria-label="@T("First name (Arabic)", "الاسم الأول (عربي)")" /></div><div class="col-3"><input name="FatherNameAr" id="emp-FatherNameAr" class="form-control form-control-sm" dir="rtl" value="@e.FatherNameAr" aria-label="@T("Father name (Arabic)", "اسم الأب (عربي)")" /></div><div class="col-3"><input name="GrandfatherNameAr" id="emp-GrandfatherNameAr" class="form-control form-control-sm" dir="rtl" value="@e.GrandfatherNameAr" aria-label="@T("Grandfather name (Arabic)", "اسم الجد (عربي)")" /></div><div class="col-3"><input name="FamilyNameAr" id="emp-FamilyNameAr" class="form-control form-control-sm" dir="rtl" value="@e.FamilyNameAr" aria-label="@T("Family name (Arabic)", "اسم العائلة (عربي)")" /></div></div></div>
                    <div><div class="d-flex align-items-center justify-content-between gap-2"><label class="form-label small mb-1" for="emp-FirstNameEn">@T("Name (English)", "الاسم (إنجليزي)")</label><button type="button" class="btn btn-link btn-sm p-0 mb-1 text-decoration-none" data-translit-fill="#emp-name-block" title="@T("Transliterate the four Arabic names into the English boxes. Check the result before saving — it is a starting point, not an authority.", "نقحرة الأسماء العربية الأربعة إلى الخانات الإنجليزية. راجع الناتج قبل الحفظ — فهو نقطة بداية لا مرجع.")">@T("Fill from Arabic", "تعبئة من العربي")</button></div><div class="row g-1"><div class="col-3"><input name="FirstNameEn" id="emp-FirstNameEn" class="form-control form-control-sm" dir="ltr" value="@e.FirstNameEn" data-translit-from="#emp-FirstNameAr" aria-label="@T("First name (English)", "الاسم الأول (إنجليزي)")" /></div><div class="col-3"><input name="FatherNameEn" class="form-control form-control-sm" dir="ltr" value="@e.FatherNameEn" data-translit-from="#emp-FatherNameAr" aria-label="@T("Father name (English)", "اسم الأب (إنجليزي)")" /></div><div class="col-3"><input name="GrandfatherNameEn" class="form-control form-control-sm" dir="ltr" value="@e.GrandfatherNameEn" data-translit-from="#emp-GrandfatherNameAr" aria-label="@T("Grandfather name (English)", "اسم الجد (إنجليزي)")" /></div><div class="col-3"><input name="FamilyNameEn" class="form-control form-control-sm" dir="ltr" value="@e.FamilyNameEn" data-translit-from="#emp-FamilyNameAr" aria-label="@T("Family name (English)", "اسم العائلة (إنجليزي)")" /></div></div></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-2"><label class="form-label small" for="emp-Gender">@T("Gender", "الجنس")</label><select name="Gender" id="emp-Gender" class="form-select form-select-sm"><option value="Male" selected="@(e.Gender == Sms.Domain.Common.Gender.Male)">@T("Male", "ذكر")</option><option value="Female" selected="@(e.Gender == Sms.Domain.Common.Gender.Female)">@T("Female", "أنثى")</option></select></div>
                    <div class="col-md-2"><label class="form-label small" for="emp-DateOfBirth">@T("Date of birth", "الميلاد")</label><input name="DateOfBirth" id="emp-DateOfBirth" type="date" class="form-control form-control-sm" value="@e.DateOfBirth.ToString("yyyy-MM-dd")" /></div>
                    <div class="col-md-3"><label class="form-label small" for="emp-NationalityLookupId">@T("Nationality", "الجنسية")</label><select name="NationalityLookupId" id="emp-NationalityLookupId" class="form-select form-select-sm">@foreach (var n in Model.Nationalities) { <option value="@n.Id" selected="@(n.Id == e.NationalityLookupId)">@(isRtl ? n.Ar : n.En)</option> }</select></div>
                    <div class="col-md-2"><label class="form-label small" for="emp-PrimaryIdTypeLookupId">@T("ID type", "نوع الهوية")</label><select name="PrimaryIdTypeLookupId" id="emp-PrimaryIdTypeLookupId" class="form-select form-select-sm"><option value="">—</option>@foreach (var t in Model.IdTypes) { <option value="@t.Id" selected="@(t.Id == e.PrimaryIdTypeLookupId)">@(isRtl ? t.Ar : t.En)</option> }</select></div>
                    <div class="col-md-2"><label class="form-label small" for="emp-PrimaryIdNo">@T("ID number", "رقم الهوية")</label><input name="PrimaryIdNo" id="emp-PrimaryIdNo" class="form-control form-control-sm" dir="ltr" value="@e.PrimaryIdNo" /></div>
                    <div class="col-md-1"><label class="form-label small" for="emp-PrimaryIdExpiry">@T("Expiry", "الانتهاء")</label><input name="PrimaryIdExpiry" id="emp-PrimaryIdExpiry" type="date" class="form-control form-control-sm" value="@e.PrimaryIdExpiry?.ToString("yyyy-MM-dd")" /></div>
                    <div class="col-md-2"><label class="form-label small" for="emp-Mobile">@T("Mobile", "الجوال")</label><input name="Mobile" id="emp-Mobile" class="form-control form-control-sm" dir="ltr" inputmode="tel" maxlength="20" value="@e.Mobile" /></div>
                    <div class="col-md-2"><label class="form-label small" for="emp-WhatsAppNumber">@T("WhatsApp", "الواتس اب")</label><input name="WhatsAppNumber" id="emp-WhatsAppNumber" class="form-control form-control-sm" dir="ltr" inputmode="tel" maxlength="20" value="@e.WhatsAppNumber" /><div class="form-text">@T("Leave empty if it is the same number.", "اتركه فارغاً إن كان نفس الرقم.")</div></div>
                    <div class="col-md-2"><label class="form-label small" for="emp-UserAccountId">@T("User account id", "معرّف حساب المستخدم")</label><input name="UserAccountId" id="emp-UserAccountId" type="number" class="form-control form-control-sm" dir="ltr" value="@e.UserAccountId" /><div class="form-text">@T("Bridge to sec.UserAccount (BR-EMP-001); provisioning lands with Module 36.", "ربط بـ sec.UserAccount (BR-EMP-001)؛ الإنشاء مع الوحدة 36.")</div></div>
                </div>
                <div class="d-flex gap-2 align-items-end"><div style="max-width:420px" class="flex-grow-1"><label class="form-label small" for="emp-Reason">@T("Reason (required when name fields change — BR-EMP-001, T1)", "السبب (مطلوب عند تغيير حقول الاسم — BR-EMP-001)")</label><input name="Reason" id="emp-Reason" class="form-control form-control-sm" /></div><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-save me-1" aria-hidden="true"></i>@T("Save", "حفظ")</button></div>
            </form>

            @* ------------------------------------------------------------------ personal & financial
                A second form rather than a longer first one: the identity block above wants a reason
                whenever a name moves, and putting a mandatory-reason box in front of someone
                correcting a street name is how the reason box stops meaning anything. This half asks
                for one only when the marital status or a payment destination actually changes — the
                audit captor decides that, not the screen. *@
            <hr class="my-4" />
            <form method="post" asp-action="PersonalDetails" asp-route-id="@e.Id">
                <h2 class="h6 text-muted mb-3">@T("Personal details", "البيانات الشخصية")</h2>
                <div class="row g-3 mb-3">
                    <div class="col-md-3"><label class="form-label small" for="pd-maritalStatus">@T("Marital status", "الحالة الاجتماعية")</label><select name="maritalStatus" id="pd-maritalStatus" class="form-select form-select-sm"><option value="">—</option>@foreach (MaritalStatus ms in Enum.GetValues(typeof(MaritalStatus))) { <option value="@ms" selected="@(e.MaritalStatus == ms)">@StaffLabels.MaritalStatus(ms, isRtl)</option> }</select></div>
                    <div class="col-md-3"><label class="form-label small" for="pd-spouseIdTypeLookupId">@T("Spouse ID type", "نوع هوية الزوج/الزوجة")</label><select name="spouseIdTypeLookupId" id="pd-spouseIdTypeLookupId" class="form-select form-select-sm"><option value="">—</option>@foreach (var t in Model.IdTypes) { <option value="@t.Id" selected="@(t.Id == e.SpouseIdTypeLookupId)">@(isRtl ? t.Ar : t.En)</option> }</select></div>
                    <div class="col-md-3"><label class="form-label small" for="pd-spouseIdNo">@T("Spouse ID number", "رقم هوية الزوج/الزوجة")</label><input name="spouseIdNo" id="pd-spouseIdNo" class="form-control form-control-sm" dir="ltr" maxlength="30" value="@e.SpouseIdNo" /></div>
                    <div class="col-md-3"><label class="form-label small" for="pd-originTown">@T("Town of origin", "البلدة الأصلية")</label><input name="originTown" id="pd-originTown" class="form-control form-control-sm" maxlength="100" value="@e.OriginTown" /></div>
                    <div class="col-12"><label class="form-label small" for="pd-address">@T("Address", "العنوان")</label><input name="address" id="pd-address" class="form-control form-control-sm" maxlength="250" value="@e.Address" /></div>
                </div>

                <h2 class="h6 text-muted mb-3">@T("Payment details", "البيانات المالية")</h2>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small" for="pd-bankLookupId">@T("Bank", "البنك")</label>
                        <select name="bankLookupId" id="pd-bankLookupId" class="form-select form-select-sm">
                            <option value="">—</option>
                            @foreach (var b in Model.Banks)
                            {
                                <option value="@b.Id" selected="@(b.Id == e.BankLookupId)">@(isRtl ? b.Ar : b.En)</option>
                            }
                            @*  Model.Banks is the picker — active values only, so a retired bank is
                                not in it. Without this option the select would render "—" for an
                                employee paid into one and blank the field on the next save of an
                                unrelated address. It stays offered to the row already holding it and
                                to nobody else.  *@
                            @if (e.BankLookupId != null && !Model.Banks.Any(b => b.Id == e.BankLookupId))
                            {
                                <option value="@e.BankLookupId" selected="selected">@Model.BankName @T("(retired)", "(ملغى)")</option>
                            }
                        </select>
                        @*  The bank of a register entered before this picker existed is not in the
                            catalogue and cannot be selected, so it stays editable as text rather
                            than being dropped: without a field of its own it would be blanked by
                            the next save of an unrelated address, and there would be no way to
                            correct or clear it either. Picking from the list supersedes it —
                            EmployeeAdmin keeps one answer, never both.  *@
                        @if (e.BankLookupId == null && !string.IsNullOrWhiteSpace(e.BankName))
                        {
                            <input name="bankName" class="form-control form-control-sm mt-1" maxlength="120" value="@e.BankName" aria-label="@T("Bank, as typed before the list was offered", "البنك كما كُتب قبل توفّر القائمة")" />
                            <div class="form-text">@T("Typed before this list was offered. Pick one above to replace it, or clear it here.", "كُتب قبل توفّر هذه القائمة. اختر بنكاً أعلاه ليحلّ محله، أو امسحه من هنا.")</div>
                        }
                    </div>
                    <div class="col-md-4"><label class="form-label small" for="pd-bankAccountNo">@T("Account number / IBAN", "رقم الحساب / الآيبان")</label><input name="bankAccountNo" id="pd-bankAccountNo" class="form-control form-control-sm" dir="ltr" maxlength="40" value="@e.BankAccountNo" /></div>
                    <div class="col-md-2"><label class="form-label small" for="pd-palPayWalletNo">@T("PalPay wallet", "محفظة بالي بي")</label><input name="palPayWalletNo" id="pd-palPayWalletNo" class="form-control form-control-sm" dir="ltr" inputmode="tel" maxlength="20" value="@e.PalPayWalletNo" /></div>
                    <div class="col-md-2"><label class="form-label small" for="pd-jawwalPayWalletNo">@T("JawwalPay wallet", "محفظة جوال بي")</label><input name="jawwalPayWalletNo" id="pd-jawwalPayWalletNo" class="form-control form-control-sm" dir="ltr" inputmode="tel" maxlength="20" value="@e.JawwalPayWalletNo" /></div>
                </div>
                @* The catalogue ships empty on purpose (LookupProductSeedContributor): which banks a
                   school pays through is a local list. Say where to author it rather than leaving a
                   registrar looking at a picker with one dash in it. *@
                @if (Model.Banks.Count == 0)
                {
                    <div class="alert alert-light border small py-2 mb-3">
                        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                        @T("The bank list ships empty — a school authors its own.", "قائمة البنوك تصل فارغة — كل مدرسة تُدخل قائمتها.")
                        <a asp-action="Reference" asp-route-list="Bank">@T("Add banks under Staff → Reference data", "أضِف البنوك من الموظفين ← الثوابت")</a>@T(", then they appear here.", "، ثم تظهر هنا.")
                    </div>
                }
                <div class="d-flex gap-2 align-items-end"><div style="max-width:420px" class="flex-grow-1"><label class="form-label small" for="pd-reason">@T("Reason (required when the marital status or a payment destination changes — T1)", "السبب (مطلوب عند تغيير الحالة الاجتماعية أو أي جهة تُصرف إليها الرواتب — T1)")</label><input name="reason" id="pd-reason" class="form-control form-control-sm" /></div><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-save me-1" aria-hidden="true"></i>@T("Save", "حفظ")</button></div>
                <div class="form-text mt-2">@T("This system never computes a salary (BR-EMP-007) — these are the destinations the payroll export carries. Nothing here pays anybody.", "هذا النظام لا يحتسب راتباً (BR-EMP-007) — وهذه هي الجهات التي يحملها تصدير الرواتب. ولا شيء هنا يصرف لأحد.")</div>
            </form>
            </div>
            </div>
        </div>

        <div class="tab-pane fade @Show("position")" id="tab-position">
            <table class="table table-sm sms-table mb-3"><caption class="visually-hidden">@T("Position history", "سجل المناصب")</caption><thead><tr><th scope="col">@T("Org unit", "الوحدة")</th><th scope="col">@T("Position", "المسمى")</th><th scope="col">@T("Reports to", "يرفع إلى")</th><th scope="col">@T("From", "من")</th><th scope="col">@T("To", "إلى")</th></tr></thead>
                <tbody>@foreach (var a in Model.Assignments) { <tr class="@(a.Assignment.EffectiveToUtc == null ? "fw-semibold" : "text-muted")"><td>@(a.OrgUnit == null ? "?" : (isRtl ? a.OrgUnit.NameAr : a.OrgUnit.NameEn))</td><td>@(a.Position ?? "?")</td><td>@(a.Manager == null ? "—" : $"{a.Manager.EmployeeNo} · {(isRtl ? $"{a.Manager.FirstNameAr} {a.Manager.FamilyNameAr}" : $"{a.Manager.FirstNameEn} {a.Manager.FamilyNameEn}")}")</td><td>@a.Assignment.EffectiveFromUtc.ToString("yyyy-MM-dd")</td><td>@(a.Assignment.EffectiveToUtc?.ToString("yyyy-MM-dd") ?? T("current", "حالي"))</td></tr> }
                @if (Model.Assignments.Count == 0) { <tr><td colspan="5" class="text-center text-warning-emphasis py-3">@T("No position yet — every employee needs a position + org unit (BR-EMP-002).", "لا منصب بعد — كل موظف يحتاج منصباً ووحدة (BR-EMP-002).")</td></tr> }</tbody></table>
            <form method="post" asp-action="AssignPosition" asp-route-id="@e.Id" class="row g-2 align-items-end">
                <div class="col-md-3"><label class="form-label small" for="pos-orgUnitId">@T("Org unit", "الوحدة")</label><select name="orgUnitId" id="pos-orgUnitId" class="form-select form-select-sm"><option value="">—</option>@foreach (var u in Model.OrgUnits) { <option value="@u.Id" selected="@(u.Id == current?.Assignment.OrgUnitId)">@(isRtl ? u.NameAr : u.NameEn)</option> }</select></div>
                <div class="col-md-3"><label class="form-label small" for="pos-positionLookupId">@T("Job title", "المسمى")</label><select name="positionLookupId" id="pos-positionLookupId" class="form-select form-select-sm"><option value="">—</option>@foreach (var p in Model.Positions) { <option value="@p.Id" selected="@(p.Id == current?.Assignment.PositionLookupId)">@(isRtl ? p.Ar : p.En)</option> }</select></div>
                <div class="col-md-3"><label class="form-label small" for="pos-managerEmployeeId">@T("Reports to", "يرفع إلى")</label><select name="managerEmployeeId" id="pos-managerEmployeeId" class="form-select form-select-sm"><option value="">—</option>@foreach (var m in Model.Managers) { <option value="@m.Id" selected="@(m.Id == current?.Assignment.ManagerEmployeeId)">@m.EmployeeNo · @(isRtl ? $"{m.FirstNameAr} {m.FamilyNameAr}" : $"{m.FirstNameEn} {m.FamilyNameEn}")</option> }</select></div>
                <div class="col-md-2"><label class="form-label small" for="pos-effectiveFrom">@T("Effective from", "سريان من")</label><input name="effectiveFrom" id="pos-effectiveFrom" type="date" class="form-control form-control-sm" value="@today" /></div>
                <div class="col-md-1"><button class="btn btn-sm btn-primary w-100" type="submit" title="@T("Assign (closes the current one)", "إسناد (يغلق الحالي)")" aria-label="@T("Assign (closes the current one)", "إسناد (يغلق الحالي)")"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i></button></div>
            </form>
            <div class="form-text">@T("Reassignment closes the current row as of the new effective date — history is kept. Reporting line drives WF-10 leave approvals (deferred).", "إعادة الإسناد تغلق الصف الحالي بتاريخ السريان الجديد مع حفظ السجل. خط الرفع يقود اعتمادات الإجازات WF-10 (مؤجل).")</div>
        </div>

        <div class="tab-pane fade @Show("contracts")" id="tab-contracts">
            <div class="alert alert-light border small py-2"><i class="bi bi-lock me-1" aria-hidden="true"></i>@T("Salary is restricted to HR + Principal (BR-GLB-072) and changes need a reason (T1). The permission gate and Always-Encrypted storage (O10) are pending in this build.", "الراتب مقصور على الموارد البشرية والمدير (BR-GLB-072) وتغييره يحتاج سبباً (T1). بوابة الصلاحية والتشفير (O10) معلّقان في هذا الإصدار.")</div>
            <table class="table table-sm sms-table mb-3 align-middle"><caption class="visually-hidden">@T("Contracts", "العقود")</caption><thead><tr><th scope="col">@T("Type", "النوع")</th><th scope="col">@T("Start", "البداية")</th><th scope="col">@T("End", "النهاية")</th><th scope="col">@T("Basic 🔒", "الأساسي 🔒")</th><th scope="col">@T("Allowances 🔒", "البدلات 🔒")</th><th scope="col">@T("Status", "الحالة")</th><th scope="col"></th></tr></thead>
                <tbody>@foreach (var c in Model.Contracts)
                {
                    var expired = c.Status == ContractStatus.Active && c.EndDate < DateTime.UtcNow.Date;
                    <tr>
                        @if (c.Status == ContractStatus.Draft)
                        {
                            var fid = $"ct{c.Id}";
                            <td><select form="@fid" name="type" class="form-select form-select-sm" aria-label="@T($"Contract {c.Id} type", $"نوع العقد {c.Id}")">@foreach (ContractType ct in Enum.GetValues(typeof(ContractType))) { <option value="@ct" selected="@(ct == c.Type)">@StaffLabels.ContractType(ct, isRtl)</option> }</select></td>
                            <td><input form="@fid" name="startDate" type="date" class="form-control form-control-sm" value="@c.StartDate.ToString("yyyy-MM-dd")" aria-label="@T($"Contract {c.Id} start date", $"تاريخ بداية العقد {c.Id}")" /></td>
                            <td><input form="@fid" name="endDate" type="date" class="form-control form-control-sm" value="@c.EndDate.ToString("yyyy-MM-dd")" aria-label="@T($"Contract {c.Id} end date", $"تاريخ نهاية العقد {c.Id}")" /></td>
                            <td><input form="@fid" name="salaryBasic" type="number" step="0.01" class="form-control form-control-sm" style="width:7rem" value="@c.SalaryBasic.ToString(CultureInfo.InvariantCulture)" aria-label="@T($"Contract {c.Id} basic salary", $"الراتب الأساسي للعقد {c.Id}")" /></td>
                            <td><input form="@fid" name="salaryAllowances" type="number" step="0.01" class="form-control form-control-sm" style="width:7rem" value="@(c.SalaryAllowances?.ToString(CultureInfo.InvariantCulture))" aria-label="@T($"Contract {c.Id} allowances", $"بدلات العقد {c.Id}")" /></td>
                            <td><span class="badge text-bg-secondary">@StaffLabels.ContractStatus(c.Status, isRtl)</span></td>
                            <td class="text-end text-nowrap">
                                <form id="@fid" method="post" asp-action="EditContract" asp-route-id="@e.Id" asp-route-contractId="@c.Id" class="d-inline-flex gap-1"><input name="reason" class="form-control form-control-sm" placeholder="@T("reason", "السبب")" style="width:8rem" aria-label="@T($"Reason for editing contract {c.Id}", $"سبب تعديل العقد {c.Id}")" /><button class="btn btn-sm btn-outline-primary" type="submit" title="@T("Save", "حفظ")" aria-label="@T("Save", "حفظ")"><i class="bi bi-check-lg" aria-hidden="true"></i></button></form>
                                <form method="post" asp-action="ContractStatusChange" asp-route-id="@e.Id" asp-route-contractId="@c.Id" class="d-inline"><input type="hidden" name="target" value="Active" /><button class="btn btn-sm btn-success" type="submit"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i>@T("Activate", "تفعيل")</button></form>
                            </td>
                        }
                        else
                        {
                            <td>@StaffLabels.ContractType(c.Type, isRtl)</td><td>@c.StartDate.ToString("yyyy-MM-dd")</td><td>@c.EndDate.ToString("yyyy-MM-dd")</td><td>@c.SalaryBasic.ToString("N2")</td><td>@(c.SalaryAllowances?.ToString("N2") ?? "—")</td>
                            <td><span class="badge @(c.Status == ContractStatus.Active ? (expired ? "text-bg-warning" : "text-bg-success") : "text-bg-dark")">@StaffLabels.ContractStatus(c.Status, isRtl)@(expired ? " · " + T("expired", "منتهي المدة") : "")</span></td>
                            <td class="text-end">@if (c.Status == ContractStatus.Active) { <form method="post" asp-action="ContractStatusChange" asp-route-id="@e.Id" asp-route-contractId="@c.Id" class="d-inline-flex gap-1" onsubmit="return confirm('@T("Terminate this contract early?", "إنهاء هذا العقد مبكراً؟")');"><input type="hidden" name="target" value="Terminated" /><input name="reason" class="form-control form-control-sm" placeholder="@T("reason", "السبب")" style="width:8rem" aria-label="@T($"Reason for terminating contract {c.Id}", $"سبب إنهاء العقد {c.Id}")" /><button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-x-circle me-1" aria-hidden="true"></i>@T("Terminate", "إنهاء")</button></form> }</td>
                        }
                    </tr>
                }
                @if (Model.Contracts.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">@T("No contracts.", "لا عقود.")</td></tr> }</tbody></table>
            <form method="post" asp-action="DefineContract" asp-route-id="@e.Id" class="row g-2 align-items-end">
                <div class="col-md-2"><label class="form-label small" for="ctnew-type">@T("Type", "النوع")</label><select name="type" id="ctnew-type" class="form-select form-select-sm">@foreach (ContractType ct in Enum.GetValues(typeof(ContractType))) { <option value="@ct">@StaffLabels.ContractType(ct, isRtl)</option> }</select></div>
                <div class="col-md-2"><label class="form-label small" for="ctnew-startDate">@T("Start", "البداية")</label><input name="startDate" id="ctnew-startDate" type="date" class="form-control form-control-sm" /></div>
                <div class="col-md-2"><label class="form-label small" for="ctnew-endDate">@T("End", "النهاية")</label><input name="endDate" id="ctnew-endDate" type="date" class="form-control form-control-sm" /></div>
                <div class="col-md-2"><label class="form-label small" for="ctnew-salaryBasic">@T("Basic salary 🔒", "الراتب الأساسي 🔒")</label><input name="salaryBasic" id="ctnew-salaryBasic" type="number" step="0.01" class="form-control form-control-sm" /></div>
                <div class="col-md-2"><label class="form-label small" for="ctnew-salaryAllowances">@T("Allowances 🔒", "البدلات 🔒")</label><input name="salaryAllowances" id="ctnew-salaryAllowances" type="number" step="0.01" class="form-control form-control-sm" /></div>
                <div class="col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("Draft contract", "مسودة عقد")</button></div>
            </form>
            <div class="form-text">@T("Dates must not overlap another non-terminated contract (BR-EMP-003). Draft → Active (Principal approval, P2 not enforced) → Terminated; natural expiry is derived from the end date.", "لا تتداخل التواريخ مع عقد آخر غير منتهٍ (BR-EMP-003). مسودة → ساري (اعتماد المدير، P2 غير مفعّل) → منتهٍ؛ انتهاء المدة يُستنتج من تاريخ النهاية.")</div>
        </div>

        <div class="tab-pane fade @Show("qualifications")" id="tab-qualifications">
            @*
                One field set, drawn twice — once empty to add and once per row to correct. Written
                as a local function rather than copied, because six fields chosen from four
                dropdowns is exactly the shape that drifts between two copies of the same markup.
                async Task and awaited: the repository's Razor rule for a local function that emits
                markup.
            *@
            @{
                async Task QualificationFields(string id, Sms.Domain.Employees.Qualification? q)
                {
                    await Task.CompletedTask;
                    <div class="row g-2 mb-2">
                        <div class="col-md-3"><label class="form-label small mb-0" for="@(id)-education">@T("Qualification", "المؤهل")</label><select name="educationLookupId" id="@(id)-education" class="form-select form-select-sm"><option value="">—</option>@foreach (var v in Model.EducationLevels) { <option value="@v.Id" selected="@(v.Id == q?.EducationLookupId)">@(isRtl ? v.Ar : v.En)</option> }</select></div>
                        <div class="col-md-3"><label class="form-label small mb-0" for="@(id)-specialization">@T("Specialization", "التخصص")</label><select name="specializationLookupId" id="@(id)-specialization" class="form-select form-select-sm"><option value="">—</option>@foreach (var v in Model.Specializations) { <option value="@v.Id" selected="@(v.Id == q?.SpecializationLookupId)">@(isRtl ? v.Ar : v.En)</option> }</select></div>
                        <div class="col-md-3"><label class="form-label small mb-0" for="@(id)-university">@T("University", "الجامعة")</label><select name="universityLookupId" id="@(id)-university" class="form-select form-select-sm"><option value="">—</option>@foreach (var v in Model.Universities) { <option value="@v.Id" selected="@(v.Id == q?.UniversityLookupId)">@(isRtl ? v.Ar : v.En)</option> }</select></div>
                        <div class="col-md-3"><label class="form-label small mb-0" for="@(id)-grade">@T("Classification", "التقدير")</label><select name="academicGradeLookupId" id="@(id)-grade" class="form-select form-select-sm"><option value="">—</option>@foreach (var v in Model.AcademicGrades) { <option value="@v.Id" selected="@(v.Id == q?.AcademicGradeLookupId)">@(isRtl ? v.Ar : v.En)</option> }</select></div>
                    </div>
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-md-2"><label class="form-label small mb-0" for="@(id)-gpa">@T("GPA", "المعدل")</label><input name="gpa" id="@(id)-gpa" type="number" step="0.01" min="0" max="100" class="form-control form-control-sm" dir="ltr" value="@(q?.Gpa?.ToString(CultureInfo.InvariantCulture))" /></div>
                        <div class="col-md-3"><label class="form-label small mb-0" for="@(id)-dateAwarded">@T("Graduation date", "تاريخ التخرج")</label><input name="dateAwarded" id="@(id)-dateAwarded" type="date" class="form-control form-control-sm" value="@(q?.DateAwarded.ToString("yyyy-MM-dd"))" /></div>
                        <div class="col-md-3"><div class="form-check"><input type="checkbox" name="isTeachingRelevant" value="true" class="form-check-input" id="@(id)-teaching" checked="@(q == null || q.IsTeachingRelevant)" /><label class="form-check-label small" for="@(id)-teaching">@T("Teaching-relevant", "يخص التدريس")</label></div></div>
                    </div>
                    @* The written fallback, for what the four catalogues cannot name: BR-EMP-004
                       covers licences and certificates as well as degrees, and a laboratory-safety
                       certificate has no university and no classification. *@
                    <div class="row g-2">
                        <div class="col-md-3"><label class="form-label small mb-0" for="@(id)-titleAr">@T("Or write the title (Arabic)", "أو اكتب العنوان (عربي)")</label><input name="titleAr" id="@(id)-titleAr" class="form-control form-control-sm" dir="rtl" value="@q?.TitleAr" placeholder="شهادة السلامة المخبرية" /></div>
                        <div class="col-md-3"><label class="form-label small mb-0" for="@(id)-titleEn">@T("Or write the title (English)", "أو اكتب العنوان (إنجليزي)")</label><input name="titleEn" id="@(id)-titleEn" class="form-control form-control-sm" dir="ltr" value="@q?.TitleEn" placeholder="Laboratory Safety Certificate" /></div>
                        <div class="col-md-3"><label class="form-label small mb-0" for="@(id)-institution">@T("Awarding body (if not a university)", "الجهة المانحة (إن لم تكن جامعة)")</label><input name="institution" id="@(id)-institution" class="form-control form-control-sm" value="@q?.InstitutionName" /></div>
                    </div>
                }
            }
            <table class="table table-sm sms-table mb-3"><caption class="visually-hidden">@T("Qualifications", "المؤهلات")</caption><thead><tr><th scope="col">@T("Qualification", "المؤهل")</th><th scope="col">@T("Specialization", "التخصص")</th><th scope="col">@T("University / body", "الجامعة / الجهة")</th><th scope="col">@T("Classification", "التقدير")</th><th scope="col">@T("GPA", "المعدل")</th><th scope="col">@T("Graduated", "تاريخ التخرج")</th><th scope="col">@T("Teaching-relevant", "يخص التدريس")</th><th scope="col"></th></tr></thead>
                <tbody>
                @foreach (var row in Model.Qualifications)
                {
                    var q = row.Qualification;
                    var written = isRtl ? q.TitleAr : q.TitleEn;
                    <tr>
                        @* The catalogued value when there is one, the written title when there is not — the two ways BR-EMP-004 lets an entry name itself. *@
                        <td>@(row.Education ?? (string.IsNullOrWhiteSpace(written) ? "—" : written))</td>
                        <td>@(row.Specialization ?? "—")</td>
                        <td>@(row.University ?? q.InstitutionName ?? "—")</td>
                        <td>@(row.AcademicGrade ?? "—")</td>
                        <td dir="ltr" class="text-end">@(q.Gpa?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                        <td>@q.DateAwarded.ToString("yyyy-MM-dd")</td>
                        <td><span aria-hidden="true">@(q.IsTeachingRelevant ? "✓" : "—")</span><span class="visually-hidden">@(q.IsTeachingRelevant ? T("yes", "نعم") : T("no", "لا"))</span></td>
                        @*
                            The date names the row in the confirmation, not its title: this file's
                            confirm() dialogs interpolate codes only (employee no, cheque no), because
                            a written title reaching the JS string literal through an HTML attribute
                            brings its apostrophes with it — "Bachelor's degree" would end the string
                            early and swallow the dialog. A date is digits, and it is also what tells
                            two bachelor's degrees apart.
                        *@
                        <td class="text-end text-nowrap"><div class="d-inline-flex gap-1">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#qedit@(q.Id)" aria-expanded="false" aria-controls="qedit@(q.Id)" title="@T("Edit", "تعديل")" aria-label="@T($"Edit qualification {q.Id}", $"تعديل المؤهل {q.Id}")"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                            <form method="post" asp-action="DeleteQualification" asp-route-id="@e.Id" asp-route-qualificationId="@q.Id" class="d-inline" onsubmit="return confirm('@T($"Delete the qualification dated {q.DateAwarded.ToString("yyyy-MM-dd")}? This cannot be undone.", $"حذف المؤهل المؤرخ في {q.DateAwarded.ToString("yyyy-MM-dd")}؟ لا يمكن التراجع عن هذا الإجراء.")');">
                                <button class="btn btn-sm btn-outline-danger" type="submit" title="@T("Delete", "حذف")" aria-label="@T($"Delete qualification {q.Id}", $"حذف المؤهل {q.Id}")"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </form>
                        </div></td>
                    </tr>
                    @* The edit sits in its own full-width row: Bootstrap's collapse animates a block, and a table row is not one. *@
                    <tr><td colspan="8" class="p-0 border-0">
                        <div class="collapse" id="qedit@(q.Id)"><div class="border rounded p-3 mb-2 bg-body-tertiary">
                            <form method="post" asp-action="EditQualification" asp-route-id="@e.Id" asp-route-qualificationId="@q.Id">
                                @{ await QualificationFields($"q{q.Id}", q); }
                                <div class="mt-3"><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-save me-1" aria-hidden="true"></i>@T("Save", "حفظ")</button></div>
                            </form>
                        </div></div>
                    </td></tr>
                }
                @if (Model.Qualifications.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-3">@T("No qualifications recorded.", "لا مؤهلات مسجلة.")</td></tr> }</tbody></table>

            <div class="border rounded p-3">
                <h2 class="h6 text-muted mb-3">@T("Add a qualification", "إضافة مؤهل")</h2>
                <form method="post" asp-action="AddQualification" asp-route-id="@e.Id">
                    @{ await QualificationFields("qnew", null); }
                    <div class="mt-3"><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T("Add", "إضافة")</button></div>
                </form>
            </div>
            <div class="form-text">@T("Pick the qualification from the list, or write a title for a certificate no list names — one of the two is required. Teaching-relevant entries are meant to feed the BR-SUB-006 qualification matrix (Subjects → matrix); the auto-feed and document upload are deferred.", "اختر المؤهل من القائمة، أو اكتب عنواناً لشهادة لا تسميها أي قائمة — أحدهما مطلوب. والمدخلات الخاصة بالتدريس تغذي مصفوفة التأهيل BR-SUB-006 (المواد → المصفوفة)؛ التغذية التلقائية ورفع المستندات مؤجلان.")</div>
            @if (Model.Universities.Count == 0 || Model.Specializations.Count == 0)
            {
                <div class="alert alert-light border small py-2 mt-2 mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@T("The university and specialization lists ship empty — a school authors its own. Add them under Setup → Lookups, then they appear here.", "قائمتا الجامعة والتخصص تصلان فارغتين — كل مدرسة تُدخل قوائمها. أضِفهما من الإعدادات ← القوائم المرجعية لتظهرا هنا.")</div>
            }
        </div>

        <div class="tab-pane fade @Show("teaching")" id="tab-teaching">
            @if (Model.TeacherProfile == null)
            {
                <p class="text-muted">@T("Not designated as a teacher. Designation needs an active contract (BR-TCH-001) and a weekly maximum (BR-TCH-004).", "غير معيَّن معلماً. التعيين يحتاج عقداً سارياً (BR-TCH-001) وحداً أسبوعياً (BR-TCH-004).")</p>
                <form method="post" asp-action="Designate" asp-route-id="@e.Id" class="d-flex gap-2 align-items-end"><div><label class="form-label small" for="designate-maxWeeklyPeriods">@T("Max weekly periods", "الحد الأقصى للحصص/أسبوع")</label><input name="maxWeeklyPeriods" id="designate-maxWeeklyPeriods" type="number" min="1" class="form-control form-control-sm" style="width:8rem" value="24" /></div><button class="btn btn-sm btn-primary" type="submit" @(Model.HasActiveContract ? "" : "disabled") title="@(Model.HasActiveContract ? "" : T("Needs an active contract", "يحتاج عقداً سارياً"))"><i class="bi bi-person-workspace me-1" aria-hidden="true"></i>@T("Designate as teacher", "تعيين معلماً")</button></form>
            }
            else
            {
                var pct = Model.TeacherProfile.MaxWeeklyPeriods == 0 ? 0 : Math.Min(100, (int)Math.Round(100.0 * Model.CurrentLoad / Model.TeacherProfile.MaxWeeklyPeriods));
                <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                    <div class="small">@T("Load", "النصاب"): <strong>@Model.CurrentLoad / @Model.TeacherProfile.MaxWeeklyPeriods</strong> @T("periods/week", "حصة/أسبوع")</div><div class="sms-progress" style="width:10rem" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="@T("Load", "النصاب")"><span style="width:@(pct)%;@(Model.CurrentLoad > Model.TeacherProfile.MaxWeeklyPeriods ? "background:#dc2626" : "")"></span></div>
                    <form method="post" asp-action="MaxLoad" asp-route-id="@e.Id" class="d-inline-flex gap-1 align-items-center ms-auto"><input type="hidden" name="profileId" value="@Model.TeacherProfile.Id" /><label class="small" for="maxload-maxWeeklyPeriods">@T("max", "الحد")</label><input name="maxWeeklyPeriods" id="maxload-maxWeeklyPeriods" type="number" min="1" class="form-control form-control-sm" style="width:5rem" value="@Model.TeacherProfile.MaxWeeklyPeriods" aria-label="@T("Max weekly periods", "الحد الأقصى للحصص الأسبوعية")" /><button class="btn btn-sm btn-outline-primary" type="submit" aria-label="@T("Save load cap", "حفظ حد النصاب")"><i class="bi bi-check-lg" aria-hidden="true"></i></button></form>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Teachers" asp-action="Matrix"><i class="bi bi-grid-3x3 me-1" aria-hidden="true"></i>@T("Assignment matrix", "مصفوفة الإسناد")</a>
                </div>
                <table class="table table-sm sms-table mb-0"><caption class="visually-hidden">@T("Teaching assignments", "الإسنادات التدريسية")</caption><thead><tr><th scope="col">@T("Subject", "المادة")</th><th scope="col">@T("Section", "الشعبة")</th><th scope="col">@T("Role", "الدور")</th><th scope="col">@T("Periods/wk", "حصص")</th><th scope="col">@T("From", "من")</th><th scope="col">@T("To", "إلى")</th></tr></thead>
                    <tbody>@foreach (var t in Model.Teaching) { <tr class="@(t.Assignment.EffectiveToUtc == null ? "" : "text-muted")"><td>@(t.Subject == null ? "?" : (isRtl ? t.Subject.Name.NameAr : t.Subject.Name.NameEn))</td><td>@(t.Section == null ? "?" : (isRtl ? t.Section.NameAr : t.Section.NameEn))</td><td>@StaffLabels.TeacherRole(t.Assignment.Role, isRtl)</td><td>@(t.Offering?.WeeklyPeriods)</td><td>@t.Assignment.EffectiveFromUtc.ToString("yyyy-MM-dd")</td><td>@(t.Assignment.EffectiveToUtc?.ToString("yyyy-MM-dd") ?? T("current", "حالي"))</td></tr> }@if (Model.Teaching.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-3">@T("No assignments yet — use the assignment matrix.", "لا إسنادات بعد — استخدم مصفوفة الإسناد.")</td></tr> }</tbody></table>
                @if (!Model.HasActiveContract) { <div class="alert alert-warning small mt-3 mb-0">@T("No active contract — new assignments are blocked until a contract is active (BR-TCH-001).", "لا عقد ساري — الإسنادات الجديدة محجوبة حتى يسري عقد (BR-TCH-001).")</div> }
            }
        </div>

        <div class="tab-pane fade @Show("status")" id="tab-status">
            <div class="d-flex flex-wrap gap-2 mb-3">@foreach (var st in Model.AllowedTransitions) { <form method="post" asp-action="Status" asp-route-id="@e.Id" class="d-inline-flex gap-1" onsubmit="return @(st == EmployeeStatus.Terminated ? "confirm('" + T("Terminate employment? This is final (BR-EMP-008).", "إنهاء الخدمة؟ هذا نهائي (BR-EMP-008).") + "')" : "true");"><input type="hidden" name="target" value="@st" /><input name="reason" class="form-control form-control-sm" placeholder="@T("reason", "السبب")" style="width:11rem" aria-label="@T($"Reason for changing status to {StaffLabels.EmployeeStatus(st, false)}", $"سبب تغيير الحالة إلى {StaffLabels.EmployeeStatus(st, true)}")" /><button class="btn btn-sm @(st == EmployeeStatus.Terminated ? "btn-outline-danger" : "btn-outline-primary")" type="submit">→ @StaffLabels.EmployeeStatus(st, isRtl)</button></form> }@if (Model.AllowedTransitions.Count == 0) { <span class="text-muted small">@T("Terminal status.", "حالة نهائية.")</span> }</div>
            <div class="form-text">@T("Offboarding clearance (handover, assets, final settlement, account deactivation — BR-EMP-008) arrives as a wizard; today Terminated is a plain transition.", "معالج إخلاء الطرف (التسليم، العهد، التسوية النهائية، تعطيل الحساب — BR-EMP-008) يأتي لاحقاً؛ حالياً الإنهاء انتقال بسيط.")</div>
        </div>

        @* doc 10 §5: contracts, qualifications and ID papers filed through the one intake the whole
           product uses — the same partial, the same four verbs, as the student file. *@
        <div class="tab-pane fade @Show("documents")" id="tab-documents"><partial name="_EntityDocuments" model="Model.Documents" /></div>
        <div class="tab-pane fade @Show("audit")" id="tab-audit"><table class="table table-sm sms-table mb-0 small"><caption class="visually-hidden">@T("Audit trail", "سجل التدقيق")</caption><thead><tr><th scope="col">@T("When", "متى")</th><th scope="col">@T("Action", "الإجراء")</th><th scope="col">@T("Field", "الحقل")</th><th scope="col">@T("Old", "قبل")</th><th scope="col">@T("New", "بعد")</th><th scope="col">@T("Reason", "السبب")</th><th scope="col">@T("Actor", "المنفذ")</th></tr></thead><tbody>@foreach (var a in Model.Audit) { <tr><td>@a.At.ToString("yyyy-MM-dd HH:mm")</td><td>@a.Action</td><td>@a.Field</td><td>@a.Old</td><td>@a.New</td><td>@a.Reason</td><td>#@a.Actor</td></tr> }</tbody></table></div>
        <div class="tab-pane fade @Show("more")" id="tab-more"><ul class="small text-muted mb-0"><li>@T("Training (PD hours), Attendance (staff console), Leave (WF-10 balances + requests), Documents (attachments), Payroll-prep, Offboarding — open as their engines/screens land.", "التدريب (ساعات التطوير)، الحضور (كونسول الموظفين)، الإجازات (WF-10)، المستندات، تجهيز الرواتب، إنهاء الخدمة — تُفعَّل مع محركاتها/شاشاتها.")</li></ul></div>
    </div>
</div>
