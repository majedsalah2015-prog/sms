@using System.Globalization
@model EmployeeImportViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    string T(string en, string ar) => isRtl ? ar : en;
    ViewData["Title"] = T("Import staff from Access", "استيراد الموظفين من أكسس");
    ViewData["Breadcrumb"] = T("Employees / Import", "الموظفون / استيراد");
    var haveFile = !string.IsNullOrWhiteSpace(Model.Token);
    var haveColumns = Model.Columns.Count > 0;
    var help = new HelpPanelViewModel
    {
        Id = "emp-import-help", Title = T("Import — help", "الاستيراد — مساعدة"),
        Intro = T("Fifteen columns are read, and one row becomes up to four records: the employee, a contract, a job assignment and a qualification. Only the employee is required — a row whose salary cell is unreadable still becomes an employee, without a contract.", "تُقرأ خمسة عشر عموداً، ويصبح الصف الواحد أربعة سجلات كحدّ أقصى: الموظف وعقده وتعيينه ومؤهله. والموظف وحده مطلوب — فالصف الذي لا يُقرأ راتبه يصبح موظفاً بلا عقد."),
        Items = new[]
        {
            new HelpPanelViewModel.Item(T("Nothing is written until the last step", "لا يُكتَب شيء حتى الخطوة الأخيرة"), T("Uploading and previewing only read. The preview is produced by the very same code the import runs, so a row that looks right in it is a row that will go in — and one marked with a problem is one that will be skipped, counted and left behind in the old file.", "الرفع والمعاينة قراءة فقط. والمعاينة تنتجها الشيفرة ذاتها التي تنفّذ الاستيراد، فالسطر الذي يبدو صحيحاً فيها هو ما سيُكتَب — والمعلَّم بمشكلة يُتخطّى ويُحصى ويبقى في الملف القديم.")),
            new HelpPanelViewModel.Item(T("Three things are chosen once, not per row", "ثلاثة أمور تُختار مرة لا لكل صف"), T("Nationality, the organisation unit an assignment belongs to, and the contract end date. A staff register never carries an end date, and one this system invented would be indistinguishable from a date the school agreed to — it is the date the expiry alerts fire on (BR-EMP-003).", "الجنسية، والوحدة التنظيمية التي يتبعها التعيين، وتاريخ نهاية العقد. فسجل الموظفين لا يحمل تاريخ نهاية قطّ، وتاريخٌ يخترعه النظام لا يُميَّز عن تاريخ وافقت عليه المدرسة — وهو التاريخ الذي تنطلق عنده تنبيهات انتهاء العقد (BR-EMP-003).")),
            new HelpPanelViewModel.Item(T("Job titles must already exist", "المسميات الوظيفية يجب أن تكون موجودة"), T("A job title from the register is matched against the school's own JobTitle list in either language. No match means the assignment is dropped and the employee still imported — inventing a lookup value from a spreadsheet cell would fill the list with every spelling the old register used.", "يُطابَق المسمى الوظيفي من السجل مع قائمة المسميات لدى المدرسة بأي اللغتين. وعدم التطابق يعني إسقاط التعيين مع بقاء الموظف مستورداً — فاختراع قيمة مرجعية من خلية جدول يملأ القائمة بكل هجاء استعمله السجل القديم.")),
            new HelpPanelViewModel.Item(T("Bank details are audited with a reason", "بيانات البنك مدقَّقة بسبب"), T("The bank name and the account number are tier-1 audited and require a stated reason, exactly like the salary. The import states one for you: the name of the file the values came from.", "اسم البنك ورقم الحساب مدقَّقان من الفئة الأولى ويتطلبان سبباً مكتوباً، تماماً كالراتب. والاستيراد يذكر لك سبباً: اسم الملف الذي جاءت منه القيم.")),
            new HelpPanelViewModel.Item(T("Names go in twice", "الاسم يُخزَّن مرتين"), T("The model requires an English name as well as an Arabic one. The import stores the register's own text in both rather than transliterating: an invented spelling is harder to notice and harder to correct than an obviously untranslated one.", "يتطلب النموذج اسماً إنجليزياً كما يتطلب عربياً. والاستيراد يخزّن نص السجل نفسه في الاثنين بدل النقحرة: فالهجاء المخترَع أصعب ملاحظةً وأصعب تصحيحاً من نصٍّ ظاهر أنه لم يُترجَم.")),
            new HelpPanelViewModel.Item(T("If the server has no Access driver", "إن لم يكن على الخادم مشغّل أكسس"), T("Reading an .accdb needs Microsoft's Access Database Engine installed on the server, in the same bitness as the application. Without it the upload step says so plainly instead of failing silently.", "قراءة ملف accdb. تتطلب تثبيت Microsoft Access Database Engine على الخادم بالمعمارية نفسها للتطبيق. وبدونه تقول خطوة الرفع ذلك صراحةً بدل أن تفشل بصمت.")),
        },
    };
}

<div class="sms-page-head">
    <div>
        <h1 class="sms-page-title">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">@T("Name · hire date · ID number · contract type · job · active · date of birth · gender · marital status · qualification · university · graduation date · salary · bank · account number.", "الاسم · تاريخ التعيين · رقم الهوية · نوع العقد · الوظيفة · فعال · تاريخ الميلاد · الجنس · الحالة الاجتماعية · المؤهل العلمي · الجامعة · تاريخ التخرج · الراتب · البنك · رقم الحساب.")</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <partial name="_HelpModal" model="help" />
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="bi bi-arrow-left @(isRtl ? "sms-flip" : "")" aria-hidden="true"></i> @T("Employees", "الموظفون")</a>
    </div>
</div>

<partial name="_StaffNav" />

<!-- step 1 -->
<div class="sms-card p-4 mb-3">
    <h2 class="h6">@T("1 · The file", "١ · الملف")</h2>
    <form method="post" asp-action="ImportUpload" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small" for="register">@T("Access database (.mdb or .accdb)", "قاعدة بيانات أكسس (mdb. أو accdb.)")</label>
            <input id="register" type="file" name="register" accept=".mdb,.accdb" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-upload me-1" aria-hidden="true"></i>@T("Read it", "اقرأه")</button>
        </div>
        @if (haveFile)
        {
            <div class="col-md-3 small text-muted">@T("Loaded:", "المحمَّل:") <strong>@Model.OriginalFileName</strong></div>
        }
    </form>
</div>

@if (haveFile && Model.Tables.Count > 0)
{
    <!-- step 2 -->
    <div class="sms-card p-4 mb-3">
        <h2 class="h6">@T("2 · The table and its columns", "٢ · الجدول وأعمدته")</h2>
        <form method="post" asp-action="ImportPreview">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="OriginalFileName" />
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-5">
                    <label class="form-label small" asp-for="Table">@T("Table", "الجدول")</label>
                    <select asp-for="Table" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">@T("— choose —", "— اختر —")</option>
                        @foreach (var t in Model.Tables)
                        {
                            <option value="@t" selected="@(t == Model.Table)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-sm btn-outline-primary">@T("Read the table", "اقرأ الجدول")</button>
                </div>
            </div>

            @if (haveColumns)
            {
                <p class="small text-muted">@T("Say which column holds what. The guesses below come from the column names; correct any that are wrong. A field left at “none” is simply not imported.", "بيّن أي عمود يحمل ماذا. والتخمينات أدناه من أسماء الأعمدة؛ صحّح ما أخطأ منها. والحقل المتروك على «بلا» لا يُستورَد ببساطة.")</p>

                // Grouped by the record each column ends up in, because that is the thing an
                // operator needs to understand: a mapping mistake in the "contract" group costs
                // a contract, one in the "employee" group costs the row.
                var groups = new (string En, string Ar, (string Prop, string En, string Ar, string? Value)[] Fields)[]
                {
                        ("The employee", "الموظف", new[]
                        {
                            ("FullNameColumn", "Whole name in one column", "اسم الموظف كاملاً في عمود واحد", Model.FullNameColumn),
                            ("FirstNameColumn", "First name", "الاسم الأول", Model.FirstNameColumn),
                            ("FatherNameColumn", "Father's name", "اسم الأب", Model.FatherNameColumn),
                            ("GrandfatherNameColumn", "Grandfather's name", "اسم الجد", Model.GrandfatherNameColumn),
                            ("FamilyNameColumn", "Family name", "اسم العائلة", Model.FamilyNameColumn),
                            ("IdNumberColumn", "Identity number", "رقم الهوية", Model.IdNumberColumn),
                            ("DateOfBirthColumn", "Date of birth", "تاريخ الميلاد", Model.DateOfBirthColumn),
                            ("GenderColumn", "Gender", "الجنس", Model.GenderColumn),
                            ("ActiveColumn", "Active", "فعال", Model.ActiveColumn),
                            ("MaritalStatusColumn", "Marital status", "الحالة الاجتماعية", Model.MaritalStatusColumn),
                            ("BankNameColumn", "Bank", "البنك", Model.BankNameColumn),
                            ("BankAccountColumn", "Account number", "رقم الحساب", Model.BankAccountColumn),
                        }),
                        ("The contract", "العقد", new[]
                        {
                            ("HireDateColumn", "Hire date", "تاريخ التعيين", Model.HireDateColumn),
                            ("ContractTypeColumn", "Contract type", "نوع العقد", Model.ContractTypeColumn),
                            ("SalaryColumn", "Salary", "الراتب", Model.SalaryColumn),
                        }),
                        ("The assignment", "التعيين", new[]
                        {
                            ("PositionColumn", "Job title", "الوظيفة", Model.PositionColumn),
                        }),
                        ("The qualification", "المؤهل", new[]
                        {
                            ("QualificationColumn", "Qualification", "المؤهل العلمي", Model.QualificationColumn),
                            ("UniversityColumn", "University", "الجامعة", Model.UniversityColumn),
                            ("GraduationDateColumn", "Graduation date", "تاريخ التخرج", Model.GraduationDateColumn),
                        }),
                };

                foreach (var g in groups)
                {
                    <fieldset class="border rounded p-3 mb-2">
                        <legend class="float-none w-auto px-2 small text-muted">@(isRtl ? g.Ar : g.En)</legend>
                        <div class="row g-2">
                            @foreach (var f in g.Fields)
                            {
                                <div class="col-md-3">
                                    <label class="form-label small" for="map-@f.Prop">@(isRtl ? f.Ar : f.En)</label>
                                    <select id="map-@f.Prop" name="@f.Prop" class="form-select form-select-sm">
                                        <option value="">@T("— none —", "— بلا —")</option>
                                        @foreach (var c in Model.Columns)
                                        {
                                            <option value="@c" selected="@(c == f.Value)">@c</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    </fieldset>
                }

                <fieldset class="border rounded p-3 mb-2">
                    <legend class="float-none w-auto px-2 small text-muted">@T("The same for every row", "واحد لكل الصفوف")</legend>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label small" asp-for="NationalityLookupId">@T("Nationality", "الجنسية")</label>
                            <select asp-for="NationalityLookupId" class="form-select form-select-sm">
                                @foreach (var n in Model.Nationalities)
                                {
                                    <option value="@n.Id" selected="@(n.Id == Model.NationalityLookupId)">@(isRtl ? n.Ar : n.En)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small" asp-for="IdTypeLookupId">@T("Identity document type", "نوع وثيقة الهوية")</label>
                            <select asp-for="IdTypeLookupId" class="form-select form-select-sm">
                                <option value="">@T("— none —", "— بلا —")</option>
                                @foreach (var t in Model.IdTypes)
                                {
                                    <option value="@t.Id" selected="@(t.Id == Model.IdTypeLookupId)">@(isRtl ? t.Ar : t.En)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small" asp-for="OrgUnitId">@T("Organisation unit", "الوحدة التنظيمية")</label>
                            <select asp-for="OrgUnitId" class="form-select form-select-sm">
                                <option value="">@T("— none —", "— بلا —")</option>
                                @foreach (var u in Model.OrgUnits)
                                {
                                    <option value="@u.Id" selected="@(u.Id == Model.OrgUnitId)">@(isRtl ? u.Ar : u.En)</option>
                                }
                            </select>
                            <div class="form-text">@T("Required if a job title is mapped.", "مطلوبة إن رُبط عمود الوظيفة.")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small" asp-for="ContractEndDate">@T("Contract end date", "تاريخ نهاية العقد")</label>
                            <input asp-for="ContractEndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control form-control-sm" />
                            <div class="form-text">@T("Required if a hire date is mapped.", "مطلوب إن رُبط تاريخ التعيين.")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small" asp-for="DefaultContractType">@T("Contract type when the cell cannot be read", "نوع العقد حين لا تُقرأ الخلية")</label>
                            <select asp-for="DefaultContractType" class="form-select form-select-sm">
                                @foreach (Sms.Domain.Employees.ContractType t in Enum.GetValues(typeof(Sms.Domain.Employees.ContractType)))
                                {
                                    <option value="@t" selected="@(t == Model.DefaultContractType)">@StaffLabels.ContractType(t, isRtl)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 align-self-end">
                            <button type="submit" class="btn btn-sm btn-outline-primary w-100">@T("Preview", "معاينة")</button>
                        </div>
                    </div>
                </fieldset>
            }
        </form>
    </div>
}

@if (Model.Preview.Count > 0)
{
    <!-- step 3 -->
    <div class="sms-card p-4">
        <h2 class="h6">@T("3 · What will be written", "٣ · ما الذي سيُكتَب")</h2>
        <p class="small">
            <span class="badge text-bg-success">@Model.ReadyRows</span> @T("ready", "جاهز") ·
            <span class="badge text-bg-warning">@Model.SkippedRows</span> @T("will be skipped", "سيُتخطّى") ·
            <span class="text-muted">@T("of", "من") @Model.TotalRows @T("rows", "صفاً")</span>
        </p>

        <div class="table-responsive mb-3">
            <table class="table table-sm sms-table mb-0">
                <caption class="visually-hidden">@T("Import preview", "معاينة الاستيراد")</caption>
                <thead><tr>
                    <th scope="col">#</th>
                    <th scope="col">@T("Name", "الاسم")</th>
                    <th scope="col">@T("Born", "الميلاد")</th>
                    <th scope="col">@T("Gender", "الجنس")</th>
                    <th scope="col">@T("ID", "الهوية")</th>
                    <th scope="col">@T("Active", "فعال")</th>
                    <th scope="col">@T("Marital", "الاجتماعية")</th>
                    <th scope="col">@T("Hired", "التعيين")</th>
                    <th scope="col">@T("Type", "النوع")</th>
                    <th scope="col" class="text-end">@T("Salary", "الراتب")</th>
                    <th scope="col">@T("Job", "الوظيفة")</th>
                    <th scope="col">@T("Qualification", "المؤهل")</th>
                    <th scope="col">@T("Bank", "البنك")</th>
                    <th scope="col">@T("Problem / notes", "المشكلة / ملاحظات")</th>
                </tr></thead>
                <tbody>
                @foreach (var r in Model.Preview)
                {
                    <tr class="@(r.Problem == null ? "" : "table-warning")">
                        <td class="text-muted">@r.Number</td>
                        <td>@r.FirstName @r.FatherName @r.GrandfatherName @r.FamilyName</td>
                        <td class="small"><bdi dir="ltr">@r.DateOfBirth</bdi></td>
                        <td class="small">@(r.Gender == "F" ? T("Female", "أنثى") : r.Gender == "M" ? T("Male", "ذكر") : "—")</td>
                        <td class="small"><bdi dir="ltr">@r.IdNumber</bdi></td>
                        <td class="small"><span aria-hidden="true">@(r.IsActive ? "✓" : "—")</span><span class="visually-hidden">@(r.IsActive ? T("active", "فعال") : T("not active", "غير فعال"))</span></td>
                        <td class="small">@(r.MaritalStatus == null ? "—" : StaffLabels.MaritalStatus(Enum.Parse<Sms.Domain.Employees.MaritalStatus>(r.MaritalStatus), isRtl))</td>
                        <td class="small"><bdi dir="ltr">@r.HireDate</bdi></td>
                        <td class="small">@(r.ContractType == null ? "—" : StaffLabels.ContractType(Enum.Parse<Sms.Domain.Employees.ContractType>(r.ContractType), isRtl))</td>
                        <td class="small text-end"><bdi dir="ltr">@(r.Salary?.ToString("N2", CultureInfo.InvariantCulture) ?? "—")</bdi></td>
                        <td class="small">@(r.Position ?? "—")</td>
                        <td class="small">@(r.Qualification ?? "—")@if (r.University != null) { <span class="text-muted"> · @r.University</span> }</td>
                        <td class="small">@(r.BankName ?? "—")@if (r.BankAccountNo != null) { <span class="text-muted"> · <bdi dir="ltr">@r.BankAccountNo</bdi></span> }</td>
                        <td class="small">
                            @if (r.Problem != null) { <span class="text-danger d-block">@r.Problem</span> }
                            @foreach (var n in r.Notes) { <span class="text-warning-emphasis d-block">@n</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.TotalRows > Model.Preview.Count)
        {
            <p class="form-text">@T("Showing the first", "تُعرض أول") @Model.Preview.Count @T("rows; every row is checked, not only these.", "صفاً؛ وكل الصفوف مفحوصة لا هذه وحدها.")</p>
        }

        <form method="post" asp-action="ImportCommit" onsubmit="return confirm('@T("Import the ready rows?", "استيراد الصفوف الجاهزة؟")');">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="OriginalFileName" />
            <input type="hidden" asp-for="Table" />
            <input type="hidden" asp-for="FullNameColumn" />
            <input type="hidden" asp-for="FirstNameColumn" />
            <input type="hidden" asp-for="FatherNameColumn" />
            <input type="hidden" asp-for="GrandfatherNameColumn" />
            <input type="hidden" asp-for="FamilyNameColumn" />
            <input type="hidden" asp-for="IdNumberColumn" />
            <input type="hidden" asp-for="DateOfBirthColumn" />
            <input type="hidden" asp-for="GenderColumn" />
            <input type="hidden" asp-for="ActiveColumn" />
            <input type="hidden" asp-for="MaritalStatusColumn" />
            <input type="hidden" asp-for="BankNameColumn" />
            <input type="hidden" asp-for="BankAccountColumn" />
            <input type="hidden" asp-for="HireDateColumn" />
            <input type="hidden" asp-for="ContractTypeColumn" />
            <input type="hidden" asp-for="SalaryColumn" />
            <input type="hidden" asp-for="PositionColumn" />
            <input type="hidden" asp-for="QualificationColumn" />
            <input type="hidden" asp-for="UniversityColumn" />
            <input type="hidden" asp-for="GraduationDateColumn" />
            <input type="hidden" asp-for="NationalityLookupId" />
            <input type="hidden" asp-for="IdTypeLookupId" />
            <input type="hidden" asp-for="OrgUnitId" />
            <input type="hidden" asp-for="ContractEndDate" />
            <input type="hidden" asp-for="DefaultContractType" />
            <button type="submit" class="btn btn-primary" @(Model.ReadyRows == 0 ? "disabled" : "")>
                <i class="bi bi-database-add me-1" aria-hidden="true"></i>@T("Import", "استيراد") @Model.ReadyRows
            </button>
        </form>
    </div>
}
